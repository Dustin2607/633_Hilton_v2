  {
    "logic": "AND"
  },
  {
    "path": "alarmState",
    "comparator": "!=",
    "value": 2
  },
  {
    "logic": "AND"
  },
  {
    "path": "alarmState",
    "comparator": "!=",
    "value": 1
  }
]
</script>
