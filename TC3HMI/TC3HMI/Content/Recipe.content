<div id="tRecipeName_1" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextbox" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-height="35" data-tchmi-height-unit="px" data-tchmi-left="9" data-tchmi-left-unit="px" data-tchmi-text="Recipe name" data-tchmi-top="101" data-tchmi-top-unit="px" data-tchmi-width="408" data-tchmi-width-unit="px" data-tchmi-auto-focus-out="false" data-tchmi-auto-select-text="true" data-tchmi-is-enabled="true" data-tchmi-zindex="3">
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{"top":3,"right":3,"bottom":3,"left":3}
</script>


<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "tRecipeName_1.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%ContKeyboard_2::Visibility%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/Visibility",
          "value": "Visible"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "(function () {",
          "    if ($('#HMICompactKeypad').length === 0) {",
          "        let isShift = false;",
          "        let isCaps = false;",
          "",
          "        const keyRows = [",
          "            ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '_', '+', 'Backspace'],",
          "            ['Tab', 'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '{', '}', '|'],",
          "            ['Caps', 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ':', '\"', 'Enter'],",
          "            ['Shift', 'z', 'x', 'c', 'v', 'b', 'n', 'm', '<', '>', '?', 'OK'],",
          "            ['Space', 'Clear']",
          "        ];",
          "",
          "        const getDisplayKey = (key) => {",
          "            const shiftMap = {",
          "  \t\t\t\t'`': '~', '1': '!', '2': '@', '3': '#', '4': '$', '5': '%',",
          "                '6': '^', '7': '&', '8': '*', '9': '(', '0': ')', '-': '_', '=': '+',",
          "                '[': '{', ']': '}', '\\': '|', ';': ':', \"'\": '\"', ',': '<', '.': '>', '/': '?'",
          "",
          "",
          "            };",
          "",
          "            if (key.length === 1) {",
          "                if (isShift) {",
          "                    if (shiftMap[key]) return shiftMap[key];",
          "                    return key.toUpperCase();",
          "                } else if (isCaps && /[a-z]/i.test(key)) {",
          "                    return key.toUpperCase();",
          "                } else {",
          "                    return key;",
          "                }",
          "            }",
          "",
          "            return key;",
          "        };",
          "",
          "        const renderKeys = () => {",
          "            return keyRows.map((row, rowIndex) => {",
          "                let rowHtml = '<div class=\"keyRow\" style=\"display:flex; gap:6px; margin-bottom:6px; justify-content:center;\">';",
          "                row.forEach(key => {",
          "                    const display = getDisplayKey(key);",
          "                    let styles = 'height:40px; font-size:16px; border:1px solid #888; border-radius:4px; cursor:pointer; user-select:none;';",
          "                    let extraStyle = '';",
          "",
          "                    if (key === 'Space') {",
          "                        extraStyle = 'flex:4;';",
          "                    } else if (['Clear', 'Shift', 'Caps', 'Tab', 'Enter', 'Backspace', 'OK'].includes(key)) {",
          "                        extraStyle = 'flex:1.5; background:#ddd;';",
          "                        if (key === 'OK') extraStyle += ' background:#4CAF50; color:white;';",
          "                    } else {",
          "                        extraStyle = 'width:36px; background:#fff;';",
          "                    }",
          "",
          "                    rowHtml += `<button class=\"keyBtn\" data-key=\"${key}\" style=\"${styles}${extraStyle}\">${display}</button>`;",
          "                });",
          "                rowHtml += '</div>';",
          "                return rowHtml;",
          "            }).join('');",
          "        };",
          "",
          "        $('body').append(`",
          "            <div id=\"HMICompactKeypad\" style=\"",
          "                position: fixed;",
          "                bottom: 100px;",
          "                right: 80px;",
          "                background: #f0f0f0;",
          "                border: 2px solid #666;",
          "                padding: 16px;",
          "                z-index: 10000;",
          "                font-family: Arial;",
          "                border-radius: 10px;",
          "                box-shadow: 0px 0px 12px rgba(0,0,0,0.4);",
          "                width: 700px;",
          "                user-select: none;",
          "            \">",
          "                <input type=\"text\" id=\"HMIKeyInput\" readonly style=\"",
          "                    width: 100%;",
          "                    height: 40px;",
          "                    font-size: 20px;",
          "                    text-align: left;",
          "                    margin-bottom: 12px;",
          "                    padding: 6px;",
          "                    border: 1px solid #ccc;",
          "                    border-radius: 4px;",
          "                \" />",
          "                <div id=\"keyGrid\">",
          "                    ${renderKeys()}",
          "                </div>",
          "            </div>",
          "        `);",
          "",
          "        $('#keyGrid').on('click', '.keyBtn', function () {",
          "            const key = $(this).data('key');",
          "            const input = $('#HMIKeyInput');",
          "            let current = input.val();",
          "",
          "            switch (key) {",
          "                case 'Backspace':",
          "                    input.val(current.slice(0, -1));",
          "                    break;",
          "                case 'Clear':",
          "                    input.val('');",
          "                    break;",
          "                case 'Space':",
          "                    input.val(current + ' ');",
          "                    break;",
          "                case 'Shift':",
          "                    isShift = !isShift;",
          "                    $('#keyGrid').html(renderKeys());",
          "                    break;",
          "                case 'Caps':",
          "                    isCaps = !isCaps;",
          "                    $('#keyGrid').html(renderKeys());",
          "                    break;",
          "                case 'Tab':",
          "                    input.val(current + '\\t');",
          "                    break;",
          "                case 'Enter':",
          "                    input.val(current + '\\n');",
          "                    break;",
          "                case 'OK':",
          "                    const value = input.val();",
          "                    TcHmi.Symbol.writeEx('%s%plc2.GVL_Gr02HMI.stHMITOPLC.sWorker%/s%', value, function (data) {",
          "                        if (data.error === TcHmi.Errors.NONE) {",
          "                            console.log('? Value written:', value);",
          "                        } else {",
          "                            console.error('? Write failed:', data.error);",
          "                        }",
          "                    });",
          "                    $('#HMICompactKeypad').remove();",
          "                    break;",
          "                default:",
          "                    input.val(current + getDisplayKey(key));",
          "            }",
          "        });",
          "    }",
          "})();"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
