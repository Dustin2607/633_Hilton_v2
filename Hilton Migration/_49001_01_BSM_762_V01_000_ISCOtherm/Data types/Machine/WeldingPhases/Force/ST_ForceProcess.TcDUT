<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_ForceProcess" Id="{26f31207-547f-405b-a6ed-cdbb5b057e8d}">
    <Declaration><![CDATA[TYPE ST_ForceProcess :
STRUCT
	lrProcessForce						:LREAL;											(* Process force [N] *)
	unProcessRamp						:UINT;											(* Process ramp [s] *)
	unProcessTime						:UINT;											(* Process time [s]  *)
	arunDuration							:ARRAY[1..2] OF UINT;								(* Duration [s] *)
	lrVeloForceCtrlKp						:LREAL;											(* Velocity - force controller proportional band Kp *)
	lrVeloForceCtrlTi						:LREAL;											(* Velocity - force controller integral Ti *)
	lrVeloForcePreCtrlVelo					:LREAL;											(* Feedforward velocity precontrol wieghting =  0..1 *)
	lrVeloForceCtrlLimit					:LREAL;											(* Velocity - force controller limit  *)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>