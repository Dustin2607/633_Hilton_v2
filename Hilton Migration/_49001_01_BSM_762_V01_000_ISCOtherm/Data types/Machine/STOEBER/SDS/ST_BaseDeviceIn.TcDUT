<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_BaseDeviceIn" Id="{144a02f1-74f7-47aa-bf50-4231e48a981c}">
    <Declaration><![CDATA[TYPE ST_BaseDeviceIn :
STRUCT

	bEnabled					:BOOL;			(* The drive is ready for operation. *)
	bError						:BOOL;			(* The drive state is fault. *)
	bGroupError					:BOOL;			(* Group error: Maximum following error *)
	bQuickStop 					:BOOL;			(* Quick stop is queued/is being executed. *)
	bAxisActive					:BOOL;			(* Axis is active. *)
	bToggleBit 					:BOOL;			(* Handshake bit. *)

	(* Command Positioning *)
	stCommandPositioning			:ST_CommandPositioningFROMNC;

	(* Fast Referene Value  *)
	stFastRefereneValue			:ST_FastRefereneValueFROMNC;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>