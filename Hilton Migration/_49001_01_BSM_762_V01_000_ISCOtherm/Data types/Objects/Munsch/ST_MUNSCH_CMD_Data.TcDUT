  <DUT Name="ST_MUNSCH_CMD_Data" Id="{b077aa9f-a46f-4448-a43b-437d412148f1}">
    <Declaration><![CDATA[TYPE ST_MUNSCH_CMD_Data :
STRUCT
	nMaterialTemp				:INT := 0;				(* Material temperatur. unsMaterialTemp is the temperature in °C added to 160 °C. The range is 0 (160 °C) to 240 (400 °C) *)
	nAirTemp					:INT := 0;				(* Air temperatur. unsAirTemp is the temperature in °C added to 160 °C. The range is 0 (160 °C) to 240 (400 °C) *)
	etCommand					:ET_MUNSCH_CMD;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>