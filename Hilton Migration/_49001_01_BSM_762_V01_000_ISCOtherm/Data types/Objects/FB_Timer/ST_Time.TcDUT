  <DUT Name="ST_Time" Id="{8b9b8734-7651-49ce-aefe-7c6dbc3e90e7}">
    <Declaration><![CDATA[TYPE ST_Time :
STRUCT
	dwSec				:DWORD; 						(* Time in 1 [s] *)
	dwDeciSec			:DWORD; 						(* Time in deci 0.1 [s] *)
	dwCentiSec			:DWORD; 						(* Time in centi 0.01 [s] *)
	dwMiliSec			:DWORD; 						(* Time in mili 0.001 [s] *)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
