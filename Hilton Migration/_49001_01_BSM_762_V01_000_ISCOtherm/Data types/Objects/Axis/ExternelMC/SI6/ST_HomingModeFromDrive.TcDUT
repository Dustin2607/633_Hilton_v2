<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_HomingModeFromDrive" Id="{4a292c29-a9ca-4f8a-9394-fa03fa4abeef}">
    <Declaration><![CDATA[TYPE ST_HomingModeFromDrive :
STRUCT
	bHomeReached				:BOOL;			(* Referencing ended  *)
	bHomingAttained				:BOOL;			(* Reference set *)
	bHomingError				:BOOL;			(* Referencing error *)
												(*
													000 bin = referencing active; 
													001 bin = referencing canceled or not started; 
													010 bin = reference set, referencing not yet complete; 
													011 bin = referencing ended successfully; 
													100 bin = referencing error, velocity is not zero; 
													110 bin = referencing error, velocity is zero
												*)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>