	bGripperTongsOpen						:BOOL;					(* OUT - Gripper tongs open. *)
	bGripperTongsClose						:BOOL;					(* OUT - Gripper tongs close. *)

	unTargetForce							:UINT;					(* OUT - Target force [N] *)

END_STRUCT
END_TYPE]]></Declaration>
