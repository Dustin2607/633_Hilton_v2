  <DUT Name="ST_YASKAWATOPLC" Id="{3dea4cff-81a7-47d3-9656-af58605139fc}">
    <Declaration><![CDATA[TYPE ST_YASKAWATOPLC :
STRUCT
	bOperatingRunning						:BOOL;					(* Operating running. *)
