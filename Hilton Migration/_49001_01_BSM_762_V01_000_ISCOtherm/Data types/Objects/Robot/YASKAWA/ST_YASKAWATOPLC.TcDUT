	bNotMoving								:BOOL;					(* OUT - Robot running. *)
	bNotInCrashAreaMachine					:BOOL;					(* OUT - Robot not in crash area with machine. *)

	bWeldingToBase							:BOOL;					(* OUT - Welding to base. *)
	bWeldingToWork							:BOOL;					(* OUT - Welding to work.*)
