	bAlarmErrorOccured						:BOOL;					(* Alarm error occured. *)
	bReducedSpeed							:BOOL;					(* Reduced speed *)
	bRemoteModeSelected					:BOOL;					(* Remote mode selected. *)
	bPlayModeSelected						:BOOL;					(* Play mode selected. *)
	bTeachModeSelected						:BOOL;					(* Teach mode selected. *)

	bHold									:BOOL;					(* Hold. *)

	bInHome									:BOOL;					(* OUT - Robot in home position. *)
	bInHeatingStationArea						:BOOL;					(* OUT - Robot in heating station area. *)
	bInFlushStationArea						:BOOL;					(* OUT - Robot in flush station area. *)
	bInLeftStationArea							:BOOL;					(* OUT - Robot in left station area. *)
	bInRightStationArea						:BOOL;					(* OUT - Robot in right station area. *)

	bPrgDone								:BOOL;					(* OUT - Program done. *)
