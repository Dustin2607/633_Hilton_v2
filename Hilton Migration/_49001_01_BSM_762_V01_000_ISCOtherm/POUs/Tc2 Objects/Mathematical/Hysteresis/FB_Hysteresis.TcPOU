<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Hysteresis" Id="{1f2bf3c5-f169-443c-bcdc-eee8a7fecad2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Hysteresis
(*
Function block used to generate hysteresis

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			15.07.2016
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	bEnable							:BOOL := TRUE;					(* Enable FB *)

	lrInSignal							:LREAL;							(* Input signal *)
	lrGoDown						:REAL;
	lrGoUp							:REAL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
END_VAR
VAR_OUTPUT
	(* Enummerations *)
	
	(* Variables *)
	lrOutSignal						:LREAL;						(* Output signal *)
	bLowLevel						:BOOL;						(* Low level detected *)
	bGoLevel						:BOOL;						(* Go level detected *)
	bHighLevel						:BOOL;						(* High level detected *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime							:BOOL;							(* First cycle *)

	lrLastSignal							:LREAL;							(* Last signal *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	lrOutSignal := lrInSignal;

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF

lrOutSignal:=SEL(lrInSignal - lrGoUp > lrLastSignal, lrOutSignal, lrInSignal - lrGoUp);
lrOutSignal:=SEL(lrInSignal + lrGoDown < lrLastSignal, lrOutSignal, lrInSignal + lrGoDown);

lrLastSignal := lrOutSignal;]]></ST>
    </Implementation>
    <LineIds Name="FB_Hysteresis">
      <LineId Id="60" Count="17" />
    </LineIds>
  </POU>
</TcPlcObject>