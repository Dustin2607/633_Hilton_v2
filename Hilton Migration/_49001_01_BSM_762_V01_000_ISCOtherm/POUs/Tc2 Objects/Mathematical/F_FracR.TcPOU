<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_FracR" Id="{97b4f8fa-c636-483a-8c45-f01c6722e00a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_FracR : REAL
(*
Function used to get fraction part of a real number.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			17.07.2014
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	rReal 						:REAL;			(* Input variable *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR
VAR
	(* Enummerations *)
	
	(* Variables *)
	rFloor						:REAL;

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rFloor := DINT_TO_REAL(F_FloorDN(ABS(rReal)));								(* Floor the value *)

IF rReal < 0
THEN
	F_FracR := rReal + rFloor ;								(* The fraction of the value *)

ELSE
	F_FracR := rReal - rFloor;								(* The fraction of the value *)

END_IF


]]></ST>
    </Implementation>
    <LineIds Name="F_FracR">
      <LineId Id="39" Count="13" />
    </LineIds>
  </POU>
</TcPlcObject>