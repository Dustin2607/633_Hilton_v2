<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_VFD_AxisMoveManual" Id="{90b2279a-bc52-4d3a-a9b2-3eb882da0242}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_VFD_AxisMoveManual
(*

The function block used to manual control of drive.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bNoEStop					:BOOL;						(* No ermergency Stop / Keine Notaus *)
	bPowerSupplyOn				:BOOL;						(* Power supply on / Leitung eingeschaltet *)
	bSafetyOK					:BOOL;						(* Safety ok / Sicherheit i.o *)
	bCtrlEnabled					:BOOL;						(* Controller enabled *)
	bReset						:BOOL;						(* Reset *)
	bMovePlus					:BOOL;						(* Move in plus direction *)
	bMoveMinus					:BOOL;						(* Move in minus direction *)
	bInPlusLimit					:BOOL;						(* In plus limit *)
	bInMinusLimit					:BOOL;						(* In minus limit *)
	bPlusRelease				:BOOL;						(* Plus move release *)
	bMinusRelease				:BOOL;						(* Minus move release *)
	lrVelocity						:LREAL;						(* Target velocity *)
	lrSpeedLimitMax				:LREAL;						(* Maximal speed *)
	tControllerOff					:TIME := t#60s;				(* Time to switch controller off *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bMoving						:BOOL;						(* Axis moving *)
	bControllerOff					:BOOL;						(* Switch controller off *)
	bError						:BOOL;						(* Program error *)
	udnErrorNo					:UDINT;						(* Error number *)
END_VAR
VAR_IN_OUT
	bHomeCompleted				:BOOL;						(* Home completed *)
	Axis							:ST_VFD_AXIS_REF;			(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bErrorMoveToPlus			:BOOL;						(* Error move to plus *)
	bErrorMoveToMinus			:BOOL;						(* Error move to minus *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbJog						:FB_Motor;					(* The function block is used to manual control an axis *)
	fbAtPlusLimit					:FB_SignalHandlingDelay;
	fbAtMinusLimit				:FB_SignalHandlingDelay;
	fbPlusRelease				:FB_SignalHandlingDelay;
	fbMinusRelease				:FB_SignalHandlingDelay;
	fbMovePlus					:FB_SignalWatchdog;
	fbMoveMinus					:FB_SignalWatchdog;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable							(* Signal FB enable *)
THEN
	fbJog(
		bEnable := FALSE,
		bHandPlus := FALSE,
		bHandMinus := FALSE,
		bAutoPlus := FALSE,
		bAutoMinus := FALSE,
		bHomeCompleted := bHomeCompleted,
	);

	fbMovePlus(
		bEnable := FALSE,
		tWatchdog := tControllerOff
	);

	fbMoveMinus(
		bEnable := FALSE,
		tWatchdog := tControllerOff
	);

	bControllerOff := FALSE;

	bFirstTime := FALSE;

	RETURN;
END_IF

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF

(* Control on/off motor *)
fbAtPlusLimit(
	bEnable := TRUE,
	bIn := bInPlusLimit,
	tDelay := t#0ms
);

fbAtMinusLimit(
	bEnable := TRUE,
	bIn := bInMinusLimit,
	tDelay := t#0ms
);

fbPlusRelease(
	bEnable := TRUE,
	bIn := bPlusRelease,
	tDelay :=t#0ms
);

fbMinusRelease(
	bEnable := TRUE,
	bIn := bMinusRelease,
	tDelay := t#0ms
);

fbJog(
	bEnable := TRUE,
	bNoEmergencyStop := bNoEStop
						AND bSafetyOK
						AND bCtrlEnabled,
	bVoltageOK := bPowerSupplyOn,
	bReset := bReset,
	bAutoHand := FALSE,
	bHandPlus := bMovePlus,
	bHandMinus := bMoveMinus,
	bAtPlusLimit := fbAtPlusLimit.bOut,
	bAtMinusLimit := fbAtMinusLimit.bOut,
	bPlusRelease := fbPlusRelease.bOut,
	bMinusRelease := fbMinusRelease.bOut,
	bSyncPlus := FALSE,
	bSyncMinus := FALSE,
	bSyncOn := FALSE,
	bControlOff := FALSE,
	bMotorCtrlErrOff := FALSE,
	bErrorOff := TRUE,
	tSyncTimeOut := ,
	tConTimeOut := ,
	tCtrlTimeOut := ,
	bHomeCompleted := bHomeCompleted,
	bMoveToPlus => Axis.bReverseStop,
	bMoveToMinus => Axis.bForwardStop
);

Axis.nSetMotorSpeed := LREAL_TO_INT(ABS(lrVelocity) * (32767.0/lrSpeedLimitMax));

fbMovePlus(
	bEnable := etMachineMode = ET_MachineMode_eManual,
	bIn := fbJog.bMoveToPlus
		  AND fbPlusRelease.bOut,
	tWatchdog := tControllerOff
);

fbMoveMinus(
	bEnable := etMachineMode = ET_MachineMode_eManual,
	bIn := fbJog.bMoveToMinus
		  AND fbMinusRelease.bOut,
	tWatchdog := tControllerOff
);

bControllerOff := NOT (fbMovePlus.bOut OR fbMoveMinus.bOut)
			    AND etMachineMode = ET_MachineMode_eManual;

IF NOT Axis.bNotMoving
THEN
	bHomeCompleted := FALSE;
END_IF;

A_Error();
]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{58f12f51-dd38-4f3b-90dc-2b10202fbe5e}">
      <Implementation>
        <ST><![CDATA[
bErrorMoveToMinus := fbJog.bError
					AND (fbJog.udnErrorNo = 1
					     OR fbJog.udnErrorNo = 2
					     OR fbJog.udnErrorNo = 5);

bErrorMoveToPlus := fbJog.bError
					 AND (fbJog.udnErrorNo = 3
					       OR fbJog.udnErrorNo = 4
					       OR fbJog.udnErrorNo = 5);

bError := bErrorMoveToMinus
	         OR bErrorMoveToPlus;]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_VFD_AxisMoveManual">
      <LineId Id="67" Count="113" />
    </LineIds>
    <LineIds Name="FB_VFD_AxisMoveManual.A_Error">
      <LineId Id="0" Count="12" />
    </LineIds>
  </POU>
</TcPlcObject>