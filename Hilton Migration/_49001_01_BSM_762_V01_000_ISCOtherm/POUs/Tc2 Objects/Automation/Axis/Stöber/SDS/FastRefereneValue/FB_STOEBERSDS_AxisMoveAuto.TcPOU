<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_AxisMoveAuto" Id="{06aedbae-099e-4db2-af14-5f28469f89a8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_AxisMoveAuto
(*

The function block used to auto control of axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bCtrlEnabled					:BOOL;						(* Controller enabled *)
	bReset						:BOOL;						(* Reset *)
	bExeHome					:BOOL;						(* Execute home *)
	bExeMoveAbs				:BOOL;						(* Execute move absolut *)
	bExeMoveVelo				:BOOL;						(* Execute move velo *)
	bExeStop					:BOOL;						(* Execute stop *)
	bExeHalt						:BOOL;						(* Execute stop *)
	lrPosition						:LREAL;						(* Target position *)
	lrVelocity						:LREAL;						(* Target velocity *)
	lrAcceleration					:LREAL;						(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;						(* Value of jerk (always positive) *)
	bSignalReference				:BOOL;						(* Reference signal *)
	lrOriginPosition				:LREAL;						(* Origin position *)
	tControllerOff					:TIME := t#60s;				(* Time to switch controller off *)
	stControllerConfig				:ST_VeloControllerConfig;				(* Controller configuration *)
	pAxis						:POINTER TO ST_AXIS_REF_V2;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bInReference					:BOOL;						(* Target has reference *)
	bInPosition					:BOOL;						(* Target position is reached *)
	bInVelocity					:BOOL;						(* Target velocity is reached *)
	bStopped					:BOOL;						(* Target stopped *)
	bControllerOff					:BOOL;						(* Switch controller off *)
	bError						:BOOL;						(* Program error *)
	udnErrorNo					:UDINT;						(* Error number *)
END_VAR
VAR_IN_OUT
	bHomeCompleted				:BOOL;						(* Home completed *)
	Axis							:AXIS_REF;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbHome						:FB_STOEBERSDS_Home;
	fbMoveAbs					:FB_STOEBERSDS_MoveAbsolut;
	fbMoveVelo					:FB_STOEBERSDS_MoveVelocity;
	fbStop						:FB_STOEBERSDS_Stop;
	fbQuickStop					:FB_STOEBERSDS_QuickStop;
	fbPositionController		:FB_PositionController;
	fbStateIdle					:FB_SignalWatchdog;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable								(* Signal FB enable *)
THEN
	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveVelocity starts a continuous movement with specified velocity and direction.  *)
	fbMoveVelo(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		pAxis := pAxis,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbStop(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bStopped
	);

	(* The function block Quick Stop stops an axis blocks the axis for any motion commands.  *)
	fbQuickStop(
		bExecute := FALSE,
		Axis := Axis,
		bDone =>
	);

	fbStateIdle(
		bEnable := FALSE,
		tWatchdog := tControllerOff
	);

	bControllerOff := FALSE;

	bFirstTime := FALSE;

	RETURN;
END_IF;

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

IF bReset
     AND bError
THEN
	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveVelocity starts a continuous movement with specified velocity and direction.  *)
	fbMoveVelo(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		pAxis := pAxis,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbStop(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bStopped
	);

	(* The function block Quick Stop stops an axis blocks the axis for any motion commands.  *)
	fbQuickStop(
		bExecute := FALSE,
		Axis := Axis,
		bDone =>
	);
END_IF;

IF bCtrlEnabled
     AND (etMachineMode = ET_MachineMode_eAutomatic
		OR etMachineMode = ET_MachineMode_eStepping
		OR etMachineMode = ET_MachineMode_eHome)
    AND etMachineState <> ET_MachineState_eIdle
    AND etMachineState <> ET_MachineState_eUndefined
THEN
	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := bExeHome,
		lrOriginPosition := lrOriginPosition,
		bCalibrationCam := bSignalReference,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveVelocity starts a continuous movement with specified velocity and direction.  *)
	fbMoveVelo(
		bExecute := bExeMoveVelo,
		lrVelocity := lrVelocity,
		etMC_Direction := SEL(lrVelocity < 0.0,  ET_MC_Direction_ePositive, ET_MC_Direction_eNegative),
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := bExeMoveAbs,
		lrPosition := lrPosition,
		lrVelocity := lrVelocity,
		lrCtrlVeloOut := fbPositionController.lrVeloOut,
		pAxis := pAxis,
		Axis := Axis,
		bDone => bInPosition
	);

	A_Controller();

ELSE
	(* The function block MoveVelocity starts a continuous movement with specified velocity and direction.  *)
	fbMoveVelo(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		pAxis := pAxis,
		Axis := Axis,
		bDone => bInPosition
	);

END_IF;

fbStateIdle(
	bEnable := etMachineMode = ET_MachineMode_eAutomatic
			    OR etMachineMode = ET_MachineMode_eStepping
		  	    OR etMachineMode = ET_MachineMode_eHome,
	bIn := etMachineState <> ET_MachineState_eIdle
		  AND etMachineState <> ET_MachineState_eUndefined,
	tWatchdog := tControllerOff
);

bControllerOff := NOT fbStateIdle.bOut
			    AND (etMachineMode = ET_MachineMode_eAutomatic
				        OR etMachineMode = ET_MachineMode_eStepping
				        OR etMachineMode = ET_MachineMode_eHome);

(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
fbStop(
	bExecute := bExeStop,
	Axis := Axis,
	bDone => bStopped
);

(* The function block Quick Stop stops an axis blocks the axis for any motion commands.  *)
fbQuickStop(
	bExecute := Axis.stPlcToNc.stBaseDevice.stFastRefereneValue.bHWLimitMax
			     OR Axis.stPlcToNc.stBaseDevice.stFastRefereneValue.bHWLimitMin,
	Axis := Axis,
	bDone =>
);

bError :=  fbMoveVelo.bError
		OR fbMoveAbs.bError
		OR fbStop.bError;]]></ST>
    </Implementation>
    <Action Name="A_Controller" Id="{3ffcb344-847d-41f4-a3fd-e4ee740f174f}">
      <Implementation>
        <ST><![CDATA[
fbPositionController (
	bEnable := TRUE,
	dnSetPos := pAxis^.stPosition.dnSetPos,
	stCtrlCfg := stControllerConfig,
(*	lrPosMin := ,
	lrPosMax := ,*)
	pAxis := pAxis,
	lrVeloOut => ,
	lrProcessErr => ,
	bVeloMin => ,
	bVeloMax =>
);
]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_STOEBERSDS_AxisMoveAuto">
      <LineId Id="71" Count="184" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisMoveAuto.A_Controller">
      <LineId Id="0" Count="13" />
    </LineIds>
  </POU>
</TcPlcObject>