<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AxisController" Id="{940e204f-ed2e-4944-8c55-1d4f9169e63f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AxisController
(*

The function block used to control axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bRegulatorOn				:BOOL;						(* Enable the power stage *)
	bReset						:BOOL;						(* Signal reset *)
	bCMDInterrupt				:BOOL;						(* Signal interrupt *)
	bTerminalOK					:BOOL;						(* Terminal Ok *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	bExeSetPos					:BOOL;						(* Execute set position *)
	lrSetPosition					:LREAL;						(* Position value to which the axis position is to be set. *)
	bExeGearIn					:BOOL;						(* Execute gear in *)
	bExeGearOut					:BOOL;						(* Execute gear out *)
	dnRatioNumerator				:DINT;						(* Gear ratio numerator. Alternatively, the gear ratio can be specified in the numerator as a floating comma value, if the denominator is 1. *)
	udnRatioDenominator			:UDINT;						(* Gear ratio denominator *)
	lrOverride					:LREAL;						(* Override 100% percent *)
	bWithAbsoluteEncoder			:BOOL; 						(* Encoder is an absolute one / Absolutwertgeber *)
	bPosLagMonitoringEn			:BOOL;						(* Enable position lag monitoring *)
	lrPositionBias					:LREAL;						(* Position bias *)
	bHWSignalLimitMax			:BOOL;						(* Signal position limit switch maximum *)
	bHWSignalLimitMin			:BOOL;						(* Signal position limit switch minimum *)
	lrSoftLimitMax					:LREAL; 						(* Position limit switch maximum *)
	lrSoftLimitMin					:LREAL; 						(* Position limit switch minimum *)
	lrAcceleration					:LREAL;						(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;						(* Value of jerk (always positive) *)
	lrActTemp					:LREAL;						(* Current temperatur *)
	tAdsTimeOut 					:TIME := t#2s;					(* Timout for ads commands *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bStatus						:BOOL;						(* Feedback *)
	bStatusDelay					:BOOL;						(* Feedback delay *)
	bReseted					:BOOL;						(* Reset completed *)
	bError						:BOOL;						(* Controller error *)
	bErrorInit						:BOOL;						(* Controller initialization error *)
	udnErrorNo					:UDINT;						(* Error number *)
	lrActPos						:LREAL;						(* Actual position *)
	lrActAbsPos					:LREAL;						(* Actual absolut position *)
	lrActVelo						:LREAL;						(* Actual velocity *)
	bNotMoving					:BOOL;						(* Status of moving *)
	bReferenced					:BOOL;						(* Referenced *)
	bCoupled					:BOOL;						(* Coupled *)
	lrVeloLimitMax				:LREAL;						(* Velocity limit maximum *)
	lrAccLimitMax					:LREAL;						(* Acceleration limit maximum *)
	lrDecLimitMax				:LREAL;						(* Deceleration limit maximum *)
	lrJerkLimitMax				:LREAL;						(* Jerk limit maximum *)
	bHardLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bHardLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
	bSoftLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bSoftLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
END_VAR
VAR_IN_OUT
	Axis							:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
	MasterAxis					:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	etAxisGetLimits				:ET_AxisGetLimits;
	bGetLimitsExe				:BOOL;						(* Progam execute *)
	bGetLimitsDone 				:BOOL;                             		   	(* Program done *)
	bGetLimitsBusy 				:BOOL;                                 		(* Program busy *)
	bGetLimitsError 				:BOOL;                                 		(* Program error *)
	bGetLimitsInitDone 			:BOOL;                             		   	(* Program initialization done *)
	bGetLimitsInitError 				:BOOL;                                 		(* Program initialization error *)
	udnGetLimitsErrorNo 			:UDINT;                                 		(* Error number *)

	etAxisSetLimits				:ET_AxisSetLimits;
	bSetLimitsExe				:BOOL;						(* Progam execute *)
	bSetLimitsDone 				:BOOL;                             		   	(* Program done *)
	bSetLimitsBusy 				:BOOL;                                 		(* Program busy *)
	bSetLimitsError 				:BOOL;                                 		(* Program error *)
	bSetLimitsInitDone 			:BOOL;                             		   	(* Program initialization done *)
	bSetLimitsInitError 				:BOOL;                                 		(* Program initialization error *)
	udnSetLimitsErrorNo 			:UDINT;                                 		(* Error number *)

	tStatusDelay					:TIME := t#1s;					(* Status delay time *)
	tRegulatorOffDelay			:TIME := t#50ms;				(* Regulator off delay time *)

	dwReferenceSystem			:DWORD;					(* Reference system: 0 - INC, 1 - ABS, 2 - ABS MODULO *)
	lrPositionBiasCache			:LREAL;						(* Position bias *)
	lrSoftLimitMaxCache			:LREAL; 						(* Position limit switch maximum *)
	lrSoftLimitMinCache			:LREAL; 						(* Position limit switch minimum *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbMcPower					:MC_Power;					(* The function block is used to enable for an axis *)
	tofRegulatorOn				:TOF;						(* Delay controller disable *)
	tonStatusDelay				:TON;						(* Delay controller enabled status *)
	fbMcReset					:MC_Reset;					(* An axis reset is carried out with the function block *)
	fbMcSetPosition				:MC_SetPosition;				(* Sets the current axis position to a parameterisable value. *)
	fbMcGearIn					:MC_GearInDyn;				(* The function block is used to couples a slave axis to a master axis using a floating point gear ratio. *)
	fbMcGearOut					:MC_GearOut;					(* The function block  is used to decoupling the slave from the master axis.  *)
	fbMcReadParameter 			:MC_ReadParameter;			(* The function block is used to read an axis parameter. *)
	fbMcWriteParameter 			:MC_WriteParameter;			(* The function block is used to write an axis parameter. *)
	fbMcWriteBoolParameter 		:MC_WriteBoolParameter;		(* The function block is used to write bool value an axis parameter. *)
	fbAdsWrite					:ADSWRITE;					(* The function block permits execution of an ADS write command, for the transfer of data to an ADS device. *)
	fbAdsRead					:ADSREAD;					(* The function block permits execution of an ADS read command, for the transfer of data to an ADS device. *)
END_VAR
VAR CONSTANT
	dwIdxGrMainPara				:DWORD := 16#00004000;		(* Index group for main parameters of axis *)
	dwIdxGrNCEncPara			:DWORD := 16#00005000;		(* Index group for nc-encoder parameters of axis *)
	dwIdxGrNCCtrlPara			:DWORD := 16#00006000;		(* Index group for nc-controller parameters of axis *)
	dwIdxGrNCDrivePara			:DWORD := 16#00007000;		(* Index group for nc-drive parameters of axis *)
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable							(* Signal FB enable *)
THEN
	bStatus := FALSE;						(* Feedback *)
	bStatusDelay := FALSE;				(* Feedback *)
	bError := FALSE;						(* Controller error *)
	udnErrorNo := 0;						(* Error number *)

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	bGetLimitsExe := FALSE;					(* Program execute *)
	bGetLimitsDone := FALSE;                                	(* Program done *)
	bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bGetLimitsError := FALSE;                                 	(* Program not error *)
	bGetLimitsInitDone := FALSE;				(* Program initialization done *)
	bGetLimitsInitError := FALSE;				(* Program initialization error *)
	udnGetLimitsErrorNo := 0;                                 		(* Error number *)

	etAxisGetLimits := ET_AxisGetLimits_eWaitExecute;       			(* Next step *)

	bSetLimitsExe := FALSE;					(* Program execute *)
	bSetLimitsDone := FALSE;                                	(* Program done *)
	bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bSetLimitsError := FALSE;                                	 	(* Program not error *)
	bSetLimitsInitDone := FALSE;                            	(* Program initialization done *)
	bSetLimitsInitError := FALSE;				(* Program initialization error *)
	udnSetLimitsErrorNo := 0;                                 		(* Error number *)

	etAxisSetLimits := ET_AxisSetLimits_eWaitExecute;       			(* Next step *)

	(* Actual position *)
	lrActAbsPos := Axis.NcToPlc.ActPos;
	lrActAbsPos := F_LRealRound(lrReal := lrActAbsPos, usiPrecision := 3);

	bFirstTime := TRUE;
END_IF;

A_MCPower();
A_MCReset();
A_MCSetPosition();
A_MCGearCoupling();
A_Utility();
A_GetLimits();
A_SetLimits();
A_Error();

(* Actual position *)
lrActPos := Axis.NcToPlc.ActPos;
lrActPos := F_LRealRound(lrReal := lrActPos, usiPrecision := 2);

(* Actual velocity *)
lrActVelo := Axis.NcToPlc.ActVelo;
lrActVelo := F_LRealRound(lrReal := lrActVelo, usiPrecision := 2);

(* Current engine torque *)
(*nActEngineTorque := Axis.stNcToPlc.stCommandPositioning.nActEngineTorque;*)

(* Reference signal *)
bReferenced := Axis.NcToPlc.StateDWord.1;                               (* In Reference *)


(* Status not moving *)
bNotMoving := Axis.NcToPlc.StateDWord.2;

(* Status coupling *)
bCoupled := Axis.NcToPlc.CoupleState = 2
		      OR Axis.NcToPlc.CoupleState = 3;]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{34316384-5fd5-41cb-9d75-ecc5e1c13b52}">
      <Implementation>
        <ST><![CDATA[
bError := fbMcPower.Error
		OR fbMcReset.Error
	  	OR fbMcSetPosition.Error
		OR fbMcGearIn.Error
		OR fbMcGearOut.Error
		OR Axis.NcToPlc.StateDWord.31
		OR MasterAxis.NcToPlc.StateDWord.31;

bErrorInit := bGetLimitsInitError
		    OR bSetLimitsInitError;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_GetLimits" Id="{051f1c2b-96b9-468f-b07d-41fd65e759a6}">
      <Implementation>
        <ST><![CDATA[
(* Status hardware limit switch *)
bHardLimitMaxExceeded := bHWSignalLimitMax;						(* Position limit switch maximum is exceeded *)
bHardLimitMinExceeded := bHWSignalLimitMin;						(* Position limit switch minimum is exceeded *)

(* Status software limit switch *)
bSoftLimitMaxExceeded := Axis.NcToPlc.StateDWord.27 AND lrSoftLimitMax <> lrSoftLimitMin;			(* Position limit switch maximum is exceeded *)
bSoftLimitMinExceeded := Axis.NcToPlc.StateDWord.26 AND  lrSoftLimitMax <> lrSoftLimitMin;			(* Position limit switch minimum is exceeded *)

(* Get limits execute *)
bGetLimitsExe := bTerminalOK
			      AND NOT bGetLimitsInitDone
			      AND NOT bGetLimitsInitError;

(* Get axis limits *)
CASE etAxisGetLimits OF

	ET_AxisGetLimits_eWaitExecute:
		IF bGetLimitsExe
		THEN
			bGetLimitsDone := FALSE;                                	(* Program done *)
			bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bGetLimitsError := FALSE;                                 	(* Program not error *)

			fbMcReadParameter(
				Enable:= FALSE,
				ReadMode := READMODE_ONCE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eReadVeloMax;         		(* Next step *)
		END_IF

	ET_AxisGetLimits_eReadVeloMax:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= MaxVelocityAppl;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadVeloMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadVeloMax:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrVeloLimitMax := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eReadAccMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eReadAccMax:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= MaxAccelerationAppl;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadAccMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadAccMax:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrAccLimitMax := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eReadDecMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eReadDecMax:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= MaxDecelerationAppl;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadDecMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadDecMax:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrDecLimitMax := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eReadJerkMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eReadJerkMax:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= MaxJerkAppl;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadJerkMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadJerkMax:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrJerkLimitMax := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eReadSoftLimitMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eReadSoftLimitMax:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= SWLimitPos;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadSoftLimitMax;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadSoftLimitMax:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrSoftLimitMax := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eReadSoftLimitMin;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eReadSoftLimitMin:
		fbMcReadParameter.Enable := TRUE;
		fbMcReadParameter.ParameterNumber:= SWLimitNeg;

		IF fbMcReadParameter.Busy
		THEN
			etAxisGetLimits := ET_AxisGetLimits_eWfReadSoftLimitMin;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eWfReadSoftLimitMin:
		IF NOT fbMcReadParameter.Busy
		     AND NOT fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			lrSoftLimitMin := fbMcReadParameter.Value;

			etAxisGetLimits := ET_AxisGetLimits_eDone;         		(* Next step *)

		ELSIF fbMcReadParameter.Error
		THEN
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			etAxisGetLimits := ET_AxisGetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisGetLimits_eDone:
		bGetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := TRUE;                             		(* Program initialization done *)
		bGetLimitsInitError := FALSE;                                 		(* Program initialization error *)

		etAxisGetLimits := ET_AxisGetLimits_eNoExecute;            	(* Next step *)

	ET_AxisGetLimits_eError:
		bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bGetLimitsError := TRUE;                                     		(* Program error *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := FALSE;                             		(* Program initialization done *)
		bGetLimitsInitError := TRUE;                             		(* Program initialization error *)
		udnGetLimitsErrorNo := 1;                                 			(* Error number *)

		etAxisGetLimits := ET_AxisGetLimits_eNoExecute;           	(* Next step *)

	ET_AxisGetLimits_eNoExecute:
		IF NOT bGetLimitsExe
		THEN
			bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bGetLimitsError := FALSE;                                     		(* Program error *)
			bGetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisGetLimits := ET_AxisGetLimits_eWaitExecute;       (* Next step *)
		END_IF

END_CASE;

fbMcReadParameter(
	ReadMode := READMODE_ONCE,
	Axis := Axis
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCGearCoupling" Id="{8b6fd9b4-b001-4a24-b50d-a94f1ff45fa3}">
      <Implementation>
        <ST><![CDATA[
(* The function block MC_GearInDyn couples a slave axis to a master axis using a floating point gear ratio. The gear ratio can be dynamically modified every PLC cycle as long as the Execute input is TRUE *)
IF udnRatioDenominator = 0
THEN
	fbMCGearIn.GearRatio := 0;
ELSE
	fbMCGearIn.GearRatio:= dnRatioNumerator / udnRatioDenominator;
END_IF


IF NOT bCMDInterrupt
THEN

	(* The function block MC_GearIn used to coupling with ratio between the velocity of the slave and master axis  *)
	fbMCGearIn(
		Enable := bExeGearIn,
		Acceleration := lrAcceleration,
		Deceleration := lrDeceleration,
		Jerk := lrJerk,
		Options := ,
		Master := MasterAxis,
		Slave := Axis
	);
	
	(* The function block MC_GearOut used to decoupling the Slave from the Master axis.  *)
	fbMCGearOut(
		Execute := bExeGearOut,
		Slave := Axis,
	);

	(* Weiter für die GearIn und GearOut entwickeln*)
	(*Axis.bCmdInterrupted := FALSE;*)

ELSE
	(* The function block MC_GearIn used to coupling with ratio between the velocity of the slave and master axis  *)
	fbMCGearIn(
		Enable := FALSE,
		Master := MasterAxis,
		Slave := Axis
	);

	(* The function block MC_GearOut used to decoupling the Slave from the Master axis.  *)
	fbMCGearOut(
		Execute := FALSE,
		Slave := Axis
	);

	(*Axis.bCmdInterrupted := TRUE;*)
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCPower" Id="{53adc4b1-5c4d-41c4-9b50-db8f59335077}">
      <Implementation>
        <ST><![CDATA[
tofRegulatorOn(
	IN := bRegulatorOn,
	PT := tRegulatorOffDelay
);

fbMCPower(
	Enable := tofRegulatorOn.Q
			OR Axis.Status.Moving,
	Enable_Positive := (bRegulatorOn
					AND NOT bHWSignalLimitMax)                          			(* HW limit switch maximum *)
					OR Axis.NcToPlc.HomingState <> 0,
	Enable_Negative := (bRegulatorOn
					   AND NOT bHWSignalLimitMin)                         			(* HW Limit switch minimum *)
					   OR Axis.NcToPlc.HomingState <> 0,
	Override := lrOverride,
	Axis := Axis,
	Status => bStatus,
);

tonStatusDelay(
	IN := fbMCPower.Status,
	PT := SEL(etMachineMode = ET_MachineMode_eManual, tStatusDelay, t#0s),
	Q => bStatusDelay
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCReset" Id="{37c6d9e4-eb8e-4f23-890e-b26a9236c96a}">
      <Implementation>
        <ST><![CDATA[
fbMCReset(
	Execute := (bReset
			   AND Axis.NcToPlc.StateDWord.31)
			   XOR bExeReset,
	Axis := Axis,
	Done => bReseted
 );]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCSetPosition" Id="{3982a804-2517-4db5-a5be-79c099dc5488}">
      <Implementation>
        <ST><![CDATA[
fbMCSetPosition(
	Execute := bExeSetPos,
	Position := lrSetPosition,
	Mode := FALSE,
	Options := ,
	Axis := Axis
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SetLimits" Id="{838baf47-fe12-40dc-b0e5-da9512bdf1ac}">
      <Implementation>
        <ST><![CDATA[
(* Set limits execute *)
bSetLimitsExe := bTerminalOK
			     AND bGetLimitsInitDone
			     AND SEL(
						bSetLimitsInitDone,
						NOT bSetLimitsInitError,
						NOT bSetLimitsInitError
						AND (lrPositionBias <> lrPositionBiasCache
			      				   OR lrSoftLimitMaxCache <> lrSoftLimitMax
			      				   OR lrSoftLimitMinCache <> lrSoftLimitMin)
);

(* Set axis limits *)
CASE etAxisSetLimits OF

	ET_AxisSetLimits_eWaitExecute:
		IF bSetLimitsExe
		THEN
			bSetLimitsDone := FALSE;                                	(* Program done *)
			bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bSetLimitsError := FALSE;                                	 	(* Program not error *)
			udnSetLimitsErrorNo := 0;                                 		(* Error number *)

			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);
	
			fbAdsWrite(
				NETID := '',
				WRITE := FALSE,
				TMOUT := tAdsTimeOut
			 );

			etAxisSetLimits := ET_AxisSetLimits_eSetReferenceSystem;         		(* Next step *)

		END_IF;

	ET_AxisSetLimits_eSetReferenceSystem:
		dwReferenceSystem := BOOL_TO_DWORD(bWithAbsoluteEncoder);

		fbAdsWrite.PORT := 501;
		fbAdsWrite.WRITE := TRUE;
		fbAdsWrite.IDXGRP := dwIdxGrNCEncPara + Axis.NcToPlc.AxisId;
		fbAdsWrite.IDXOFFS := 16#00000019;
		fbAdsWrite.LEN := SIZEOF(dwReferenceSystem);
		fbAdsWrite.SRCADDR := ADR(dwReferenceSystem);

		IF fbAdsWrite.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfSetReferenceSystem;         		(* Next step *)

		ELSIF fbAdsWrite.ERR
		THEN
			fbAdsWrite(
				WRITE := FALSE,
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfSetReferenceSystem:
		IF NOT fbAdsWrite.Busy
		     AND NOT fbAdsWrite.ERR
		THEN
			fbAdsWrite(
				WRITE := FALSE,
			);

			etAxisSetLimits := ET_AxisSetLimits_eSetPositionBias;         		(* Next step *)

		ELSIF fbAdsWrite.ERR
		THEN
			fbAdsWrite(
				WRITE := FALSE,
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eSetPositionBias:
		lrPositionBiasCache := lrPositionBias;

		IF bWithAbsoluteEncoder
		THEN
			fbAdsWrite.PORT := 501;
			fbAdsWrite.WRITE := TRUE;
			fbAdsWrite.IDXGRP := dwIdxGrNCEncPara + Axis.NcToPlc.AxisId;
			fbAdsWrite.IDXOFFS := 16#00000007;
			fbAdsWrite.LEN := SIZEOF(lrPositionBiasCache);
			fbAdsWrite.SRCADDR := ADR(lrPositionBiasCache);
	
			IF fbAdsWrite.Busy
			THEN
				etAxisSetLimits := ET_AxisSetLimits_eWfSetPositionBias;         		(* Next step *)
	
			ELSIF fbAdsWrite.ERR
			THEN
				fbAdsWrite(
					WRITE := FALSE,
				);
	
				etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)
	
			END_IF
		ELSE
			etAxisSetLimits := ET_AxisSetLimits_eSetLimitPos;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfSetPositionBias:
		IF NOT fbAdsWrite.Busy
		     AND NOT fbAdsWrite.ERR
		THEN
			fbAdsWrite(
				WRITE := FALSE,
			);

			etAxisSetLimits := ET_AxisSetLimits_eSetLimitPos;         		(* Next step *)

		ELSIF fbAdsWrite.ERR
		THEN
			fbAdsWrite(
				WRITE := FALSE,
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eSetLimitPos:
		lrSoftLimitMaxCache := lrSoftLimitMax;

		fbMcWriteParameter.Execute := TRUE;
		fbMcWriteParameter.ParameterNumber := SWLimitPos;
		fbMcWriteParameter.Value := lrSoftLimitMax;

		IF fbMcWriteParameter.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfSetLimitPos;         		(* Next step *)

		ELSIF fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfSetLimitPos:
		IF NOT fbMcWriteParameter.Busy
		     AND NOT fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eSetLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eSetLimitNeg:
		lrSoftLimitMinCache := lrSoftLimitMin;

		fbMcWriteParameter.Execute := TRUE;
		fbMcWriteParameter.ParameterNumber := SWLimitNeg;
		fbMcWriteParameter.Value := lrSoftLimitMin;

		IF fbMcWriteParameter.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfSetLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfSetLimitNeg:
		IF NOT fbMcWriteParameter.Busy
		     AND NOT fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteParameter.Error
		THEN
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eEnableLimitPos:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnableLimitPos;
		fbMcWriteBoolParameter.Value := lrSoftLimitMax <> lrSoftLimitMin;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfEnableLimitPos:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eEnableLimitNeg:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnableLimitNeg;
		fbMcWriteBoolParameter.Value := lrSoftLimitMax <> lrSoftLimitMin;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfEnableLimitNeg:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eEnablePosLagMonitoring:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnablePosLagMonitoring;
		fbMcWriteBoolParameter.Value := bPosLagMonitoringEn;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etAxisSetLimits := ET_AxisSetLimits_eWfEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eWfEnablePosLagMonitoring:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eDone;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etAxisSetLimits := ET_AxisSetLimits_eError;         		(* Next step *)

		END_IF

	ET_AxisSetLimits_eDone:
		bSetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := TRUE;                             		(* Program initialization done *)
		bSetLimitsInitError := FALSE;                                 		(* Program initialization error *)

		etAxisSetLimits := ET_AxisSetLimits_eNoExecute;            	(* Next step *)

	ET_AxisSetLimits_eError:
		bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bSetLimitsError := TRUE;                                     		(* Program error *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := FALSE;                             		(* Program initialization done *)
		bSetLimitsInitError := TRUE;                             			(* Program initialization error *)

		etAxisSetLimits := ET_AxisSetLimits_eNoExecute;           	(* Next step *)

	ET_AxisSetLimits_eNoExecute:
		IF NOT bSetLimitsExe
		THEN
			bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bSetLimitsError := FALSE;                                     		(* Program error *)
			bSetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisSetLimits := ET_AxisSetLimits_eWaitExecute;       (* Next step *)
		END_IF;

END_CASE;

fbMcWriteParameter(
	Axis := Axis
);

fbMcWriteBoolParameter(
	Axis := Axis
);

fbAdsWrite(
	NETID := '',
	TMOUT := tAdsTimeOut
 );]]></ST>
      </Implementation>
