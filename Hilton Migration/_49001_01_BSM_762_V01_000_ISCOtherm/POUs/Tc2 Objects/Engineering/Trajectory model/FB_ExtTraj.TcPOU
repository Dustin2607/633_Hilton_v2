<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ExtTraj" Id="{d512b12a-fa35-49f6-882d-7e174e134598}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ExtTraj
(*

The function block used to generate move external trajectory.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			01.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable							:BOOL;						(* Function block enable *)
	bStart							:BOOL;						(* Execute start an external trajectory with rising edge *)
	bStop							:BOOL;						(* Execute stop an external trajectory with rising edge *)
	lrStartPosHorizontal				:LREAL;						(* Start position of horizontal axis [mm] *)
	lrStartPosVertical					:LREAL;						(* Start position of vertical axis [mm] *)
	lrRadius							:LREAL;						(* Radius of circle [mm] *)
	unPosWindow					:UINT := 2;					(* Position window [mm] *)
	bTakeHorMovePara				:BOOL;						(* Take move parameters from 1- horizontal axis, 0 - vertical axis *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	lrNewPos						:LREAL;						(* New position [mm] *)
	lrNewVelo						:LREAL;						(* New velocity [mm/s] *)
	lrNewAcc						:LREAL;						(* New acceleration [mm/s^2] *)
	bEnabled  						:BOOL;						(* Calculate positon is enabled *)
	bDone							:BOOL;						(* Command done *)
	bBusy							:BOOL;						(* Command busy *)
	bError							:BOOL;						(* Command error  *)
	udnErrorNo						:UDINT;						(* Error number *)
	sErrorMsg						:STRING; 					(* Error message *)
END_VAR
VAR_IN_OUT
	AxisHorizontal					:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
	AxisVertical						:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Instances / Instanzen *)

	(* Enumerator  *)
	etCalcExtTrajState					:ET_CalcExtTrajState;								(* Current state *)

	(* General flags / Allgemeine Variablen *)
	lrExtStartPosHorizontal				:LREAL;
	lrExtStartPosVertical				:LREAL;
	lrExtRadius						:LREAL;

	bFirstTime						:BOOL;
END_VAR
VAR CONSTANT

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	lrNewPos := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetPos, AxisHorizontal.NcToPlc.SetPos);
	lrNewVelo := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetVelo, AxisHorizontal.NcToPlc.SetVelo);
	lrNewAcc := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetAcc, AxisHorizontal.NcToPlc.SetAcc);

	bDone := FALSE;					(* Command done *)
	bBusy := FALSE;					(* Command busy *)
	bError := FALSE;					(* Command error  *)
	udnErrorNo := 0;					(* Error number *)
	sErrorMsg := ''; 					(* Error message *)

	bEnabled := FALSE;

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	bEnabled := FALSE;

	etCalcExtTrajState := ET_CalcExtTrajState_eWaitExecute;

	bFirstTime := TRUE;
END_IF

CASE etCalcExtTrajState
OF
	ET_CalcExtTrajState_eWaitExecute:
		IF bStop
		THEN
			bEnabled := FALSE;

			bDone := FALSE;						(* Command done *)
			bBusy := TRUE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)
			udnErrorNo := 0;						(* Error number *)
			sErrorMsg := ''; 						(* Error message *)

			etCalcExtTrajState := ET_CalcExtTrajState_eDone;

		ELSIF bStart
		THEN
			bDone := FALSE;						(* Command done *)
			bBusy := TRUE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)
			udnErrorNo := 0;						(* Error number *)
			sErrorMsg := ''; 						(* Error message *)

			etCalcExtTrajState := ET_CalcExtTrajState_eCalcTrajPos;

		END_IF

	ET_CalcExtTrajState_eCalcTrajPos:
		bEnabled := TRUE;

		lrExtStartPosHorizontal := lrStartPosHorizontal;
		lrExtStartPosVertical := lrStartPosVertical;
		lrExtRadius := lrRadius;

		etCalcExtTrajState := ET_CalcExtTrajState_eDone;

	ET_CalcExtTrajState_eError:
		bBusy := FALSE;						(* Command busy *)
		bError := TRUE;						(* Command error  *)

		etCalcExtTrajState := ET_CalcExtTrajState_eNoExecute;

	ET_CalcExtTrajState_eDone:
		bDone := TRUE;						(* Command done *)
		bBusy := FALSE;						(* Command busy *)

		etCalcExtTrajState := ET_CalcExtTrajState_eNoExecute;

	ET_CalcExtTrajState_eNoExecute:
		IF NOT bStart
		     AND NOT bStop
		THEN
			(* Reset outputs *)
			bDone := FALSE;						(* Command done *)
			bBusy := FALSE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)

			etCalcExtTrajState := ET_CalcExtTrajState_eWaitExecute;
		END_IF
END_CASE

(* The function is used to calculate a trajectory of vertical position. *)
IF bEnabled
THEN
	lrNewPos := F_CalcTrajPos(
		lrStartPosHorizontal := lrExtStartPosHorizontal,
		lrStartPosVertical := lrExtStartPosVertical,
		lrCurrentPosHorizontal := AxisHorizontal.NcToPlc.SetPos,
		lrCurrentPosVertical := AxisVertical.NcToPlc.SetPos,
		lrRadius := lrExtRadius
	);

	lrNewVelo := AxisHorizontal.NcToPlc.SetVelo;
	lrNewAcc := AxisHorizontal.NcToPlc.SetAcc;

	(* ABS(lrNewPos - AxisVertical.NcToPlc.SetPos) > UINT_TO_LREAL(unPosWindow)
	THEN
		bError := TRUE;								(* Command error  *)
		udnErrorNo :=  1;								(* Error number *)
		sErrorMsg := ''; 								(* Error message *)
	END_IF*)
ELSE
	lrNewPos := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetPos, AxisHorizontal.NcToPlc.SetPos);
	lrNewVelo := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetVelo, AxisHorizontal.NcToPlc.SetVelo);
	lrNewAcc := SEL(bTakeHorMovePara, AxisVertical.NcToPlc.SetAcc, AxisHorizontal.NcToPlc.SetAcc);

	bError := FALSE;								(* Command error  *)
	udnErrorNo :=  0;								(* Error number *)
	sErrorMsg := ''; 								(* Error message *)
END_IF


]]></ST>
    </Implementation>
    <LineIds Name="FB_ExtTraj">
      <LineId Id="57" Count="119" />
    </LineIds>
  </POU>
</TcPlcObject>