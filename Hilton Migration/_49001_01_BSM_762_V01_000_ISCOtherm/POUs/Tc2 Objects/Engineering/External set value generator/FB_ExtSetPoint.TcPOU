<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ExtSetPoint" Id="{fd79bb22-fc18-4680-a872-ed89785cfecd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ExtSetPoint
(*

The function block used to move axis with an external set value.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			01.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Function block enable *)
	bStart					:BOOL;						(* Execute start an external set value generator with rising edge *)
	bStop					:BOOL;						(* Execute stop an external set value generator with rising edge *)
	lrPosition					:LREAL;						(* Set position from an external set value generator *)
	lrPositionOffset			:LREAL;						(* Set offset of position *)
	ePositionType 			:E_PositionType ;				(* Position type - POSITIONTYPE_ABSOLUTE or POSITIONTYPE_RELATIVE *)
	lrVelocity					:LREAL;						(* Set velocity from an external set point generator  > 0 *)
	lrAcceleration				:LREAL;						(* Set acceleration from an external set point generator > 0 *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bEnabled  				:BOOL;						(* Enabled shows the current state of the external set point generator *)
	bDone					:BOOL;						(* Command done *)
	bBusy					:BOOL;						(* Command busy *)
	bError					:BOOL;						(* Command error  *)
	udnErrorNo				:UDINT;						(* Error number *)
	sErrorMsg				:STRING; 					(* Error message *)
END_VAR
VAR_IN_OUT
	Axis						:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Instances / Instanzen *)
	fbMC_ExtSetPointGenEnable			:MC_ExtSetPointGenEnable;						(* Switch on external set value generator with the function. *)
	fbMC_ExtSetPointGenDisable			:MC_ExtSetPointGenDisable;						(* Switch off external set value generator with the function. *)

	(* Enumerator  *)
	etMoveExtState						: ET_MoveExtState;								(* Current state *)

	(* General flags / Allgemeine Variablen *)
	eLastPositionType 					:E_PositionType;
	lrExtPosition							:LREAL;
	lrExtVelocity							:LREAL;
	lrExtAcceleration						:LREAL;
	dnExtDirection						:DINT;
	bImediateStop						:BOOL;
	bFirstTime							:BOOL;

END_VAR
VAR CONSTANT
	lrEPSILON				 :LREAL := 1E-6;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	bDone := FALSE;					(* Command done *)
	bBusy := FALSE;					(* Command busy *)
	bError := FALSE;					(* Command error  *)
	udnErrorNo := 0;					(* Error number *)
	sErrorMsg := ''; 					(* Error message *)

	bEnabled := FALSE;
	IF bStart
	THEN
		bEnabled := TRUE;
	END_IF;

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	bEnabled := FALSE;

	fbMC_ExtSetPointGenEnable(Execute := FALSE, Axis:=Axis);						(* Reset FB and get Enabled status *)
	fbMC_ExtSetPointGenDisable(Execute := FALSE, Axis:=Axis); 						(* Reset FB and get Enabled status *)

	etMoveExtState := ET_MoveExtState_eWaitExecute;

	bFirstTime := TRUE;
END_IF

bImediateStop := AxisInErrorState(Axis.NcToPlc.AxisState);
IF bImediateStop
THEN
	(* Stop generator if axis is in error state *)
	lrExtVelocity := 0.0;
	lrExtAcceleration := 0.0;
	bError := TRUE;													(* Command error  *)
	udnErrorNo :=  Axis.NcToPlc.ErrorCode;								(* Error number *)
	sErrorMsg := ''; 													(* Error message *)

	etMoveExtState := ET_MoveExtState_eError;

ELSE
	(* Produce the dynamic data for the external setpoint generator interface *)
	lrExtVelocity := lrVelocity;
	lrExtAcceleration := lrAcceleration;
END_IF

lrExtPosition :=  lrPosition + lrPositionOffset;

IF lrExtVelocity = 0.0
    AND lrExtAcceleration = 0.0
THEN
	dnExtDirection := 0;				(* Stand still *)
END_IF

IF lrExtVelocity >= 0.0
THEN
	dnExtDirection := 1;				(* Positive motion *)
ELSE
	dnExtDirection := -1;				(* Negative motion *)
END_IF

CASE etMoveExtState
OF
	ET_MoveExtState_eWaitExecute:
		IF bStop
		THEN
			fbMC_ExtSetPointGenEnable(Execute := FALSE, Axis := Axis);						(* Reset FB and get Enabled status *)
			fbMC_ExtSetPointGenDisable(Execute := FALSE, Axis := Axis); 					(* Reset FB and get Enabled status *)

			bDone := FALSE;						(* Command done *)
			bBusy := TRUE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)
			udnErrorNo := 0;						(* Error number *)
			sErrorMsg := ''; 						(* Error message *)

			etMoveExtState := ET_MoveExtState_eDisableExtSetPointGenerator;

		ELSIF bStart
		THEN
			fbMC_ExtSetPointGenEnable(Execute := FALSE, Axis := Axis);						(* Reset FB and get Enabled status *)
			fbMC_ExtSetPointGenDisable(Execute := FALSE, Axis := Axis); 					(* Reset FB and get Enabled status *)

			bDone := FALSE;						(* Command done *)
			bBusy := TRUE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)
			udnErrorNo := 0;						(* Error number *)
			sErrorMsg := ''; 						(* Error message *)

			etMoveExtState := ET_MoveExtState_eEnableExtSetPointGenerator;

			(* Check for errors *)
			(* lrExtVelocity < lrEPSILON
			THEN
				udnErrorNo := 1;						(* Error number *)

				etMoveExtState := ET_MoveExtState_eError;
			END_IF
			IF lrExtAcceleration < lrEPSILON
			THEN
				udnErrorNo := 2;						(* Error number *)

				etMoveExtState := ET_MoveExtState_eError;
			END_IF*)
		END_IF

	ET_MoveExtState_eEnableExtSetPointGenerator:
		IF fbMC_ExtSetPointGenEnable.Enabled
		    AND NOT fbMC_ExtSetPointGenEnable.Execute
		    AND (ePositionType = eLastPositionType)
		THEN
			(* Send enable command to set the new target position but do not wait until the command has finished *)
			fbMC_ExtSetPointGenEnable.Execute := TRUE ;
			fbMC_ExtSetPointGenEnable.PositionType := ePositionType;

			etMoveExtState := ET_MoveExtState_eDone;

		ELSE
			(* Enable the set point generator *)
			fbMC_ExtSetPointGenEnable.Execute := TRUE ;
			fbMC_ExtSetPointGenEnable.PositionType := ePositionType;

			IF fbMC_ExtSetPointGenEnable.Error
			     AND NOT fbMC_ExtSetPointGenEnable.Busy
			THEN
				bError := fbMC_ExtSetPointGenEnable.Error;							(* Command error  *)
				udnErrorNo := fbMC_ExtSetPointGenEnable.ErrorID;						(* Error number *)

				etMoveExtState := ET_MoveExtState_eError;

			ELSIF fbMC_ExtSetPointGenEnable.Done
			     	    AND NOT fbMC_ExtSetPointGenEnable.Busy
			THEN
				eLastPositionType := ePositionType;

				etMoveExtState := ET_MoveExtState_eDone;
			END_IF

		END_IF

	ET_MoveExtState_eDisableExtSetPointGenerator:
		(* Call the disable external set point generator function block *)
		fbMC_ExtSetPointGenDisable(
			Execute := TRUE ,
			Axis:=Axis
		);
		
		IF fbMC_ExtSetPointGenDisable.Error
		     AND NOT fbMC_ExtSetPointGenEnable.Busy
		THEN
			fbMC_ExtSetPointGenDisable(
				Execute := FALSE ,
				Axis:=Axis
			);
		
			bError := fbMC_ExtSetPointGenDisable.Error;												(* Command error  *)
			udnErrorNo := fbMC_ExtSetPointGenDisable.ErrorID;										(* Error number *)

			etMoveExtState := ET_MoveExtState_eError;
		
		ELSIF fbMC_ExtSetPointGenDisable.Done
		     	    AND NOT fbMC_ExtSetPointGenEnable.Busy
		THEN
		
			etMoveExtState := ET_MoveExtState_eDone;
		END_IF

	ET_MoveExtState_eError:
		bBusy := FALSE;						(* Command busy *)
		bError := TRUE;						(* Command error  *)

		etMoveExtState := ET_MoveExtState_eNoExecute;

	ET_MoveExtState_eDone:
		bDone := TRUE;						(* Command done *)
		bBusy := FALSE;						(* Command busy *)

		etMoveExtState := ET_MoveExtState_eNoExecute;

	ET_MoveExtState_eNoExecute:
		IF NOT bStart
		     AND NOT bStop
		THEN
			(* Reset outputs *)
			bDone := FALSE;						(* Command done *)
			bBusy := FALSE;						(* Command busy *)
			bError := FALSE;						(* Command error  *)

			etMoveExtState := ET_MoveExtState_eWaitExecute;
		END_IF
END_CASE

(* The function is used to feed set values from an external set point generator into an axis. *)
MC_ExtSetPointGenFeed(
	Position := lrExtPosition,
	Velocity := 0.0,
	Acceleration := 0.0,
	Direction := dnExtDirection,
	Axis := Axis
);

(* Call the enable external set point generator function block *)
fbMC_ExtSetPointGenEnable(
	Position := lrPosition,
	Enabled => bEnabled,
	Axis:= Axis
 );]]></ST>
    </Implementation>
    <LineIds Name="FB_ExtSetPoint">
      <LineId Id="58" Count="207" />
    </LineIds>
  </POU>
</TcPlcObject>