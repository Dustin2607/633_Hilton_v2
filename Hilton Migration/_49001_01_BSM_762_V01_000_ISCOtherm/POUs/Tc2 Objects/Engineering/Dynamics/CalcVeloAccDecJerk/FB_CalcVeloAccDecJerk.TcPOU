<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CalcVeloAccDecJerk" Id="{aaf89073-3895-4be9-8fac-fdacb5c45502}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CalcVeloAccDecJerk
(*
The Function Block used to calculate velocity, acceleration, deceleration and jerk from position.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			20.01.2014
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)

VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	bEnable								:BOOL;							(* Enable FB *)
	bReset								:BOOL;							(* Reset FB *)

	lrActPos								:LREAL;							(* Current position *)
	lrSectorTime							:LREAL := 0.005; 					(* Time of sector [µs] *)
	
	(* References *)

	(* Interfaces *)

	(* Instances *)
END_VAR
VAR_OUTPUT
	(* Enummerations *)
	etDirection 							:ET_MC_Direction := ET_MC_Direction_ePositive;
	
	(* Variables *)
	lrCalcVelo							:LREAL;						(* Calculated velocity from current position *)

	bAccelerating 						:BOOL;
	bDecelerating 						:BOOL;
	lrCalcAcc							:LREAL;						(* Calculated acceleration from current position *)
	lrCalcDec							:LREAL;						(* Calculated deceleration from current position *)
	lrCalcJerk							:LREAL;						(* Calculated jerk from current position *)

	(* References *)

	(* Interfaces *)
	
	(* Instances *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime							:BOOL;						(* First cycle *)

	lrSampleN							:LREAL;						(* Current signal N *)
	lrSampleN_1							:LREAL;						(* Current signal N - 1 *)
	lrSampleN_2							:LREAL;						(* Current signal N - 2 *)
	lrSampleN_3							:LREAL;						(* Current signal N - 3 *)

	(* References *)

	(* Interfaces *)
	
	(* Instances *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable
THEN
	bFirstTime := FALSE;

	RETURN;
END_IF

IF NOT bFirstTime
THEN
	A_Init();

	bFirstTime := TRUE;
END_IF

IF bReset
THEN
	A_Reset();
END_IF

lrSampleN := lrActPos;

A_CalcVelo();
A_CalcAccDec();
A_CalcJerk();

lrSampleN_3 := lrSampleN_2;
lrSampleN_2 := lrSampleN_1;								 														 
lrSampleN_1 := lrSampleN;]]></ST>
    </Implementation>
    <Action Name="A_CalcAccDec" Id="{2c0e7635-f641-4eee-b27a-b48cc92db4ce}">
      <Implementation>
        <ST><![CDATA[
(*
	Method gives acceleration and deceleration depending on moving direction.
	
	a =  dv / dt [m/s] => v = (Vn - Vn-1) / dt^2

	d - delta 

*)

lrCalcAcc := (lrSampleN - 2*lrSampleN_1 + lrSampleN_2)
			 / EXPT(lrSectorTime, 2);

IF lrCalcAcc * etDirection > 0
THEN
	lrCalcAcc := ABS(lrCalcAcc);
	lrCalcDec := 0.0;
	bAccelerating := TRUE;
	bDecelerating := FALSE;
	
ELSIF lrCalcAcc * etDirection < 0
THEN
	lrCalcDec := ABS(lrCalcAcc);
	lrCalcAcc := 0.0;
	bAccelerating := FALSE;
	bDecelerating := TRUE;

ELSE
	lrCalcAcc := ABS(lrCalcAcc);
	lrCalcDec := 0.0;
	bAccelerating := FALSE;
	bDecelerating := FALSE;	
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_CalcJerk" Id="{5d3b3843-e0de-40a1-b0de-5db351acb0df}">
      <Implementation>
        <ST><![CDATA[
(*
	Method gives jerk of object moving.
	
	a =  da / dt [m/s] => v = (An - An-1) / dt^3 

	d - delta
*)

lrCalcJerk := (lrSampleN - 3*lrSampleN_1 + 3*lrSampleN_2 - lrSampleN_3)
			  / EXPT(lrSectorTime, 3);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_CalcVelo" Id="{176a4775-d4e2-416f-8bc0-676bde148581}">
      <Implementation>
        <ST><![CDATA[
(*
	Method gives both how fast and in what direction the object is moving.
	
	v =  ds / dt [m/s] => v = (Dn - Dn-1) / dt
	
	d - delta 

*)

lrCalcVelo := (lrSampleN - lrSampleN_1)
			  / lrSectorTime;

IF lrCalcVelo < 0 
THEN
	etDirection := ET_MC_Direction_eNegative;
ELSE
	etDirection := ET_MC_Direction_ePositive;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{12212994-6db0-4471-8e30-9db3b7a9e1e1}">
      <Implementation>
        <ST><![CDATA[
lrSampleN := lrActPos;
lrSampleN_1 := lrActPos;
lrSampleN_2 := lrActPos;
lrSampleN_3 := lrActPos;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Reset" Id="{cb58703b-125d-4d9f-94b7-9f5a5ebc9361}">
      <Implementation>
        <ST><![CDATA[
A_Init();]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_CalcVeloAccDecJerk">
      <LineId Id="66" Count="28" />
    </LineIds>
    <LineIds Name="FB_CalcVeloAccDecJerk.A_CalcAccDec">
      <LineId Id="0" Count="32" />
    </LineIds>
    <LineIds Name="FB_CalcVeloAccDecJerk.A_CalcJerk">
      <LineId Id="0" Count="10" />
    </LineIds>
    <LineIds Name="FB_CalcVeloAccDecJerk.A_CalcVelo">
      <LineId Id="0" Count="18" />
    </LineIds>
    <LineIds Name="FB_CalcVeloAccDecJerk.A_Init">
      <LineId Id="0" Count="4" />
    </LineIds>
    <LineIds Name="FB_CalcVeloAccDecJerk.A_Reset">
      <LineId Id="0" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>