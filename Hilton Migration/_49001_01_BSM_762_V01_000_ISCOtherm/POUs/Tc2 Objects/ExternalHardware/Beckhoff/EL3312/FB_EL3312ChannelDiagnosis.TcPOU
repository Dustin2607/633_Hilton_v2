<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EL3312ChannelDiagnosis" Id="{f6cf9182-a8d1-4c87-aff3-70da80409f21}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EL3312ChannelDiagnosis
VAR_INPUT
	stChannelState				:ST_EL3312ChannelState;
END_VAR
VAR_OUTPUT
	bChannelOK					:BOOL;
	bLimit1						:BOOL;			(* State limit 1 *)
	bLimit2 						:BOOL;			(* State limit 2 *)
END_VAR
VAR

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* General Channel Status *)
IF stChannelState.bUnderrange = 0
    AND stChannelState.bOverrange = 0
    AND stChannelState.bError = 0
    AND stChannelState.bState = 0
THEN
	bChannelOK := TRUE;
ELSE
	bChannelOK := FALSE;
END_IF

(*bLimit1 := stChannelState.byLimit1;
bLimit2 := stChannelState.byLimit2*);



]]></ST>
    </Implementation>
    <LineIds Name="FB_EL3312ChannelDiagnosis">
      <LineId Id="12" Count="17" />
    </LineIds>
  </POU>
</TcPlcObject>