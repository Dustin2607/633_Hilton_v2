    <Declaration><![CDATA[FUNCTION_BLOCK FB_LEISTER_EXTRUDER_REF
VAR_INPUT
	bEnable						:BOOL;						(* Enable *)
	bResetAlarm					:BOOL;						(* Reset alarm *)
	bDriveAbort					:BOOL;						(* Drive abort *)

	bStartHeater					:BOOL;						(* Heater start *)
	bStopHeater					:BOOL;						(* Heater stop *)
	bStartExtruder				:BOOL;						(* Extruder start *)
	bStopExtruder				:BOOL;						(* Extruder start *)

