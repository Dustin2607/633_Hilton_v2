	nAirTempMax				:INT;						(* Maximal air temperature  °C *)
	nAirActTemp					:INT;						(* Current air temperature ° C *)
	nAirActFlow					:INT;						(* Current air flow l/min *)

	bLockedInterface				:BOOL;						(* Interface lock *)

	stTerminalState				AT %I*:ST_TerminalState;
	stLeisterToPlc				AT %I*:ST_LEISTERTOPLC;
	stPlcToLeister				AT %Q*:ST_PLCTOLEISTER;
