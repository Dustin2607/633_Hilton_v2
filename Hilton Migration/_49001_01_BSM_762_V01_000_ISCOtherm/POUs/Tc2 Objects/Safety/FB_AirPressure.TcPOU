<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AirPressure" Id="{98c76894-2a2d-40a4-a6f3-367dac922319}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AirPressure
(*

The function block used to control air pressure.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable FB signal *)
	bIn						:BOOL;						(* Input signal *)
	bNoEStop				:BOOL;						(* Emergency stop *)
	tAirOnDelay				:TIME := t#2s;					(* Delay air pressure on *)
	tAirPresentDelay			:TIME := t#2s;					(* Delay air pressure present *)
	tTimeOut					:TIME := t#5s;					(* Timeout *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bOut					:BOOL;						(* Air pressure ok *)
	bAirOn					:BOOL;						(* Air pressure on *)
	bError					:BOOL;						(* Error by no air pressure *)
	udnErrorNo				:UDINT;
	udnMessageNo			:UDINT;
	sMsg					:STRING;
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime				:BOOL;						(* First cycle *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	tonAirOnDelay			:TON;						(* Delay air pressure on *)
	tofAirPresentDelay		:TOF;						(* Delay air pressure present *)
	tonWatchDog				:TON;						(* Timer to delay *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	bOut := TRUE;
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	tonWatchDog(IN := FALSE,
	             		 PT := tTimeOut);
	bFirstTime := FALSE;
	RETURN;
END_IF;

IF NOT bFirstTime
THEN
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	tonWatchDog(IN := FALSE,
	             		 PT := tTimeOut);
	bFirstTime := TRUE;
END_IF;

(* Air pressure on delay *)
tonAirOnDelay(
	IN := bNoEStop,
	PT := tAirOnDelay
);

bAirOn := tonAirOnDelay.Q;

(* Air pressure present delay *)
tofAirPresentDelay(
	IN := bIn,
	PT := tAirPresentDelay
);

bOut := tofAirPresentDelay.Q;

(* Timer starts when came rising edge of signal *)
tonWatchDog(
	IN := bAirOn,
	PT := tTimeOut
);

bError := NOT bOut
	        AND tonWatchDog.Q;

IF NOT bOut
     AND bAirOn
THEN
	IF tonWatchDog.Q                       		 (* Error if air pressure not present *)
	THEN
		udnErrorNo := 1;
		udnMessageNo := 0;
		sMsg := 'No pressured air';
	ELSE                                  				  (* Message if air pressure softstarting *)
		udnMessageNo := 1;
		sMsg := 'Air pressure building up';
	END_IF;
ELSE
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_AirPressure">
      <LineId Id="50" Count="65" />
    </LineIds>
  </POU>
</TcPlcObject>