<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr05AutoProcedure" Id="{c006d6a3-c91a-4fe7-8398-424f5924b193}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr05AutoProcedure
(*

The function block used to generate auto process..

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Enable FB signal *)
	bExecute					:BOOL;						(* Auto procedure execute *)
	bReleaseNextStep			:BOOL;						(* Auto procedure release next step *)
	bInterrupt					:BOOL;						(* Auto procedure interrupt *)
	SFCInit						:BOOL; 						(* System Flag:: INIT Flag *)
	bFirstTime					:BOOL;
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;						(* Program done *)
	bInterrupted					:BOOL;						(* Program interrupted *)
	bBusy						:BOOL;						(* Program busy *)
	bError						:BOOL;						(* Program error *)
	udnErrorNo					:UDINT;						(* Error number *)
	SFCError						:BOOL; 						(* System Flag: Timeout in this step *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	lrClamp1Pos					:LREAL;
	lrClamp1PosCache			:LREAL;
	lrClamp1PosPipeEnd			:LREAL;
	lrClamp2Pos					:LREAL;
	lrActRemoveLength			:LREAL;
	bPipeEndDetected			:BOOL;
	unProcessCounter				:UINT;
	lrActSawingLength				:LREAL;
	lrActSawingAngle				:LREAL;

	lrDistPipeBeginSawBand		:LREAL;

	bSafetyDistEnable			:BOOL; 						(* Safety distance between Clamp1 & 2 increase *)
	bErrorPipeBeginNoDetected	:BOOL;						(* Pipe begin no detected *)
	bErrorPipeEndNoDetected		:BOOL;						(* Pipe end no detected *)
	bErrorCollisionDetected		:BOOL;						(* Collision detected *)
	bWarningPipeBeginNoDetected	:BOOL;						(* Pipe begin no detected *)

	SFCCurrentStep				:STRING;					(* Name des aktiven Schritts *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtPipeBeginIdentify			:R_TRIG;
	rtPipeEndIdentify				:R_TRIG;
END_VAR]]></Declaration>
