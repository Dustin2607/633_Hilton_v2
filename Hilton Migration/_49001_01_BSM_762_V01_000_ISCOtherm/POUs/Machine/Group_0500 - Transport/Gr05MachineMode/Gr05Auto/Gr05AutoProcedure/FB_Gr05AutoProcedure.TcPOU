    <Transition Name="_Current_pos_clamp_1_sawing_lenght_current_pos_clamp_2_Current_pos_clamp_2_is_" Id="{6481c542-76c8-4b43-9684-46d763f37665}">
      <Implementation>
        <ST><![CDATA[(*1 Current pos clamp 1 - sawing lenght > current pos clamp 2 (Current pos clamp 2 is " + ") *)
(lrClamp1Pos - MAX(ABS(lrActSawingLength), ABS(lrActRemoveLength)) > (F_GetCylinderPos(
										F_SetCylinderPos(SEL(stgGr05HMI.stHMITOPLC.bCylinderPosActive, Gr05Control.fbCylinderPos.lrActPosition, lrClamp2Pos),
														lrgGr05CylinderPosOffset,
														lrgGr05CylinderPosOriginShiftPos,
														etgGr05CylinderPosDirection,
														usngGr05CylinderPosCodingType),
										lrgGr05CylinderPosOffset,
										lrgGr05CylinderPosOriginShiftPos,
										etgGr05CylinderPosDirection,
										usngGr05CylinderPosCodingType)
									    	+ lrgGr05Clamp2Width (*+ lrgGr05SafetyDistance*)))
AND bReleaseNextStep





]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Current_pos_clamp_1_sawing_lenght_current_pos_clamp_2_Current_pos_clamp_2_is_1" Id="{c65fc21f-bb3b-4cd4-9e8a-6c45a80448ee}">
      <Implementation>
        <ST><![CDATA[(*2 Current pos clamp 1 - sawing lenght <= current pos clamp 2 (Current pos clamp 2 is " + ") *)
(lrClamp1Pos - MAX(ABS(lrActSawingLength), ABS(lrActRemoveLength)) <= (F_GetCylinderPos(
														F_SetCylinderPos(SEL(stgGr05HMI.stHMITOPLC.bCylinderPosActive, Gr05Control.fbCylinderPos.lrActPosition, lrClamp2Pos),
																		lrgGr05CylinderPosOffset,
																		lrgGr05CylinderPosOriginShiftPos,
																		etgGr05CylinderPosDirection,
																		usngGr05CylinderPosCodingType),
														lrgGr05CylinderPosOffset,
														lrgGr05CylinderPosOriginShiftPos,
														etgGr05CylinderPosDirection,
														usngGr05CylinderPosCodingType)
									   					 + lrgGr05Clamp2Width))
AND bReleaseNextStep

]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_No_pipe_end_detected_" Id="{91338bbf-53d1-4184-bed6-d73023aafab0}">
      <Implementation>
        <ST><![CDATA[NOT bPipeEndDetected
AND bReleaseNextStep]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_begin_was_detected_" Id="{f2b07088-bb37-471a-801e-c6ecbaf7a004}">
      <Implementation>
        <ST><![CDATA[(* Pipe begin was detected *)
rtPipeBeginIdentify.Q]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_begin_was_no_detected_" Id="{8db41f5e-4a0f-443a-a780-380d1f41a938}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.lrActPosition < (lrgGr05Clamp1DistPipeBeginSawBand + 10)
OR Gr05Control.fbAxisClamp1.bHardLimitMinExceeded
OR Gr05Control.fbAxisClamp1.bSoftLimitMinExceeded]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_begin_was_no_detected_1" Id="{1e069f00-c6b8-490d-a87a-b080814a921c}">
      <Implementation>
        <ST><![CDATA[(Gr05Control.fbAxisClamp1.lrActPosition <= lrClamp1Pos - lrgGr05SearchDistPipeBegin
AND Gr05Control.fbAxisClamp1.lrActPosition > (lrgGr05Clamp1DistPipeBeginSawBand + 10))
OR Gr05Control.fbAxisClamp1.bHardLimitMinExceeded
OR Gr05Control.fbAxisClamp1.bSoftLimitMinExceeded]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_end_detected_" Id="{9e7cd500-a92b-4ee3-a79b-95b5c25ca170}">
      <Implementation>
        <ST><![CDATA[NOT binGr05PipeEndEdge
AND bReleaseNextStep]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_end_was_detected_" Id="{c5fd9dc7-71cd-428d-bfbf-95b4b388e900}">
      <Implementation>
        <ST><![CDATA[(* Pipe end was detected *)
rtPipeEndIdentify.Q]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="_Pipe_end_was_not_detected_" Id="{2c869067-fd6f-4c9e-9e22-8aadf3bbb1e4}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.lrActPosition <= lrClamp1Pos - lrgGr05SearchDistPipeEnd
OR Gr05Control.fbAxisClamp1.bHardLimitMinExceeded
OR Gr05Control.fbAxisClamp1.bSoftLimitMinExceeded]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="ActSawingL_RemoveL" Id="{fe49722e-35f7-4a17-a97f-217c16edbb81}">
      <Implementation>
        <ST><![CDATA[ABS(lrActSawingLength) < ABS(lrActRemoveLength)]]></ST>
      </Implementation>
    </Transition>
    <Action Name="Gr05Auto_ChkPipeBeginEdge_Exit" Id="{7d1101a2-06f3-4b58-bdba-abb1531224e7}">
      <Implementation>
        <ST><![CDATA[IF NOT binGr05PipeBeginEdge
THEN
	lrDistPipeBeginSawBand := lrgGr05Clamp1DistPipeBeginSawBand;
ELSE
	lrDistPipeBeginSawBand := 0;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAngleReq_Entry" Id="{1d389b3c-9699-4362-b889-d016f35d9696}">
      <Implementation>
        <ST><![CDATA[stgGr05HMI.stHMITOPLC.lrActSawingLength := ABS(lrClamp1PosPipeEnd - ABS(stgGr05HMI.stHMITOPLC.lrActSawingLength));
lrActSawingLength := ABS(lrClamp1PosPipeEnd - ABS(lrActSawingLength));									(* Next sawing lenght *)
lrActSawingAngle := arrGr00ProcessPara[unProcessCounter - 1, 1] / 180 * PI;
bgGr05AngleReq := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAngleReq_Exit" Id="{534527a1-8315-4c66-9664-36794cbaf616}">
      <Implementation>
        <ST><![CDATA[bgGr05AngleReq := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InBackPos_Exit" Id="{82f27437-61a9-45f9-8bc8-d1d22b9b4029}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InBackPosErr_Entry" Id="{c587c135-40d7-4d96-97bc-9cad6350b39d}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPipeBeginPos_Action" Id="{818575f0-a336-4413-9f5c-e9f2037814b7}">
      <Implementation>
        <ST><![CDATA[rtPipeBeginIdentify(CLK := binGr05PipeBeginEdge);

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPipeBeginPos_Exit" Id="{d8b00fc7-8f08-47d7-89cb-baa3f7a1f272}">
      <Implementation>
        <ST><![CDATA[rtPipeBeginIdentify(CLK := FALSE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPipeEndPos_Action" Id="{02437d06-368c-46ab-b97e-751dd7ee46d1}">
      <Implementation>
        <ST><![CDATA[rtPipeEndIdentify(CLK := binGr05PipeEndEdge );

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPipeEndPos_Exit" Id="{010e0099-2b89-4bbf-a561-caf5a0e95b21}">
      <Implementation>
        <ST><![CDATA[rtPipeEndIdentify(CLK := FALSE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPos_Exit" Id="{d5857da8-10ea-4615-acb6-caa53af139cc}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPos2_Exit" Id="{447f4946-7b9d-47b6-8988-b094f8f70f11}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPos2Err_Entry" Id="{67a7eb8f-cc21-4a2a-958e-094230f470c6}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InPosErr_Entry" Id="{1f8f0153-e9b0-480c-a34d-00c2505183a0}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InSawBandPos_Exit" Id="{a1ce9bc2-95ab-4922-9439-6b141e3588f7}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1InSawBandPosErr_Entry" Id="{21f85646-0df1-460d-be10-4ec4635e9559}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveAbsPipeEnde_Entry" Id="{a0101a6c-31a1-43c3-a722-76f0baeda599}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := binGr05PipeEndEdge;
Gr05Control.fbAxisClamp1.lrTargetPosition := stgGr05HMI.stHMITOPLC.arlrAxisClampSoftLimitMax[1];
Gr05Control.fbAxisClamp1.lrAutoVelocity := stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1];
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveAbsPipeEnde_Exit" Id="{ec425a8e-f2a1-44e3-8922-f107615160fb}">
      <Implementation>
        <ST><![CDATA[IF NOT Gr05Control.fbUtility.bPipeEndPresent
THEN
	Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveAbsPipeEndeErr_Entry" Id="{21853957-6bde-4e98-b330-6d97e5247b95}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToBackPos_Entry" Id="{e265f354-3adf-4b1b-a593-e700b87d49f9}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := TRUE;
Gr05Control.fbAxisClamp1.lrTargetPosition := lrClamp1Pos + ABS(lrActRemoveLength - lrActSawingLength);
Gr05Control.fbAxisClamp1.lrAutoVelocity := stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1];
lrActSawingLength := 0.0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToBackPosErr_Entry" Id="{676edf1c-3706-4631-914d-22510e6f13d7}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToPos_Action" Id="{a26a0dce-c76a-4711-be64-a08c8aa22c56}">
      <Implementation>
        <ST><![CDATA[
Gr05Control.fbAxisClamp1.bExeMoveAbs := lrClamp1Pos - MAX(ABS(lrActSawingLength), ABS(lrActRemoveLength)) > (stgGr05HMI.stPLCTOHMI.arlrAxisClampActPos[2] + lrgGr05Clamp2Width (*+lrgGr05SafetyDistance   	(*ESKG 12032026*)*) );
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToPos_Entry" Id="{ecc447ef-c0f8-470d-ac82-be64f50fa825}">
      <Implementation>
        <ST><![CDATA[(*IF lrClamp1Pos + ABS(lrActSawingLength) > stgGr05HMI.stPLCTOHMI.lrAxisClamp1ActPos
THEN
	Gr05Control.fbAxisClamp1.bExeMoveAbs := lrClamp1Pos + ABS(lrActSawingLength) < (stgGr05HMI.stPLCTOHMI.lrAxisClamp2ActPos - lrgGr05Clamp2Width);
ELSE
	Gr05Control.fbAxisClamp1.bExeMoveAbs := TRUE;
END_IF*)
Gr05Control.fbAxisClamp1.lrTargetPosition := lrClamp1Pos - MAX(ABS(lrActSawingLength), ABS(lrActRemoveLength));
Gr05Control.fbAxisClamp1.lrAutoVelocity := stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1];]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToPos2_Entry" Id="{a86c68ce-4588-492a-b688-fd2f40e0f9a9}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := TRUE;
Gr05Control.fbAxisClamp1.lrTargetPosition := lrClamp1Pos -MIN(lrActSawingLength , ABS(Gr05Control.fbAxisClamp1.lrActPosition - Gr05Control.fbCylinderPos.lrActPosition - lrgGr05Clamp2Width)); 	(*ESKG 12032026*)
Gr05Control.fbAxisClamp1.lrAutoVelocity := stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1];]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToPos2Err_Entry" Id="{e9c77a3a-e884-499f-8e39-ffaab5eeaccf}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToPosErr_Entry" Id="{ca8224d6-1b22-4e4c-8c8e-2294d0d8c087}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToSawBandPos_Entry" Id="{2eef4d10-19d2-42cf-93b6-58293ec388af}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := TRUE;
Gr05Control.fbAxisClamp1.lrTargetPosition := lrClamp1Pos - lrDistPipeBeginSawBand;
Gr05Control.fbAxisClamp1.lrAutoVelocity := stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1];
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveToSawBandPosErr_Entry" Id="{ba50b007-a133-476c-b3ab-5fc9f431f3ca}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp1MoveVeloPipeBegin_Entry" Id="{e699aee6-0300-4c07-a2a6-49007f5a09ad}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbAxisClamp1.bExeMoveVelo := TRUE;
Gr05Control.fbAxisClamp1.lrAutoVelocity := -stgGr05HMI.stHMITOPLC.arlrAxisClampAutoVelo[1] / 10;
lrClamp1Pos := Gr05Control.fbAxisClamp1.lrActPosition;


]]></ST>
      </Implementation>
    </Action>
