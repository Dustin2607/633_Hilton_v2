    <Action Name="Gr05Auto_eGetClamp2ActPos_Entry" Id="{8f51bb36-e3aa-4108-b809-c75d7ad21bb0}">
      <Implementation>
        <ST><![CDATA[
lrClamp2Pos := F_AxisClamp2Pos(
					bEnable := TRUE,
					lrActClamp2Pos := Gr05Control.fbCylinderPos.lrActPosition,
					lrAngle := lrActSawingAngle,
					lrRadius := stgGr01HMI.stHMITOPLC.rPipeDiameter / 2.0,
					lrPipeClampWidth := lrgGr05PipeClampWidth,
					lrSawbandGuideWidth := lrgGr05SawbandGuideWidth
				);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eGetProcessPara_Entry" Id="{22f4a980-7d39-48f7-b450-d1793048e058}">
      <Implementation>
        <ST><![CDATA[IF unProcessCounter <= usnFileArrayMaxDimR
THEN
	unProcessCounter := unProcessCounter + 1;

	IF unProcessCounter > 1
	THEN
		lrActRemoveLength := lrgGr05RemovalBandSawBand;
	ELSE
		lrActRemoveLength := 0.0;
	END_IF

	stgGr05HMI.stHMITOPLC.lrActSawingLength := REAL_TO_LREAL(ABS(arrGr00ProcessPara[unProcessCounter,0]));
	lrActSawingLength := SEL(
							stgGr05HMI.stHMITOPLC.lrActSawingLength > 0,
						    	0.0,
						    	REAL_TO_LREAL(ABS(arrGr00ProcessPara[unProcessCounter,0]) +
							(stgGr01HMI.stHMITOPLC.lrSawBandThickness * (1/COS(ABS(arrGr00ProcessPara[unProcessCounter, 1] / 180 * PI)))))
						     );
	(*lrActSawingLength := ABS(arrGr00ProcessPara[unProcessCounter,0]) + (stgGr01HMI.stHMITOPLC.lrSawBandThickness * 1);*)
	lrActSawingAngle := REAL_TO_LREAL(arrGr00ProcessPara[unProcessCounter, 1] / 180 * PI);

	(*ESKG 12032026*)
	IF lrActSawingLength>=lrActRemoveLength
	THEN
		lrActRemoveLength := 0.0;
	END_IF

END_IF




]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eRemovalBandErr_Entry" Id="{cbb27a62-3f2f-4868-991f-db92473c6f01}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbRemovalBand.arbAutoMoveToMinus[2] := FALSE;				(* Auto move to minus *)]]></ST>
