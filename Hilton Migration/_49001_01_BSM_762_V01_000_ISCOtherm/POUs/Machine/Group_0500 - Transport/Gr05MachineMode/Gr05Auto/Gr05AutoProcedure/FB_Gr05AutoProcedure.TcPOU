    <Action Name="Init_Action" Id="{73020b56-24e3-4ee9-bad5-4ae590e36ed2}">
      <Implementation>
        <ST><![CDATA[IF NOT bFirstTime
THEN
	SFCCurrentStep:= 'Init';

	bDone := FALSE;                                 	(* Program done *)
	bBusy := FALSE;                                  	(* Program not busy *)
	bError := FALSE;                                 	(* Program not error *)
	udnErrorNo := 0;                                		(* Error number *)
	
	(* Internal flags *)
	bgGr05SawingReq := FALSE;
	bgGr05AngleReq := FALSE;
	bgGr05TransportAck := FALSE;
	unProcessCounter	 := 0;

	bErrorPipeBeginNoDetected := FALSE;
	bErrorPipeEndNoDetected := FALSE;
	bWarningPipeBeginNoDetected := FALSE;
	(*ESKG 12032026*)
	bSafetyDistEnable := FALSE;

	bFirstTime := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Init_Exit" Id="{85d4513c-b205-4f2e-89c9-544ae04dd426}">
      <Implementation>
        <ST><![CDATA[(* Set status *)
bDone := FALSE;                                 	(* Program done *)
bBusy := FALSE;                                  	(* Program not busy *)
bError := FALSE;                                 	(* Program not error *)
udnErrorNo := 0;                                		(* Error number *)

(* Internal flags *)
bgGr05SawingReq := FALSE;
bgGr05AngleReq := FALSE;
bgGr05TransportAck := FALSE;
unProcessCounter	 := 0;
bPipeEndDetected := FALSE;
rtPipeBeginIdentify(CLK := FALSE);
rtPipeEndIdentify(CLK := FALSE);

bErrorPipeBeginNoDetected := FALSE;
bErrorPipeEndNoDetected := FALSE;
bWarningPipeBeginNoDetected := FALSE;

(*ESKG 12032026*)
bSafetyDistEnable:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Transition Name="SafetyDistEnable" Id="{d0ec5b99-d67e-4fe1-8932-a0722f74e568}">
      <Implementation>
        <ST><![CDATA[bSafetyDistEnable  	(*ESKG 12032026*)
AND Gr05Control.arfbCylinderClamp[1].fbCylinder.bEndWork
AND bReleaseNextStep]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="SafetyDistEnable_1" Id="{b1fda3e7-c5fa-48d9-8a77-5c2022df07d4}">
      <Implementation>
        <ST><![CDATA[	(*ESKG 12032026*)
(*(Gr05Control.fbAxisClamp1.lrActPosition - Gr05Control.fbCylinderPos.lrActPosition - lrgGr05Clamp2Width ) <  lrgGr05SafetyDistance*)
bSafetyDistEnable]]></ST>
      </Implementation>
    </Transition>
