        <ST><![CDATA[Gr01Control.fbSawband.bExeMoveVelo:= TRUE;
Gr01Control.fbSawband.lrAutoVelocity := stgGr01HMI.stHMITOPLC.lrSawbandAutoSpeed;

]]></ST>
