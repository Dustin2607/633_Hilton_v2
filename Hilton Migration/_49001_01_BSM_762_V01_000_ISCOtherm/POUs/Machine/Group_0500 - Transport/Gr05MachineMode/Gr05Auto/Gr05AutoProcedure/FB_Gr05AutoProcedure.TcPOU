      <Implementation>
        <ST><![CDATA[Gr05Control.fbCylinderPos.bExeMoveAbs := TRUE;
Gr05Control.fbCylinderPos.lrTargetPosition := lrgGr05Clamp2SawPos; (* 0.0 *)

]]></ST>
      </Implementation>
    </Action>
