    <Action Name="Gr05Auto_eSawingLengthCorrection_Entry" Id="{9c418063-f092-4e75-95d0-e602933e46bc}">
      <Implementation>
        <ST><![CDATA[stgGr05HMI.stHMITOPLC.lrActSawingLength := MAX(0, ABS(stgGr05HMI.stHMITOPLC.lrActSawingLength) - ABS(lrClamp1Pos - Gr05Control.fbAxisClamp1.lrActPosition));
lrActSawingLength := MAX(0, ABS(lrActSawingLength) - ABS(lrClamp1Pos - Gr05Control.fbAxisClamp1.lrActPosition));]]></ST>
      </Implementation>
    </Action>
