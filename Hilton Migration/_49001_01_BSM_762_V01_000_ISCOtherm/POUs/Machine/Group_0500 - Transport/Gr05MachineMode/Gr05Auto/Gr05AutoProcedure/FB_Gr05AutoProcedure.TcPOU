    <Action Name="Gr05Auto_eChkAxisClamp1MoveToBackPos_Entry" Id="{c15f677a-24fd-4755-8ab3-a5e3d41c95d0}">
      <Implementation>
        <ST><![CDATA[(*ESKG 12032026*)

IF ABS(lrActSawingLength) >= ABS(lrActRemoveLength)
THEN
	bSafetyDistEnable := ((Gr05Control.fbAxisClamp1.lrActPosition - Gr05Control.fbCylinderPos.lrActPosition - lrgGr05Clamp2Width ) <  lrgGr05SafetyDistance)
						AND Gr05Control.fbUtility.bPipeEndPresent;

	IF bSafetyDistEnable
	THEN
		lrActSawingLength := 0;
		lrActRemoveLength := 0;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
