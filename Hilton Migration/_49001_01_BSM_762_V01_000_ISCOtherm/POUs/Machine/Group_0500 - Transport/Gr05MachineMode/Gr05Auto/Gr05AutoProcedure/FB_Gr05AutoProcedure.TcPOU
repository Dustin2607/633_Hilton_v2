    <Action Name="Gr05Auto_eAxisClamp2MoveToPos_Entry" Id="{564b843a-143b-4f2c-b16d-cf8e822d734b}">
      <Implementation>
        <ST><![CDATA[(*IF (lrClamp2Pos - lrgGr05Clamp2Width) > stgGr05HMI.stPLCTOHMI.lrAxisClamp2ActPos
THEN*)
	Gr05Control.fbCylinderPos.bExeMoveAbs := TRUE;
(*ELSE
	Gr05Control.fbCylinderPos.bExeMoveAbs := stgGr05HMI.stPLCTOHMI.lrAxisClamp1ActPos < (lrClamp2Pos - lrgGr05Clamp2Width);
END_IF*)

Gr05Control.fbCylinderPos.lrTargetPosition := lrClamp2Pos;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp2MoveToPos2_Entry" Id="{dee9280e-ac7e-48cd-a916-68ade5b1e999}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbCylinderPos.bExeMoveAbs := TRUE;
IF ABS(lrActSawingLength) < ABS(lrClamp1Pos - lrgGr05Clamp2Width)
THEN
	IF Gr05Control.fbCylinderPos.lrActPosition < (lrClamp1Pos - ABS(lrActSawingLength) - lrgGr05Clamp2Width)
	THEN
		Gr05Control.fbCylinderPos.lrTargetPosition := Gr05Control.fbCylinderPos.lrActPosition;
	ELSE
		Gr05Control.fbCylinderPos.lrTargetPosition := lrClamp1Pos - ABS(lrActSawingLength) - lrgGr05Clamp2Width;
	END_IF
ELSE
	Gr05Control.fbCylinderPos.lrTargetPosition := 0.0;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Gr05Auto_eAxisClamp2MoveToPos2Err_Entry" Id="{6595b859-6d9e-4a6d-9a76-9ea032ca9493}">
      <Implementation>
        <ST><![CDATA[Gr05Control.fbCylinderPos.bExeMoveAbs := FALSE;]]></ST>
      </Implementation>
    </Action>
