<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr05AutoInit" Id="{d93730de-a6be-47b0-ab48-dc7df37dd8fc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr05AutoInit
(*

The function block used to initialize automatic mode.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bFirstTime					:BOOL;
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)

END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	unClampIdx					:UINT;						(* Clamp index *)
	unCylinderPosIdx				:UINT;						(* Position cylinder index *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Initializing variables *)
IF NOT bFirstTime
THEN

	(* Initialise axis saw bow *)
	Gr05Control.fbAxisClamp1.bExeSetPos := FALSE;					(* Execute set  position *)
	Gr05Control.fbAxisClamp1.bExeHome := FALSE;					(* Execute home *)
	Gr05Control.fbAxisClamp1.bExeMoveAbs := FALSE;					(* Execute move absolut *)
	Gr05Control.fbAxisClamp1.bExeMoveRel := FALSE;					(* Execute move relative *)
	Gr05Control.fbAxisClamp1.bExeMoveAdd := FALSE;					(* Execute move additive *)
	Gr05Control.fbAxisClamp1.bExeMoveSuper := FALSE;				(* Execute move superimposed *)
	Gr05Control.fbAxisClamp1.bExeMoveVelo := FALSE;					(* Execute move velo *)
	Gr05Control.fbAxisClamp1.bExeGearIn := FALSE;					(* Execute gear in *)
	Gr05Control.fbAxisClamp1.bExeGearOut := FALSE;					(* Execute gear out *)
	Gr05Control.fbAxisClamp1.bExeStop := FALSE;						(* Execute move stop *)
	Gr05Control.fbAxisClamp1.bExeReset := FALSE;						(* Execute auto reset *)
	Gr05Control.fbAxisClamp1.bExtOverrideEn := FALSE;					(* Execute extern override *)

	(* Initialise clamp *)
	FOR unClampIdx :=1 TO ungGr05ClampMaxNo
	DO
		Gr05Control.arfbCylinderClamp[unClampIdx].bAutoOpen := FALSE;					(* Auto open *)
		Gr05Control.arfbCylinderClamp[unClampIdx].bAutoClose := FALSE;					(* Auto close *)
		Gr05Control.arfbCylinderClamp[unClampIdx].bControlStateOn := FALSE;
	END_FOR

	(* Initialise slide *)
	Gr05Control.fbSlide.bAutoMoveToBase := FALSE;				(* Auto move to base *)
	Gr05Control.fbSlide.bAutoMoveToWork := FALSE;				(* Auto move to work *)
	Gr05Control.fbSlide.bControlStateOn := FALSE;

	(* Initialise removal band *)
	Gr05Control.fbRemovalBand.bAutoMoveToPlus := FALSE;				(* Auto move to plus *)
	Gr05Control.fbRemovalBand.arbAutoMoveToMinus[1] := FALSE;				(* Auto move to minus *)
	Gr05Control.fbRemovalBand.arbAutoMoveToMinus[2] := FALSE;				(* Auto move to minus *)

	(* Initialise position cylinder *)
	Gr05Control.fbCylinderPos.bExeMoveAbs := FALSE;					(* Execute move absolut *)
	Gr05Control.fbCylinderPos.bControlStateOn := FALSE;

	(* Auto procedure *)
	Gr05Auto.fbProcedure.bEnable := FALSE;								(* Start init process *)
	Gr05Auto.fbProcedure.SFCInit := TRUE;								(* Reset SFC *)
	Gr05Auto.fbProcedure.bFirstTime := FALSE;							(* Initialise *)
	Gr05Auto.fbProcedure.bExecute := FALSE;							(* Reset *)
	Gr05Auto.fbProcedure();											(* Start init process *)
	Gr05Auto.fbProcedure.SFCInit := FALSE;								(* Initialise over *)

	(* Auto functions *)

	(* Auto *)
	bgGr05SawingReq := FALSE;
	bgGr05AngleReq := FALSE;
	bgGr05TransportAck := FALSE;

	bgGr05AutoCompleted := FALSE;
	bgGr05MoveInterrupted := FALSE;

	bFirstTime := TRUE;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_Gr05AutoInit">
      <LineId Id="40" Count="60" />
    </LineIds>
  </POU>
</TcPlcObject>