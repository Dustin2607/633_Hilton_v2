<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Gr05Home" Id="{336f6945-3936-4e6b-8a18-8474b96e4ba1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Gr05Home
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable Gr02Home *)
	bExecute				:BOOL;						(* Home execute *)

	(* Instances *)
	fbInit						:FB_Gr05HomeInit;
	fbProcedure				:FB_Gr05HomeProcedure;

	fbAxisClamp1				:FB_Gr05HomeAxisClamp1;
	fbAxisClamp2				:FB_Gr05HomeAxisClamp2;

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute					:R_TRIG;

	fbAlarm					:FB_Gr05HomeAlarm;

END_VAR
VAR CONSTANT
	nFatalErrorMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nErrorMaxIdx					:INT := 2;						(* Maximal index of  using alarms *)
	nWarningMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nMessageMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nHintMaxIdx					:INT := 0;						(* Maximal index of  using alarms *)

	dnFatalErrorBaseIdentNo		:DINT := 53000;					(* Fatal error identification number *)
	dnErrorBaseIdentNo			:DINT := 53100;					(* Error identification number *)	
	dnWarningBaseIdentNo		:DINT := 53200;					(* Warning identification number *)	
	dnMessageBaseIdentNo		:DINT := 53300;					(* Message identification number *)	
	dnHintBaseIdentNo			:DINT := 53400;					(* Hint identification number *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	RETURN;
END_IF;

(* Check home execute *)
bExecute := etgGr00MachineState = ET_MachineState_eHomeRefExe
		      OR etgGr00MachineState = ET_MachineState_eHomeExe;

rtExecute(CLK := bExecute);

IF rtExecute.Q
THEN
	fbInit.bFirstTime := FALSE;
	A_Init();
END_IF;

A_Procedure();
A_Functions();
A_Alarm();
]]></ST>
    </Implementation>
    <Action Name="A_Alarm" Id="{95a7a2d3-49a5-419d-8ba4-c3e0517bd745}">
      <Implementation>
        <ST><![CDATA[
(* Collect and execute input alarms *)
fbAlarm.stAlarmIn.arbError[0].bActive := fbAxisClamp1.bErrorByReference;
fbAlarm.stAlarmIn.arbError[0].dnCode := dnErrorBaseIdentNo + 0;

fbAlarm.stAlarmIn.arbError[1].bActive := fbAxisClamp1.bErrorByPipeCollision ;
fbAlarm.stAlarmIn.arbError[1].dnCode := dnErrorBaseIdentNo + 1;

fbAlarm.stAlarmIn.arbError[2].bActive := fbAxisClamp1.bErrorByPipeEndNoDetected;
fbAlarm.stAlarmIn.arbError[2].dnCode := dnErrorBaseIdentNo + 2;

fbAlarm(
	etMachineMode := etgGr00MachineMode,
	etMachineState := etgGr00MachineState,
	bNoEStop := bgGr00NoEmergencyStop,
	bConfirmAlarm := bgGr00ConfirmAlarm,
	dtDateTime := stgGr00DateTime.dtDateTime,
	nFatalErrorMaxIdx := nFatalErrorMaxIdx,
	nErrorMaxIdx := nErrorMaxIdx,
	nWarningMaxIdx := nWarningMaxIdx,
	nMessageMaxIdx := nMessageMaxIdx,
	nHintMaxIdx := nHintMaxIdx,
	bMoveInterrupted := bgGr05MoveInterrupted,
	bHomeCompleted := bgGr05HomeCompleted,
	stAlarmOut => stgGr05Alarm.stHome
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Functions" Id="{a48c19f2-117f-46f0-a27b-c35cbbb413b8}">
      <Implementation>
        <ST><![CDATA[
fbAxisClamp1(
	bEnable := etgGr00MachineMode = ET_MachineMode_eHome,
	bReleaseNextStep := etgGr00MachineState = ET_MachineState_eHomeRefExe
		      	     		      OR etgGr00MachineState = ET_MachineState_eHomeExe
);

fbAxisClamp2(
	bEnable := etgGr00MachineMode = ET_MachineMode_eHome,
	bReleaseNextStep := etgGr00MachineState = ET_MachineState_eHomeRefExe
		      	     		      OR etgGr00MachineState = ET_MachineState_eHomeExe
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{3fa8d3a3-f7c1-4e40-8c7b-a29b2182b50b}">
      <Implementation>
        <ST><![CDATA[
(* Initializing variables *)
fbInit();]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Procedure" Id="{19a25bf5-6a72-4c63-9dc2-5880b266e8cb}">
      <Implementation>
        <ST><![CDATA[
(* Execute home procedure *)
fbProcedure(
	bEnable := etgGr00MachineMode = ET_MachineMode_eHome,
	bExecute := rtExecute.Q,
	bReleaseNextStep := etgGr00MachineState = ET_MachineState_eHomeRefExe
		      	     		      OR etgGr00MachineState = ET_MachineState_eHomeExe
);]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="Gr05Home">
      <LineId Id="42" Count="20" />
    </LineIds>
    <LineIds Name="Gr05Home.A_Alarm">
      <LineId Id="0" Count="26" />
    </LineIds>
    <LineIds Name="Gr05Home.A_Functions">
      <LineId Id="0" Count="11" />
    </LineIds>
    <LineIds Name="Gr05Home.A_Init">
      <LineId Id="0" Count="2" />
    </LineIds>
    <LineIds Name="Gr05Home.A_Procedure">
      <LineId Id="0" Count="7" />
    </LineIds>
  </POU>
</TcPlcObject>