  <POU Name="FB_Gr05ManualProcedure" Id="{b64005ce-f722-4bb4-9b21-54055061ffc1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr05ManualProcedure
(*

The function block used to initialize manual mode.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Enable FB signal *)
	bExecute					:BOOL;						(* Manual procedure execute *)
	bReleaseNextStep			:BOOL;						(* Manual procedure release next step *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)

END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN

	bFirstTime := FALSE;
	RETURN;
END_IF;

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

IF bExecute
THEN
	 ;
END_IF;]]></ST>
    </Implementation>
