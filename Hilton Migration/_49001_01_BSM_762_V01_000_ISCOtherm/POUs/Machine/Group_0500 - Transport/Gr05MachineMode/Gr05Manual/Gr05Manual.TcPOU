<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Gr05Manual" Id="{e59b243d-30c0-48ee-bcfe-ae66acdd483d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Gr05Manual
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable Gr05Manual *)
	bExecute				:BOOL;						(* Manual execute *)

	(* Instances *)
	fbInit						:FB_Gr05ManualInit;
	fbProcedure				:FB_Gr05ManualProcedure;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute					:R_TRIG;

	fbAlarm					:FB_Gr05ManualAlarm;
END_VAR
VAR CONSTANT
	nFatalErrorMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nErrorMaxIdx					:INT := 0;						(* Maximal index of  using alarms *)
	nWarningMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nMessageMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nHintMaxIdx					:INT := 0;						(* Maximal index of  using alarms *)

	dnFatalErrorBaseIdentNo		:DINT := 54000;					(* Fatal error identification number *)
	dnErrorBaseIdentNo			:DINT := 54100;					(* Error identification number *)	
	dnWarningBaseIdentNo		:DINT := 54200;					(* Warning identification number *)	
	dnMessageBaseIdentNo		:DINT := 54300;					(* Message identification number *)	
	dnHintBaseIdentNo			:DINT := 54400;					(* Hint identification number *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	RETURN;
END_IF;

(* Check manual execute *)
bExecute := etgGr00MachineMode = ET_MachineMode_eManual;

rtExecute(CLK := bExecute);

IF rtExecute.Q
THEN
	fbInit.bFirstTime := FALSE;
	A_Init();
END_IF;

A_Procedure();
A_Alarm();





]]></ST>
    </Implementation>
    <Action Name="A_Alarm" Id="{924d65c9-36cc-46f3-82eb-27c6375d9c2a}">
      <Implementation>
        <ST><![CDATA[
(* Collect and execute input alarms *)
fbAlarm.stAlarmIn.arbError[0].bActive := FALSE;
fbAlarm.stAlarmIn.arbError[0].dnCode := dnErrorBaseIdentNo + 0;

fbAlarm(
	etMachineMode := etgGr00MachineMode,
	etMachineState := etgGr00MachineState,
	bNoEStop := bgGr00NoEmergencyStop,
	bConfirmAlarm := bgGr00ConfirmAlarm,
	dtDateTime := stgGr00DateTime.dtDateTime,
	nFatalErrorMaxIdx := nFatalErrorMaxIdx,
	nErrorMaxIdx := nErrorMaxIdx,
	nWarningMaxIdx := nWarningMaxIdx,
	nMessageMaxIdx := nMessageMaxIdx,
	nHintMaxIdx := nHintMaxIdx,
	bHomeCompleted := bgGr05HomeCompleted,
	stAlarmOut => stgGr05Alarm.stManual
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{4d4fe3e0-05fe-44c9-affb-47957eefe2fd}">
      <Implementation>
        <ST><![CDATA[
(* Initializing variables *)
fbInit();]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Procedure" Id="{4785a8a2-1dc0-4d9f-ab9f-0ff7a6eb7045}">
      <Implementation>
        <ST><![CDATA[
(* Execute manual procedure *)
fbProcedure(
	bEnable := etgGr00MachineMode = ET_MachineMode_eManual,
	bExecute := rtExecute.Q,
	bReleaseNextStep := etgGr00MachineMode = ET_MachineMode_eManual
);]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="Gr05Manual">
      <LineId Id="37" Count="23" />
    </LineIds>
    <LineIds Name="Gr05Manual.A_Alarm">
      <LineId Id="0" Count="19" />
    </LineIds>
    <LineIds Name="Gr05Manual.A_Init">
      <LineId Id="0" Count="2" />
    </LineIds>
    <LineIds Name="Gr05Manual.A_Procedure">
      <LineId Id="0" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>