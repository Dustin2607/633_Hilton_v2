<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr05Safety" Id="{930ac431-f393-42b2-87e5-ce591dbcbd24}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr05Safety
(*

The function block used to control genaeral safety of the machine.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bLightCurtain					:BOOL;						(* Light curtain ok / Freigabe Lichtschranke i.o *)
	bConfirmLightCurtain			:BOOL;						(* Confirm light Curtain input signal *)
	tLightCurtainDelay				:TIME := t#1s;					(* After time light Curtain safe *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bLightCurtainOK				:BOOL;						(* Light curtain ok / Freigabe Lichtschranke i.o *)
	bConfirmedLightCurtain			:BOOL;						(* Confirmed light Curtain signal *)
	bNotInCrashArea				:BOOL;						(* Axis not in crash area with *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbLightCurtain					:FB_LightCurtain;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
A_LightCurtain();
A_SafetyArea();
]]></ST>
    </Implementation>
    <Action Name="A_LightCurtain" Id="{ccab16f0-2164-4d2b-8a10-6c63cf7e0c5b}">
      <Implementation>
        <ST><![CDATA[
(* Light Curtain control *)
fbLightCurtain(
	bEnable := TRUE,
	bIn := bLightCurtain,
	bInConf := bConfirmLightCurtain,
	tTimeOut := tLightCurtainDelay,
	bOut => bLightCurtainOK,
	bOutConf => bConfirmedLightCurtain
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SafetyArea" Id="{123c30bd-5493-4911-9e0f-26db6e6c7f0c}">
      <Implementation>
        <ST><![CDATA[
(* Safety area *)
bNotInCrashArea := FALSE;

IF FALSE
THEN
	bNotInCrashArea := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_Gr05Safety">
      <LineId Id="45" Count="3" />
    </LineIds>
    <LineIds Name="FB_Gr05Safety.A_LightCurtain">
      <LineId Id="0" Count="9" />
    </LineIds>
    <LineIds Name="FB_Gr05Safety.A_SafetyArea">
      <LineId Id="0" Count="7" />
    </LineIds>
  </POU>
</TcPlcObject>