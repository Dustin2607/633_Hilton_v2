<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr05Slide" Id="{b0a916f8-21c0-4ef1-ab8e-6d933e0f46f3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr05Slide
(*

The function block used to control slide.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bAirPressureOK				:BOOL;						(* Air pressure OK *)
	bSafetyOk					:BOOL;						(* Safety Ok *)
	bInBase						:BOOL;						(* In base position *)
	bInWork						:BOOL;						(* In work position *)
	bMoveToBaseRelease		:BOOL;						(* Release move to base *)
	bMoveToWorkRelease		:BOOL;						(* Release move to work *)
	bHandMoveToBase			:BOOL;						(* Hand move to base *)
	bHandMoveToWork			:BOOL;						(* Hand move to work *)
	bAutoMoveToBase			:BOOL;						(* Auto move to base *)
	bAutoMoveToWork			:BOOL;						(* Auto move to work *)
	bControlStateOn				:BOOL;						(* Control with input state *)
	bControlOff					:BOOL;						(* Controle off *)
	bValveOff					:BOOL;						(* Valve off *)
	bConfirmAlarm				:BOOL;						(* Confirm alarm *)
	tTimeOut						:TIME := t#6s;					(* TimeOut *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bMoveToBase				:BOOL;						(* Move to base *)
	bMoveToWork				:BOOL;						(* Move to work *)
	bErrorMoveToBase			:BOOL;						(* Error move to base *)
	bErrorMoveToWork			:BOOL;						(* Error move to work *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	bHomeCompleted				:BOOL;						(* Home completed *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbCylinder					:FB_Cylinder;
	fbCylinderAtBasePos			:FB_SignalHandlingDelay;
	fbCylinderAtWorkPos			:FB_SignalHandlingDelay;
	fbCylinderBaseRelease		:FB_SignalHandlingDelay;
	fbCylinderWorkRelease		:FB_SignalHandlingDelay;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable								(* Signal FB enable *)
THEN

	RETURN;
END_IF

(* Control slide cylinder *)

fbCylinderAtBasePos(
	bEnable := TRUE,
	bIn := bInBase,
	tDelay := t#0ms
);

fbCylinderAtWorkPos(
	bEnable := TRUE,
	bIn := bInWork,
	tDelay := t#0ms
);

fbCylinderBaseRelease(
	bEnable := TRUE,
	bIn := bMoveToBaseRelease,
	tDelay :=t#0ms
);

fbCylinderWorkRelease(
	bEnable := TRUE,
	bIn := bMoveToWorkRelease,
	tDelay := t#0ms
);

fbCylinder(
	bEnable := TRUE,
	bAirPressure := bAirPressureOK,
	bSafetyOk := bSafetyOk,
	bReset := bConfirmAlarm,
	bAutoHand := etMachineMode = ET_MachineMode_eHome
			         OR etMachineMode = ET_MachineMode_eStepping
			         OR etMachineMode = ET_MachineMode_eAutomatic,
	bHandBase := bHandMoveToBase,
	bHandWork := bHandMoveToWork,
	bAutoBase := bAutoMoveToBase,
	bAutoWork := bAutoMoveToWork,
	bAtBasePos := fbCylinderAtBasePos.bOut,
	bAtWorkPos := fbCylinderAtWorkPos.bOut,
	bBaseRelease := fbCylinderBaseRelease.bOut,
	bWorkRelease := fbCylinderWorkRelease.bOut,
	bControlStateOn := bControlStateOn,
	bControlOff := bControlOff,
	bValveOff := bValveOff,
	bValveErrOff := FALSE,
	bErrorOff := FALSE,
	tTimeOut := tTimeOut,
	bHomeCompleted := bHomeCompleted,
	bMoveToBase => bMoveToBase,
	bMoveToWork => bMoveToWork
);

A_Alarm();]]></ST>
    </Implementation>
    <Action Name="A_Alarm" Id="{23009865-5502-47a3-9fd9-e4bd76a3673c}">
      <Implementation>
        <ST><![CDATA[
bErrorMoveToWork := fbCylinder.bError
					AND (fbCylinder.udnErrorNo = 1
					     OR fbCylinder.udnErrorNo = 2
					     OR fbCylinder.udnErrorNo = 5);

bErrorMoveToBase := fbCylinder.bError
					 AND (fbCylinder.udnErrorNo = 3
					       OR fbCylinder.udnErrorNo = 4
					       OR fbCylinder.udnErrorNo = 5);]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_Gr05Slide">
      <LineId Id="63" Count="60" />
    </LineIds>
    <LineIds Name="FB_Gr05Slide.A_Alarm">
      <LineId Id="0" Count="9" />
    </LineIds>
  </POU>
</TcPlcObject>