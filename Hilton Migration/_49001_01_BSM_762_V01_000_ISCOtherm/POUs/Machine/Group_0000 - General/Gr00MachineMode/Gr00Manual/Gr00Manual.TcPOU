<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Gr00Manual" Id="{e8970a8a-b721-4e66-bb29-879f8ba4d846}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Gr00Manual
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable Gr00Manual *)
	bExecute				:BOOL;						(* Manual execute *)

	(* Instances *)
	fbInit						:FB_Gr00ManualInit;
	fbProcedure				:FB_Gr00ManualProcedure;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute					:R_TRIG;

	fbAlarm					:FB_Gr00ManualAlarm;
END_VAR
VAR CONSTANT
	nFatalErrorMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nErrorMaxIdx					:INT := 0;						(* Maximal index of  using alarms *)
	nWarningMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nMessageMaxIdx				:INT := 0;						(* Maximal index of  using alarms *)
	nHintMaxIdx					:INT := 0;						(* Maximal index of  using alarms *)

	dnFatalErrorBaseIdentNo		:DINT := 04000;				(* Fatal error identification number *)
	dnErrorBaseIdentNo			:DINT := 04100;				(* Error identification number *)
	dnWarningBaseIdentNo		:DINT := 04200;				(* Warning identification number *)
	dnMessageBaseIdentNo		:DINT := 04300;				(* Message identification number *)
	dnHintBaseIdentNo			:DINT := 04400;				(* Hint identification number *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	RETURN;
END_IF;

(* Check manual execute *)
bExecute := etgGr00MachineMode = ET_MachineMode_eManual;

rtExecute(CLK := bExecute);

IF rtExecute.Q
THEN
	fbInit.bFirstTime := FALSE;
	A_Init();
END_IF;

A_Procedure();
A_Alarm();






]]></ST>
    </Implementation>
    <Action Name="A_Alarm" Id="{63665fab-e6f0-4d33-baad-5dbdfd8c0dd5}">
      <Implementation>
        <ST><![CDATA[
(* Collect and execute input alarms *)
fbAlarm.stAlarmIn.arbError[0].bActive := FALSE;
fbAlarm.stAlarmIn.arbError[0].dnCode := dnErrorBaseIdentNo + 0;

fbAlarm(
	etMachineMode := etgGr00MachineMode,
	etMachineState := etgGr00MachineState,
	bNoEStop := bgGr00NoEmergencyStop,
	bConfirmAlarm := bgGr00ConfirmAlarm,
	dtDateTime := stgGr00DateTime.dtDateTime,
	nFatalErrorMaxIdx := nFatalErrorMaxIdx,
	nErrorMaxIdx := nErrorMaxIdx,
	nWarningMaxIdx := nWarningMaxIdx,
	nMessageMaxIdx := nMessageMaxIdx,
	nHintMaxIdx := nHintMaxIdx,
	bHomeCompleted := bgGr00HomeCompleted,
	stAlarmOut => stgGr00Alarm.stManual
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{51a22500-bcb3-40a9-8f44-afdac57fe666}">
      <Implementation>
        <ST><![CDATA[
(* Initializing variables *)
fbInit();]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Procedure" Id="{ce2ed996-75ad-4339-99ff-41488ec1adf0}">
      <Implementation>
        <ST><![CDATA[
(* Execute manual procedure *)
fbProcedure(
	bEnable := etgGr00MachineMode = ET_MachineMode_eManual,
	bExecute := rtExecute.Q,
	bReleaseNextStep := etgGr00MachineMode = ET_MachineMode_eManual
);]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="Gr00Manual">
      <LineId Id="37" Count="24" />
    </LineIds>
    <LineIds Name="Gr00Manual.A_Alarm">
      <LineId Id="0" Count="18" />
    </LineIds>
    <LineIds Name="Gr00Manual.A_Init">
      <LineId Id="0" Count="2" />
    </LineIds>
    <LineIds Name="Gr00Manual.A_Procedure">
      <LineId Id="0" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>