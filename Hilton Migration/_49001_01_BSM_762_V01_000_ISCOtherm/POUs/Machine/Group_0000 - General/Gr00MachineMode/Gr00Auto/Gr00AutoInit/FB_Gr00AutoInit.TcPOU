<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr00AutoInit" Id="{43400f2c-a741-4ac1-9407-aa5eb3218231}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr00AutoInit
(*

The function block used to initialize manual mode.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bFirstTime					:BOOL;
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)

END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Initializing variables *)
IF NOT bFirstTime
THEN
	(* Program init *)
	Gr00Control.fbProgram.bRead := FALSE;								(* Read program *)

	(* Auto procedure *)
	Gr00Auto.fbProcedure.bEnable := FALSE;								(* Start init process *)
	Gr00Auto.fbProcedure.bExecute := FALSE;
	Gr00Auto.fbProcedure();

	bgGr00AutoCompleted := FALSE;
	bgGr00MoveInterrupted := FALSE;

	bFirstTime := TRUE;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_Gr00AutoInit">
      <LineId Id="38" Count="16" />
    </LineIds>
  </POU>
</TcPlcObject>