<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Gr01SawBow" Id="{19b6ff95-4841-47fe-a1b0-4c16c0a5d0d7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Gr01SawBow
(*

The function block used to control axis welding.

Constructor: 		Patryk Panylo
Company:			E. Riexinger GmbH
Date:				28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)

	(* --- Axis / Achse --- *)
	bEnable						:BOOL;						(* Axis present *)
	bOccupied					:BOOL;						(* Axis occupied *)

	(* --- Machine state / Maschinenzustand --- *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bMachineStandstill			:BOOL;						(* Machine standstill *)

	(* --- Safety & releases / Sicherheit & Freigaben --- *)
	bNoEStop					:BOOL;						(* No ermergency Stop / Keine Notaus *)
	bPowerSupplyOn				:BOOL;						(* Power supply on / Leitung eingeschaltet *)
	bSafetyOK					:BOOL;						(* Safety ok / Sicherheit i.o *)
	bSafetyDriveEnabled			:BOOL;						(* Safety drive enable *)
	bCtrlInterrupt				:BOOL;						(* Control interrupt *)
	bMoveRelease				:BOOL;						(* Move release *)
	bPlusRelease				:BOOL;						(* Plus move release *)
	bMinusRelease				:BOOL;						(* Minus move release *)

	(* --- Limits & signals / Endlagen & Signale --- *)
	bSignalReference			:BOOL;						(* Reference signal *)
	bSignalHWLimitMax			:BOOL;						(* Position Hard limit switch maximum *)
	bSignalHWLimitMin			:BOOL;						(* Position Hard limit switch minimum *)
	lrSoftLimitMax				:LREAL;						(* Position limit switch maximum *)
	lrSoftLimitMin				:LREAL;						(* Position limit switch minimum *)

	(* --- Commands / Befehle --- *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	bExeCtrlEnable				:BOOL;						(* Controller enable *)
	bExeSetPos					:BOOL;						(* Execute set position *)
	bExeHome					:BOOL;						(* Execute home *)
	etHomingMode				:MC_HomingMode;				(* HomingMode determines in which way the calibration is carried out. *)
	bExeMoveAbs					:BOOL;						(* Execute move absolut *)
	bExeMoveRel					:BOOL;						(* Execute move relative *)
	bExeMoveAdd					:BOOL;						(* Execute move additive *)
	bExeMoveSuper				:BOOL;						(* Execute move superimposed *)
	bExeMoveVelo				:BOOL;						(* Execute move velo *)
	bExeGearIn					:BOOL;						(* Execute gear in *)
	bExeGearOut					:BOOL;						(* Execute gear out *)
	bExeStop					:BOOL;						(* Execute move stop *)
	bConfirmAlarm				:BOOL;						(* Confirm alarm *)

	(* --- Manual mode / Handbetrieb --- *)
	bTipPlus					:BOOL;						(* Manual tip in plus direction *)
	bTipMinus					:BOOL;						(* Manual tip in minus direction *)
	lrTipDistance				:LREAL;						(* Relative distance for movements *)
	lrManualVelocity			:LREAL;						(* Value of velocity in manual motion [mm/s] *)

	(* --- Motion parameters / Bewegungsparameter --- *)
	lrTargetPosition			:LREAL;						(* Absolute target position *)
	lrTargetPositionOffset		:LREAL;						(* Absolute target position offset *)
	lrAutoVelocity				:LREAL;						(* Value of velocity in auto motion [mm/s] *)
	lrNoRefVelocity				:LREAL;						(* Velocity if has no reference [mm/s] *)
	bVelocityLimitEn			:BOOL;						(* Enable velocity limit *)
	lrVelocityMin				:LREAL;						(* Velocity minimum [%] *)
	lrVelocityMax				:LREAL;						(* Velocity maximum [%] *)
	lrAcceleration				:LREAL;						(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;						(* Value of jerk (always positive) *)

	(* --- Override --- *)
	lrOverride					:LREAL;						(* Override *)
	bExtOverrideEn				:BOOL;						(* External override enable *)
	lrExtOverride				:LREAL;						(* External override *)

	(* --- Gearing / Getriebe --- *)
	dnRatioNumerator			:DINT;						(* Gear ratio numerator. Alternatively, the gear ratio can be specified in the numerator as a floating comma value, if the denominator is 1. *)
	udnRatioDenominator			:UDINT;						(* Gear ratio denominator *)

	(* --- Drive / Antrieb --- *)
	snModesOfOperation			:SINT;						(* Modes of drive operation *)
	bEngineTorqueLimitEn		:BOOL;						(* Enable engine torque limit *)
	lrEngineTorque				:LREAL;						(* Engine torque [%] *)
	bPosLagMonitoringEn			:BOOL;						(* Enable position lag monitoring *)
	tControllerOff				:TIME := T#60S;				(* Time to switch controller off *)

	(* --- Encoder / Geber --- *)
	bWithAbsoluteEncoder		:BOOL;						(* Encoder is an absolute one / Absolutwertgeber *)
	lrOriginShiftPos			:LREAL;						(* Origin shift position *)

	(* --- Force control / Kraftregelung --- *)
	unForceMeasureType			:UINT;						(* Type of force measure system. 1: Simple mA,  2: EL3351 3: EL3356 *)
	bVeloForceCtrlEn			:BOOL;						(* Enable velocity  force controller *)
	lrVeloForceCtrlKp			:LREAL;						(* Velocity - force controller proportional band Kp *)
	lrVeloForceCtrlTi			:LREAL;						(* Velocity - force controller integral Ti *)
	lrVeloForceCtrlMin			:LREAL;						(* Velocity - force controller minimum  *)
	lrVeloForceCtrlMax			:LREAL;						(* Velocity - force controller maxmimum  *)
	lrVeloForcePreCtrlVelo		:LREAL;						(* Feedforward velocity precontrol wieghting =  0..1 *)
	lrTargetForce				:LREAL;						(* Absolute target force [N] *)
	lrForceCurrent				:LREAL;						(* Current force [mA] *)
	rForceOffset				:REAL;						(* Force offset [N] *)
	lrMaintenanceOverflowForce	:LREAL;						(* Maintenance overflow force [N] *)
	lrManualOverflowForce		:LREAL;						(* Maximal force in manual mode [N] *)
	lrAutoOverflowForce			:LREAL;						(* Maximal force in automatic mode [N] *)
	lrForceMinmA				:LREAL;						(* Force min [mA] 16#0000 = 4 [mA] *)
	lrForceMaxmA				:LREAL;						(* Force max [mA] 16#7FFF = 20 [mA] *)
	lrForceMinN					:LREAL;						(* Force min [N] *)
	lrForceMaxN					:LREAL;						(* Force max [N] *)

	(* --- Temperature & cooling / Temperatur & Kühlung --- *)
	lrActTemp					:LREAL;						(* Current temperatur *)
	lrTempLimitMax				:LREAL;						(* Temperatur limit maximum*)
	lrTempLimitMin				:LREAL;						(* Temperatur limit minimum*)
	bCoolingActive				:BOOL;						(* Cooling on *)

	(* --- System --- *)
	tAdsTimeOut					:TIME := T#2S;				(* Timout for ads commands *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)

	(* --- Status --- *)
	bCtrlEnabled				:BOOL;						(* Controller enabled *)
	bNotMoving					:BOOL;						(* Axis not moving *)
	bStandStill					:BOOL;						(* Added by Dustin for 633_Hilton) Axis stands stil*)
	bReferenced					:BOOL;						(* Axis referenced *)
	bCoupled					:BOOL;						(* Axis coupled *)

	(* --- Actual values / Istwerte --- *)
	lrActPosition				:LREAL;						(* Actual position [mm] *)
	lrActAbsPosition			:LREAL;						(* Actual absolut position [mm] *)
	lrActVelocity				:LREAL;						(* Actual velocity [mm/s] *)
	lrActForce					:LREAL;						(* Actual force [N] *)
	lrVeloMax					:LREAL;						(* Velocity limit maximum *)
	lrAccMax					:LREAL;						(* Acceleration limit maximum *)
	lrDecMax					:LREAL;						(* Deceleration limit maximum *)
	lrJerkMax					:LREAL;						(* Jerk limit maximum *)

	(* --- Limits / Endlagen --- *)
	bHardLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bHardLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
	bSoftLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bSoftLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)

	(* --- Peripherals / Peripherie --- *)
	bCoolingOn					:BOOL;						(* Cooling *)

	(* --- Safety / Sicherheit --- *)
	bSafetyLock					:BOOL;						(* Safety lock*)
	bSafetyDriveEnable			:BOOL;						(* Safety drive enable *)

	(* --- Errors / Fehler --- *)
	bErrorTerminal				:BOOL;						(* Error Axis terminal *)
	bErrorDrive					:BOOL;						(* Error drive *)
	bErrorCtrlEnabled			:BOOL;						(* Error Axis controller enabled *)
	bErrorForceOverflow			:BOOL;						(* Error force overflow *)
	bErrPosLimitOverflow		:BOOL;						(* Error position limit overflow *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	bHomeCompleted				:BOOL;						(* Home completed *)
	Drive						:ST_STOEBERSI6SC6CIA402_REF; (* The ST_STOEBERSI6SC6CIA402_REF data type  is an interface between the PLC and the DRIVE and contains axis information *)
	Axis						:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
	MasterAxis					:AXIS_REF;					(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	sAdsAddr					:STRING(23);					(* AmsNetId of the EtherCAT master device.*)
	unSlaveAddr					:UINT;						(* Address of the slave device.*)

	nTorqueLimitMax				:INT := 100;					(* The torque limit (absolute value). Value range in %: -200 ... 200 ... 200 *)

	lrVeloLimitMax				:LREAL;
	lrVeloLimitMin				:LREAL;

	sTerminalStatus				:STRING;
	
	bSetCoeParaToDefault		:BOOL;
	bReadCoePara				:BOOL;
	bWriteCoePara				:BOOL;
	stCoeWrite					:ST_EL3356CoeInfo;
	stCoeRead					:ST_EL3356CoeInfo;
	
	lrCacheWeightTara			:LREAL;
	
	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbTerminalDiagnosis			:FB_TerminalDiagnosis;
	rtMachineStandstill			:R_TRIG;
	tonAxisEnabled				:TON;

	fbController				:FB_STOEBER_AxisController;
	fbMoveManual				:FB_STOEBER_AxisMoveManual;
	fbMoveAuto					:FB_STOEBER_AxisMoveAuto;
	(*fbDriveLink				:FB_STOEBER_DriveLink;*)
	fbForce						:FB_ScalingOffset;
	fbForceCtrl					:FB_ForceController;
	fbCoolingOff				:FB_SignalHandlingDelay;
	
	fbSawingOverride			:FB_Override;
	rtWriteForcePara			:R_TRIG;
	
	fbForceSimple				:FB_ScalingOffset;
	fbForceEL3351				:FB_EL3351;
	fbForceEL3356				:FB_EL3356;

	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable								(* Signal FB enable *)
THEN
	bCtrlEnabled := TRUE;
	bReferenced := TRUE;
	bNotMoving := TRUE;
	
	RETURN;
END_IF

A_AxisLink();
A_AxisGetStatus();
A_AxisController();
A_AxisForceCtrl();
A_AxisMoveManual();
A_AxisMoveAuto();
A_AxisTerminalDiag();
A_AxisAlarm();
]]></ST>
    </Implementation>
    <Action Name="A_AxisAlarm" Id="{ac0900e8-360e-4f77-8e32-8b93e604493e}">
      <Implementation>
        <ST><![CDATA[
(* Axis error *)
tonAxisEnabled(
	IN := fbController.bEnable
		AND fbController.bRegulatorOn
		AND NOT fbController.bStatusDelay,
	PT := fbController.tStatusDelay + t#2s
);

bErrorCtrlEnabled := tonAxisEnabled.Q;
(*byErrorPLCOpenController := fbAxisControl.byPLCOpenErrCode;*)
(*bErrorController := fbAxisControl.bError;
bErrorMoveManual := fbMoveManual.bError;
bErrorMoveAuto := fbMoveAuto.bError;*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisController" Id="{43e8fd7a-ab28-41e1-aaf8-1689aa4bd10f}">
      <Implementation>
        <ST><![CDATA[
(* Axis controller *)
fbController(
    bEnable := TRUE,
	etMachineMode := etMachineMode,
	etMachineState := etMachineState,
	bNoEStop := bNoEStop,
	bRegulatorOn := bNoEStop
				      AND bPowerSupplyOn
				      AND bSafetyOk
				      AND SEL(bNotMoving, NOT bCtrlInterrupt, TRUE)
				      AND NOT fbMoveManual.bControllerOff
				      AND NOT fbMoveAuto.bControllerOff,
	bReset := bConfirmAlarm,
	bTerminalOK := fbTerminalDiagnosis.bTerminalOK,
	bExeReset := bExeReset,
	bExeSetPos := bExeSetPos,
	lrSetPosition := lrTargetPosition,
	bExeGearIn := bExeGearIn,
	bExeGearOut := bExeGearOut,
	dnRatioNumerator := dnRatioNumerator,
	udnRatioDenominator := udnRatioDenominator,
	lrOverride := SEL(bExtOverrideEn,
					SEL(
						bVeloForceCtrlEn,
						lrOverride,
						fbForceCtrl.lrCVVelo),
					lrOverride*lrExtOverride/100.0)/2,
	bWithAbsoluteEncoder := bWithAbsoluteEncoder,
	bPosLagMonitoringEn := bPosLagMonitoringEn,
	lrPositionBias := lrOriginShiftPos,
	lrSoftLimitMax := lrSoftLimitMax,
	lrSoftLimitMin := lrSoftLimitMin,
	bSignalHWLimitMax:= bSignalHWLimitMax,
	bSignalHWLimitMin := bSignalHWLimitMin,
	lrAcceleration := lrAcceleration,
	lrDeceleration := lrDeceleration,
	lrJerk := lrJerk,
	pDrive := ADR(Drive),
	Axis := Axis,
	MasterAxis := MasterAxis,
	bStatusDelay => bCtrlEnabled,
	lrActPos => lrActPosition,
	lrActAbsPos => lrActAbsPosition,
	lrActVelo => lrActVelocity,
	bNotMoving => bNotMoving,
	bStandStill => bStandStill,
	bReferenced => bReferenced,
	bCoupled => bCoupled,
	lrVeloLimitMax => lrVeloMax,
	lrAccLimitMax => lrAccMax,
	lrDecLimitMax => lrDecMax,
	lrJerkLimitMax => lrJerkMax,
	bHardLimitMaxExceeded => bHardLimitMaxExceeded,
	bHardLimitMinExceeded => bHardLimitMinExceeded,
	bSoftLimitMaxExceeded => bSoftLimitMaxExceeded,
	bSoftLimitMinExceeded => bSoftLimitMinExceeded,

);

bSafetyDriveEnable := fbMoveManual.bSafetyCtrlEnable 
				 	  OR fbMoveAuto.bSafetyCtrlEnable;


(* From Tc2)

(* Sawbow sawing override *)
fbSawingOverride(
	bEnable := bExtOverrideEn
			    AND
			    (etgGr00MachineState = ET_MachineState_eAutoExe
			    OR etgGr00MachineState = ET_MachineState_eAutoSteppingExe)
			    AND
			    (etMachineMode = ET_MachineMode_eAutomatic
			     OR etMachineMode = ET_MachineMode_eCycle
			     OR etMachineMode = ET_MachineMode_eStepping),
	bBypassAccDec := FALSE,
	bSetOverideMax := FALSE,
	rSetOverride := rSetSawingOverride,
	rAcc := rgGr00AdsOverrideAcc,
	rDec := rgGr01AdsOverrideDec
);


IF bExtOverrideEn
     AND
    (etgGr00MachineState = ET_MachineState_eAutoExe
    OR etgGr00MachineState = ET_MachineState_eAutoSteppingExe)
    AND
    (etMachineMode = ET_MachineMode_eAutomatic
     OR etMachineMode = ET_MachineMode_eCycle
     OR etMachineMode = ET_MachineMode_eStepping)
THEN
	rSawingOverride := INT_TO_REAL(nSetSawingOverride)/32767.0 * 100.0;
ELSE
	rSawingOverride := 100.0;
END_IF;

(* Axis controller *)
fbController(
    	bEnable := TRUE,
	etMachineMode := etMachineMode,
	etMachineState := etMachineState,
	bRegulatorOn := bNoEStop
				      AND bPowerSupplyOn
				      AND bSafetyOK
                   		      AND NOT bCtrlInterrupt
				      AND NOT fbMoveManual.bControllerOff
				      AND NOT fbMoveAuto.bControllerOff,
	bReset := bConfirmAlarm,
	bCMDInterrupt := bMoveInterrupt,
	bTerminalOK := fbTerminalDiagnosis.bTerminalOK,
	bExeReset := bExeReset,
  	bExeGearIn := bExeGearIn,
    	bExeGearOut := bExeGearOut,
   	dnRatioNumerator := dnRatioNumerator,
    	udnRatioDenominator := udnRatioDenominator,
	lrOverride := SEL(bExtOverrideEn,
					SEL(
						bVeloForceCtrlEn,
						lrOverride,
						fbForceCtrl.lrCVVelo),
					lrOverride * rSawingOverride / 100),
	lrEngineTorque := SEL(
						bEngineTorqueLimitEn,
						nTorqueLimitMax,
						(lrEngineTorque) / 1),
	bWithAbsoluteEncoder := bWithAbsoluteEncoder,
	bHWSignalLimitMax := bHWSignalLimitMax,
	bHWSignalLimitMin := bHWSignalLimitMin,
	lrSoftLimitMax := lrSoftLimitMax,
	lrSoftLimitMin := lrSoftLimitMin,
	lrAcceleration := lrAcceleration,
	lrDeceleration := lrDeceleration,
	lrJerk := lrJerk,
	tTimeOut := tAdsTimeOut,
	Axis := Axis,
	bStatusDelay => bCtrlEnabled,
	lrActPos => lrActPosition,
	lrActVelo => lrActVelocity,
	bNotMoving => bNotMoving,
	bReferenced => bReferenced,
	bCoupled => bCoupled,
	bHardLimitMaxExceeded => bHardLimitMaxExceeded,
	bHardLimitMinExceeded => bHardLimitMinExceeded,
	bSoftLimitMaxExceeded => bSoftLimitMaxExceeded,
	bSoftLimitMinExceeded => bSoftLimitMinExceeded
);

*)

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisForceCtrl" Id="{11811993-dd14-451e-adc7-5a48a81b0803}">
      <Implementation>
        <ST><![CDATA[
IF unForceMeasureType = 1			(* Current or voltage force measure *)
THEN
	fbForceCtrl.lrMaxForce := lrForceMaxN; (* [N] *)

	fbForceSimple(
		bEnable := TRUE,
		lrInput := lrForceCurrent,
		lrXLowLimit := lrForceMinmA, (* 16#0000 = 4 [mA] *)
		lrXUpperLimit := lrForceMaxmA, (* 16#7FFF = 20 [mA] *)
		lrYLowLimit := lrForceMinN,  (*[N]*)
		lrYUpperLimit := lrForceMaxN,  (*[N]*)
		usiPrecision := 2,
		lrOffset := rForceOffset,
		lrOutputPV => lrActForce
	);


ELSIF unForceMeasureType = 2			(* EL3351 force measure *)
THEN
	fbForceCtrl.lrMaxForce := lrForceMaxN; (* [N] *)

	fbForceEL3351(
		bEnable := TRUE,
		nTerminalNr := 1,
		stTerminalState := ,
		stBridgeState := ,
		stSupplyState := ,
		dnRefvoltage := ,
		dnDiffvoltage := ,
		rOffset := rForceOffset,
		usiPrecision := 2,
		bDeviceOk => ,
		sDeviceStatus => ,
		rUdiff => ,
		rUref => ,
		lrGrossWeightRV=> ,
		lrGrossWeightPV => lrActForce,
		lrNetWeightRV=> ,
		lrNetWeightPV=> ,
		lrTareWeightRV=> ,
		lrTareWeightPV=>
	);

ELSIF  unForceMeasureType = 3			(* EL3356 force measure *)
THEN

(*
	rtWriteForcePara(
		CLK:= bgGr01ForceActiv5kN
			   XOR bgGr01ForceActiv10kN
	);

	CASE nStepWriteForcePara OF
		0:	(*Idle*)

			fbForceEL3356.bWriteCoePara:= FALSE;
			bWriteForceParaBusy := FALSE;

			IF rtWriteForcePara.Q
			THEN
				nStepWriteForcePara := 10;
				bWriteForceParaBusy := TRUE;
			END_IF
		10: 	(*Start*)

			IF bgGr01ForceActiv5kN
			THEN
				fbForceCtrl.lrMaxForce := 5000, (* [N] *)

				stCoeWrite.bEnableFilter := TRUE;
				stCoeWrite.bEnableUserScale := TRUE;
				stCoeWrite.dwFilterSettings := 0;
				stCoeWrite.rGain := 1.0;
				stCoeWrite.rTara := stgGr01HMI.stHMITOPLC.lrOriginShiftForceX2Right;
				stCoeWrite.rRatedOutput := 0.995000;
				stCoeWrite.rNominalLoad := 5000.0;
				stCoeWrite.rZeroBalance := -0.00028;
				stCoeWrite.rGravityOfEarth := 9.806650;
				stCoeWrite.rScaleFactor := 1.0;
				stCoeWrite.rReferenceLoad	:= 5.0;
				stCoeWrite.bEnableUserScaleIndex8010 := FALSE;
				stCoeWrite.dnUserScaleOffsetIndex8010 := 0;
				stCoeWrite.dnUserScaleGainIndex8010 := 65536;
				stCoeWrite.dwFilterSettingsIndex8010	:= 0;

				fbForceEL3356.bWriteCoePara:= TRUE;

				nStepWriteForcePara := 20;

			ELSIF bgGr01ForceActiv10kN
			THEN
				fbForceCtrl.lrMaxForce := 10000, (* [N] *)

				stCoeWrite.bEnableFilter := TRUE;
				stCoeWrite.bEnableUserScale := TRUE;
				stCoeWrite.dwFilterSettings := 0;
				stCoeWrite.rGain := 1.0;
				stCoeWrite.rTara := stgGr01HMI.stHMITOPLC.lrOriginShiftForceX2Right;
				stCoeWrite.rRatedOutput := 0.9907;
				stCoeWrite.rNominalLoad := 10000.0;
				stCoeWrite.rZeroBalance := 0.00147;
				stCoeWrite.rGravityOfEarth := 9.806650;
				stCoeWrite.rScaleFactor := 1.0;
				stCoeWrite.rReferenceLoad	:= 10.0;
				stCoeWrite.bEnableUserScaleIndex8010 := FALSE;
				stCoeWrite.dnUserScaleOffsetIndex8010 := 0;
				stCoeWrite.dnUserScaleGainIndex8010 := 65536;
				stCoeWrite.dwFilterSettingsIndex8010	:= 0;

				fbForceEL3356.bWriteCoePara:= TRUE;

				nStepWriteForcePara := 20;

			ELSE

				nStepWriteForcePara := 40;
			END_IF

		20: 	(*Wait*)
			IF fbForceEL3356.fbCoe.bCoeBusy
			THEN
				fbForceEL3356.bWriteCoePara:= FALSE;

				nStepWriteForcePara := 30;
			END_IF
	
		30: (*Write*)
			IF NOT fbForceEL3356.fbCoe.bCoeBusy
			THEN
				bWriteForceParaBusy := FALSE;

				IF NOT fbForceEL3356.fbCoe.bCoeError
				THEN
					nStepWriteForcePara := 0;
				ELSE
					nStepWriteForcePara := 40;
				END_IF
			END_IF
		40: (*Error*)
			nStepWriteForcePara := 0;

		ELSE
			nStepWriteForcePara := 0;
	END_CASE

*)

	fbForceCtrl.lrMaxForce := 5000; (* [N] *)

	stCoeWrite.bEnableFilter := TRUE;
	stCoeWrite.bEnableUserScale := TRUE;
	stCoeWrite.dwFilterSettings := 0;
	stCoeWrite.rGain := 1.0;
	stCoeWrite.rTara := (*stgGr01HMI.stHMITOPLC.lrOriginShiftForce*)0.0;
	stCoeWrite.rRatedOutput := 0.995000;
	stCoeWrite.rNominalLoad := 5000.0;
	stCoeWrite.rZeroBalance := -0.00028;
	stCoeWrite.rGravityOfEarth := 9.806650;
	stCoeWrite.rScaleFactor := 1.0;
	stCoeWrite.rReferenceLoad	:= 5.0;
	stCoeWrite.bEnableUserScaleIndex8010 := FALSE;
	stCoeWrite.dnUserScaleOffsetIndex8010 := 0;
	stCoeWrite.dnUserScaleGainIndex8010 := 65536;
	stCoeWrite.dwFilterSettingsIndex8010	:= 0;

	bWriteCoePara := lrCacheWeightTara <> (*stgGr01HMI.stHMITOPLC.lrOriginShiftForce*)0.0;

	fbForceEL3356(
		bEnable := TRUE,
		nTerminalNr := 1,
(*		stTerminalState := stinGr01EL3356A12TerminalState,
		stChannelState := stinGr01EL3356A12ChannelState,*)
		bSetCoeParaToDefault := bSetCoeParaToDefault,
		bReadCoePara := bReadCoePara,
		bWriteCoePara := bWriteCoePara,
		rValue := (*rinGr01ForceRMBValue*)0.0,
		stCoeWrite := stCoeWrite,
		stCoeRead => stCoeRead,
(*		stChannelCtrl => stoutGr01EL3356A8ChannelCtrl,*)
		lrGrossWeightPV =>
	);

	lrActForce := F_LRealRound(fbForceEL3356.lrGrossWeightPV - rForceOffset, 2);

	lrCacheWeightTara := (*stgGr01HMI.stHMITOPLC.lrOriginShiftForce*)0.0;

ELSE							(* Directly force measure *)

	lrActForce := lrForceCurrent;
	fbForceCtrl.lrMaxForce := lrForceMaxN; (* [N] *)

END_IF

fbForceCtrl(
	bEnable := bNoEStop
			    AND bPowerSupplyOn
			    AND bSafetyOK
			    AND bCtrlEnabled,
	bControllerOn := bVeloForceCtrlEn,
	lrVeloKp := lrVeloForceCtrlKp,
	lrVeloTi := lrVeloForceCtrlTi,
	lrCtrlVeloFilter := lrVeloForcePreCtrlVelo,
	lrPVForce := lrActForce, (* [N] *)
	lrSPForce := lrTargetForce, (* [N] *)
	lrVeloMax := lrVeloForceCtrlMax,
	lrVeloMin := lrVeloForceCtrlMin,
	lrTaskCycle := lrgActCycleTime
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisGetStatus" Id="{3f995c4c-2bd7-4469-aba7-1ef7cf8a1759}">
      <Implementation>
        <ST><![CDATA[
(* Get axis status *)
Axis.ReadStatus();]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisLink" Id="{8800498b-5969-4e31-ae7c-8a6f0c6603c8}">
      <Implementation>
        <ST><![CDATA[
(* Get terminal status *)
sAdsAddr := F_CreateAmsNetId(Drive.stTerminalState.stAdsAddr.netId);
unSlaveAddr := Drive.stTerminalState.stAdsAddr.port;
Axis.DriveAddress.NetID := F_CreateAmsNetId(Drive.stTerminalState.stAdsAddr.netId);
Axis.DriveAddress.SlaveAddress := Drive.stTerminalState.stAdsAddr.port;

(* Set drive parameter *)
Drive.stPlcToStoeber.snA541ModesOfOperation := snModesOfOperation;

(*Drive.PlcToStoeber.nA558TargetTorque := SEL(bEngineTorqueLimitEn,
				    nTorqueLimitMax,
				    LREAL_TO_INT(lrEngineTorque / 1.0))*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisMoveAuto" Id="{b252668a-c801-4b3a-82a4-1c7c2237259f}">
      <Implementation>
        <ST><![CDATA[
(* Move axis auto *)
rtMachineStandstill(CLK := bMachineStandstill);

lrVeloLimitMin := SEL(bVelocityLimitEn, -1 * lrVeloMax, lrVelocityMin);
lrVeloLimitMax := SEL(bVelocityLimitEn, lrVeloMax, lrVelocityMax);;

fbMoveAuto(
	bEnable := bNoEStop
               		    AND bPowerSupplyOn
               		    AND bSafetyOK,
    	bCtrlEnabled := bCtrlEnabled
                    		   AND bMoveRelease,
	etMachineMode := etMachineMode,
	etMachineState := etMachineState,
	bReset := bConfirmAlarm,
	bExeHome := bExeHome,
	bExeMoveAbs := bExeMoveAbs,
	bExeMoveRel := bExeMoveRel,
	bExeMoveAdd := bExeMoveAdd,
	bExeMoveSuper := bExeMoveSuper,
	bExeMoveVelo := bExeMoveVelo,
	bExeStop := bExeStop
			      OR rtMachineStandstill.Q,
	lrPosition := lrTargetPosition,
	lrVelocity := LIMIT(lrVeloLimitMin, lrAutoVelocity, lrVeloLimitMax),
	lrAcceleration := lrAcceleration,
	lrDeceleration := lrDeceleration,
	lrJerk := lrJerk,
	lrOriginShiftPos := lrOriginShiftPos,
	bSignalReference := bSignalReference,
	tControllerOff := tControllerOff,
	bHomeCompleted := bHomeCompleted,
	Axis := Axis,
	MasterAxis 				:= GVL_Gr00Interface.iAxisDummy,
 );]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisMoveManual" Id="{b094ae6d-7cf7-434d-9b5f-644d1a6e12ee}">
      <Implementation>
        <ST><![CDATA[
(* Move axis manual *)
fbMoveManual(
	bEnable := bNoEStop
               AND bPowerSupplyOn
               AND bSafetyOK,
	bOccupied := bOccupied,
	bSafetyCtrlEnabled := bSafetyDriveEnabled,
	bCtrlEnabled := bCtrlEnabled
				    AND bMoveRelease,
	etMachineMode := etMachineMode,
	etMachineState := etMachineState,
	bReset := bConfirmAlarm,
	bMovePlus := bTipPlus,
	bMoveMinus := bTipMinus,
	lrTipDistance := lrTipDistance,
	bLimitMax := bHardLimitMaxExceeded
			     OR bSoftLimitMaxExceeded,
	bLimitMin := bHardLimitMinExceeded
			     OR bSoftLimitMinExceeded,
	bPlusRelease := bPlusRelease,
	bMinusRelease := bMinusRelease 
					 AND NOT bErrorForceOverflow,
	lrVelocity := SEL(NOT bReferenced, lrManualVelocity, lrNoRefVelocity),
	lrAcceleration := lrAcceleration,
	lrDeceleration := lrDeceleration,
	lrJerk := lrJerk,
	tControllerOff := tControllerOff,
	pDrive := ADR(Drive),
	bHomeCompleted := bHomeCompleted,
	Axis := Axis,
	MasterAxis := MasterAxis
);

(* From Tc2)
(* Move axis manual *)
fbMoveManual(
	bEnable := bNoEStop
               		    AND bPowerSupplyOn
               		    AND bSafetyOK,
	bCtrlEnabled := bCtrlEnabled
                			    AND bMoveRelease,
	etMachineMode := etMachineMode,
	etMachineState := etMachineState,
	bReset := bConfirmAlarm,
	bMovePlus := bTipPlus,
	bMoveMinus := bTipMinus,
	lrTipDistance := lrTipDistance,
	bLimitMax := bHardLimitMaxExceeded
			       OR bSoftLimitMaxExceeded ,
	bLimitMin := bHardLimitMinExceeded
			      OR bSoftLimitMinExceeded,
	bPlusRelease := bPlusRelease,
	bMinusRelease := bMinusRelease,
	lrVelocity := SEL(NOT bReferenced, lrManualVelocity, lrVelocityNoRef),
	lrAcceleration := lrAcceleration,
	lrDeceleration := lrDeceleration,
	lrJerk := lrJerk,
	tControllerOff := tControllerOff,
	bHomeCompleted := bHomeCompleted,
	Axis := Axis
);

bSafetyLock := fbMoveManual.bMovePlus
                		OR fbMoveManual.bMoveMinus;
						
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_AxisTerminalDiag" Id="{22051634-0a60-4388-822f-d1a6c5d30ac3}">
      <Implementation>
        <ST><![CDATA[
(*Axis terminal diagnosis *)
fbTerminalDiagnosis(
	stTerminalState := Drive.stTerminalState,
	sTerminalStatus => sTerminalStatus
);

bErrorTerminal := NOT fbTerminalDiagnosis.bTerminalOK;]]></ST>
      </Implementation>
    </Action>
