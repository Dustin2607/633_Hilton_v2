<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Warning" Id="{d3a01821-c571-4376-b0c4-a2fba099d48d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Warning
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable FB signal *)
	bReset					:BOOL;						(* Reset *)
	stAlarmIn					:ST_AlarmProperties;				(* Alarm output *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bAlarmOut				:BOOL;				(* Alarm executed *)
	stAlarmOut				:ST_AlarmProperties;				(* Alarm output *)
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Check method enabled *)
IF NOT bEnable
THEN
	RETURN;
END_IF;

IF bReset
THEN
	IF stAlarmOut.bActive
	THEN
		stAlarmOut.bActive := FALSE;
		(*stAlarmOut.enType := ET_AlarmType_eIdle;*)
		(*stAlarmOut.dtDateTime := DT#1970-01-01-00:00;*)
		(*stAlarmOut.dnCode := 0;*)
	END_IF;
	
ELSE
	IF stAlarmIn.bActive
	    AND NOT stAlarmOut.bActive
	THEN
		stAlarmOut.bActive := TRUE;
		stAlarmOut.enType := stAlarmIn.enType;
		stAlarmOut.dtDateTime := stAlarmIn.dtDateTime;
		stAlarmOut.dnCode := stAlarmIn.dnCode;
	END_IF;
	
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_Warning">
      <LineId Id="27" Count="26" />
    </LineIds>
  </POU>
</TcPlcObject>