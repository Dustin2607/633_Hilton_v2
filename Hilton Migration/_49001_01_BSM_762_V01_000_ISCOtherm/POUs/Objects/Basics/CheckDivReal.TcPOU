  <POU Name="CheckDivReal" Id="{e6d67e03-deaa-4fab-abbf-fb647249295e}" SpecialFunc="CheckDivReal32">
    <Declaration><![CDATA[FUNCTION CheckDivReal : REAL
VAR_INPUT
	divisor: REAL;
END_VAR
VAR_EXTERNAL
	fbCheckDivRealInfo: FB_CheckDivRealInfo;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*This function checks if a division by zero is performed*)

