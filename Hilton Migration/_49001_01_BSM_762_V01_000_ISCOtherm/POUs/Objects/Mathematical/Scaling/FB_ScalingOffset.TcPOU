<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ScalingOffset" Id="{d189bebc-1007-482b-9811-63ea5e69dc4e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ScalingOffset
(*

The function block used to scaling input signal.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			04.08.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable							:BOOL;						(* Function block enable *)
	lrInput							:LREAL;						(* Input scaling proces value *)
	lrXLowLimit						:LREAL;						(* Upper limit of X range *)
	lrXUpperLimit						:LREAL; 						(*Upper limit of X range  *)
	lrYLowLimit						:LREAL; 						(* Low limit of Y range  *)
	lrYUpperLimit						:LREAL; 						(* Upper limit of Y range  *)
	usiPrecision						:USINT := 2; 					(* The number of digits after the decimal point depends on the requested precision *)
	lrOffset							:LREAL;						(* Offset of output *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	lrOutputRV						:LREAL;						(* Raw Value *)
	lrOutputPV						:LREAL;						(* Judgment Value  *)
END_VAR
VAR
	(* Instances / Instanzen *)
	fbScaling						:FB_Scaling;

	(* Enumerator  *)

	(* General flags / Allgemeine Variablen *)

END_VAR
VAR CONSTANT

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable THEN
	fbScaling(
		bEnable := FALSE,
	);

	lrOutputRV := 0.0;					(* Raw Value *)
	lrOutputPV := 0.0;					(* Judgment Value *)
	RETURN;
END_IF

(* Scaling *)

fbScaling(
	bEnable := TRUE,
	lrInput := lrInput,
	lrXLowLimit := lrXLowLimit,
	lrXUpperLimit := lrXUpperLimit,
	lrYLowLimit := lrYLowLimit,
	lrYUpperLimit := lrYUpperLimit,
	usiPrecision := usiPrecision
);

lrOutputRV := fbScaling.lrOutputRV + lrOffset;
lrOutputPV := fbScaling.lrOutputPV + lrOffset;
]]></ST>
    </Implementation>
    <LineIds Name="FB_ScalingOffset">
      <LineId Id="42" Count="24" />
    </LineIds>
  </POU>
</TcPlcObject>