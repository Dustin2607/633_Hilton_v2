<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_VFD_Reset" Id="{ca4bab1b-c4c1-4c45-b239-e9e43db9e8f2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_VFD_Reset
(*

The function block used to reset drive

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			14.06.2018
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;		(* Execut the function block *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Program done. *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_VFD_AXIS_REF;			(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute
           		    AND Axis.bError );       (* Error *)

IF Axis.bFaultReset
THEN
	bBusy := FALSE;
	Axis.bFaultReset := FALSE;
END_IF;

IF rtExecute.Q
THEN
	bBusy := TRUE;
	Axis.bFaultReset := TRUE;
END_IF;

bDone := bExecute
		AND NOT bBusy
		AND NOT Axis.bError;       (* Error *)]]></ST>
    </Implementation>
    <LineIds Name="FB_VFD_Reset">
      <LineId Id="41" Count="18" />
    </LineIds>
  </POU>
</TcPlcObject>