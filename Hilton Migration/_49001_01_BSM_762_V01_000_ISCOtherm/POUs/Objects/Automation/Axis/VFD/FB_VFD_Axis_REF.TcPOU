	bEnabled						:BOOL;			(* The drive is enabled. *)
	bOperational						:BOOL;			(* The drive is ready for operation. *)
	bError							:BOOL;			(* The drive state is fault. *)
	bNotMoving						:BOOL;			(* Motor not moving *)
	bMotorSpeedReached				:BOOL;			(* Motor speed reached *)
	nCurrentMotorSpeed				:INT;			(* Current motor speed *)

	bEnable							:BOOL;			(* Enable controller *)
	bFaultReset						:BOOL;			(* Acknowledgment for faults of the device state machine. *)
	bForwardStop					:BOOL;			(* Counterclockwise rotation moving. *)
	bReverseStop					:BOOL;			(* Clockwise rotation moving. *)
	bJog							:BOOL;			(* Jog command. *)
	bExtError							:BOOL;			(* External error signal. *)
	nSetMotorSpeed					:INT;			(* Relative speed reference value *)
	bReserve1						:BOOL;			(* Reserve 1. *)
	bReserve2						:BOOL;			(* Reserve 2. *)

	nOverride						:INT;			(* Override *)
	bHasJob						:BOOL;			(* Job is busy *)
END_VAR
VAR_OUTPUT

END_VAR
VAR_IN_OUT

END_VAR
VAR

END_VAR]]></Declaration>
