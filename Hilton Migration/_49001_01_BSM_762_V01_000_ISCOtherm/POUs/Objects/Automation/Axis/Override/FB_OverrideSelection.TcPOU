<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_OverrideSelection" Id="{53bd7ef3-b505-4c98-883c-497b5f822c43}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OverrideSelection
(*

The function block used to select override of axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	rGlobalOverride				:REAL;						(* Global override *)
	rAcc							:REAL;						(* Accerlation of Override [%/s] *)
	rDec						:REAL;						(* Decerlation of Override [%/s] *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	rActOverride					:REAL;						(* Actual override *)
	bActGlobalOverride			:BOOL;						(* Actual override is global *)
	bActLocalOverride			:BOOL;						(* Actual override is local *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	rLocalOverride				:REAL;						(* Actual override *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	rCacheGlobalOverride			:REAL;						(* Caches global override *)
	rCacheLocalOverride			:REAL;						(* Caches local override *)

	bFirstTime					:BOOL;						(* First run *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	tonChkCycleTime				:TON;						(* Check cycle time *)
END_VAR
VAR CONSTANT

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable
THEN
	bFirstTime := FALSE;                               		(* Firstrun *)
	rActOverride := 0.0;                               		(* Override to set *)
	bActGlobalOverride := FALSE;                       	(* Actual override is global *)
	bActLocalOverride := FALSE;                       	(* Actual override is local *)
	RETURN;
END_IF;

IF NOT bFirstTime
THEN
	rCacheGlobalOverride := rGlobalOverride;          	(* Cache values *)
	rCacheLocalOverride := rLocalOverride;            		(* Cache values *)
	bActGlobalOverride := TRUE;                        			(* Actual override is global *)
	bActLocalOverride := FALSE;                       			(* Actual override is local *)
	bFirstTime := TRUE;                                				(* Firstrun *)
END_IF;

A_SelectLocal();
A_SelectGlobal();

]]></ST>
    </Implementation>
    <Action Name="A_SelectGlobal" Id="{54f3c3f9-d5cb-438a-89da-be732661d084}">
      <Implementation>
        <ST><![CDATA[
IF rCacheGlobalOverride <> rGlobalOverride
    OR rLocalOverride >= rGlobalOverride
THEN
	rCacheGlobalOverride := rGlobalOverride;
	rActOverride := rGlobalOverride;
	bActGlobalOverride := TRUE;                       	 		(* Actual override is global *)
	bActLocalOverride := FALSE;                        			(* Actual override is local *)
	rLocalOverride := rGlobalOverride;                		(* Set local Override *)
	rCacheLocalOverride := rGlobalOverride;           		(* Set local Override *)
END_IF;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SelectLocal" Id="{c60e2f13-46f4-4723-9010-9efc80dbdd05}">
      <Implementation>
        <ST><![CDATA[
IF rCacheLocalOverride <> rLocalOverride
    AND rLocalOverride < rGlobalOverride
THEN
	rCacheLocalOverride := rLocalOverride;
	rActOverride := rLocalOverride;
	bActGlobalOverride := FALSE;                       			(* Actual override is global *)
	bActLocalOverride := TRUE;                        			(* Actual override is local *)
END_IF;]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_OverrideSelection">
      <LineId Id="50" Count="22" />
    </LineIds>
    <LineIds Name="FB_OverrideSelection.A_SelectGlobal">
      <LineId Id="0" Count="10" />
    </LineIds>
    <LineIds Name="FB_OverrideSelection.A_SelectLocal">
      <LineId Id="0" Count="8" />
    </LineIds>
  </POU>
</TcPlcObject>