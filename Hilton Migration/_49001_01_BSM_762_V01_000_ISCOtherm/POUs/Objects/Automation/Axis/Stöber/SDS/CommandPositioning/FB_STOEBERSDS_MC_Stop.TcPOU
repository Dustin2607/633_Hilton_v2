<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_MC_Stop" Id="{661688c3-e33a-49c3-8dbe-1ce90e833a8c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_MC_Stop
(*

The function block used to control motion stop and transfers the axis to the state "Stopping". It aborts any ongoing function block execution. 
With the Done output set, the state is transferred to the StandStill. While the axis is in state Stopping, no other FB can perform any motion on the same axis.
Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execut the function block *)
	lrDeceleration				:LREAL;			(* Value of the deceleration (always positive) *)
	lrJerk						:LREAL;			(* Value of the jerk (always positive). *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Program done *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)
	etMC_States					:ET_MC_States := ET_MC_States_eInit;

	(* Variables *)
	nWatchdog					:INT;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);

IF rtExecute.Q
THEN
	etMC_States := ET_MC_States_eInit;                      (* Next step *)
END_IF;

CASE etMC_States OF

	ET_MC_States_eInit:
		bBusy := FALSE;			(* Program not busy *)
		bError := FALSE;                  	(* Program not error *)
		udnErrorNo := 0;			(* Error number *)

		IF rtExecute.Q
		THEN
			nWatchdog := 0;
			bDone := FALSE;			(* Program done, in position *)
			bBusy := TRUE;			(* Program busy *)

			Axis.bLockPDO := TRUE;

			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.nVeloFactor := 0;                                                     								(* Value of velocity *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnAccFactor := 0;                                                    					     			(* Value of the acceleration (always positive) *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnDccFaktor := LREAL_TO_USINT(ABS(lrDeceleration * 2.55));			(* Value of deceleration (always positive) *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnJerkFaktor := LREAL_TO_USINT(ABS(lrJerk * 2.55));			(* Value of the jerk (always positive) *)

			IF Axis.stNcToPlc.stBaseDevice.bEnabled							(* Control enabled*)
			     AND NOT Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenStandstill			(* Axis running *)
			THEN
				Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 224;			(* Reset MC modes staus *)
				Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;                                               						(* Reset MC_Stop execute *)

				Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;			(* Reset Toggle bit *)
				
				etMC_States := ET_MC_States_eReset;        			 (* Next step *)

			ELSE
				etMC_States := ET_MC_States_eDone;          			(* Next step *)
			
			END_IF;
	END_IF;

	ET_MC_States_eReset:
		nWatchdog := nWatchdog + 1;

		IF NOT Axis.stNcToPlc.stBaseDevice.bToggleBit			(* Ack Toggle bit *)
		THEN
			nWatchdog := 0;
			etMC_States := ET_MC_States_eRunning;			(* Next step *)
		
		ELSIF nWatchdog > 150
		THEN
			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eRunning:
		nWatchdog := nWatchdog + 1;

		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd OR 5;			(* Set MC_Stop *)
		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := TRUE;                                                     					(* Set MC_Stop execute *)

		Axis.stPlcToNc.stBaseDevice.bToggleBit := TRUE;     												(* Set Toggle bit *)

		IF Axis.stNcToPlc.stBaseDevice.bToggleBit			 					(* Ack Toggle bit *)
		     AND (Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 31) = 5			(* Ack MC_Stop *)
		     AND Axis.stNcToPlc.stBaseDevice.bAxisActive        						(* Axis active *)
		THEN
			Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;			(* Reset Toggle bit *)

			nWatchdog := 0;
			etMC_States := ET_MC_States_eWaiting;           			(* Next step *)
		
		ELSIF Axis.stNcToPlc.stBaseDevice.bError         					(* Error *)
			   OR nWatchdog > 150
		THEN
			Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;			(* Reset Toggle bit *)

			udnErrorNo := 2;                    							(* Error number *)
		
			etMC_States := ET_MC_States_eError;             			(* Next step *)
		END_IF;

	ET_MC_States_eAbort:
		IF Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdAborted			(* Aborted *)
		THEN
			etMC_States := ET_MC_States_eWaiting;           			(* Next step *)

		ELSIF Axis.stNcToPlc.stBaseDevice.bError						(* Error *)
		THEN
			udnErrorNo := 3;									(* Error number *)
		
			etMC_States := ET_MC_States_eError;				(* Next step *)
		END_IF;

	ET_MC_States_eWaiting:
		nWatchdog := nWatchdog + 1;

		IF Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdDone				(* Command done *)
		     OR Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdAborted			(* Aborted *)
		     OR NOT Axis.stNcToPlc.stBaseDevice.bEnabled					(* Control enabled *)
		     OR  (Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 31) = 5			(* Ack MC_Stop *)
		THEN
			etMC_States := ET_MC_States_eDone;             			(* Next step *)
		
		ELSIF Axis.stNcToPlc.stBaseDevice.bError						(* Error *)
			   OR nWatchdog > 150
		THEN
			udnErrorNo := 3;                    							(* Error number *)
		
			etMC_States := ET_MC_States_eError;             			(* Next step *)
		END_IF;

	ET_MC_States_eDone:
		nWatchdog := 0;
		bDone := TRUE;			(* Program done, in position *)
		bBusy := FALSE;                       (* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;			(* Next step *)

	ET_MC_States_eError:
		nWatchdog := 0;
		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;			(* Reset MC_Stop execute *)
		bDone := FALSE;                                     						(* Program done, in position *)
		bError := TRUE;                          							(* Program error *)
		bBusy := FALSE;                                    						(* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;			(* Next step *)


	ET_MC_States_eNotExecute:
		IF NOT bExecute
		THEN
			nWatchdog := 0;
			Axis.bLockPDO := FALSE;

			bDone := FALSE;			(* Program done, in position *)
			bBusy := FALSE;                       (* Program not busy *)
			bError := FALSE;			(* Program not error *)
			udnErrorNo := 0;			(* Error number *)
			
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 224;			(* Reset MC modes staus *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;											(* Reset MC_Stop execute *)

			etMC_States := ET_MC_States_eInit;              (* Next step *)
		
		END_IF;
END_CASE;]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSDS_MC_Stop">
      <LineId Id="45" Count="148" />
    </LineIds>
  </POU>
</TcPlcObject>