<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_MC_AxisController" Id="{508d2344-dd3b-4cd7-9a15-f8e2768923ed}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_MC_AxisController
(*

The function block used to control axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bRegulatorOn				:BOOL;						(* Enable the power stage *)
	bReset						:BOOL;						(* Signal reset *)
	bCMDInterrupt				:BOOL;						(* Signal interrupt *)
	bTerminalOK					:BOOL;						(* Terminal Ok *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	bExeGearIn					:BOOL;						(* Execute gear in *)
	bExeGearOut					:BOOL;						(* Execute gear out *)
	dnRatioNumerator				:DINT;						(* Gear ratio numerator. Alternatively, the gear ratio can be specified in the numerator as a floating comma value, if the denominator is 1. *)
	udnRatioDenominator			:UDINT;						(* Gear ratio denominator *)
	lrOverride					:LREAL;						(* Override 100% percent *)
	lrEngineTorque				:LREAL;						(* Engine torque 100% percent  *)
	bWithAbsoluteEncoder			:BOOL; 						(* Encoder is an absolute one / Absolutwertgeber *)
	bHWSignalLimitMax			:BOOL;						(* Signal position limit switch maximum *)
	bHWSignalLimitMin			:BOOL;						(* Signal position limit switch minimum *)
	lrSoftLimitMax					:LREAL; 						(* Position limit switch maximum *)
	lrSoftLimitMin					:LREAL; 						(* Position limit switch minimum *)
	lrAcceleration					:LREAL;						(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;						(* Value of jerk (always positive) *)
	tTimeOut 					:TIME := t#2s;					(* Timout for ads commands *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bStatus						:BOOL;						(* Feedback *)
	bStatusDelay					:BOOL;						(* Feedback delay *)
	bReseted					:BOOL;						(* Reset completed *)
	bError						:BOOL;						(* Controller error *)
	bErrorInit						:BOOL;						(* Controller initialization error *)
	udnErrorNo					:UDINT;						(* Error number *)
	byPLCOpenErrCode			:BYTE;						(* Error code PLCOpen-State *)
	lrActPos						:LREAL;						(* Actual position *)
	lrActVelo						:LREAL;						(* Actual velocity *)
	nTorqueLimit					:INT;						(* The torque limit *)
	nActEngineTorque			:INT;						(* Actual engine torque *)
	bNotMoving					:BOOL;						(* Status of moving *)
	bReferenced					:BOOL;						(* Referenced *)
	bCoupled					:BOOL;						(* Coupled *)
	bHardLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bHardLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
	bSoftLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bSoftLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
END_VAR
VAR_IN_OUT
	Axis							:ST_AXIS_REF;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	etAxisGetLimits				:ET_STOEBER_AxisGetLimits;
	bGetLimitsExe				:BOOL;						(* Progam execute *)
	bGetLimitsDone 				:BOOL;                     			 	(* Program done *)
	bGetLimitsBusy 				:BOOL;                   				(* Program busy *)
	bGetLimitsError 				:BOOL;                      				(* Program error *)
	bGetLimitsInitDone 			:BOOL;                     				(* Program initialization done *)
	udnGetLimitsErrorNo 			:UDINT;                    				(* Error number *)
	unGetValueWatchdog			:UINT;
	dwGetValue					:DWORD;

	etAxisSetLimits				:ET_STOEBER_AxisSetLimits;
	bSetLimitsExe				:BOOL;						(* Progam execute *)
	bSetLimitsDone 				:BOOL;                      				(* Program done *)
	bSetLimitsBusy 				:BOOL;                      				(* Program busy *)
	bSetLimitsError 				:BOOL;                      				(* Program error *)
	bSetLimitsInitDone 			:BOOL;                      				(* Program initialization done *)
	bSetLimitsInitError 				:BOOL;                      				(* Program initialization error *)
	udnSetLimitsErrorNo 			:UDINT;                    				(* Error number *)
	unSetValueWatchdog			:UINT;
	dnSoftLimitMax				:DINT; 						(* Position limit switch maximum *)
	dnSoftLimitMin				:DINT; 						(* Position limit switch minimum *)

	tStatusDelay					:TIME := t#1s;					(* Status delay time *)
	tRegulatorOffDelay			:TIME := t#50ms;				(* Regulator off delay time *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbPower						:FB_STOEBERSDS_MC_Power;		(* The function block is used to enable for an axis *)
	tonStatusDelay				:TON;						(* Delay controller enabled status *)
	fbReset						:FB_STOEBERSDS_MC_Reset;		(* An axis reset is carried out with the function block *)
	fbGearIn						:FB_STOEBERSDS_MC_GearIn;
	fbGearOut					:FB_STOEBERSDS_MC_GearOut;
	fbWriteSDO					:FB_EcCoESdoWrite;
	fbReadSDO					:FB_EcCoESdoRead;
	tonFirstInit					:TON;						(* First initialization *)
	tofRepeateSetLimitsInit			:TOF;
	tofRepeateGetLimitsInit			:TOF;
END_VAR
VAR CONSTANT
	tFirstInit						:TIME := T#2S;				(* First initialization *)
	tRepeateInit					:TIME := T#1S;				(* Repeate initialization *)
	
	unWatchdogMax				:UINT := 150;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable							(* Signal FB enable *)
THEN
	bStatus := FALSE;						(* Feedback *)
	bStatusDelay := FALSE;				(* Feedback *)
	bError := FALSE;						(* Controller error *)
	udnErrorNo := 0;						(* Error number *)

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	tonFirstInit(IN := FALSE);					(* Program execute *)
	bGetLimitsDone := FALSE;                                	(* Program done *)
	bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bGetLimitsError := FALSE;                                 	(* Program not error *)
	bGetLimitsInitDone := FALSE;				(* Program initialization done *)
	udnGetLimitsErrorNo := 0;                                 		(* Error number *)
	unGetValueWatchdog := 0;

	etAxisGetLimits := ET_STOEBER_AxisGetLimits_eWaitExecute;       			(* Next step *)

	bSetLimitsExe := FALSE;					(* Program execute *)
	bSetLimitsDone := FALSE;                                	(* Program done *)
	bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bSetLimitsError := FALSE;                                	 	(* Program not error *)
	bSetLimitsInitDone := FALSE;                            	(* Program initialization done *)
	bSetLimitsInitError := FALSE;				(* Program initialization error *)
	udnSetLimitsErrorNo := 0;                                 		(* Error number *)
	unSetValueWatchdog := 0;

	etAxisSetLimits := ET_STOEBER_AxisSetLimits_eWaitExecute;       			(* Next step *)

	bFirstTime := TRUE;
END_IF;

A_MCPower();
A_MCReset();
A_MCGearCoupling();
A_GetLimits();
A_SetLimits();
A_Error();

(* Actual position *)
lrActPos := DINT_TO_LREAL(Axis.stNcToPlc.stBaseDevice.stCommandPositioning.dnActPosition) / (EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits));
lrActPos := F_LRealRound(lrReal := lrActPos, usiPrecision := 2);

(* Actual velocity *)
lrActVelo := DINT_TO_LREAL(Axis.stNcToPlc.stBaseDevice.stCommandPositioning.dnActVelocity) / (EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits));
lrActVelo := F_LRealRound(lrReal := lrActVelo, usiPrecision := 3);

(* Current engine torque *)
nActEngineTorque := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.nActEngineTorque;

(* Reference signal *)
bReferenced := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bHomed
			   OR bWithAbsoluteEncoder;

(* Status not moving *)
bNotMoving := NOT Axis.stNcToPlc.stBaseDevice.bEnabled                           		(* Control enabled *)
			  OR NOT Axis.stNcToPlc.stBaseDevice.bAxisActive                   	(* An axis is not active. *)
			  OR Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenStandstill;			(* Axis standstill *)

(* Status coupling *)
bCoupled := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bCoupled;                        (* In gear  *)

(* Error Code PLCOpen-State *)
byPLCOpenErrCode := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.byPLCOpenErrorCode;





               
]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{e0ac803a-7a6f-4dfc-9507-4dc4e1f71b05}">
      <Implementation>
        <ST><![CDATA[
bError := fbReset.bError
	         OR fbPower.bError
            	OR fbGearIn.bError
            	OR fbGearOut.bError;

bErrorInit := bGetLimitsError
		      OR bSetLimitsError;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_GetLimits" Id="{62bf4140-f8f8-49eb-9214-fc9f8aaa27b4}">
      <Implementation>
        <ST><![CDATA[
(* Status hardware limit switch *)
bHardLimitMaxExceeded := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bLimitMaxExceeded;						(* Position limit switch maximum is exceeded *)
bHardLimitMinExceeded := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bLimitMinExceeded;						(* Position limit switch minimum is exceeded *)

(* Status software limit switch *)
bSoftLimitMaxExceeded := lrActPos >= lrSoftLimitMax AND bReferenced AND lrSoftLimitMax <> lrSoftLimitMin;		(* Position limit switch maximum is exceeded *)
bSoftLimitMinExceeded := lrActPos <= lrSoftLimitMin AND bReferenced AND lrSoftLimitMax <> lrSoftLimitMin;			(* Position limit switch minimum is exceeded *)

(* Get limits execute *)
tofRepeateGetLimitsInit(
	IN := bGetLimitsError,
	PT := tRepeateInit
);

tonFirstInit(
	IN:= bTerminalOK
		 AND NOT bGetLimitsInitDone,
	PT := tFirstInit
);

(* Get limits execute *)
bGetLimitsExe := (tonFirstInit.Q
				  OR bGetLimitsInitDone)
				  AND NOT tofRepeateGetLimitsInit.Q;

(* Get axis limits *)
CASE etAxisGetLimits OF

	ET_STOEBER_AxisGetLimits_eWaitExecute:
		IF bGetLimitsExe
		   AND bTerminalOK
		THEN
			bGetLimitsDone := FALSE;                                	(* Program done *)
			bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bGetLimitsError := FALSE;                                 	(* Program not error *)

			fbReadSDO(
				bExecute := FALSE
			);
	
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eDecimalDigits;         		(* Next step *)

		END_IF
	ET_STOEBER_AxisGetLimits_eDecimalDigits:

		(* Read decimal digits I06 *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#3006,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 1;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits := DWORD_TO_REAL(dwGetValue);

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eScalingDenom;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eScalingDenom:

		(* Read effective distance per rev. Denominator [INC] - I254 *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#30FE,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 2;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			Axis.stNcToPlc.stBaseDevice.stCommandPositioning.udnScalingDenom := dwGetValue;			(* Effective distance per rev. Denominator [INC] - I254 = e.g 16384 *)

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eScalingNum;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eScalingNum:

		(* Read effective distance per rev. Numerator [technical units]: The factor indicates the distance per one increment of position control. - I253 = e.g 176.0 / 7.0 (* I07 / I08 *) *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#30FD,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 3;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			Axis.stNcToPlc.stBaseDevice.stCommandPositioning.lrScalingNum := DWORD_TO_LREAL(dwGetValue)			(* Effective distance per rev. Numerator [technical units]: The factor indicates the distance per one increment of position control. - I253 = e.g 176.0 / 7.0 (* I07 / I08 *) *)
																		/ EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits);

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eDone;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eDone:
		bGetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := TRUE;                             		(* Program initialization done *)

		etAxisGetLimits := ET_STOEBER_AxisGetLimits_eNoExecute;            	(* Next step *)

	ET_STOEBER_AxisGetLimits_eError:
		bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bGetLimitsError := TRUE;                                     		(* Program error *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := FALSE;                             		(* Program initialization done *)

		etAxisGetLimits := ET_STOEBER_AxisGetLimits_eNoExecute;           	(* Next step *)

	ET_STOEBER_AxisGetLimits_eNoExecute:
		IF NOT bGetLimitsExe
		THEN
			bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bGetLimitsError := FALSE;                                     		(* Program error *)
			bGetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eWaitExecute;       (* Next step *)
		END_IF
END_CASE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCGearCoupling" Id="{7c27bbeb-11e2-4d86-803e-3c2ed3ef0534}">
      <Implementation>
        <ST><![CDATA[
IF NOT bCMDInterrupt
THEN
	(* The function block MC_GearIn used to coupling with ratio between the velocity of the slave and master axis  *)
	fbGearIn(
		bExecute := bExeGearIn,
		dnRatioNumerator := dnRatioNumerator,
		udnRatioDenominator := udnRatioDenominator,
		lrAcceleration := lrAcceleration,
		lrDeceleration := lrDeceleration,
		lrJerk := lrJerk,
		Axis := Axis
	);
	
	(* The function block MC_GearOut used to decoupling the Slave from the Master axis.  *)
	fbGearOut(
		bExecute := bExeGearOut,
		Axis := Axis
	);

	(* Weiter für die GearIn und GearOut entwickeln*)
	Axis.bCmdInterrupted := FALSE;

ELSE
	(* The function block MC_GearIn used to coupling with ratio between the velocity of the slave and master axis  *)
	fbGearIn(
		bExecute := FALSE,
		Axis := Axis
	);

	(* The function block MC_GearOut used to decoupling the Slave from the Master axis.  *)
	fbGearOut(
		bExecute := FALSE,
		Axis := Axis
	);

	Axis.bCmdInterrupted := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCPower" Id="{13d7cb3a-62b0-4bf4-822e-767ec17e7ef0}">
      <Implementation>
        <ST><![CDATA[
fbPower(
	bEnable := TRUE,
   	bRegulatorOn := bRegulatorOn,
	bEnablePositive := NOT bHWSignalLimitMax,                         			(* HW limit switch maximum *)
	bEnableNegative := NOT bHWSignalLimitMin,                         			(* HW limit switch minimum *)
	lrOverride := lrOverride,
	Axis:= Axis,
	bStatus => bStatus,
);

tonStatusDelay(
	IN := fbPower.bStatus,
	PT := SEL(etMachineMode = ET_MachineMode_eManual, tStatusDelay, t#0ms),
	Q => bStatusDelay
);

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCReset" Id="{24a9f92b-1407-4770-82a8-0b6dddcafae7}">
      <Implementation>
        <ST><![CDATA[
fbReset(
	bExecute := bReset
	            	     XOR bExeReset,
	Axis := Axis,
	bDone => bReseted
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SetLimits" Id="{159f002a-9e7c-4619-8202-d59bb620b3d5}">
      <Implementation>
        <ST><![CDATA[
(* Reference engine torque *)
Axis.stPlcToNc.stBaseDevice.nTorqueLimit := LREAL_TO_INT((lrEngineTorque * 32767) / 200);                    (* The torque limit (absolute value). Value range in %: -200 ... 200 ... 200 *)
nTorqueLimit := Axis.stPlcToNc.stBaseDevice.nTorqueLimit;


bSetLimitsExe := bTerminalOK
			     AND bGetLimitsInitDone
			     AND SEL(
						bSetLimitsInitDone,
						NOT bSetLimitsInitError,
						NOT bSetLimitsInitError
					      		 AND (dnSoftLimitMax <> REAL_TO_DINT(lrSoftLimitMax * EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits))
								    OR dnSoftLimitMin <> REAL_TO_DINT(lrSoftLimitMin * EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits))));

(* Set axis limits *)
CASE etAxisSetLimits OF

	ET_STOEBER_AxisSetLimits_eWaitExecute:
		IF bSetLimitsExe
		    AND bTerminalOK
		    AND bGetLimitsDone
		THEN
			unSetValueWatchdog := 0;
			bSetLimitsDone := FALSE;                                	(* Program done *)
			bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bSetLimitsError := FALSE;                                	 	(* Program not error *)
			udnSetLimitsErrorNo := 0;

			fbWriteSDO(
				bExecute := FALSE
			);

			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetLimitPos;         		(* Next step *)

		END_IF;

	ET_STOEBER_AxisSetLimits_eSetLimitPos:
		dnSoftLimitMax := REAL_TO_DINT(lrSoftLimitMax * EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits));

		(* Write software limit maximum I50 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#3032,                                             (* Index of object *)
			pSrcBuf := ADR(dnSoftLimitMax),
			cbBufLen := SIZEOF(dnSoftLimitMax),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			udnSetLimitsErrorNo := 1;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetLimitNeg;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eSetLimitNeg:
		dnSoftLimitMin := REAL_TO_DINT(lrSoftLimitMin * EXPT(10, Axis.stNcToPlc.stBaseDevice.stCommandPositioning.rDecimalDigits));

		(* Write software limit minimum I51 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#3033,                                             (* Index of object *)
			pSrcBuf := ADR(dnSoftLimitMin),
			cbBufLen := SIZEOF(dnSoftLimitMin),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			udnSetLimitsErrorNo := 2;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eDone;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eDone:
		bSetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := TRUE;                             		(* Program initialization done *)

		etAxisSetLimits := ET_STOEBER_AxisSetLimits_eNoExecute;            	(* Next step *)

	ET_STOEBER_AxisSetLimits_eError:
		bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bSetLimitsError := TRUE;                                     		(* Program error *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := FALSE;                             		(* Program initialization done *)

		etAxisSetLimits := ET_STOEBER_AxisSetLimits_eNoExecute;           	(* Next step *)

	ET_STOEBER_AxisSetLimits_eNoExecute:
		IF NOT bSetLimitsExe
		THEN
			bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bSetLimitsError := FALSE;                                     		(* Program error *)
			bSetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eWaitExecute;       (* Next step *)
		END_IF;

END_CASE;]]></ST>
      </Implementation>
    </Action>
