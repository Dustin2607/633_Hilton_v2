<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_MC_GearIn" Id="{f582724e-a87c-4cc4-aef9-70ef6eb86c7c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_MC_GearIn
(*

The function block used to coupling with ratio between the velocity of the slave and master axis 

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execut the function block *)
	dnRatioNumerator 			:DINT;			(* Gear ratio numerator. Alternatively, the gear ratio can be specified in the numerator as a floating comma value, if the denominator is 1. *)
	udnRatioDenominator			:UDINT;			(* Gear ratio denominator *)
	lrAcceleration					:LREAL;			(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;			(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;			(* Value of the jerk (always positive). *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bInGear						:BOOL;			(* Commanded gearing completed *)
	bCmdAborted				:BOOL;			(* Command aborted *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)
	etMC_States					:ET_MC_States := ET_MC_States_eInit;

	(* Variables *)
	dwValue						:DWORD;
	nEcCoESdoWrite				:INT;
	nWatchdog					:INT;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbWriteSDO					:FB_EcCoESdoWrite;
	fbReadSDO					:FB_EcCoESdoRead;
	rtExecute						:R_TRIG;
	rtAborted						:R_TRIG;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);
rtAborted(CLK := Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdAborted);			(* Aborted *)

IF rtAborted.Q                                             									(* Aborted *)
THEN
	etMC_States := ET_MC_States_eAbort;                   					 (* Next step *)

ELSIF rtExecute.Q
	    AND NOT bCmdAborted
THEN
	etMC_States := ET_MC_States_eInit;                      						(* Next step *)

END_IF;

CASE etMC_States OF

	ET_MC_States_eInit:
		bCmdAborted := FALSE;			(* Command not aborted *)
		bBusy := FALSE;                                     	(* Program not busy *)
		bError := FALSE;                         		(* Program not error *)
		udnErrorNo := 0;                         		(* Error number *)

		IF rtExecute.Q
		     AND NOT Axis.bLockPDO
		THEN
			nWatchdog := 0;
			bInGear := FALSE;                               	(* Target not in gear *)
			bBusy := TRUE;                                  	(* Program busy *)

			Axis.bLockPDO := TRUE;
			nEcCoESdoWrite := 1;

			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnAccFactor := LREAL_TO_USINT(ABS(lrAcceleration * 2.55));           			(* Value of the acceleration (always positive) *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnDccFaktor := LREAL_TO_USINT(ABS(lrDeceleration * 2.55));         			(* Value of the deceleration (always positive) *)
			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.usnJerkFaktor := LREAL_TO_USINT(ABS(lrJerk * 2.55));			(* Value of the jerk (always positive) *)

			(* Write SDO *)
			fbWriteSDO(
				sNetId := Axis.sAdsAddr,
				nSlaveAddr := Axis.unSlaveAddr,
				bExecute := FALSE,
				tTimeout := DEFAULT_ADS_TIMEOUT
			);

			(* Read SDO *)
			fbReadSDO(
				sNetId := Axis.sAdsAddr,
				nSlaveAddr := Axis.unSlaveAddr,
				bExecute := FALSE,
				tTimeout := DEFAULT_ADS_TIMEOUT
			);

			IF Axis.stNcToPlc.stBaseDevice.bEnabled   			(* Control enabled *)
			     AND Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bHomed          	(* Axis in reference *)
			THEN
				Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 224;				(* Reset MC modes staus *)
				Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;                                                 						(* Reset MC_GearIn execute *)

				Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;    (* Reset toggle bit *)

                			etMC_States := ET_MC_States_eReset;         (* Next step *)
		                
			ELSE
				udnErrorNo := 4;                     (* Error number *)

				etMC_States := ET_MC_States_eError;             (* Next step *)
		                
			END_IF;
		END_IF;
        
	ET_MC_States_eReset:
		nWatchdog := nWatchdog + 1;

		CASE nEcCoESdoWrite OF

				1:	(* Write Gear ratio dnG21_Master_Drehzahl *)
					fbWriteSDO(
						sNetId := Axis.sAdsAddr,
						nSlaveAddr := Axis.unSlaveAddr,
						nSubIndex := 0,			(* Subindex of object *)
						nIndex := 16#2C15,                                             (* Index of object *)
						pSrcBuf := ADR(dnRatioNumerator),
						cbBufLen := SIZEOF(dnRatioNumerator),
						bExecute := TRUE,
						tTimeout := DEFAULT_ADS_TIMEOUT
					);

					IF (NOT fbWriteSDO.bBusy
					     AND fbWriteSDO.bError)
					     OR nWatchdog > 1000
					THEN
						fbWriteSDO(bExecute := FALSE);

						udnErrorNo := 6;                     (* Error number *)

						etMC_States := ET_MC_States_eError;              (* Next step *)

					ELSIF NOT fbWriteSDO.bBusy
						   AND NOT fbWriteSDO.bError
					THEN
						nWatchdog := 0;

						fbWriteSDO(bExecute := FALSE);
		
						nEcCoESdoWrite := nEcCoESdoWrite + 1;

					END_IF;

				2:	(* Write Gear ratio udnG22_Slave_Drehzahl *)
					fbWriteSDO(
						sNetId := Axis.sAdsAddr,
						nSlaveAddr := Axis.unSlaveAddr,
						nSubIndex := 0,			(* Subindex of object *)
						nIndex := 16#2C16,                                             (* Index of object *)
						pSrcBuf := ADR(udnRatioDenominator),
						cbBufLen := SIZEOF(udnRatioDenominator),
						bExecute := TRUE,
						tTimeout := DEFAULT_ADS_TIMEOUT
					);
		
		
					IF (NOT fbWriteSDO.bBusy
					     AND fbWriteSDO.bError)
					     OR nWatchdog > 1000
					THEN
						fbWriteSDO(bExecute := FALSE);

						udnErrorNo := 7;                     (* Error number *)
					
						etMC_States := ET_MC_States_eError;              (* Next step *)
					
					ELSIF NOT fbWriteSDO.bBusy
						   AND NOT fbWriteSDO.bError
					THEN
						nWatchdog := 0;

						fbWriteSDO(bExecute := FALSE);

						nEcCoESdoWrite := nEcCoESdoWrite + 1;

					END_IF;

				3:
					IF NOT Axis.stNcToPlc.stBaseDevice.bToggleBit        		   	(* Ack Toggle bit *)
					THEN
						nEcCoESdoWrite := 0;
						nWatchdog := 0;
						etMC_States := ET_MC_States_eRunning;			(* Next step *)
			
					END_IF;

		END_CASE

	ET_MC_States_eRunning:
		nWatchdog := nWatchdog + 1;

		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd OR 10;			(* Set MC_GearIn *)
		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := TRUE;                                                    					(* Set MC_GearIn execute *)

		Axis.stPlcToNc.stBaseDevice.bToggleBit := TRUE;     (* Set Toggle bit *)

		IF Axis.stNcToPlc.stBaseDevice.bToggleBit								(* Ack Toggle bit *)
		     AND (Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 31) = 10 			(* Ack MC_GearIn *)
		     AND Axis.stNcToPlc.stBaseDevice.bAxisActive      						(* Axis active *)
		     AND NOT Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenStandstill				(* Axis runnning *)
		     AND NOT Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdAborted			(* Aborted *)
		THEN
			Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;    		(* Reset Toggle bit *)

			nWatchdog := 0;
			etMC_States := ET_MC_States_eWaiting;           (* Next step *)
		
		ELSIF Axis.stNcToPlc.stBaseDevice.bError					(* Error *)
			   OR nWatchdog > 150
		THEN
			Axis.stPlcToNc.stBaseDevice.bToggleBit := FALSE;    		(* Reset Toggle bit *)

			udnErrorNo := 2;                     (* Error number *)

			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eWaiting:
		IF Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bPLCOpenCmdDone       		(* Command done *)
		THEN

			nWatchdog := nWatchdog + 1;

			(* Read usnI192_Synchronlauf dwI192Synchronlauf := 16#0000*)
			fbReadSDO(
				sNetId := Axis.sAdsAddr,
				nSlaveAddr := Axis.unSlaveAddr,
				nSubIndex := 0,			(* Subindex of object *)
				nIndex := 16#30C0,                   (* Index of object *)
				pDstBuf := ADR(dwValue),
				cbBufLen := SIZEOF(dwValue),
				bExecute := TRUE,
				tTimeout := DEFAULT_ADS_TIMEOUT
			);

			IF (NOT fbReadSDO.bBusy
			     AND fbReadSDO.bError)
			     OR nWatchdog > 150
			THEN
				fbReadSDO(bExecute := FALSE);

				udnErrorNo := 5;                     (* Error number *)

				etMC_States := ET_MC_States_eError;              (* Next step *)
			
			ELSIF NOT fbReadSDO.bBusy
				   AND NOT fbReadSDO.bError
			THEN
				IF dwValue.1                         					(* In gear *)
				    AND Axis.stNcToPlc.stBaseDevice.stCommandPositioning.bCoupled
				THEN
					nWatchdog := 0;

					fbReadSDO(bExecute := FALSE);

					etMC_States := ET_MC_States_eDone;              (* Next step *)
				    
				END_IF;
			END_IF;

		ELSIF Axis.stNcToPlc.stBaseDevice.bError					(* Error *)
		THEN
			udnErrorNo := 3;                     (* Error number *)
		
			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eAbort:
		bCmdAborted := TRUE;			(* Command aborted *)
		bInGear := FALSE;                               	(* In Gear cmd aborted *)
		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;         (* Reset MC_GearIn execute *)
	
		 etMC_States := ET_MC_States_eNotExecute;        (* Next step *)

	ET_MC_States_eDone:
		nWatchdog := 0;
		bInGear := dwValue.1;				(* In Gear cmd done *)	(* In gear          stNcToPlc.byI201_Motion_Status_Byte AND 5) = 5 *)
		bBusy := FALSE;                                      	(* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;            (* Next step *)

	ET_MC_States_eError:
		nWatchdog := 0;
 		Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;         (* Reset MC_GearIn execute *)
	         bInGear := FALSE;				(* In Gear cmd error *)
	         bError := TRUE;				(* Program error  *)
	         bBusy := FALSE;				(* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;            (* Next step *)

	ET_MC_States_eNotExecute:
		IF NOT bExecute
		THEN
			nWatchdog := 0;
			Axis.bLockPDO := FALSE;

			bInGear := FALSE;			(* In Gear cmd *)
			bCmdAborted := FALSE;	(* Command not aborted *)
			bBusy := FALSE;                       (* Program not busy *)
			bError := FALSE;                       (* Program not error *)
			udnErrorNo := 0;                        (* Error number *)

			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd := Axis.stPlcToNc.stBaseDevice.stCommandPositioning.byPLCOpenCmd AND 224;			(* Reset MC modes staus *)
 			Axis.stPlcToNc.stBaseDevice.stCommandPositioning.bPLCOpenCmdExe := FALSE;         										(* Reset MC_GearIn execute *)

			etMC_States := ET_MC_States_eInit;              (* Next step *)
		
		END_IF;
END_CASE;
]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSDS_MC_GearIn">
      <LineId Id="55" Count="275" />
    </LineIds>
  </POU>
</TcPlcObject>