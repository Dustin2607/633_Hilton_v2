<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_AxisController" Id="{38642c5c-90b4-46cd-b6fa-dce2f31d10f5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_AxisController
(*

The function block used to control axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bRegulatorOn				:BOOL;						(* Enable the power stage *)
	bReset						:BOOL;						(* Signal reset *)
	bTerminalOK					:BOOL;						(* Terminal Ok *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	dwRawMotorEncoder			:DWORD;					(* The raw value of the motor encoder *)
	lrOverride					:LREAL;						(* Override 100% percent *)
	lrEngineTorque				:LREAL;						(* Engine torque 100% percent  *)
	bWithAbsoluteEncoder			:BOOL; 						(* Encoder is an absolute one / Absolutwertgeber *)
	bHWSignalLimitMax			:BOOL;						(* Signal position limit switch maximum *)
	bHWSignalLimitMin			:BOOL;						(* Signal position limit switch minimum *)
	lrSoftLimitMax					:LREAL; 						(* Position limit switch maximum *)
	lrSoftLimitMin					:LREAL; 						(* Position limit switch minimum *)
	tTimeOut 					:TIME := t#2s;					(* Timout for ads commands *)
	stEncoderConfig				:ST_EncoderConfig;			(* Encoder configuration *)
	pAxis						:POINTER TO ST_AXIS_REF_V2;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bStatus						:BOOL;						(* Feedback *)
	bStatusDelay					:BOOL;						(* Feedback delay *)
	bReseted					:BOOL;						(* Reset completed *)
	bError						:BOOL;						(* Controller error *)
	bErrorInit						:BOOL;						(* Controller initialization error *)
	udnErrorNo					:UDINT;						(* Error number *)
	lrActPos						:LREAL;						(* Actual position *)
	lrActVelo						:LREAL;						(* Actual velocity *)
	bNotMoving					:BOOL;						(* Status of moving *)
	bReferenced					:BOOL;						(* Referenced *)
	bHardLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bHardLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
	bSoftLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bSoftLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
END_VAR
VAR_IN_OUT
	Axis							:ST_AXIS_REF;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	tStatusDelay					:TIME := t#1s;					(* Status delay time *)
	tRegulatorOffDelay			:TIME := t#50ms;				(* Regulator off delay time *)
	nTorqueLimitMin 				:INT := 100;					(* The torque limit *)
	nTorqueLimitMax				:INT := 200;					(* The torque limit (absolute value). Value range in %: -200 ... 200 ... 200 *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbPower						:FB_STOEBERSDS_Power;		(* The function block is used to enable for an axis *)
	tonStatusDelay				:TON;						(* Delay controller enabled status *)
	fbReset						:FB_STOEBERSDS_Reset;			(* An axis reset is carried out with the function block *)
	fbPositionEncoder				:FB_PositionEncoder;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable							(* Signal FB enable *)
THEN
	bStatus := FALSE;						(* Feedback *)
	bStatusDelay := FALSE;				(* Feedback *)
	bError := FALSE;						(* Controller error *)
	udnErrorNo := 0;						(* Error number *)

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

A_MCPower();
A_MCReset();
A_PositionDynamics();
A_GetLimits();
A_SetLimits();
A_Error();

(* Actual position *)
lrActPos := pAxis^.stPosition.lrActPos;
lrActPos := F_LRealRound(lrReal := lrActPos, usiPrecision := 2);

(* Actual velocity *)
lrActVelo := pAxis^.stDynamics.lrActVelo;
lrActVelo := F_LRealRound(lrReal := lrActVelo, usiPrecision := 2);

(* Reference signal *)
bReferenced := bWithAbsoluteEncoder;

(* Status not moving *)
bNotMoving := NOT Axis.stNcToPlc.stBaseDevice.bEnabled                           		(* Control enabled *)
			  OR NOT Axis.stNcToPlc.stBaseDevice.bAxisActive                   	(* An axis is not active. *)
			  OR Axis.stNcToPlc.stBaseDevice.stFastRefereneValue.bStandstill;			(* Axis standstill *)





               
]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{823b0460-8577-466d-a571-6efd94cd5222}">
      <Implementation>
        <ST><![CDATA[
bError := fbReset.bError
	         OR fbPower.bError;

bErrorInit := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_GetLimits" Id="{dfca0875-9bfb-4ca5-93ad-5165c1f12a3d}">
      <Implementation>
        <ST><![CDATA[
(* Status hardware limit switch *)
bHardLimitMaxExceeded := bHWSignalLimitMax;						(* Position limit switch maximum is exceeded *)
bHardLimitMinExceeded := bHWSignalLimitMin;						(* Position limit switch minimum is exceeded *)

Axis.stPlcToNc.stBaseDevice.stFastRefereneValue.bHWLimitMax := bHardLimitMaxExceeded;
Axis.stPlcToNc.stBaseDevice.stFastRefereneValue.bHWLimitMin := bHardLimitMinExceeded;

(* Status software limit switch *)
bSoftLimitMaxExceeded := lrActPos >= lrSoftLimitMax AND lrSoftLimitMax <> lrSoftLimitMin;		(* Position limit switch maximum is exceeded *)
bSoftLimitMinExceeded := lrActPos <= lrSoftLimitMin AND lrSoftLimitMax <> lrSoftLimitMin;		(* Position limit switch minimum is exceeded *)


]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCPower" Id="{f4462c3b-89d0-4820-9b93-899dc49f518d}">
      <Implementation>
        <ST><![CDATA[
fbPower(
	bEnable := TRUE,
   	bRegulatorOn := bRegulatorOn,
	bEnablePositive := NOT bHWSignalLimitMax,                          			(* HW limit switch maximum *)
	bEnableNegative := NOT bHWSignalLimitMin,                         			(* HW limit switch minimum *)
	lrOverride := lrOverride,
	Axis := Axis,
	bStatus => bStatus,
);

tonStatusDelay(
	IN := fbPower.bStatus,
	PT := SEL(etMachineMode = ET_MachineMode_eManual, tStatusDelay, t#0ms),
	Q => bStatusDelay
);

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MCReset" Id="{a54b9c83-0ccc-4089-ae82-3085d5c87295}">
      <Implementation>
        <ST><![CDATA[
fbReset(
	bExecute := bReset
	            	     XOR bExeReset,
	Axis := Axis,
	bDone => bReseted
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PositionDynamics" Id="{2276259b-d9f8-4278-8dc4-2a36cccb44f1}">
      <Implementation>
        <ST><![CDATA[
(* Position encoding *)
fbPositionEncoder(
	bEnable := TRUE,
	dwEncCurrentValue := dwRawMotorEncoder,
	stEncCfg := stEncoderConfig,
	pAxis := pAxis
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SetLimits" Id="{5332d3cf-b65d-4334-92df-48ecb687695e}">
      <Implementation>
        <ST><![CDATA[
(* Reference engine torque *)
Axis.stPlcToNc.stBaseDevice.nTorqueLimit := LREAL_TO_INT(
	MIN(LIMIT(nTorqueLimitMin, lrEngineTorque, nTorqueLimitMax) * 163.84, 32765.0)
);
]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_STOEBERSDS_AxisController">
      <LineId Id="76" Count="46" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_Error">
      <LineId Id="0" Count="4" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_GetLimits">
      <LineId Id="0" Count="13" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_MCPower">
      <LineId Id="0" Count="17" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_MCReset">
      <LineId Id="0" Count="6" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_PositionDynamics">
      <LineId Id="0" Count="7" />
    </LineIds>
    <LineIds Name="FB_STOEBERSDS_AxisController.A_SetLimits">
      <LineId Id="0" Count="5" />
    </LineIds>
  </POU>
</TcPlcObject>