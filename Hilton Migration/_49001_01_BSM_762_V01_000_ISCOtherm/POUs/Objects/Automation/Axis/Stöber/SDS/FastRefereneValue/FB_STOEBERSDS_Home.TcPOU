<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSDS_Home" Id="{9b9e5e1d-70a8-4ba7-ab0f-744b10dbf5cd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSDS_Home
(*

The function block used to carried out calibration of the axis (referencing) . 

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execut the function block *)
	lrOriginPosition				:LREAL;			(* Origin position when the reference signal is detected *)
	bCalibrationCam				:BOOL; 			(* The signal of a reference cam via a digital input. *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Status = TRUE indicates that the axis is ready for operation. *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);                           (* Control enabled *)

IF rtExecute.Q
THEN
	bBusy := TRUE;

ELSIF bBusy
THEN
	bBusy := FALSE;
END_IF;

bDone := bExecute
		AND NOT bBusy;]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSDS_Home">
      <LineId Id="43" Count="13" />
    </LineIds>
  </POU>
</TcPlcObject>