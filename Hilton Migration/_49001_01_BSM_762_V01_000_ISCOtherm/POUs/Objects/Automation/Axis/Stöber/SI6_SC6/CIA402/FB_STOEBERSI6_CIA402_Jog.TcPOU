<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_Jog" Id="{47fdb627-2338-4dc5-9acf-76f8f68aa32f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_Jog
(*

The function block enables an axis to be moved via manual keys.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;			(* Signal FB enable *)
	bJogForward					:BOOL;			(* Axis moved in positive direction of travel. *)
	bJogBackwards				:BOOL;			(* Axis moved in negative direction of travel. *)
	dnJogStep	 				:DINT;			(* Relative distance for movements. *)
	lrVelocity						:LREAL;			(* Target velocity *)
	lrAcceleration					:LREAL;			(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;			(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;			(* Value of jerk (always positive) *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bActive						:BOOL;			(* If Active is TRUE the axis is controlled by the jog function. *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbJogForward					:FB_SignalHandlingEdge;
	fbJogBackwards				:FB_SignalHandlingEdge;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable
THEN
	bActive := FALSE;

	Axis.stPlcToNc.stCIA402.stJogMode.bJogPositive := FALSE;			(* Jog mode in positive direction *)
	Axis.stPlcToNc.stCIA402.stJogMode.bJogNegative := FALSE;         	(* Tip mode in negative direction *)

	Axis.stPlcToNc.stCIA402.stJogMode.lrVelocity := 0.0;				(* Value of velocity *);

	fbJogForward(bEnable := FALSE);
	fbJogBackwards(bEnable := FALSE);

	bFirstTime := FALSE;
	RETURN;
END_IF;

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

fbJogForward(
	bEnable := TRUE,
	bIn := bJogForward
);

fbJogBackwards(
	bEnable := TRUE,
	bIn := bJogBackwards
);

Axis.stPlcToNc.stCIA402.stJogMode.lrVelocity := lrVelocity  * (Axis.stPlcToNc.stCIA402.nOverride/100.0);							(* Value of velocity *);
Axis.stPlcToNc.stCIA402.stJogMode.lrAcceleration := ABS(lrAcceleration);           			(* Value of the acceleration (always positive) *)
Axis.stPlcToNc.stCIA402.stJogMode.lrDeceleration:= ABS(lrDeceleration);           			(* Value of the deceleration (always positive) *)
Axis.stPlcToNc.stCIA402.stJogMode.lrJerk:= ABS(lrJerk);           							(* Value of the jerk (always positive) *)

IF (NOT fbJogForward.bOut
     AND NOT fbJogBackwards.bOut)
     OR NOT Axis.stNcToPlc.stCIA402.bSwitchedOn					(* Switched on *)
THEN
	Axis.stPlcToNc.stCIA402.stJogMode.bJogPositive := FALSE;                             																(* Jog mode in positive direction *)
	Axis.stPlcToNc.stCIA402.stJogMode.bJogNegative := FALSE;                          																(* Jog mode in negative direction *)
	Axis.stPlcToNc.stCIA402.stJogMode.dnJogStep := 0;																				(* Jog step *)

	IF bActive
	    AND Axis.stNcToPlc.stCIA402.bNotMoving												(* Axis moving *)
	THEN
		Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;

		bActive := FALSE;
	END_IF;

ELSIF (fbJogForward.bRisingEdge
     XOR fbJogBackwards.bRisingEdge)
    AND Axis.stNcToPlc.stCIA402.bNotMoving         				(* Axis sillstand *)
    AND Axis.stNcToPlc.stCIA402.bSwitchedOn					(* Switched on *)
    AND NOT Axis.stNcToPlc.stCIA402.bEnabled				(* Enabled *)
THEN
	Axis.stPlcToNc.stCIA402.bEnableOperation := TRUE;
	Axis.stPlcToNc.stCIA402.etModesOfOperation := ET_ModesOfOperation_Jog;					(* Activates jog mode *)

	bActive := FALSE;

ELSIF (fbJogForward.bOut
    	    XOR fbJogBackwards.bOut)
             AND Axis.stNcToPlc.stCIA402.bSwitchedOn					(* Switched on *)
	    AND Axis.stNcToPlc.stCIA402.bEnabled					(* Enabled *)
	    AND Axis.stNcToPlc.stCIA402.etModesOfOperation = ET_ModesOfOperation_Jog				(* Activated jog mode *)
THEN
	Axis.stPlcToNc.stCIA402.stJogMode.bJogPositive := fbJogForward.bOut;                            														(* Jog mode in positive direction *)
	Axis.stPlcToNc.stCIA402.stJogMode.bJogNegative := fbJogBackwards.bOut;                          														(* Jog mode in negative direction *)
	Axis.stPlcToNc.stCIA402.stJogMode.dnJogStep := dnJogStep * REAL_TO_DINT(EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));			(* Jog step *)

	bActive := TRUE;

END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSI6_CIA402_Jog">
      <LineId Id="50" Count="77" />
    </LineIds>
  </POU>
</TcPlcObject>