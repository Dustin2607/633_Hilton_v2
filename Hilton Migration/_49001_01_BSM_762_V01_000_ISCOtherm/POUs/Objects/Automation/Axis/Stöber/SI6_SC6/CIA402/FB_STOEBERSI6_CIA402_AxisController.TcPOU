<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_AxisController" Id="{e03d24b1-43f7-49f6-a2dc-bc9c98db3a0b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_AxisController
(*

The function block used to control axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bEnableVoltage				:BOOL;						(* Enable voltage *)
	bRegulatorOn				:BOOL;						(* Enable the power stage *)
	bReset						:BOOL;						(* Signal reset *)
	bCMDInterrupt				:BOOL;						(* Signal interrupt *)
	bTerminalOK					:BOOL;						(* Terminal Ok *)
	bQuickStop					:BOOL;						(* Quick stop *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	lrOverride					:LREAL;						(* Override 100% percent *)
	lrMaxTorque					:LREAL;						(* Engine torque 100% percent  *)
	bWithAbsoluteEncoder			:BOOL; 						(* Encoder is an absolute one / Absolutwertgeber *)
	bHWSignalLimitMax			:BOOL;						(* Signal position limit switch maximum *)
	bHWSignalLimitMin			:BOOL;						(* Signal position limit switch minimum *)
	lrSoftLimitMax					:LREAL; 						(* Position limit switch maximum *)
	lrSoftLimitMin					:LREAL; 						(* Position limit switch minimum *)
	lrMaxAcceleration				:LREAL;						(* Value of the acceleration (always positive) *)
	lrMaxDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrMaxJerk					:LREAL;						(* Value of jerk (always positive) *)
	tTimeOut 					:TIME := t#2s;					(* Timout for ads commands *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bStatus						:BOOL;						(* Feedback *)
	bStatusDelay					:BOOL;						(* Feedback delay *)
	bReseted					:BOOL;						(* Reset completed *)
	bError						:BOOL;						(* Controller error *)
	bErrorInit						:BOOL;						(* Controller error init *)
	udnErrorNo					:UDINT;						(* Error number *)
	byPLCOpenErrCode			:BYTE;						(* Error code PLCOpen-State *)
	lrActPos						:LREAL;						(* Actual position *)
	lrActVelo						:LREAL;						(* Actual velocity *)
	nActTorque					:INT;						(* Actual torque *)
	bNotMoving					:BOOL;						(* Status of moving *)
	bReferenced					:BOOL;						(* Referenced *)
	bHardLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bHardLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
	bSoftLimitMaxExceeded		:BOOL;						(* Position limit switch maximum is exceeded *)
	bSoftLimitMinExceeded		:BOOL;						(* Position limit switch minimum is exceeded *)
END_VAR
VAR_IN_OUT
	Axis							:ST_AXIS_REF;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	etAxisGetLimits				:ET_STOEBER_AxisGetLimits;
	bGetLimitsExe				:BOOL;						(* Progam execute *)
	bGetLimitsDone 				:BOOL;                     			 	(* Program done *)
	bGetLimitsBusy 				:BOOL;                   				(* Program busy *)
	bGetLimitsError 				:BOOL;                      				(* Program error *)
	bGetLimitsInitDone 			:BOOL;                     				(* Program initialization done *)
	udnGetLimitsErrorNo 			:UDINT;                    				(* Error number *)
	unGetValueWatchdog			:UINT;
	dwGetValue					:DWORD;

	etAxisSetLimits				:ET_STOEBER_AxisSetLimits;
	bSetLimitsExe				:BOOL;						(* Progam execute *)
	bSetLimitsDone 				:BOOL;                      				(* Program done *)
	bSetLimitsBusy 				:BOOL;                      				(* Program busy *)
	bSetLimitsError 				:BOOL;                      				(* Program error *)
	bSetLimitsInitDone 			:BOOL;                      				(* Program initialization done *)
	bSetLimitsInitError 				:BOOL;                      				(* Program initialization error *)
	udnSetLimitsErrorNo 			:UDINT;                    				(* Error number *)
	unSetValueWatchdog			:UINT;

	lrJogVelo					:LREAL;
	lrJogAcc						:LREAL;
	lrJogDec						:LREAL;
	lrJogJerk					:LREAL;

	tStatusDelay					:TIME := t#1s;					(* Status delay time *)
	tRegulatorOffDelay			:TIME := t#50ms;				(* Regulator off delay time *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbPower						:FB_STOEBERSI6_CIA402_Power;		(* The function block is used to enable for an axis *)
	tonStatusDelay				:TON;								(* Delay controller enabled status *)
	fbReset						:FB_STOEBERSI6_CIA402_Reset;		(* An axis reset is carried out with the function block *)
	fbWriteSDO					:FB_EcCoESdoWrite;
	fbReadSDO					:FB_EcCoESdoRead;
	tonFirstInit					:TON;						(* First initialization *)
	tofRepeateSetLimitsInit			:TOF;
	tofRepeateGetLimitsInit			:TOF;
END_VAR
VAR CONSTANT
	tFirstInit						:TIME := T#2S;				(* First initialization *)
	tRepeateInit					:TIME := T#1S;				(* Repeate initialization *)
	
	unWatchdogMax				:UINT := 150;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable							(* Signal FB enable *)
THEN
	bStatus := FALSE;						(* Feedback *)
	bStatusDelay := FALSE;				(* Feedback *)
	bError := FALSE;						(* Controller error *)
	udnErrorNo := 0;						(* Error number *)

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	tonFirstInit(IN := FALSE);					(* Program execute *)
	bGetLimitsDone := FALSE;                                	(* Program done *)
	bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bGetLimitsError := FALSE;                                 	(* Program not error *)
	bGetLimitsInitDone := FALSE;				(* Program initialization done *)
	udnGetLimitsErrorNo := 0;                                 		(* Error number *)
	unGetValueWatchdog := 0;

	etAxisGetLimits := ET_STOEBER_AxisGetLimits_eWaitExecute;       			(* Next step *)

	bSetLimitsExe := FALSE;					(* Program execute *)
	bSetLimitsDone := FALSE;                                	(* Program done *)
	bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
	bSetLimitsError := FALSE;                                	 	(* Program not error *)
	bSetLimitsInitDone := FALSE;                            	(* Program initialization done *)
	bSetLimitsInitError := FALSE;				(* Program initialization error *)
	udnSetLimitsErrorNo := 0;                                 		(* Error number *)
	unSetValueWatchdog := 0;

	etAxisSetLimits := ET_STOEBER_AxisSetLimits_eWaitExecute;       			(* Next step *)

	bFirstTime := TRUE;
END_IF;

A_Power();
A_Reset();
A_GetLimits();
A_SetLimits();
A_Error();

(* Actual position *)
lrActPos := DINT_TO_LREAL(Axis.stNcToPlc.stCIA402.dnActPosition) / (EXPT(10, Axis.stNcToPlc.stCIA402.snDecimalDigits));
lrActPos := F_LRealRound(lrReal := lrActPos, usiPrecision := 2);

(* Actual velocity *)
lrActVelo := DINT_TO_LREAL(Axis.stNcToPlc.stCIA402.dnActVelocity) / (EXPT(10, Axis.stNcToPlc.stCIA402.snDecimalDigits));
lrActVelo := F_LRealRound(lrReal := lrActVelo, usiPrecision := 3);

(* Current engine torque *)
nActTorque := Axis.stNcToPlc.stCIA402.nActTorque / 10;

(* Reference signal *)
IF bWithAbsoluteEncoder
THEN
	Axis.stNcToPlc.stCIA402.bReferenced := TRUE;
END_IF
bReferenced := Axis.stNcToPlc.stCIA402.bReferenced;

(* Status not moving *)
bNotMoving := Axis.stNcToPlc.stCIA402.bNotMoving
			  OR (Axis.stNcToPlc.stCIA402.snPLCOpenState = 2);

(* Error Code PLCOpen-State *)
byPLCOpenErrCode := Axis.stNcToPlc.stCIA402.snPLCOpenErrStopCause;





               
]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{da22af40-f9a3-409a-acf3-d8cbbdf0d3dc}">
      <Implementation>
        <ST><![CDATA[
bError := fbReset.bError
	         OR fbPower.bError;

bErrorInit := bGetLimitsError
		      OR bSetLimitsError;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_GetLimits" Id="{15a22422-cf76-40c8-9604-9ba30e1fffd5}">
      <Implementation>
        <ST><![CDATA[
(* Status hardware limit switch *)
bHardLimitMaxExceeded := Axis.stNcToPlc.stCIA402.bPosLimitSwitch;							(* Position limit switch maximum is exceeded *)
bHardLimitMinExceeded := Axis.stNcToPlc.stCIA402.bNegLimitSwitch;							(* Position limit switch minimum is exceeded *)

(* Status software limit switch *)
bSoftLimitMaxExceeded := lrActPos >= lrSoftLimitMax AND bReferenced AND lrSoftLimitMax <> lrSoftLimitMin;		(* Position limit switch maximum is exceeded *)
bSoftLimitMinExceeded := lrActPos <= lrSoftLimitMin AND bReferenced AND lrSoftLimitMax <> lrSoftLimitMin;			(* Position limit switch minimum is exceeded *)

(* Get limits execute *)
tofRepeateGetLimitsInit(
	IN := bGetLimitsError,
	PT := tRepeateInit
);

tonFirstInit(
	IN:= bTerminalOK
		 AND NOT bGetLimitsInitDone,
	PT := tFirstInit
);

(* Get limits execute *)
bGetLimitsExe := (tonFirstInit.Q
				  OR bGetLimitsInitDone)
				  AND NOT tofRepeateGetLimitsInit.Q;

(* Get axis limits *)
CASE etAxisGetLimits OF

	ET_STOEBER_AxisGetLimits_eWaitExecute:
		IF bGetLimitsExe
		   AND bTerminalOK
		THEN
			bGetLimitsDone := FALSE;                                	(* Program done *)
			bGetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bGetLimitsError := FALSE;                                 	(* Program not error *)

			fbReadSDO(
				bExecute := FALSE
			);
	
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eDecimalDigits;         		(* Next step *)

		END_IF
	ET_STOEBER_AxisGetLimits_eDecimalDigits:

		(* Read decimal digits I06 *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#3006,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 1;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			Axis.stNcToPlc.stCIA402.snDecimalDigits := DWORD_TO_SINT(dwGetValue);

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eDone;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eScalingDenom:

		(* Read effective distance per rev. Denominator [INC] - I254 *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#30FE,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 2;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			(*Axis.stNcToPlc.stCIA402.udnScalingDenom := dwGetValue;			(* Effective distance per rev. Denominator [INC] - I254 = e.g 16384 *)*)

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eScalingNum;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eScalingNum:

		(* Read effective distance per rev. Numerator [technical units]: The factor indicates the distance per one increment of position control. - I253 = e.g 176.0 / 7.0 (* I07 / I08 *) *)
		fbReadSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#30FD,                   (* Index of object *)
			pDstBuf := ADR(dwGetValue),
			cbBufLen := SIZEOF(dwGetValue),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);

		IF NOT fbReadSDO.bBusy
		     AND fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			udnGetLimitsErrorNo := 3;                     (* Error number *)
		
			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eError;              (* Next step *)
		
		ELSIF NOT fbReadSDO.bBusy
			   AND NOT fbReadSDO.bError
		THEN
			fbReadSDO(
				bExecute := FALSE
			);

			(*Axis.stNcToPlc.stCIA402.lrScalingNum := DWORD_TO_LREAL(dwGetValue)			(* Effective distance per rev. Numerator [technical units]: The factor indicates the distance per one increment of position control. - I253 = e.g 176.0 / 7.0 (* I07 / I08 *) *)
																		/ EXPT(10, Axis.stNcToPlc.stCIA402.snDecimalDigits);*)

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eDone;              (* Next step *)

		END_IF;

	ET_STOEBER_AxisGetLimits_eDone:
		bGetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := TRUE;                             		(* Program initialization done *)

		etAxisGetLimits := ET_STOEBER_AxisGetLimits_eNoExecute;            	(* Next step *)

	ET_STOEBER_AxisGetLimits_eError:
		bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bGetLimitsError := TRUE;                                     		(* Program error *)
		bGetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bGetLimitsInitDone := FALSE;                             		(* Program initialization done *)

		etAxisGetLimits := ET_STOEBER_AxisGetLimits_eNoExecute;           	(* Next step *)

	ET_STOEBER_AxisGetLimits_eNoExecute:
		IF NOT bGetLimitsExe
		THEN
			bGetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bGetLimitsError := FALSE;                                     		(* Program error *)
			bGetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisGetLimits := ET_STOEBER_AxisGetLimits_eWaitExecute;       (* Next step *)
		END_IF
END_CASE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Power" Id="{efdc21e4-c04d-49b6-9b16-fa26a6a5e138}">
      <Implementation>
        <ST><![CDATA[
fbPower(
	bEnable := TRUE,
	bSwitchOn := bRegulatorOn,
	bEnablePositive := NOT bHWSignalLimitMax,                         			(* HW limit switch maximum *)
	bEnableNegative := NOT bHWSignalLimitMin,                         			(* HW limit switch minimum *)
	bEnableVoltage := bEnableVoltage,
	bQuickStop := NOT bQuickStop,
	lrOverride:= lrOverride,
	Axis := Axis,
	bStatus => bStatus
);

tonStatusDelay(
	IN := fbPower.bStatus,
	PT := SEL(etMachineMode = ET_MachineMode_eManual, tStatusDelay, t#0ms),
	Q => bStatusDelay
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Reset" Id="{512fa002-5b06-4637-9b9f-e94c57189c73}">
      <Implementation>
        <ST><![CDATA[
fbReset(
	bExecute := bReset
	            	     XOR bExeReset,
	Axis := Axis,
	bDone => bReseted
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SetLimits" Id="{d782f427-e08e-4556-9ee4-083380a3f680}">
      <Implementation>
        <ST><![CDATA[
(* Reference engine torque *)
Axis.stPlcToNc.stCIA402.dnSoftwarePosLimitMax := LREAL_TO_DINT(ABS(lrSoftLimitMax) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           				(* Position limit switch maximum *)
Axis.stPlcToNc.stCIA402.dnSoftwarePosLimitMin:= LREAL_TO_DINT(ABS(lrSoftLimitMin) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           					(* Position limit switch minimum *)
Axis.stPlcToNc.stCIA402.unMaxTorque:= LREAL_TO_UINT(ABS(lrMaxTorque) * 10.0);           																	(* Value of the torque *)
Axis.stPlcToNc.stCIA402.udnMaxAcceleration := LREAL_TO_UDINT(ABS(lrMaxAcceleration) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           				(* Value of the acceleration (always positive) *)
Axis.stPlcToNc.stCIA402.udnMaxDeceleration:= LREAL_TO_UDINT(ABS(lrMaxDeceleration) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           				(* Value of the deceleration (always positive) *)
Axis.stPlcToNc.stCIA402.udnMaxJerk:= LREAL_TO_UDINT(ABS(lrMaxJerk) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           								(* Value of the jerk (always positive) *)

(* Set limits execute *)
tofRepeateSetLimitsInit(
	IN := bSetLimitsError,
	PT := tRepeateInit
);

bSetLimitsExe := NOT bSetLimitsExe
			      AND SEL(
						bSetLimitsInitDone,
						NOT bSetLimitsInitError,
						NOT bSetLimitsInitError
					      		 AND (lrJogVelo <> Axis.stPlcToNc.stCIA402.stJogMode.lrVelocity
								    OR lrJogAcc <> Axis.stPlcToNc.stCIA402.stJogMode.lrAcceleration
								    OR lrJogDec <> Axis.stPlcToNc.stCIA402.stJogMode.lrDeceleration
								    OR lrJogJerk <> Axis.stPlcToNc.stCIA402.stJogMode.lrJerk)
				     		);

(* Set axis limits *)
CASE etAxisSetLimits OF

	ET_STOEBER_AxisSetLimits_eWaitExecute:
		IF bSetLimitsExe
		    AND bTerminalOK
		    AND bGetLimitsDone
		THEN
			unSetValueWatchdog := 0;
			bSetLimitsDone := FALSE;                                	(* Program done *)
			bSetLimitsBusy := FALSE;                                 	(* Program not busy *)
			bSetLimitsError := FALSE;                                	 	(* Program not error *)
			udnSetLimitsErrorNo := 0;

			fbWriteSDO(
				bExecute := FALSE
			);

			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetJogVelo;         		(* Next step *)

		END_IF;

	ET_STOEBER_AxisSetLimits_eSetJogVelo:
		lrJogVelo := Axis.stPlcToNc.stCIA402.stJogMode.lrVelocity;

		(* Write jog velocity I12 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#300C,                                             (* Index of object *)
			pSrcBuf := ADR(lrJogVelo),
			cbBufLen := SIZEOF(lrJogVelo),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);
		
		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			udnSetLimitsErrorNo := 1;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetJogAcc;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eSetJogAcc:
		lrJogAcc := Axis.stPlcToNc.stCIA402.stJogMode.lrAcceleration;

		(* Write jog velocity I13 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#300D,                                             (* Index of object *)
			pSrcBuf := ADR(lrJogAcc),
			cbBufLen := SIZEOF(lrJogAcc),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);
		
		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			udnSetLimitsErrorNo := 2;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetJogDec;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eSetJogDec:
		lrJogDec := Axis.stPlcToNc.stCIA402.stJogMode.lrDeceleration;

		(* Write jog velocity I45 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#302D,                                             (* Index of object *)
			pSrcBuf := ADR(lrJogDec),
			cbBufLen := SIZEOF(lrJogDec),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);
		
		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			udnSetLimitsErrorNo := 3;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eSetJogJerk;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eSetJogJerk:
		lrJogJerk := Axis.stPlcToNc.stCIA402.stJogMode.lrJerk;

		(* Write jog velocity I18 *)
		fbWriteSDO(
			sNetId := Axis.sAdsAddr,
			nSlaveAddr := Axis.unSlaveAddr,
			nSubIndex := 0,			(* Subindex of object *)
			nIndex := 16#3012,                                             (* Index of object *)
			pSrcBuf := ADR(lrJogJerk),
			cbBufLen := SIZEOF(lrJogJerk),
			bExecute := TRUE,
			tTimeout := DEFAULT_ADS_TIMEOUT
		);
		
		IF NOT fbWriteSDO.bBusy
		     AND fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);

			udnSetLimitsErrorNo := 4;                     (* Error number *)
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eError;         		(* Next step *)
		
		ELSIF NOT fbWriteSDO.bBusy
			   AND NOT fbWriteSDO.bError
		THEN
			fbWriteSDO(
				bExecute := FALSE
			);
		
			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eDone;              (* Next step *)
		
		END_IF;

	ET_STOEBER_AxisSetLimits_eDone:
		bSetLimitsDone := TRUE;                                     		(* Program done, in position *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := TRUE;                             		(* Program initialization done *)

		etAxisSetLimits := ET_STOEBER_AxisSetLimits_eNoExecute;            	(* Next step *)

	ET_STOEBER_AxisSetLimits_eError:
		bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
		bSetLimitsError := TRUE;                                     		(* Program error *)
		bSetLimitsBusy := FALSE;                                     		(* Program not busy *)
		bSetLimitsInitDone := FALSE;                             		(* Program initialization done *)

		etAxisSetLimits := ET_STOEBER_AxisSetLimits_eNoExecute;           	(* Next step *)

	ET_STOEBER_AxisSetLimits_eNoExecute:
		IF NOT bSetLimitsExe
		THEN
			bSetLimitsDone := FALSE;                                     		(* Program done, in position *)
			bSetLimitsError := FALSE;                                     		(* Program error *)
			bSetLimitsBusy := FALSE;                                     		(* Program not busy *)

			etAxisSetLimits := ET_STOEBER_AxisSetLimits_eWaitExecute;       (* Next step *)
		END_IF;

END_CASE;
]]></ST>
