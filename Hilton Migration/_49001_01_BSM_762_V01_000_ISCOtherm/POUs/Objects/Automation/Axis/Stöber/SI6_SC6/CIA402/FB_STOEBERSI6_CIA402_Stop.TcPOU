<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_Stop" Id="{e65f9e72-b45e-410c-983f-ba1e9e08504a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_Stop
(*

The function block used to stop an axis

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execute the function block *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Status = TRUE indicates that the axis is ready for operation. *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
	rtLimitMax					:R_TRIG;
	rtLimitMin						:R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);	                          (* Stop execute  *)

rtLimitMax(CLK := Axis.bHWLimitMax);			(* Stop execute  *)
rtLimitMin(CLK := Axis.bHWLimitMin);	                   (* Stop execute  *)

IF (rtExecute.Q
     OR rtLimitMax.Q
     OR rtLimitMin.Q)
THEN
	Axis.bLockPDO := TRUE;
	Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;
	Axis.stPlcToNc.stCIA402.bHalt := FALSE;
	Axis.stPlcToNc.stCIA402.stPositionMode.bNewSetpoint := FALSE;
	Axis.stPlcToNc.stCIA402.stPositionMode.udnVelocity := 0;									(* Profil position velocity *)
	Axis.stPlcToNc.stCIA402.stJogMode.bJogNegative := FALSE;								(* Jog  negative *)
	Axis.stPlcToNc.stCIA402.stJogMode.bJogPositive := FALSE;									(* Jog  positive *)
	Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity := 0;								(* Profil velocity target velocity *)

	bBusy := TRUE;

ELSIF bBusy
	    AND NOT Axis.stNcToPlc.stCIA402.bEnabled
	    AND Axis.stNcToPlc.stCIA402.bNotMoving													(* Axis standstill *)
THEN
	Axis.bLockPDO := FALSE;
	Axis.stPlcToNc.stCIA402.etModesOfOperation := ET_ModesOfOperation_None;					(* Activates none mode *)

	bBusy := FALSE;

END_IF;

bDone := bExecute
		AND NOT bBusy
		AND Axis.stNcToPlc.stCIA402.bNotMoving;			(* Axis standstill *)]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSI6_CIA402_Stop">
      <LineId Id="43" Count="34" />
    </LineIds>
  </POU>
</TcPlcObject>