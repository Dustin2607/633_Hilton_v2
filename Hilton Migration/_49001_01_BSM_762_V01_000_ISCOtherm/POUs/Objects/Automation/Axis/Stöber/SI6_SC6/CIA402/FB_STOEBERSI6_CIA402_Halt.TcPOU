<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_Halt" Id="{5253e9ea-6528-4973-a84e-1b711149f6c5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_Halt
(*

The function block used to halt an axis

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execute the function block *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Status = TRUE indicates that the axis is ready for operation. *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bExecute
     AND Axis.stNcToPlc.stCIA402.bEnabled         					(* Axis enabled *)
THEN
	Axis.stPlcToNc.stCIA402.bHalt := bExecute;		(* Halt *)

	bBusy := TRUE;

ELSIF bBusy
THEN
	Axis.stPlcToNc.stCIA402.bHalt := FALSE;			(* Halt *)

	bBusy := FALSE;
END_IF;

bDone := Axis.stNcToPlc.stCIA402.bNotMoving;			(* Axis standstill *)]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSI6_CIA402_Halt">
      <LineId Id="41" Count="14" />
    </LineIds>
  </POU>
</TcPlcObject>