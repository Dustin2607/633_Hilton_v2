<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_AxisLink" Id="{50e1dfb2-3540-425b-918d-c0b369a8e8e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_AxisLink
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR_IN_OUT
	Drive						:ST_DRIVESI6SC6CIA402_REF;			(* The DRIVE_REF data type  is an interface between the PLC and the DRIVE and contains axis information *)
	Axis							:ST_Axis_REF;						(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Set terminal parameters *)
Axis.sAdsAddr:= F_CreateAmsNetId(Drive.stTerminalState.stAdsAddr.netId);
Axis.unSlaveAddr:= Drive.stTerminalState.stAdsAddr.port;

(* Copy the actual values from the inverter to the axis reference *)
Axis.stNcToPlc.stCIA402.bReadyToSwitchOn := Drive.stStoeberToPlc.wA516Statusword.0;								(* Ready to switch on. *)
Axis.stNcToPlc.stCIA402.bSwitchedOn := Drive.stStoeberToPlc.wA516Statusword.1;										(* Switched on. *)
Axis.stNcToPlc.stCIA402.bEnabled := Drive.stStoeberToPlc.wA516Statusword.2;											(* Operation enabled. *)
Axis.stNcToPlc.stCIA402.bError := Drive.stStoeberToPlc.wA516Statusword.3;											(* The drive state is fault. *)
Axis.stNcToPlc.stCIA402.bVoltageEnabled := Drive.stStoeberToPlc.wA516Statusword.4;									(* Voltage enabled. *)
Axis.stNcToPlc.stCIA402.bQuickStop := Drive.stStoeberToPlc.wA516Statusword.5;										(* Quick stop is queued/is being executed. *)
Axis.stNcToPlc.stCIA402.bSwitchOnDisabled := Drive.stStoeberToPlc.wA516Statusword.6;								(* Switch on disabled. *)
Axis.stNcToPlc.stCIA402.bMessage := Drive.stStoeberToPlc.wA516Statusword.8;										(* Message *)
(*Axis.stNcToPlc.stCIA402.snDecimalDigits := 3;*)																		(* Number of positions after the decimal point for indication and entry of position reference values, speeds, accelerations *)

(* Jog mode *)

(* Position mode *)
Axis.stNcToPlc.stCIA402.stPositionMode.bPositionReached := Drive.stStoeberToPlc.wA516Statusword.10;					(* Set position reached, data source: I180; prerequisite: halt inactive = A515, bit 8 = 0
												    											    		 		   Velocity is zero; data source: I199; prerequisite: halt inactive = A515, bit 8 = 1 *)
Axis.stNcToPlc.stCIA402.stPositionMode.bSetpointAck := Drive.stStoeberToPlc.wA516Statusword.12;						(* Target position accepted from motion core *)
Axis.stNcToPlc.stCIA402.stPositionMode.bFollowingError := Drive.stStoeberToPlc.wA516Statusword.13;						(* Following error *)

(* Velocity mode *)
Axis.stNcToPlc.stCIA402.stVelocityMode.bVelocityReached := Drive.stStoeberToPlc.wA516Statusword.10;					(* Set velocity reached; data source: I85; prerequisite: halt inactive = A515, bit 8 = 0
												    										             		    		Velocity is zero; data source: I199; prerequisite: halt inactive = A515, bit 8 = 1 *)
Axis.stNcToPlc.stCIA402.stVelocityMode.bVelocityZero := Drive.stStoeberToPlc.wA516Statusword.12;						(* Velocity is zero; data source I199 *)
Axis.stNcToPlc.stCIA402.stVelocityMode.bMaxSlippageError	 := Drive.stStoeberToPlc.wA516Statusword.13;					(* Difference in the amount of the effective set and actual velocity greater than velocity window, data source: I426, I88, C40 *)

(* Torque mode *)
Axis.stNcToPlc.stCIA402.stTorqueMode.bTorqueReached := Drive.stStoeberToPlc.wA516Statusword.10;					(* Set force / set torque reached; difference in the amount of effective set force / set torque and actual force / actual torque greater than torque / force window, data source: A558, A564, G900  *)

(* Homing mode *)
Axis.stNcToPlc.stCIA402.stHomingMode.bHomeReached := Drive.stStoeberToPlc.wA516Statusword.10;					(* Referencing ended  *)
Axis.stNcToPlc.stCIA402.stHomingMode.bHomingAttained := Drive.stStoeberToPlc.wA516Statusword.12;					(* Reference set *)
Axis.stNcToPlc.stCIA402.stHomingMode.bHomingError := Drive.stStoeberToPlc.wA516Statusword.13;						(* Referencing error *)
																											(*
																												000 bin = referencing active; 
																												001 bin = referencing canceled or not started; 
																												010 bin = reference set, referencing not yet complete; 
																												011 bin = referencing ended successfully; 
																												100 bin = referencing error, velocity is not zero; 
																												110 bin = referencing error, velocity is zero
																											*)

Axis.stNcToPlc.stCIA402.etModesOfOperation := SINT_TO_INT(Drive.stStoeberToPlc.snA542ModesOfOperationDisplay);			(* Actual operating mode *)
																														(*
																															-1: Jog
																															0: No mode assigned
																															1: Profile position mode
																															3: Profile velocity mode
																															4: Profile torque mode
																															6: Homing Mode
																															7: Interpolated position mode
																															8: Cyclic synchronous position mode
																															9: Cyclic synchronous velocity mode
																															10: Cyclic synchronous torque mode
																															
																														*)
Axis.stNcToPlc.stCIA402.dnActPosition := Drive.stStoeberToPlc.dnA545PositionActualValue;								(* Actual position of the axis *)
Axis.stNcToPlc.stCIA402.dnActVelocity := Drive.stStoeberToPlc.dnA553VelocityActualValue;								(* Actual velocity of the axis *)
Axis.stNcToPlc.stCIA402.nActTorque := Drive.stStoeberToPlc.nA564TorqueActualValue;									(* Actual torque/force of the axis *)
Axis.stNcToPlc.stCIA402.dnActFollowingError := Drive.stStoeberToPlc.dnA632FollowingErrorActualeValue;					(* Actual lag *)
Axis.stNcToPlc.stCIA402.bNegLimitSwitch := Drive.stStoeberToPlc.dwA636DigitalInputs.0;									(* Negative limit switch *)
Axis.stNcToPlc.stCIA402.bPosLimitSwitch := Drive.stStoeberToPlc.dwA636DigitalInputs.1;									(* Positive limit switch *)
Axis.stNcToPlc.stCIA402.bHomeSwitch := Drive.stStoeberToPlc.dwA636DigitalInputs.2;									(* Reference switch *)
Axis.stNcToPlc.stCIA402.dnActAdditionalPosition := Drive.stStoeberToPlc.dnA620AdditionalPositionActualValue;				(* Actual position of the master encoder *)

Axis.stNcToPlc.stCIA402.snPLCOpenState := Drive.stStoeberToPlc.snI89PLCOpenState;
Axis.stNcToPlc.stCIA402.snPLCOpenErrStopCause := Drive.stStoeberToPlc.snI90PLCOpenErrStopCause;					(* Cause of a requested command being denied or cancelled by the motion core *)
Axis.stNcToPlc.stCIA402.bPLCOpenDone := Drive.stStoeberToPlc.wA67UserStatusword.0;								(* The motion core has successfully ended the command to be executed  *)
Axis.stNcToPlc.stCIA402.bPLCOpenError := Drive.stStoeberToPlc.wA67UserStatusword.1;								(* Motion core has denied or is cancelling the requested command  *)
Axis.stNcToPlc.stCIA402.bPLCOpenAborted := Drive.stStoeberToPlc.wA67UserStatusword.2;								(* The motion core has aborted  *)

Axis.stNcToPlc.stCIA402.bConstantVelocity := Drive.stStoeberToPlc.wA67UserStatusword.3;								(* Speed reached *)
Axis.stNcToPlc.stCIA402.bAccelerating := Drive.stStoeberToPlc.wA67UserStatusword.4;									(* Accelerating  *)
Axis.stNcToPlc.stCIA402.bDecelerating := Drive.stStoeberToPlc.wA67UserStatusword.5;									(* Decelerating  *)
Axis.stNcToPlc.stCIA402.bNotMoving := Drive.stStoeberToPlc.wA67UserStatusword.6									(* Actual speed is zero *)
								     OR NOT Drive.stStoeberToPlc.wA516Statusword.2;								(* Operation not enabled. *)
Axis.stNcToPlc.stCIA402.bReferenced := Drive.stStoeberToPlc.wA67UserStatusword.7;									(* Referencing ended  *)


Axis.stNcToPlc.stCIA402.dwDigitalInputs := Drive.stStoeberToPlc.dwA636DigitalInputs;

(*
Axis.stNcToPlc.stCommandPositioning.bNotMoving := NOT Drive.stStoeberToPlc.byE200DeviceStatusByte.0           	(* Control enabled *) 			(* Axis is logically stationary. *)
               										     OR NOT Drive.stStoeberToPlc.byE200DeviceStatusByte.5     	(* An axis is active. *)
               										     OR Drive.stStoeberToPlc.unI200PosiStatusWord.7;                         (* Axis standstill *)


Axis.stNcToPlc.stCommandPositioning.bLimitMaxExceeded := NOT Axis.stPlcToNc.bFeedEnablePlus;				(* Position limit switch maximum is exceeded *)
Axis.stNcToPlc.stCommandPositioning.bLimitMinExceeded := NOT Axis.stPlcToNc.bFeedEnableMinus;			(* Position limit switch minimum is exceeded *)

*)


(* Copy the setpoint values from the axis reference to the inverter *)
Drive.stPlcToStoeber.wA515Controlword.0 := Axis.stPlcToNc.stCIA402.bSwitchOn;												(* Switch on. *)
Drive.stPlcToStoeber.wA515Controlword.1 := Axis.stPlcToNc.stCIA402.bEnableVoltage;											(* Enable voltage *)
Drive.stPlcToStoeber.wA515Controlword.2 := Axis.stPlcToNc.stCIA402.bQuickStop;												(* Quick stop; 0 = request quick stop; 1 = do not request quick stop*)
Drive.stPlcToStoeber.wA515Controlword.3 := Axis.stPlcToNc.stCIA402.bEnableOperation;											(* Enable operation *)
Drive.stPlcToStoeber.wA515Controlword.7 := Axis.stPlcToNc.stCIA402.bFaultReset;												(* Fault reset 0, 1 = inactive; 0 -> 1 = active*)
Drive.stPlcToStoeber.wA515Controlword.8 := Axis.stPlcToNc.stCIA402.bHalt;													(* Prerequisite: Jog, Profile position, Profile velocity or Profile torque operating modes *)
Drive.stPlcToStoeber.wA515Controlword.9 := Axis.stPlcToNc.stCIA402.bOperatingModeSpecific;									(* Operating mode specific  *)
Drive.stPlcToStoeber.wA515Controlword.11 := Axis.stPlcToNc.stCIA402.bAxisSelectorBit0;										(* Prerequisite: A63 = 2: Parameter  *)
Drive.stPlcToStoeber.wA515Controlword.12 := Axis.stPlcToNc.stCIA402.bAxisSelectorBit1;										(* Prerequisite: A643 = 2: Parameter  *)
																													(*
																														00 bin = axis 1, 01 bin = axis 2, 10 bin = axis 3, 11 bin = axis 4
																													*)
Drive.stPlcToStoeber.wA515Controlword.13 := Axis.stPlcToNc.stCIA402.bAxisDisable;											(* Prerequisite: A65 = 2: Parameter, 0 = do not disable axis; 1 = disable axis  *)
Drive.stPlcToStoeber.wA515Controlword.14 := Axis.stPlcToNc.stCIA402.bOpenBrake												(* Prerequisite: F06 = 2: Parameter; 0 = brake control through device control (prerequisite: F92[0] = 0: Internal (automatic)) or 0 = engage brake (prerequisite: F92[0] = 1: External (plc)), 1 = open brake*)
									        OR Axis.stPlcToNc.stCIA402.bEnableOperation;
Drive.stPlcToStoeber.wA515Controlword.15 := Axis.stPlcToNc.stCIA402.bSetReference;											(* Prerequisite: I111 = 2: Parameter, 0, 1 = inactive; 0 -> 1 = set reference without interrupting active movements; for controller-controlled operation, the controller must track the set position accordingly *)

CASE Axis.stPlcToNc.stCIA402.etModesOfOperation
OF

	ET_ModesOfOperation_Jog:					(* -1: Jog *)
		(*Drive.stPlcToStoeber.lrI12JogVelocity := Axis.stPlcToNc.stCIA402.lrJogVelocity;*)

		Drive.stPlcToStoeber.wA515Controlword.4 := Axis.stPlcToNc.stCIA402.stJogMode.bJogPositive;									(* 0 = inactive; 1 = active *)
		Drive.stPlcToStoeber.wA515Controlword.5 := Axis.stPlcToNc.stCIA402.stJogMode.bJogNegative;									(* 0 = inactive; 1 = active *)
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_None:					(* 0: No mode assigned *)
		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_ProfilePosition:			(* 1: Profile position mode *)
		Drive.stPlcToStoeber.dnA567TargetPosition := Axis.stPlcToNc.stCIA402.stPositionMode.dnTargetPosition;							(* Target position of the profile position operating mode and set position of the cyclic synchronous position operating mode. *)

		Drive.stPlcToStoeber.udnA574Velocity := Axis.stPlcToNc.stCIA402.stPositionMode.udnVelocity;									(* Profile velocity in the profile position mode. *)
		Drive.stPlcToStoeber.udnA576Acceleration := Axis.stPlcToNc.stCIA402.stPositionMode.udnAcceleration;							(* Profile acceleration in the profile position and profile velocity operating modes. *)
		Drive.stPlcToStoeber.udnA577Deceleration := Axis.stPlcToNc.stCIA402.stPositionMode.udnDeceleration;							(* Profile deceleration in the profile position and profile velocity operating modes. *)

		Drive.stPlcToStoeber.wA515Controlword.4 := Axis.stPlcToNc.stCIA402.stPositionMode.bNewSetpoint;								(* New setpoint (apply the new target position and start the movement) 0, 1 = inactive; 0 -> 1 = active *)
		Drive.stPlcToStoeber.wA515Controlword.5 := Axis.stPlcToNc.stCIA402.stPositionMode.bChangeSetImmediately;						(* 0 = apply new target position with bit 4 if no movement is active (prerequisite: I199 = 1: Active); 1 = apply new target position always with bit 4; a movement that is still active is interrupted *)
		Drive.stPlcToStoeber.wA515Controlword.6 := Axis.stPlcToNc.stCIA402.stPositionMode.bAbsRel;									(* Absolute target position/relative distance; 0 = Target position is an absolute position; 1 = Target position is a distance relative to the last target position A567 (prerequisite: A621 = X to X00 bin) or 1 = Target position is a distance relative to the current actual position A545 (prerequisite: A621 = X to X10 bin) *)

	ET_ModesOfOperation_Velocity:				(* 2: Profile velocity mode *)
		Drive.stPlcToStoeber.dnA638TargetVelocity := Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity;							(* Target velocity for profile velocity operating mode. *)

		Drive.stPlcToStoeber.udnA576Acceleration := Axis.stPlcToNc.stCIA402.stVelocityMode.udnAcceleration;							(* Profile acceleration in the profile position and profile velocity operating modes. *)
		Drive.stPlcToStoeber.udnA577Deceleration := Axis.stPlcToNc.stCIA402.stVelocityMode.udnDeceleration;							(* Profile deceleration in the profile position and profile velocity operating modes. *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_ProfileVelocity:			(* 3: Profile velocity mode *)
		Drive.stPlcToStoeber.dnA638TargetVelocity := Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity;							(* Target velocity for Profile velocity operating mode. *)

		Drive.stPlcToStoeber.udnA576Acceleration := Axis.stPlcToNc.stCIA402.stVelocityMode.udnAcceleration;							(* Profile acceleration in the Profile position and Profile velocity operating modes. *)
		Drive.stPlcToStoeber.udnA577Deceleration := Axis.stPlcToNc.stCIA402.stVelocityMode.udnDeceleration;							(* Profile deceleration in the Profile position and Profile velocity operating modes. *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_ProfileTorque:			(* 4: Profile torque mode *)
		Drive.stPlcToStoeber.nA558TargetTorque := Axis.stPlcToNc.stCIA402.stTorqueMode.nTargetTorque;						(* Set torque/force in the Profile torque operating mode *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_Inactive:					(* 5: Inactive *)
		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_Homing:				(* 6: Homing Mode *)
		Drive.stPlcToStoeber.dnA569HomeOffset := Axis.stPlcToNc.stCIA402.stHomingMode.dnHomeOffset;						(* Reference position of the axis in the Homing operating mode and for the Set reference function *)
		(*Drive.stPlcToStoeber.snA586HomingMethod := Axis.stPlcToNc.stCIA402.snHomingMethod;									(* Set reference method for the Homing operating mode. *)*)

		Drive.stPlcToStoeber.wA515Controlword.4 := Axis.stPlcToNc.stCIA402.stHomingMode.bHomingOperationStart;				(* Start referencing 0, 1 = inactive; 0 -> 1 = active *)
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_InterpolatedPosition:		(* 7: Interpolated position mode *)
		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_CyclicSynchroPosition:	(* 8: Cyclic synchronous position mode *)
		Drive.stPlcToStoeber.dnA567TargetPosition := Axis.stPlcToNc.stCIA402.stPositionMode.dnTargetPosition;							(* Target position of the Profile position operating mode and set position of the Cyclic synchronous position operating mode. *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_CyclicSynchroVelocity:	(* 9: Cyclic synchronous velocity mode *)
		Drive.stPlcToStoeber.dnA638TargetVelocity := Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity;							(* Target velocity for Profile velocity operating mode. *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ET_ModesOfOperation_CyclicSynchroTorque:		(* 10: Cyclic synchronous torque mode *)
		Drive.stPlcToStoeber.nA558TargetTorque := Axis.stPlcToNc.stCIA402.stTorqueMode.nTargetTorque;						(* Set torque/force in the Profile torque operating mode *)

		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

	ELSE
		Drive.stPlcToStoeber.wA515Controlword.4 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.5 := FALSE;
		Drive.stPlcToStoeber.wA515Controlword.6 := FALSE;

END_CASE

Drive.stPlcToStoeber.snA541ModesOfOperation := INT_TO_SINT(Axis.stPlcToNc.stCIA402.etModesOfOperation);				(* Set operating mode. *)
																													(*
																														-1: Jog
																														0: No mode assigned
																														1: Profile position mode
																														3: Profile velocity mode
																														4: Profile torque mode
																														6: Homing Mode
																														7: Interpolated position mode
																														8: Cyclic synchronous position mode
																														9: Cyclic synchronous velocity mode
																														10: Cyclic synchronous torque mode
																													*)

Drive.stPlcToStoeber.unA559MaxTorque := Axis.stPlcToNc.stCIA402.unMaxTorque;											(* Maximum permissible torque/force *)
Drive.stPlcToStoeber.udnA604MaxAcceleration := Axis.stPlcToNc.stCIA402.udnMaxAcceleration;								(* Maximum permissible acceleration in the Homing, Jog, Profile position and Profile velocity operating modes. *)
Drive.stPlcToStoeber.udnA605MaxDeceleration := Axis.stPlcToNc.stCIA402.udnMaxDeceleration;								(* Maximum permissible deceleration in the Homing, Jog, Profile position and Profile velocity operating modes. *)
(*Drive.stPlcToStoeber.udnAxxxMaxJerk :=																			(* Maximum permitted jerk. *)*)
Drive.stPlcToStoeber.dnA570SoftwarePosLimitMin := Axis.stPlcToNc.stCIA402.dnSoftwarePosLimitMin;							(* Positions of the software position limitation minimum *)
Drive.stPlcToStoeber.dnA570SoftwarePosLimitMax := Axis.stPlcToNc.stCIA402.dnSoftwarePosLimitMax;						(* Positions of the software position limitation maximum *);
Drive.stPlcToStoeber.dwA637DigitalOutputs :=  Axis.stPlcToNc.stCIA402.dwDigitalOutputs;

(*
Drive.stPlcToStoeber.wI210PosiControlWord.1 := Axis.stPlcToNc.bFeedEnablePlus;				(* Feed enable plus *)
Drive.stPlcToStoeber.wI210PosiControlWord.2 := Axis.stPlcToNc.bFeedEnableMinus;			(* Feed enable minus *)
Drive.stPlcToStoeber.wI210PosiControlWord.3 :=  Axis.stPlcToNc.bHomingSensor;				(* Referencing cam signal or homing sensor *)

Drive.stPlcToStoeber.nI230Override := Axis.stPlcToNc.stCommandPositioning.nOverride;							(* Value of override 16384 = 100 %. *)

Drive.stPlcToStoeber.dnI34ReferencePosition := Axis.stPlcToNc.stCommandPositioning.dnReferencePosition;		(* Value which is loaded as the actual position in the reference point.  *)

Drive.stPlcToStoeber.nD230NReferenceValueRelative := LREAL_TO_INT(Axis.stPlcToNc.stFastRefereneValue.nSpeed * Axis.stPlcToNc.stFastRefereneValue.nOverride/100.0);				(* Relative speed reference value *)

*)]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSI6_CIA402_AxisLink">
      <LineId Id="12" Count="247" />
    </LineIds>
  </POU>
</TcPlcObject>