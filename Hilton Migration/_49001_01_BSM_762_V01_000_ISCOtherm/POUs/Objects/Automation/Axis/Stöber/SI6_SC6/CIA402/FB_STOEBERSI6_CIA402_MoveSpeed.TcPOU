<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_MoveSpeed" Id="{7a0441af-e0d7-4c71-87ef-c0e5320c284c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_MoveSpeed
(*

The function block used to starts a continuous movement with specified velocity and direction. 

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execut the function block *)
	lrVelocity						:LREAL;			(* Value of velocity *)
	lrAcceleration					:LREAL;			(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;			(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;			(* Value of the jerk (always positive). *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bInVelocity					:BOOL;			(* Target velocity is reached *)
	bCmdAborted				:BOOL;			(* Command aborted *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis							:ST_AXIS_REF;
END_VAR
VAR
	(* Enummerations *)
	etMC_States					:ET_MC_States := ET_MC_States_eInit;

	(* Variables *)
	nWatchdog					:INT;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
	rtAborted						:R_TRIG;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);
rtAborted(CLK := NOT Axis.stNcToPlc.stCIA402.bSwitchedOn);

IF rtAborted.Q                                             									(* Aborted *)
THEN
	etMC_States := ET_MC_States_eAbort;                   					 (* Next step *)

ELSIF rtExecute.Q
	    AND NOT bCmdAborted
THEN
	etMC_States := ET_MC_States_eInit;                      						(* Next step *)

END_IF;

IF Axis.stNcToPlc.stCIA402.bEnabled				(* Enabled *)
    AND Axis.stNcToPlc.stCIA402.bConstantVelocity
    AND Axis.stNcToPlc.stCIA402.etModesOfOperation = ET_ModesOfOperation_ProfilePosition						(* Activated profile position mode *)
THEN
	Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity := LREAL_TO_DINT(lrVelocity * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits)			(* Value of velocity *)
														* (Axis.stPlcToNc.stCIA402.nOverride/100.0));											(* Override *)
END_IF;

CASE etMC_States OF

	ET_MC_States_eInit:
		bCmdAborted := FALSE;			(* Command not aborted *)
		bBusy := FALSE;                                     	(* Program not busy *)
		bError := FALSE;                         		(* Program not error *)
		udnErrorNo := 0;                         		(* Error number *)

		IF rtExecute.Q
		     AND NOT Axis.bLockPDO
		THEN
			nWatchdog := 0;
			bInVelocity := FALSE;                          	(* Target velocity is not reached *)
			bBusy := TRUE;                                  	(* Program busy *)

			Axis.bLockPDO := TRUE;

			IF Axis.stNcToPlc.stCIA402.bSwitchedOn						(* Switched on *)
			     AND Axis.stNcToPlc.stCIA402.bReferenced          				(* Axis in reference *)
			THEN
				IF Axis.stNcToPlc.stCIA402.bEnabled
				THEN
					IF Axis.stNcToPlc.stCIA402.etModesOfOperation <> ET_ModesOfOperation_ProfileVelocity						(* Activated profile velocity mode *)
					THEN
						Axis.stPlcToNc.stCIA402.bEnableOperation := TRUE;
						Axis.stPlcToNc.stCIA402.bHalt := TRUE;

						etMC_States := ET_MC_States_eReset;             (* Next step *)
	
					ELSE
						Axis.stPlcToNc.stCIA402.bEnableOperation := TRUE;

						etMC_States := ET_MC_States_eRunning;		(* Next step *)

					END_IF
				ELSE
					etMC_States := ET_MC_States_eReset;             (* Next step *)

				END_IF;

			ELSIF Axis.stNcToPlc.stCIA402.bError					(* Error *)
			THEN
				udnErrorNo := 1;                     (* Error number *)

				etMC_States := ET_MC_States_eError;             (* Next step *)

			ELSE
				udnErrorNo := 2;                     (* Error number *)

				etMC_States := ET_MC_States_eError;             (* Next step *)

			END_IF;
		END_IF;

	ET_MC_States_eReset:
		nWatchdog := nWatchdog + 1;

		IF Axis.stNcToPlc.stCIA402.bNotMoving         				(* Axis sillstand *)
		THEN
			Axis.stPlcToNc.stCIA402.etModesOfOperation := ET_ModesOfOperation_ProfileVelocity;					(* Activates profile velocity mode *)

			nWatchdog := 0;

			etMC_States := ET_MC_States_eRunning;			(* Next step *)

		ELSIF Axis.stNcToPlc.stCIA402.bError					(* Error *)
			   OR nWatchdog > 1500
		THEN
			Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;
			Axis.stPlcToNc.stCIA402.bHalt := FALSE;

			udnErrorNo := 3;                     (* Error number *)

			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eRunning:
		nWatchdog := nWatchdog + 1;

		IF Axis.stNcToPlc.stCIA402.etModesOfOperation = ET_ModesOfOperation_ProfileVelocity						(* Activated profile velocity mode *)
		THEN
			Axis.stPlcToNc.stCIA402.bEnableOperation := TRUE;
			Axis.stPlcToNc.stCIA402.bHalt := FALSE;

			Axis.stPlcToNc.stCIA402.stVelocityMode.dnTargetVelocity := LREAL_TO_DINT(lrVelocity * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits)								(* Value of velocity *)
																* (Axis.stPlcToNc.stCIA402.nOverride/100.0));																(* Override *)
			Axis.stPlcToNc.stCIA402.stVelocityMode.udnAcceleration := LREAL_TO_UDINT(ABS(lrAcceleration) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           				(* Value of the acceleration (always positive) *)
			Axis.stPlcToNc.stCIA402.stVelocityMode.udnDeceleration:= LREAL_TO_UDINT(ABS(lrDeceleration) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           				(* Value of the deceleration (always positive) *)
			Axis.stPlcToNc.stCIA402.stVelocityMode.udnJerk:= LREAL_TO_UDINT(ABS(lrJerk) * EXPT(10,Axis.stNcToPlc.stCIA402.snDecimalDigits));           								(* Value of the deceleration (always positive) *)

			nWatchdog := 0;

			etMC_States := ET_MC_States_eWaiting;           (* Next step *)

		ELSIF Axis.stNcToPlc.stCIA402.bError					(* Error *)
			   OR nWatchdog > 1500
		THEN
			Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;
			Axis.stPlcToNc.stCIA402.bHalt := FALSE;

			udnErrorNo := 4;                     (* Error number *)

			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eWaiting:
		IF Axis.stNcToPlc.stCIA402.bEnabled				(* Enabled *)
		     AND Axis.stNcToPlc.stCIA402.stVelocityMode.bVelocityReached
		     AND Axis.stNcToPlc.stCIA402.bPLCOpenDone      		(* Command done *)
		THEN
			etMC_States := ET_MC_States_eDone;              (* Next step *)

		ELSIF Axis.stNcToPlc.stCIA402.bError					(* Error *)
		THEN
			Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;
			Axis.stPlcToNc.stCIA402.bHalt := FALSE;

			udnErrorNo := 5;                     (* Error number *)

			etMC_States := ET_MC_States_eError;             (* Next step *)
		END_IF;

	ET_MC_States_eAbort:
		bCmdAborted := TRUE;			(* Command aborted *)
		bInVelocity := FALSE;                               	(* Target velocity is not reached *)

		Axis.stPlcToNc.stCIA402.bEnableOperation := FALSE;
		Axis.stPlcToNc.stCIA402.bHalt := FALSE;

		 etMC_States := ET_MC_States_eNotExecute;        (* Next step *)

	ET_MC_States_eDone:
		nWatchdog := 0;
		bInVelocity := TRUE;				(* Target velocity is reached *)
		bBusy := FALSE;                                      	(* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;            (* Next step *)

	ET_MC_States_eError:
		nWatchdog := 0;
	         bInVelocity := FALSE;			(* Target velocity is not reached *)
	         bError := TRUE;				(* Program error  *)
	         bBusy := FALSE;				(* Program not busy *)

		etMC_States := ET_MC_States_eNotExecute;            (* Next step *)

	ET_MC_States_eNotExecute:
		IF NOT bExecute
		THEN
			nWatchdog := 0;
			Axis.bLockPDO := FALSE;

			bInVelocity := FALSE;		(* Target velocity is not reached *)
			bCmdAborted := FALSE;	(* Command not aborted *)
			bBusy := FALSE;                       (* Program not busy *)
			bError := FALSE;                       (* Program not error *)
			udnErrorNo := 0;                        (* Error number *)

			etMC_States := ET_MC_States_eInit;              (* Next step *)

		END_IF;
END_CASE;]]></ST>
    </Implementation>
    <LineIds Name="FB_STOEBERSI6_CIA402_MoveSpeed">
      <LineId Id="50" Count="184" />
    </LineIds>
  </POU>
</TcPlcObject>