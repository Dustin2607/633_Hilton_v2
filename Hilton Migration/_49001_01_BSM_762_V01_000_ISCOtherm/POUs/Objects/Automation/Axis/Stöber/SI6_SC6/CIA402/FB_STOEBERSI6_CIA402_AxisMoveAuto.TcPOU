<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_STOEBERSI6_CIA402_AxisMoveAuto" Id="{12d5bc9e-0d0e-4ff0-a7d1-179b6d4f28e1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_STOEBERSI6_CIA402_AxisMoveAuto
(*

The function block used to auto control of axis.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			22.09.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bCtrlEnabled					:BOOL;						(* Controller enabled *)
	bReset						:BOOL;						(* Reset *)
	bExeHome					:BOOL;						(* Execute home *)
	bExeMoveAbs				:BOOL;						(* Execute move absolut *)
	bExeMoveRel				:BOOL;						(* Execute move relative *)
	bExeMoveSpeed				:BOOL;						(* Execute move speed *)
	bExeStop					:BOOL;						(* Execute stop *)
	bExeHalt						:BOOL;						(* Execute stop *)
	lrPosition						:LREAL;						(* Target position *)
	lrVelocity						:LREAL;						(* Target velocity *)
	lrAcceleration					:LREAL;						(* Value of the acceleration (always positive) *)
	lrDeceleration				:LREAL;						(* Value of deceleration (always positive) *)
	lrJerk						:LREAL;						(* Value of jerk (always positive) *)
	lrOriginPosition				:LREAL;						(* Origin position *)
	snHomeMethod				:SINT;						(* Home method *)
	tControllerOff					:TIME := t#60s;				(* Time to switch controller off *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bInReference					:BOOL;						(* Target has reference *)
	bInPosition					:BOOL;						(* Target position is reached *)
	bInVelocity					:BOOL;						(* Target velocity is reached *)
	bStopped					:BOOL;						(* Target stopped *)
	bControllerOff					:BOOL;						(* Switch controller off *)
	bError						:BOOL;						(* Program error *)
	udnErrorNo					:UDINT;						(* Error number *)
END_VAR
VAR_IN_OUT
	bHomeCompleted				:BOOL;						(* Home completed *)
	Axis							:ST_AXIS_REF;				(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	bFirstTime					:BOOL;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbHome						:FB_STOEBERSI6_CIA402_Home;
	fbMoveAbs					:FB_STOEBERSI6_CIA402_MoveAbsolut;
	fbMoveRel					:FB_STOEBERSI6_CIA402_MoveRelative;
	fbMoveSpeed				:FB_STOEBERSI6_CIA402_MoveSpeed;
	fbStop						:FB_STOEBERSI6_CIA402_Stop;
	fbHalt						:FB_STOEBERSI6_CIA402_Halt;
	fbStateIdle					:FB_SignalWatchdog;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bEnable								(* Signal FB enable *)
THEN

	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveRelative used to moves the axis a specified distance relative to the actual position at the time of the execution. *)
	fbMoveRel(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveSpeed starts a continuous movement with specified velocity and direction.  *)
	fbMoveSpeed(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbStop(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bStopped
	);

	(* The function block Halt stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbHalt(
		bExecute := FALSE,
		Axis := Axis,
		bDone =>
	);

	fbStateIdle(
		bEnable := FALSE,
		tWatchdog := tControllerOff
	);

	bControllerOff := FALSE;

	bFirstTime := FALSE;

	RETURN;
END_IF;

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

IF bReset
     AND bError
THEN
	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveRelative used to moves the axis a specified distance relative to the actual position at the time of the execution. *)
	fbMoveRel(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveSpeed starts a continuous movement with specified velocity and direction.  *)
	fbMoveSpeed(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbStop(
		bExecute := bExeStop,
		Axis := Axis,
		bDone => bStopped
	);

	(* The function block Halt stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbHalt(
		bExecute := FALSE,
		Axis := Axis,
		bDone =>
	);
END_IF;

IF bCtrlEnabled
     AND NOT Axis.bCmdInterrupted
     AND (etMachineMode = ET_MachineMode_eAutomatic
		OR etMachineMode = ET_MachineMode_eStepping
		OR etMachineMode = ET_MachineMode_eHome)
    AND etMachineState <> ET_MachineState_eIdle
    AND etMachineState <> ET_MachineState_eUndefined
THEN
	(* Calibration of the axis (referencing) is carried out with the function block Home. *)
	fbHome(
		bExecute := bExeHome,
		lrOriginPosition := lrOriginPosition,
		snMethod := snHomeMethod,
		Axis := Axis,
		bDone => bInReference,
	);

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := bExeMoveAbs,
		lrPosition := lrPosition,
		lrVelocity := lrVelocity,
		lrAcceleration := lrAcceleration,
		lrDeceleration := lrDeceleration,
		lrJerk := lrJerk,
		Axis := Axis
	 );

	(* The function block MoveRelative used to moves the axis a specified distance relative to the actual position at the time of the execution. *)
	fbMoveRel(
		bExecute := bExeMoveRel,
		lrPosition := lrPosition,
		lrVelocity := lrVelocity,
		lrAcceleration := lrAcceleration,
		lrDeceleration := lrDeceleration,
		lrJerk := lrJerk,
		Axis := Axis
	 );

	bInPosition := fbMoveAbs.bDone
			        OR fbMoveRel.bDone;

	(* The function block MoveSpeed starts a continuous movement with specified velocity and direction.  *)
	fbMoveSpeed(
		bExecute:= bExeMoveSpeed,
		lrVelocity := lrVelocity,
		lrAcceleration := lrAcceleration,
		lrDeceleration := lrDeceleration,
		lrJerk := lrJerk,
		Axis := Axis,
		bInVelocity => bInVelocity
	);

	(* The function block Halt stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbHalt(
		bExecute := bExeHalt,
		Axis := Axis,
		bDone =>
	);

ELSE
	(* Calibration of the axis (referencing) is carried out with the function block MC_Home. *)
	fbHome(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInReference
	 );

	(* The function block MoveAbsolute starts positioning to an absolute target position and monitors the axis movement over the whole travel path.  *)
	fbMoveAbs(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveRelative used to moves the axis a specified distance relative to the actual position at the time of the execution. *)
	fbMoveRel(
		bExecute := FALSE,
		Axis := Axis,
		bDone => bInPosition
	);

	(* The function block MoveSpeed starts a continuous movement with specified velocity and direction.  *)
	fbMoveSpeed(
		bExecute := FALSE,
		Axis := Axis,
		bInVelocity => bInVelocity
	 );

	(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbStop(
		bExecute := bExeStop,
		Axis := Axis,
		bDone => bStopped
	);

	(* The function block Halt stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
	fbHalt(
		bExecute := FALSE,
		Axis := Axis,
		bDone =>
	);

END_IF;

fbStateIdle(
	bEnable := etMachineMode = ET_MachineMode_eAutomatic
			    OR etMachineMode = ET_MachineMode_eStepping
		  	    OR etMachineMode = ET_MachineMode_eHome,
	bIn := etMachineState <> ET_MachineState_eIdle
		  AND etMachineState <> ET_MachineState_eUndefined,
	tWatchdog := tControllerOff
);

bControllerOff := NOT fbStateIdle.bOut
			    AND (etMachineMode = ET_MachineMode_eAutomatic
				        OR etMachineMode = ET_MachineMode_eStepping
				        OR etMachineMode = ET_MachineMode_eHome);

(* The function block Stop stops an axis with a defined braking ramp and blocks the axis for any motion commands.  *)
fbStop(
	bExecute := bExeStop,
	Axis := Axis,
	bDone => bStopped
);

A_Error();]]></ST>
    </Implementation>
    <Action Name="A_Error" Id="{6c4d0ab9-4cd6-442d-a4b8-c6bfc63c2002}">
      <Implementation>
        <ST><![CDATA[
bError := fbHome.bError
		OR fbMoveAbs.bError
		OR fbMoveRel.bError
		OR fbMoveSpeed.bError
		OR fbStop.bError
		OR fbHalt.bError;]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_STOEBERSI6_CIA402_AxisMoveAuto">
      <LineId Id="70" Count="236" />
    </LineIds>
    <LineIds Name="FB_STOEBERSI6_CIA402_AxisMoveAuto.A_Error">
      <LineId Id="0" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>