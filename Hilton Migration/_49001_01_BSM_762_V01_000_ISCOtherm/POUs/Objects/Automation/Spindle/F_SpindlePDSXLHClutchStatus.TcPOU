<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_SpindlePDSXLHClutchStatus" Id="{e046f800-650b-454f-9ba7-67537fac2204}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_SpindlePDSXLHClutchStatus : ET_SpindleClutchStatus
(*

The function used to get clutch status.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			18.05.2018
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	stClutchStatus						:ST_SpindlePDSXLHClutchStatus; (* Clutch status  *)
END_VAR
VAR
	(* Variables *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT stClutchStatus.bSpindleStandstillS3 AND (NOT stClutchStatus.bToolClampedS1 OR stClutchStatus.bToolEjectedS2)			(* Clutch rotating and not closed *)
THEN
	F_SpindlePDSXLHClutchStatus := ET_SpindleClutchStatus_RotatingNoClosed;

ELSIF NOT stClutchStatus.bToolClampedS1 AND NOT stClutchStatus.bToolEjectedS2			(* Clutch is closed without tool *)
THEN
	F_SpindlePDSXLHClutchStatus := ET_SpindleClutchStatus_ClosedWithoutTool;

ELSIF stClutchStatus.bToolClampedS1 AND NOT stClutchStatus.bToolEjectedS2			(* Clutch is closed with tool *)
THEN
	F_SpindlePDSXLHClutchStatus := ET_SpindleClutchStatus_ClosedWithTool;

ELSIF NOT stClutchStatus.bToolClampedS1 AND stClutchStatus.bToolEjectedS2			(* Clutch is opened *)
THEN
	F_SpindlePDSXLHClutchStatus := ET_SpindleClutchStatus_Opened;

ELSE
	F_SpindlePDSXLHClutchStatus := ET_SpindleClutchStatus_NoDefined;

END_IF


]]></ST>
    </Implementation>
    <LineIds Name="F_SpindlePDSXLHClutchStatus">
      <LineId Id="22" Count="23" />
    </LineIds>
  </POU>
</TcPlcObject>