<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_TypePID" Id="{33d76d89-cd76-4813-9916-cd67b60897af}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TypePID
(*
Function block is a PID controller.
The PID controller works according to the fomula CV = InSignal * (Kp + Ki * Integral(e)).
The output limits are active.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			03.06.2014
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)

VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	bEnable								:BOOL := TRUE;					(* Enable FB *)
	lrInSignal								:LREAL;							(* Input signal *)
	lrKp									:LREAL := 0.005;					(* Tuning parameter, proportional part *)
	lrTi									:LREAL := 1E32;					(* Tuning parameter, time of integral *)
	lrTd									:LREAL := 1E32;					(* Tuning parameter, time of differential *)
	lrTaskCycle							:LREAL := 1.0; 					(* Cycle time *)
	bSetToZero 							:BOOL;							(* Integral setting to zero *)
	lrLimitMin								:LREAL := -1E40;					(* Limit minimum *)
	lrLimitMax							:LREAL := 1E40;					(* Limit maximum *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR
VAR_OUTPUT
	(* Enummerations *)

	(* Variables *)
	lrOutSignal							:LREAL;							(* Output signal *)
	bLimitMin							:BOOL;							(* Limit minimum reached *)
	bLimitMax							:BOOL;							(* Limit maximum reached *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbCompP							:FB_CompP;
	fbCompI								:FB_CompI;
	fbCompD							:FB_CompD;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Calculate  proportional *)
fbCompP(
	bEnable := bEnable,
	lrInSignal := lrInSignal,
	lrProportionalValue := lrKp,
);

(* Calculate integrator *)
fbCompI(
	bEnable := bEnable,
	lrInSignal := lrInSignal,
	lrIntegralValue := SEL(lrTi > 0, lrKp, lrKp / lrTi),
	lrTaskCycle := lrTaskCycle,
	bSetToZero := SEL(lrTi > 0, TRUE, bSetToZero),
	lrLimitMin := lrLimitMin,
	lrLimitMax := lrLimitMax,
	bLimitMin => bLimitMin,
	bLimitMax => bLimitMax);

(* Calculate differential *)
fbCompD(
	bEnable := bEnable,
	lrInSignal := lrInSignal,
	lrDifferentialValue := lrKp * lrTd,
	lrTaskCycle := lrTaskCycle,
);


lrOutSignal := fbCompP.lrOutSignal + fbCompI.lrOutSignal + fbCompD.lrOutSignal;]]></ST>
    </Implementation>
    <LineIds Name="FB_TypePID">
      <LineId Id="66" Count="29" />
    </LineIds>
  </POU>
</TcPlcObject>