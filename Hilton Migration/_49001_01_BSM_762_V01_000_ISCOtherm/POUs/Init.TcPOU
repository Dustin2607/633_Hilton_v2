<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Init" Id="{686a804b-e730-4808-9911-31ba1cd60631}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Init
VAR
	bFirstTime					:BOOL; 				(* False = first run / True = not first run *)
END_VAR
VAR PERSISTENT
	bFirstTimePersistent			:BOOL;				(* Persistente Daten initialisieren *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bFirstTime
THEN
	A_InitGr0000();
	A_InitGr0100();
	A_InitGr0200();
	A_InitGr0500();

	bFirstTime:= TRUE;
END_IF

IF NOT bFirstTimePersistent
THEN

	bFirstTimePersistent:= TRUE;
END_IF]]></ST>
    </Implementation>
