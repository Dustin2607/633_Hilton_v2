<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="CheckBounds_1" Id="{e49a7ac7-9dda-409b-914c-27bb7c645f07}" SpecialFunc="CheckBounds">
    <Declaration><![CDATA[FUNCTION CheckBounds_1 : DINT
VAR_INPUT
	index: DINT;
	lower: DINT;
	upper: DINT;
END_VAR
VAR_EXTERNAL
	fbCheckArrayBounds: FB_CheckArrayBounds;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*This function checks if an index out of range an array is being accessed *)

fbCheckArrayBounds(
	diArrayIndex			:= index,
	diLowerBound		:= lower,
	diUpperBound		:= upper,
	sLogMessage		=> ,
	diReturnBound		=> CheckBounds);
]]></ST>
    </Implementation>
    <LineIds Name="CheckBounds_1">
      <LineId Id="9" Count="8" />
    </LineIds>
  </POU>
</TcPlcObject>