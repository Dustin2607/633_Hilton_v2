      <LineId Id="69" Count="0" />
      <LineId Id="80" Count="2" />
      <LineId Id="106" Count="0" />
      <LineId Id="83" Count="0" />
      <LineId Id="77" Count="0" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
