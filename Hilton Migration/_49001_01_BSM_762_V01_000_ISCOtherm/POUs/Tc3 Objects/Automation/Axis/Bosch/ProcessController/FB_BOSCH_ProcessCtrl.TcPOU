<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BOSCH_ProcessCtrl" Id="{d5b812e5-48d4-4646-90d5-6682b98993a7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BOSCH_ProcessCtrl
(*

The function block used to control Bosch process controller. 

Constructor:		Patryk Panylo
Company:			E. Riexinger GmbH
Date:				05.02.2019
Version:			1.00

Date:				Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL;						(* Signal FB enable *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bCtrlEnabled				:BOOL;						(* Controller enabled *)
	bTerminalOK					:BOOL;						(* Terminal Ok *)
	bReset						:BOOL;						(* Signal reset *)
	bExeReset					:BOOL;						(* Execute auto reset *)
	bExeStart					:BOOL;						(* Execute home *)
	bExeStop					:BOOL;						(* Execute stop *)
	rSetProcessValue			:REAL;						(* Set process value *)
	rSetProcessValueScaling		:REAL;						(* Set process value scaling *)
	rActProcessValueoOffset		:REAL;						(* Current process value offset *)
	rProportionalGain			:REAL;						(* Tuning parameter, proportional gain *)
	rIntegralTime				:REAL;						(* Tuning parameter, time of integral [ms] *)
	rCtrlLimitUpper				:REAL;						(* Controller limitation, upper *)
	rCtrlLimitLower				:REAL;						(* Controller limitation, lower *)
	rPosLimitUpper				:REAL;						(* Position limitation, upper *)
	rPosLimitLower				:REAL;						(* Position limitation, lower *)
	tAdsTimeOut 				:TIME := T#2S;				(* Timout for ads commands *)	
	pProcessCtrl				:POINTER TO ST_FWS_MLDPCx_PRE_01Vxx_MPxx;
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	lrActProcessValue			:LREAL;						(* Current process value *)	
	bEnabled					:BOOL;						(* Controller is ready for operation. *)
	bError						:BOOL;						(* Error *)
	bErrInit					:BOOL;						(* Controller initialization error *)
	bErrProcessCtrl         	:BOOL;     					(* Process controller error *)
	bErrMLDNotRunning         	:BOOL;     					(* MLD not running error *)
	bErrDriveNotEnabled         :BOOL;     					(* Drive is not enabled error *)
	bErrCtrlLimitActive			:BOOL;						(* Controller limit active error *)	
	bErrPosLimitExceeded        :BOOL;     					(* Position limit exceeded error *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	etBoschProcessCtrlGetValue	:ET_BOSCH_ProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eWaitExecute;
	bGetValueExe				:BOOL;						(* Progam execute *)
	bGetValueDone 				:BOOL;                		(* Program done *)
	bGetValueBusy 				:BOOL;                 		(* Program busy *)
	bGetValueError 				:BOOL;           			(* Program error *)
	bGetValueInitDone 			:BOOL;             			(* Program initialization done *)
	udnGetValueErrorNo 			:UDINT;						(* Error number *)
	unGetValueWatchdog			:UINT;
	
	etBoschProcessCtrlSetValue	:ET_BOSCH_ProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eWaitExecute;
	bSetValueExe				:BOOL;						(* Progam execute *)
	bSetValueDone 				:BOOL;                      (* Program done *)
	bSetValueBusy 				:BOOL;                      (* Program busy *)
	bSetValueError 				:BOOL;                      (* Program error *)
	bSetValueInitDone 			:BOOL;                      (* Program initialization done *)
	udnSetValueErrorNo 			:UDINT;						(* Error number *)
	unSetValueWatchdog			:UINT;
	
	wPLCControlword				:WORD;						(* P-0-1350, PLC Controlword *) 
	wPLCStatusword				:WORD;						(* P-0-1351, PLC Statusword *)
	dwProcessCtrlConfig			:DWORD;						(* P-0-1370, Configuration *) 
	dnAIScaling					:DINT;						(* P-0-0214, Scaling analog input *)	
	
	bErrWatchdog        		:BOOL;     					(* Watchdog error *)
	
	tonFirstInit				:TON;						(* First initialization *)
	bFirstTime					:BOOL;
	
	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbStart						:FB_BOSCH_ProcessCtrl_Start;
	fbStop						:FB_BOSCH_ProcessCtrl_Stop;
	fbReset						:FB_BOSCH_ProcessCtrl_Reset;
	fbEcSoERead					:FB_EcSoERead;
	fbEcSoEWrite				:FB_EcSoEWrite;
	tofRepeateSetValueInit		:TOF;
	tofRepeateGetValueInit		:TOF;
END_VAR
VAR CONSTANT
	wIdxPPara					:WORD := 16#8000;						(* Index offset for P Parameters *)
	wPLCControlwordPara			:WORD := wIdxPPara + 1350;				(* P-0-1350, PLC Controlword *) 
	wPLCStatuswordPara			:WORD := wIdxPPara + 1351;				(* P-0-1351, PLC Statusword *)
	wProcessCtrlConfigPara		:WORD := wIdxPPara + 1370;				(* P-0-1370, Configuration *)
	wAIScalingPara				:WORD := wIdxPPara + 214;				(* P-0-0214, Scaling analog input *)

	tFirstInit					:TIME := T#2S;							(* First initialization *)
	tRepeateInit				:TIME := t#1s;							(* Repeate initialization *)
	
	unWatchdogMax				:UINT := 150;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
A_GetValue();
A_SetValue();
A_Controller();
A_Error();



]]></ST>
    </Implementation>
    <Action Name="A_Controller" Id="{f31a9726-39b2-4b5d-8ff9-f8f97546e6b6}">
      <Implementation>
        <ST><![CDATA[
IF NOT bEnable								(* Signal FB enable *)
THEN
	(* The function block resets bosch process controller *)
	fbReset(
		bExecute := FALSE, 
		pProcessCtrl := pProcessCtrl
	);

	(* The function block starts bosch process controller *)
	fbStart(
		bExecute := FALSE, 
		pProcessCtrl := pProcessCtrl
	);

	(* The function block starts bosch process controller *)
	fbStop(
		bExecute := FALSE, 
		pProcessCtrl := pProcessCtrl
	);

	bFirstTime := FALSE;

	RETURN;
END_IF;

IF NOT bFirstTime
THEN

	bFirstTime := TRUE;
END_IF;

IF bReset
   AND bError
THEN
	(* The function block starts bosch process controller *)
	fbStart(
		bExecute := FALSE, 
		pProcessCtrl := pProcessCtrl
	);

	(* The function block starts bosch process controller *)
	fbStop(
		bExecute := FALSE, 
		pProcessCtrl := pProcessCtrl
	);

END_IF;

IF bCtrlEnabled
    AND (etMachineMode = ET_MachineMode_eAutomatic
		 OR etMachineMode = ET_MachineMode_eStepping
		 OR etMachineMode = ET_MachineMode_eHome
		 OR etMachineMode = ET_MachineMode_eMaintenance)
    AND etMachineState <> ET_MachineState_eIdle
    AND etMachineState <> ET_MachineState_eUndefined
THEN
	(* The function block starts bosch process controller *)
	fbStart(
		bExecute := bExeStart,
		rCtrlLimitUpper := rCtrlLimitUpper,
		rCtrlLimitLower := rCtrlLimitLower,
		rPosLimitUpper := rPosLimitUpper,
		rPosLimitLower := rPosLimitLower,
		tAdsTimeOut := tAdsTimeOut,	
		pProcessCtrl := pProcessCtrl
	);

ELSE
	(* The function block starts bosch process controller *)
	fbStart(
		bExecute := FALSE,
		tAdsTimeOut := tAdsTimeOut, 
		pProcessCtrl := pProcessCtrl
	);

END_IF;

(* The function block resets bosch process controller *)
fbReset(
	bExecute := bReset
	            XOR bExeReset, 
	pProcessCtrl := pProcessCtrl
);

(* The function block starts bosch process controller *)
fbStop(
	bExecute := bExeStop,
	tAdsTimeOut := tAdsTimeOut,	 
	pProcessCtrl := pProcessCtrl
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Error" Id="{731e394f-2b66-4494-9f07-dea23fd013b7}">
      <Implementation>
        <ST><![CDATA[
bErrInit := bGetValueError
		    OR bSetValueError;

bError := fbStart.bError 
		  OR fbStop.bError 
		  OR fbReset.bError;
		  
bErrProcessCtrl := fbStart.bError					
				   AND fbStart.udnErrorNo = 10;			(* Process controller error *)
bErrMLDNotRunning := fbStart.bError					
					 AND fbStart.udnErrorNo = 2;     	(* MLD not running error *)
bErrDriveNotEnabled := fbStart.bError					
					    AND fbStart.udnErrorNo = 1;     (* Drive is not enabled error *)
						
bErrPosLimitExceeded := pProcessCtrl^.bUpperPosLimitExceeded
						OR pProcessCtrl^.bLowerPosLimitExceeded;
 
bErrCtrlLimitActive := pProcessCtrl^.bUpperCtrlOutLimitActive
						 OR pProcessCtrl^.bLowerCtrlOutLimitActive;						
						
bErrWatchdog := (fbStart.bError AND fbStart.udnErrorNo = 99)			(* Watchdog error *)
				 OR (fbStop.bError AND fbStop.udnErrorNo = 99);						]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_GetValue" Id="{4c2be926-6f71-4af8-872f-56b669ae6120}">
      <Implementation>
        <ST><![CDATA[
lrActProcessValue := F_LRealRound(lrReal := REAL_TO_LREAL(pProcessCtrl^.rActProcessValue), usiPrecision := 2); 
bEnabled := pProcessCtrl^.bEnabled;

(* Get value execute *)
tofRepeateGetValueInit(
	IN := bGetValueError,
	PT := tRepeateInit
);

tonFirstInit(
	IN:= bTerminalOK
		 AND NOT bGetValueInitDone,
	PT := tFirstInit
);

bGetValueExe := (tonFirstInit.Q
				 OR bGetValueInitDone)
				 AND NOT tofRepeateGetValueInit.Q;
				
(* Get axis limits *)
CASE etBoschProcessCtrlGetValue OF

	ET_BOSCH_ProcessCtrlGetValue_eWaitExecute:
		IF bGetValueExe
		   AND bTerminalOK
		THEN
			unGetValueWatchdog := 0;
			bGetValueDone := FALSE;                                	(* Program done *)
			bGetValueBusy := TRUE;                                 (* Program not busy *)
			bGetValueError := FALSE;                                 (* Program not error *)
			udnGetValueErrorNo := 0;
			
			fbEcSoERead(
				sNetId := pProcessCtrl^.sNetId, 
				nSlaveAddr := pProcessCtrl^.unSlaveAddr, 
				nElement := 16#40, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE,  
				tTimeout := tAdsTimeOut 
			);
			
			fbEcSoEWrite(
				sNetId := pProcessCtrl^.sNetId, 
				nSlaveAddr := pProcessCtrl^.unSlaveAddr, 
				nElement := 0, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE, 
				tTimeout := tAdsTimeOut 
			);
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_ePLCControlword;         		(* Next step *)
		END_IF

	ET_BOSCH_ProcessCtrlGetValue_ePLCControlword:
		(* P-0-1350, PLC Controlword *) 	
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wPLCControlwordPara,			
			pDstBuf := ADR(wPLCControlword),
			cbBufLen := SIZEOF(wPLCControlword)
		);

		unGetValueWatchdog := unGetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			unGetValueWatchdog := 0;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_ePLCStatusword;         		(* Next step *)

		ELSIF fbEcSoERead.bError
			  OR unGetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnGetValueErrorNo := 1;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eError;         		(* Next step *)

		END_IF

	ET_BOSCH_ProcessCtrlGetValue_ePLCStatusword:
		(* P-0-1351, PLC Statusword *) 	
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wPLCStatuswordPara,		
			pDstBuf := ADR(wPLCStatusword), 
			cbBufLen := SIZEOF(wPLCStatusword) 
		);
		
		unGetValueWatchdog := unGetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			unGetValueWatchdog := 0;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eProcessCtrlConfig;         		(* Next step *)

		ELSIF fbEcSoERead.bError
			  OR unGetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnGetValueErrorNo := 2;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eError;         		(* Next step *)

		END_IF
		
	ET_BOSCH_ProcessCtrlGetValue_eProcessCtrlConfig:
		(* P-0-1370, Configuration *) 	
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wProcessCtrlConfigPara,		
			pDstBuf := ADR(dwProcessCtrlConfig),
			cbBufLen := SIZEOF(dwProcessCtrlConfig)
		);
		
		unGetValueWatchdog := unGetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			unGetValueWatchdog := 0;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eDone;         		(* Next step *)

		ELSIF fbEcSoERead.bError
			  OR unGetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnGetValueErrorNo := 3;
			
			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_ProcessCtrlGetValue_eDone:
		bGetValueDone := TRUE;                                     		(* Program done, in position *)
		bGetValueBusy := FALSE;                                     		(* Program not busy *)
		bGetValueInitDone := TRUE;                             		(* Program initialization done *)

		etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eNoExecute;            	(* Next step *)

	ET_BOSCH_ProcessCtrlGetValue_eError:
		bGetValueDone := FALSE;                                     		(* Program done, in position *)
		bGetValueError := TRUE;                                     		(* Program error *)
		bGetValueBusy := FALSE;                                     		(* Program not busy *)
		bGetValueInitDone := FALSE;                             		(* Program initialization done *)

		etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eNoExecute;           	(* Next step *)

	ET_BOSCH_ProcessCtrlGetValue_eNoExecute:
		IF NOT bGetvalueExe
		THEN
			bGetValueDone := FALSE;                                     		(* Program done, in position *)
			bGetValueError := FALSE;                                     		(* Program error *)
			bGetValueBusy := FALSE;                                     		(* Program not busy *)

			etBoschProcessCtrlGetValue := ET_BOSCH_ProcessCtrlGetValue_eWaitExecute;       (* Next step *)
		END_IF

END_CASE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_SetValue" Id="{f7b4e2a4-663d-4778-9c32-fe8ffbbf9e27}">
      <Implementation>
        <ST><![CDATA[
pProcessCtrl^.bDriveEnabled := bCtrlEnabled;
pProcessCtrl^.rSetProcessValue := rSetProcessValue;
pProcessCtrl^.rProportionalGain := ABS(rProportionalGain);
pProcessCtrl^.rIntegralTime := ABS(rIntegralTime);
pProcessCtrl^.rActProcessValueoOffset := -rActProcessValueoOffset;
pProcessCtrl^.bMLDRunning := wPLCStatusword.0;

(* Set value execute *)
tofRepeateSetValueInit(
	IN := bSetValueError,
	PT := tRepeateInit
);

bSetValueExe := SEL(
					bSetValueInitDone,
					NOT tofRepeateSetValueInit.Q,
					NOT tofRepeateSetValueInit.Q
					AND (
							(dnAIScaling <> LREAL_TO_DINT(rSetProcessValueScaling * EXPT(10, pProcessCtrl^.usnDecimalDigits)))
						)
					);

(* Set bosch process controller value *)
CASE etBoschProcessCtrlSetValue OF

	ET_BOSCH_ProcessCtrlSetValue_eWaitExecute:
		IF bSetvalueExe
		   AND bTerminalOK
		   AND bGetValueInitDone
		THEN
			unSetValueWatchdog := 0;
			bSetValueDone := FALSE;                                	(* Program done *)
			bSetValueBusy := TRUE;                                 (* Program not busy *)
			bSetValueError := FALSE;                                (* Program not error *)
			udnSetValueErrorNo := 0;
			
			fbEcSoERead(
				sNetId := pProcessCtrl^.sNetId, 
				nSlaveAddr := pProcessCtrl^.unSlaveAddr, 
				nElement := 16#40, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE,  
				tTimeout := tAdsTimeOut 
			);
			
			fbEcSoEWrite(
				sNetId := pProcessCtrl^.sNetId, 
				nSlaveAddr := pProcessCtrl^.unSlaveAddr, 
				nElement := 0, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE, 
				tTimeout := tAdsTimeOut 
			);

			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eGetPLCControlword;         		(* Next step *)

		END_IF;

	ET_BOSCH_ProcessCtrlSetValue_eGetPLCControlword:
		(* P-0-1350, PLC Controlword *) 			
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wPLCControlwordPara,			
			pDstBuf := ADR(wPLCControlword), 
			cbBufLen := SIZEOF(wPLCControlword) 
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			unSetValueWatchdog := 0;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_ePLCControlword;         		(* Next step *)

		ELSIF fbEcSoERead.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 1;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF	

	ET_BOSCH_ProcessCtrlSetValue_ePLCControlword:	
		(* P-0-1350, PLC Controlword, MLD start *)
		wPLCControlword.0 := TRUE; 		
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wPLCControlwordPara,			
			pSrcBuf := ADR(wPLCControlword),
			cbBufLen := SIZEOF(wPLCControlword)
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			unSetValueWatchdog := 0;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eGetPLCStatusword;         		(* Next step *)

		ELSIF fbEcSoEWrite.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 2;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF	
	
	ET_BOSCH_ProcessCtrlSetValue_eGetPLCStatusword:
		(* P-0-1351, PLC Statusword *) 		
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wPLCStatuswordPara,		
			pDstBuf := ADR(wPLCStatusword),
			cbBufLen := SIZEOF(wPLCStatusword) 
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			IF wPLCStatusword.0
			THEN
				unSetValueWatchdog := 0;
			
				etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eGetProcessCtrlConfig;         		(* Next step *)			
			END_IF;
			
		ELSIF fbEcSoERead.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 3;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_ProcessCtrlSetValue_eGetProcessCtrlConfig:
		(* P-0-1370, Configuration *) 	
		fbEcSoERead(
			bExecute := TRUE,
			nIdn := wProcessCtrlConfigPara,			
			pDstBuf := ADR(dwProcessCtrlConfig),
			cbBufLen := SIZEOF(dwProcessCtrlConfig)
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			unSetValueWatchdog := 0;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eProcessCtrlConfig;         		(* Next step *)

		ELSIF fbEcSoERead.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 4;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF
				
	ET_BOSCH_ProcessCtrlSetValue_eProcessCtrlConfig:
		(* P-0-1370, Configuration*)
		dwProcessCtrlConfig.6 := TRUE;  		(* Control difference inverted *)
		
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wProcessCtrlConfigPara,			
			pSrcBuf := ADR(dwProcessCtrlConfig), 
			cbBufLen := SIZEOF(dwProcessCtrlConfig) 
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			unSetValueWatchdog := 0;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eAIScaling;         		(* Next step *)

		ELSIF fbEcSoEWrite.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 5;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF	
			
	ET_BOSCH_ProcessCtrlSetValue_eAIScaling:	
		(* P-0-0214, Scaling analog input *)
		dnAIScaling := LREAL_TO_DINT(rSetProcessValueScaling * EXPT(10, pProcessCtrl^.usnDecimalDigits));
				
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wAIScalingPara,			
			pSrcBuf := ADR(dnAIScaling), 
			cbBufLen := SIZEOF(dnAIScaling)
		);
		
		unSetValueWatchdog := unSetValueWatchdog + 1;
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			unSetValueWatchdog := 0;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eDone;         		(* Next step *)

		ELSIF fbEcSoEWrite.bError
			  OR unSetValueWatchdog > unWatchdogMax
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnSetValueErrorNo := 10;
			
			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eError;         		(* Next step *)

		END_IF	
	
	ET_BOSCH_ProcessCtrlSetValue_eDone:
		bSetValueDone := TRUE;                                     		(* Program done, in position *)
		bSetValueBusy := FALSE;                                     	(* Program not busy *)
		bSetValueInitDone := TRUE;                             			(* Program initialization done *)

		etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eNoExecute;            	(* Next step *)

	ET_BOSCH_ProcessCtrlSetValue_eError:
		bSetValueDone := FALSE;                                     	(* Program done, in position *)
		bSetValueError := TRUE;                                     	(* Program error *)
		bSetValueBusy := FALSE;                                     	(* Program not busy *)
		bSetValueInitDone := FALSE;                             		(* Program initialization done *)

		etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eNoExecute;           	(* Next step *)

	ET_BOSCH_ProcessCtrlSetValue_eNoExecute:
		IF NOT bSetValueExe
		THEN
			bSetValueDone := FALSE;                                     		(* Program done, in position *)
			bSetValueError := FALSE;                                     		(* Program error *)
			bSetValueBusy := FALSE;                                     		(* Program not busy *)

			etBoschProcessCtrlSetValue := ET_BOSCH_ProcessCtrlSetValue_eWaitExecute;       (* Next step *)
		END_IF;

END_CASE;
]]></ST>
      </Implementation>
    </Action>
