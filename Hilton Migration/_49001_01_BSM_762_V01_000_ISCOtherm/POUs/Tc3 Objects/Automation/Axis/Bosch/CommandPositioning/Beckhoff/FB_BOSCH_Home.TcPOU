<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BOSCH_Home" Id="{1399e193-93c1-466a-a38f-0914d476bf79}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BOSCH_Home
(*

The function block used to start homing of axis. 

Constructor:		Patryk Panylo
Company:			E. Riexinger GmbH
Date:				08.02.2019
Version:			1.00

Date:				Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;			(* Execut the function block *)
	rOriginPosition				:REAL;			(* Origin position when the reference signal is detected *)
	pDrive						:POINTER TO ST_BOSCHINDRADRIVECIA402_REF;			(* The DRIVE_REF data type  is an interface between the PLC and the DRIVE and contains axis information *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Program done *)
	bInterrupted				:BOOL;			(* Program interrupted *)
	bCmdAborted					:BOOL;			(* Command aborted *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number:
													1: Drive is not enabled error
													2: MLD not running error
   													3: Process controller error
													99: Watchdog error *)				
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Axis						:AXIS_REF;		(* The AXIS_REF data type  is an interface between the PLC and the NC and contains axis information *)
END_VAR
VAR
	(* Enummerations *)
	etBoschHome					:ET_BOSCH_Home := ET_BOSCH_Home.eInit;

	(* Variables *)
	bCacheEnablePosLagMonitoring:BOOL;
	bCacheEnableLimitPos		:BOOL;
	bCacheEnableLimitNeg		:BOOL;
	
	wPLCControlword				:WORD;				(* P-0-1350, PLC Controlword *)
	wCancelReference			:WORD;				(* S-0-0191, C1500 Cancel reference point procedure command *) 
	wPosFeedbackValueStatus		:WORD;				(* S-0-0403, Position feedback value status *) 
	wDiagnostics				:WORD;				(* S-0-0013, Class 3 diagnostics *)
	dnActPositionPara			:DINT;				(* S-0-0051, Position feedback 1 value *)
	dwReferenceDist				:DWORD;				(* S-0-0052, Reference distance 1 *)
	
	
	unWatchdog					:UINT;

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbMCSetPosition				:MC_SetPosition;			(* Reset the motion control *)
	fbMCHome					:MC_Home;					(* Set an reference flag in the motion control *)
	fbMcReadParameter 			:MC_ReadParameter;			(* The function block is used to read an axis parameter. *)
	fbMcReadBoolParameter 		:MC_ReadBoolParameter;		(* The function block is used to reas bool value an axis parameter. *)
	fbMcWriteParameter 			:MC_WriteParameter;			(* The function block is used to write an axis parameter. *)
	fbMcWriteBoolParameter 		:MC_WriteBoolParameter;		(* The function block is used to write bool value an axis parameter. *)
	fbEcSoERead					:FB_EcSoERead;
	fbEcSoEWrite				:FB_EcSoEWrite;
	
	rtExecute					:R_TRIG;
	rtAborted					:R_TRIG;
	
	tonDelay					:TON;
END_VAR
VAR CONSTANT
	wIdxPPara					:WORD := 16#8000;			(* Index offset for P Parameters *)
	wCancelReferencePara		:WORD := 191;				(* S-0-0191, C1500 Cancel reference point procedure command *)
	wDriveControlledHomingPara	:WORD := 148;				(* S-0-0148, C600 Drive controlled homing procedure command *)
	wPosFeedbackValueStatusPara	:WORD := 403;				(* S-0-0403, Position feedback value status *)
	wDiagnosticsPara			:WORD := 13;				(* S-0-0013, Class 3 diagnostics *)
	wActPositionPara			:WORD := 51;				(* S-0-0051, Position feedback 1 value *)
	wReferenceDistPara			:WORD := 52;				(* S-0-0052, Reference distance 1 *)
	
	
	wStartHomingCmd				:WORD := 2#11;				(* 2#11 = Start command *)
	wStopHomingCmd				:WORD := 2#00;				(* 2#00 = Stop command *)	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute);

rtAborted(CLK := NOT pDrive^.bDriveAF);
IF rtAborted.Q                                              (* Aborted *)
THEN	
	bInterrupted := TRUE;		(* Program interrupted *)
	bCmdAborted := TRUE;		(* Command aborted *)
	
	fbEcSoERead(
		bExecute := FALSE
	);
	
	fbEcSoEWrite(
		bExecute := FALSE
	);
	
	etBoschHome := ET_BOSCH_Home.eReadDriveStopped;     (* Next step *)

ELSIF rtExecute.Q
	  AND NOT bCmdAborted
THEN
	etBoschHome := ET_BOSCH_Home.eInit;                     (* Next step *)

END_IF;

CASE etBoschHome OF

	ET_BOSCH_Home.eInit:
		bCmdAborted := FALSE;			(* Command not aborted *)
		bBusy := FALSE;                 (* Program not busy *)
		bError := FALSE;                (* Program not error *)

		IF rtExecute.Q
		   AND NOT Axis.NcToPlc.StateDWord.8	(* Axis has job *)
		   (* AND NOT Axis.NcToPlc.StateDWord.29	(*  29 0/1 MotionCommandsLocked MotionCommandsLocked Achse ist gesperrt für Bewegungskommandos (TcMc2)  *) *)
		THEN
			unWatchdog := 0;
			bInterrupted := FALSE;		(* Program interrupted *)
			bDone := FALSE;				(* Program done, in position *)
			bBusy := TRUE;				(* Program busy *)
			udnErrorNo := 0;            (* Error number *)

			fbMCSetPosition(
				Execute := FALSE,
				Axis := Axis,
			);	
			
			fbMCHome(
				Execute := FALSE,
				Axis := Axis,
			);			
			
			fbMcReadParameter(
				Enable:= FALSE,
				Axis := Axis
			); 
			
			fbMcReadBoolParameter(
				Enable := FALSE,
				Axis := Axis
			);
			
			fbMcWriteParameter(
				Execute := FALSE,
				Axis := Axis
			);

			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);
 
			fbEcSoERead(
				sNetId := Axis.DriveAddress.NetID, 
				nSlaveAddr := Axis.DriveAddress.SlaveAddress, 
				nElement := 16#40, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE, 
				tTimeout := DEFAULT_ADS_TIMEOUT 
			);
			
			fbEcSoEWrite(
				sNetId := Axis.DriveAddress.NetID, 
				nSlaveAddr := Axis.DriveAddress.SlaveAddress,
				nElement := 0, 
				nDriveNo := 0, 
				bCommand := FALSE,
				bExecute := FALSE, 
				tTimeout := DEFAULT_ADS_TIMEOUT 
			); 			 
			
			tonDelay(IN := FALSE, PT := T#0S);
			
			etBoschHome := ET_BOSCH_Home.eResetCalibrationFlag;                              (* Next step *)

		END_IF;
	
	ET_BOSCH_Home.eResetCalibrationFlag:
		fbMCHome.Execute := TRUE;
		fbMCHome.HomingMode := MC_ResetCalibration;

		IF fbMCHome.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfResetCalibrationFlag;         		(* Next step *)

		ELSIF fbMCHome.Error
		THEN
			fbMCHome.Execute := FALSE;

			udnErrorNo := 1;            (* Error number *)	
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_Home.eWfResetCalibrationFlag:	
		IF fbMCHome.Done
		THEN
			fbMCHome.Execute := FALSE;

			etBoschHome := ET_BOSCH_Home.eReadEnablePosLagMonitoring;		(* Next step *)

		ELSIF fbMCHome.Error
		THEN
			fbMCHome.Execute := FALSE;

			udnErrorNo := 2;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         					(* Next step *)

		END_IF

	
	ET_BOSCH_Home.eReadEnablePosLagMonitoring:
		fbMcReadBoolParameter.Enable := TRUE;
		fbMcReadBoolParameter.ParameterNumber:= EnablePosLagMonitoring;

		IF fbMcReadBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfReadEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			udnErrorNo := 3;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfReadEnablePosLagMonitoring:
		IF NOT fbMcReadBoolParameter.Busy
		   AND NOT fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			bCacheEnablePosLagMonitoring := fbMcReadBoolParameter.Value;

			etBoschHome := ET_BOSCH_Home.eReadEnableLimitPos;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);
			
			udnErrorNo := 4;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
	ET_BOSCH_Home.eReadEnableLimitPos:
		fbMcReadBoolParameter.Enable := TRUE;
		fbMcReadBoolParameter.ParameterNumber:= EnableLimitPos;

		IF fbMcReadBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfReadEnableLimitPos;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			udnErrorNo := 5;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfReadEnableLimitPos:
		IF NOT fbMcReadBoolParameter.Busy
		   AND NOT fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			bCacheEnableLimitPos := fbMcReadBoolParameter.Value;

			etBoschHome := ET_BOSCH_Home.eReadEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			udnErrorNo := 6;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
				
	ET_BOSCH_Home.eReadEnableLimitNeg:
		fbMcReadBoolParameter.Enable := TRUE;
		fbMcReadBoolParameter.ParameterNumber:= EnableLimitNeg;

		IF fbMcReadBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfReadEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			udnErrorNo := 5;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfReadEnableLimitNeg:
		IF NOT fbMcReadBoolParameter.Busy
		   AND NOT fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			bCacheEnableLimitNeg := fbMcReadBoolParameter.Value;

			etBoschHome := ET_BOSCH_Home.eEraseEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcReadBoolParameter.Error
		THEN
			fbMcReadBoolParameter(
				Enable:= FALSE,
				Axis := Axis
			);

			udnErrorNo := 6;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
	ET_BOSCH_Home.eEraseEnablePosLagMonitoring:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnablePosLagMonitoring;
		fbMcWriteBoolParameter.Value := FALSE;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfEraseEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 7;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfEraseEnablePosLagMonitoring:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eEraseEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 8;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
	ET_BOSCH_Home.eEraseEnableLimitPos:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnableLimitPos;
		fbMcWriteBoolParameter.Value := FALSE;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfEraseEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 9;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfEraseEnableLimitPos:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eEraseEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 10;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
	ET_BOSCH_Home.eEraseEnableLimitNeg:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber := EnableLimitNeg;
		fbMcWriteBoolParameter.Value := FALSE;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfEraseEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 12;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfEraseEnableLimitNeg:
		IF NOT fbMcWriteBoolParameter.Busy
		     AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eStartCancelCalibration;         		(* Next step *)
			
		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 13;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
		
	ET_BOSCH_Home.eStartCancelCalibration:	
		(* S-0-0191, C1500 Cancel reference point procedure command *)
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wCancelReferencePara,			
			pSrcBuf := ADR(wStartHomingCmd), 
			cbBufLen := SIZEOF(wStartHomingCmd) 
		);	
	
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			etBoschHome := ET_BOSCH_Home.eReadDriveNoCalibrated;         		(* Next step *)

		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 14;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_Home.eReadDriveNoCalibrated:	
		(* S-0-0403, Position feedback value status *)	
		tonDelay(IN := TRUE);
		
		fbEcSoERead(
			bExecute := tonDelay.Q,
			nIdn := wPosFeedbackValueStatusPara,			
			pDstBuf := ADR(wPosFeedbackValueStatus),
			cbBufLen := SIZEOF(wPosFeedbackValueStatus)
		);
	
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		   AND tonDelay.Q
		THEN				
			fbEcSoERead(
				bExecute := FALSE
			);
	
			IF NOT wPosFeedbackValueStatus.0	(* Calibrated *)
			THEN
				tonDelay(IN := FALSE, PT := T#0S);
			
				etBoschHome := ET_BOSCH_Home.eStopCancelCalibration;         		(* Next step *)
			ELSE
				tonDelay(IN := FALSE, PT := T#500MS);	
			
				etBoschHome := ET_BOSCH_Home.eReadDriveNoCalibrated;         		(* Next step *)
			END_IF
		ELSIF fbEcSoERead.bError
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			fbEcSoERead(
				bExecute := FALSE
			);

			udnErrorNo := 15;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
		(* Interrupt sequence *)
		IF NOT bExecute
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			fbEcSoERead(
				bExecute := FALSE
			);
			
			bInterrupted := TRUE;		(* Program interrupted *)
			
			etBoschHome := ET_BOSCH_Home.eReadDriveStopped;     (* Next step *)
		END_IF

	ET_BOSCH_Home.eStopCancelCalibration:	
		(* S-0-0191, C1500 Cancel reference point procedure command *)	
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wCancelReferencePara,			
			pSrcBuf := ADR(wStopHomingCmd), 
			cbBufLen := SIZEOF(wStopHomingCmd)
		);
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			etBoschHome := ET_BOSCH_Home.eWriteCalibrationOffset;         		(* Next step *)
			
		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 16;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_Home.eWriteCalibrationOffset:	
		(* S-0-0052, Reference distance 1 *)
		dwReferenceDist := REAL_TO_DWORD(rOriginPosition / LREAL_TO_REAL(pDrive^.lrScalingFactor));
		
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wReferenceDistPara,			
			pSrcBuf := ADR(dwReferenceDist), 
			cbBufLen := SIZEOF(dwReferenceDist) 
		);
			
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			etBoschHome := ET_BOSCH_Home.eStartCalibration;         		(* Next step *)

		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 17;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
		
	ET_BOSCH_Home.eStartCalibration:	
		(* S-0-0148, C600 Drive controlled homing procedure command *)
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wDriveControlledHomingPara,			
			pSrcBuf := ADR(wStartHomingCmd),
			cbBufLen := SIZEOF(wStartHomingCmd) 
		);	
	
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			etBoschHome := ET_BOSCH_Home.eReadDriveCalibrated;         		(* Next step *)
			
		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 18;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eReadDriveCalibrated:	
		(* S-0-0403, Position feedback value status *)	
		tonDelay(IN := TRUE);
		
		fbEcSoERead(
			bExecute := tonDelay.Q,
			nIdn := wPosFeedbackValueStatusPara,			
			pDstBuf := ADR(wPosFeedbackValueStatus), 
			cbBufLen := SIZEOF(wPosFeedbackValueStatus) 
		);
		
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		   AND tonDelay.Q
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);
	
			IF wPosFeedbackValueStatus.0	(* Calibrated *)
			THEN
				tonDelay(IN := FALSE, PT := T#0S);
			
				etBoschHome := ET_BOSCH_Home.eReadDriveStopped;         		(* Next step *)
			ELSE
				tonDelay(IN := FALSE, PT := T#500MS);	
			
				etBoschHome := ET_BOSCH_Home.eReadDriveCalibrated;         		(* Next step *)
			END_IF
		ELSIF fbEcSoERead.bError
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			fbEcSoERead(
				bExecute := FALSE
			);

			udnErrorNo := 19;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
		(* Interrupt sequence *)
		IF NOT bExecute
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			fbEcSoERead(
				bExecute := FALSE
			);
			
			bInterrupted := TRUE;		(* Program interrupted *)
			
			etBoschHome := ET_BOSCH_Home.eReadDriveStopped;     (* Next step *)
		END_IF
						
	ET_BOSCH_Home.eReadDriveStopped:	
		(* S-0-0013, Class 3 diagnostics *)		
		tonDelay(IN := TRUE);
		
		fbEcSoERead(
			bExecute := tonDelay.Q,
			nIdn := wDiagnosticsPara,		
			pDstBuf := ADR(wDiagnostics), 
			cbBufLen := SIZEOF(wDiagnostics) 
		);
				
		IF NOT fbEcSoERead.bBusy
		   AND NOT fbEcSoERead.bError
		   AND tonDelay.Q
		THEN
			fbEcSoERead(
				bExecute := FALSE
			);
	
			IF wDiagnostics.1	(* Stopped *)
			THEN
				tonDelay(IN := FALSE, PT := T#0S);
	
				etBoschHome := ET_BOSCH_Home.eWriteEnablePosLagMonitoring;         		(* Next step *)
			ELSE
				tonDelay(IN := FALSE, PT := T#500MS);	
			
				etBoschHome := ET_BOSCH_Home.eReadDriveStopped;         		(* Next step *)
			END_IF
			
		ELSIF fbEcSoERead.bError
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			fbEcSoERead(
				bExecute := FALSE
			);

			udnErrorNo := 20;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_Home.eWriteEnablePosLagMonitoring:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber:= EnablePosLagMonitoring;
		fbMcWriteBoolParameter.Value := bCacheEnablePosLagMonitoring;

		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfWriteEnablePosLagMonitoring;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 21;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfWriteEnablePosLagMonitoring:
		IF NOT fbMcWriteBoolParameter.Busy
		   AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eWriteEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 22;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
			
	ET_BOSCH_Home.eWriteEnableLimitPos:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber:= EnableLimitPos;
		fbMcWriteBoolParameter.Value := bCacheEnableLimitPos;
		
		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfWriteEnableLimitPos;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 23;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfWriteEnableLimitPos:
		IF NOT fbMcWriteBoolParameter.Busy
		   AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eWriteEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 24;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
				
	ET_BOSCH_Home.eWriteEnableLimitNeg:
		fbMcWriteBoolParameter.Execute := TRUE;
		fbMcWriteBoolParameter.ParameterNumber:= EnableLimitNeg;
		fbMcWriteBoolParameter.Value := bCacheEnableLimitNeg;
		
		IF fbMcWriteBoolParameter.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfWriteEnableLimitNeg;         		(* Next step *)

		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 25;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfWriteEnableLimitNeg:
		IF NOT fbMcWriteBoolParameter.Busy
		   AND NOT fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			etBoschHome := ET_BOSCH_Home.eWriteCancelCalibration;         		(* Next step *)
					
		ELSIF fbMcWriteBoolParameter.Error
		THEN
			fbMcWriteBoolParameter(
				Execute := FALSE,
				Axis := Axis
			);

			udnErrorNo := 26;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF

	ET_BOSCH_Home.eWriteCancelCalibration:	
		(* S-0-0191, C1500 Cancel reference point procedure command *)	
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wCancelReferencePara,			
			pSrcBuf := ADR(wStopHomingCmd), 
			cbBufLen := SIZEOF(wStopHomingCmd)
		);
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			etBoschHome := ET_BOSCH_Home.eWriteStopCalibration;         		(* Next step *)
			
		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 27;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
					
	ET_BOSCH_Home.eWriteStopCalibration:	
		(* S-0-0148, C600 Drive controlled homing procedure command *)		
		fbEcSoEWrite(
			bExecute := TRUE,
			nIdn := wDriveControlledHomingPara,			
			pSrcBuf := ADR(wStopHomingCmd),
			cbBufLen := SIZEOF(wStopHomingCmd) 
		);
		
		IF NOT fbEcSoEWrite.bBusy
		   AND NOT fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			IF NOT bInterrupted						(* Program interrupted *)
			THEN
				etBoschHome := ET_BOSCH_Home.eSetCalibrationFlag;         		(* Next step *)
			ELSE
				IF bCmdAborted
				THEN	
					etBoschHome := ET_BOSCH_Home.eAbort;         		(* Next step *)
				ELSE
					etBoschHome := ET_BOSCH_Home.eDone;         		(* Next step *)
				END_IF		
			END_IF
			
		ELSIF fbEcSoEWrite.bError
		THEN
			fbEcSoEWrite(
				bExecute := FALSE
			);

			udnErrorNo := 28;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
				
	ET_BOSCH_Home.eSetCalibrationFlag:
		fbMCHome.Execute := TRUE;
		fbMCHome.HomingMode := MC_ForceCalibration;

		IF fbMCHome.Busy
		THEN
			etBoschHome := ET_BOSCH_Home.eWfSetCalibrationFlag;         		(* Next step *)

		ELSIF fbMCHome.Error
		THEN
			fbMCHome.Execute := FALSE;

			udnErrorNo := 29;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         		(* Next step *)

		END_IF
	
	ET_BOSCH_Home.eWfSetCalibrationFlag:
		IF fbMCHome.Done
		THEN
			fbMCHome.Execute := FALSE;

			etBoschHome := ET_BOSCH_Home.eWfAxisEnabled;		(* Next step *)

		ELSIF fbMCHome.Error
		THEN
			fbMCHome.Execute := FALSE;

			udnErrorNo := 30;            (* Error number *)
			
			etBoschHome := ET_BOSCH_Home.eError;         					(* Next step *)

		END_IF

	ET_BOSCH_Home.eWfAxisEnabled:
			tonDelay(
				IN := Axis.Status.Operational
		   			  AND Axis.Status.NotMoving
					  AND pDrive^.bDriveAF, 
			PT := T#100MS);
	
		IF tonDelay.Q
		THEN
			tonDelay(IN := FALSE, PT := T#0S);
		
			etBoschHome := ET_BOSCH_Home.eDone;		(* Next step *)
			
		ELSIF  Axis.Status.Error
		THEN
			tonDelay(IN := FALSE, PT := T#0S);	
		
			udnErrorNo := 31;            (* Error number *)
		
			etBoschHome := ET_BOSCH_Home.eError;         					(* Next step *)

		END_IF			

	ET_BOSCH_Home.eAbort:	
		bCmdAborted := TRUE;		(* Command aborted *)
		bDone := FALSE;				(* Program done, in position *)		

		etBoschHome := ET_BOSCH_Home.eNotExecute;			(*Next step *)
		
	ET_BOSCH_Home.eDone:
		bDone := TRUE;			(* Program done, in position *)
		bBusy := FALSE;			(* Program not busy *)

		etBoschHome := ET_BOSCH_Home.eNotExecute;            (* Next step *)

	ET_BOSCH_Home.eError:
		bDone := FALSE;			(* Program done, in position *)
		bError := TRUE;			(* Program error *)
		bBusy := FALSE;			(* Program not busy *)
		
        etBoschHome := ET_BOSCH_Home.eNotExecute;			(*Next step *)

	ET_BOSCH_Home.eNotExecute:
		IF NOT bExecute
		THEN			
			bDone := FALSE;					(* Program done, in position *)
			bInterrupted := FALSE;			(* Program interrupted *)
			bCmdAborted := FALSE;			(* Command not aborted *)
			bBusy := FALSE;                 (* Program not busy *)
			bError := FALSE;                (* Program not error *)

			etBoschHome := ET_BOSCH_Home.eInit;			(* Next step *)

		END_IF;
END_CASE;

fbMCSetPosition(
	Mode := FALSE,
	Axis := Axis,
);

fbMCHome(
	Axis := Axis,
);

fbMcReadParameter(
	ReadMode := READMODE_ONCE,
	Axis := Axis
);

fbMcReadBoolParameter(
	ReadMode := READMODE_ONCE,
	Axis := Axis
);

fbMcWriteParameter(
	Axis := Axis
);

fbMcWriteBoolParameter(
	Axis := Axis
);]]></ST>
