<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PosCylinder" Id="{14ceaa4c-5752-4af7-96d6-4fa28f8b9aa9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PosCylinder
(*

The function block used to control position cylinder.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	etMachineMode				:ET_MachineMode;			(* Machine mode *)
	etMachineState				:ET_MachineState;			(* Machine state *)
	bAirPressureOK				:BOOL;						(* Air pressure OK *)
	bSafetyOk					:BOOL;						(* Safety OK  *)
	bInBase						:BOOL;						(* In base position *)
	bInWork						:BOOL;						(* In work position *)
	bMoveToBaseRelease			:BOOL;						(* Release move to base *)
	bMoveToWorkRelease			:BOOL;						(* Release move to work *)
	bHandMoveToBase				:BOOL;						(* Hand move to base *)
	bHandMoveToWork				:BOOL;						(* Hand move to work *)
	bAutoMoveToBase				:BOOL;						(* Auto move to base *)
	bAutoMoveToWork				:BOOL;						(* Auto move to work *)
	bConfirmAlarm				:BOOL;						(* Confirm alarm *)
	bControlStateOn				:BOOL;						(* TRUE - control with input state *)
	bControlOff					:BOOL;						(* TRUE - controle off *)
	bValveOff					:BOOL;						(* TRUE -  valve off with limit input *)
	bValveErrOff				:BOOL;						(* TRUE -  valve off if error *)
	bErrorOff					:BOOL;						(* TRUE - error diagnose off *)
	tTimeOut					:TIME := T#6S;					(* TimeOut *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bMoveToBase					:BOOL;						(* Move to base *)
	bMoveToWork					:BOOL;						(* Move to work *)
	bErrorMoveToBase			:BOOL;						(* Error move to base *)
	bErrorMoveToWork			:BOOL;						(* Error move to work *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	bHomeCompleted				:BOOL;						(* Home completed *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbPosCylinder					:FB_Cylinder;
	fbPosCylinderAtBasePos			:FB_SignalHandlingDelay;
	fbPosCylinderAtWorkPos			:FB_SignalHandlingDelay;
	fbPosCylinderBaseRelease		:FB_SignalHandlingDelay;
	fbPosCylinderWorkRelease		:FB_SignalHandlingDelay;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Control position cylinder cylinder *)

fbPosCylinderAtBasePos(
	bEnable := TRUE,
	bIn := bInBase,
	tDelay := t#0ms
);

fbPosCylinderAtWorkPos(
	bEnable := TRUE,
	bIn := bInWork,
	tDelay := t#0ms
);

fbPosCylinderBaseRelease(
	bEnable := TRUE,
	bIn := bMoveToBaseRelease,
	tDelay :=t#0ms
);

fbPosCylinderWorkRelease(
	bEnable := TRUE,
	bIn := bMoveToWorkRelease,
	tDelay := t#0ms
);

fbPosCylinder(
	bEnable := TRUE,
	bAirPressure := bAirPressureOK,
	bSafetyOk := bSafetyOk,
	bReset := bConfirmAlarm,
	bAutoHand := etMachineMode = ET_MachineMode_eHome
			         OR etMachineMode = ET_MachineMode_eStepping
			         OR etMachineMode = ET_MachineMode_eAutomatic
					 OR etMachineMode = ET_MachineMode_eMaintenance,
	bHandBase := bHandMoveToBase,
	bHandWork := bHandMoveToWork,
	bAutoBase := bAutoMoveToBase,
	bAutoWork := bAutoMoveToWork,
	bAtBasePos := fbPosCylinderAtBasePos.bOut,
	bAtWorkPos := fbPosCylinderAtWorkPos.bOut,
	bBaseRelease := fbPosCylinderBaseRelease.bOut,
	bWorkRelease := fbPosCylinderWorkRelease.bOut,
	bControlStateOn := bControlStateOn,
	bControlOff := bControlOff,
	bValveOff := bValveOff,
	bValveErrOff := bValveErrOff,
	bErrorOff := bErrorOff,
	tTimeOut := tTimeOut,
	bHomeCompleted := bHomeCompleted,
	bMoveToBase => bMoveToBase,
	bMoveToWork => bMoveToWork
);

A_Alarm();]]></ST>
    </Implementation>
    <Action Name="A_Alarm" Id="{1f3da462-a42b-44f5-ba06-2392a9084a5f}">
      <Implementation>
        <ST><![CDATA[
bErrorMoveToWork:= fbPosCylinder.bError
					AND (fbPosCylinder.udnErrorNo = 1
					     OR fbPosCylinder.udnErrorNo = 2
					     OR fbPosCylinder.udnErrorNo = 5);

bErrorMoveToBase := fbPosCylinder.bError
					 AND (fbPosCylinder.udnErrorNo = 3
					       OR fbPosCylinder.udnErrorNo = 4
					       OR fbPosCylinder.udnErrorNo = 5);]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_PosCylinder">
      <LineId Id="63" Count="29" />
      <LineId Id="242" Count="0" />
      <LineId Id="93" Count="3" />
      <LineId Id="179" Count="0" />
      <LineId Id="97" Count="19" />
    </LineIds>
    <LineIds Name="FB_PosCylinder.A_Alarm">
      <LineId Id="0" Count="9" />
    </LineIds>
  </POU>
</TcPlcObject>