<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ModeSelector_1" Id="{a9fc41ba-b9a2-432b-be13-a1039f665e19}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ModeSelector_1
(*

The function block used to control opration mode.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bStart					:BOOL;						(* Signal start *)
	bStop					:BOOL;						(* Signal stop *)
	bAbort					:BOOL;						(* Signal abort *)
	bHome					:BOOL;						(* Signal home *)
	bReference				:BOOL;						(* Signal reference *)
	bReset					:BOOL;						(* Signal reset *)
	bAutoStartRelease		:BOOL;						(* Auto start release *)
	bHomeStartRelease		:BOOL;						(* Home start release *)
	bMaintenanceStartRelease:BOOL;						(* Maintenance start release *)
	bAutoToHome				:BOOL;						(* If auto completed go to home *)
	bChangeModeWithHome		:BOOL;						(* If mode was changed start home *)
	bHomeCompleted			:BOOL;						(* Home completed *)
	bAutoCompleted			:BOOL;						(* Auto completed *)
	bMaintenanceCompleted	:BOOL;						(* Maintenance completed *)
	bAllDoorsClosed 		:BOOL;						(* All doors closed *)
	bAllDoorsLocked 		:BOOL;						(* All doors locked *)
	bLightCurtainOk			:BOOL;						(* Light curtain ok *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	etMachineMode			:ET_MachineMode;			(* Machine mode enum variable *)
	etMachineState			:ET_MachineState;			(* Machine state enum variable *)
	etMaintenanceType		:ET_MaintenanceType;		(* Maintenance type enum variable *)
	bModeAutomatic			:BOOL;						(* Machine mode automatic *)
	bModeHome				:BOOL;						(* Machine mode home *)
	bModeManual				:BOOL;						(* Machine mode manual *)
	bModeMaintenance		:BOOL;						(* Machine mode maintenance *)
	bMachineRunning			:BOOL;						(* Machine running *)
	bMachineStandstill		:BOOL;						(* Machine standstill *)
	bConfirmAlarm			:BOOL;						(* Confirm alarm *)
END_VAR
VAR_IN_OUT
	etMachineModeReq		:ET_MachineMode;			(* Machine mode request enum variable *)
	etMaintenanceTypeReq	:ET_MaintenanceType;		(* Maintenance type request *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	etMachinePrvState		:ET_MachineState;			(* Machine previous active state enum variable *)
	etMachinePrvModeReq		:ET_MachineMode;			(* Machine mode request previous enum variable *)
	
	bModeExecute			:BOOL;						(* Mode execute *)
	bSafetyCompleted		:BOOL;						(* Safety completed *)
	
	bFirstHomeCompleted		:BOOL;						(* First home is completed *)	
	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtStart					:R_TRIG;
	rtStop					:R_TRIG;
	rtAbort					:R_TRIG;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
bConfirmAlarm := bReset;
bSafetyCompleted := bAllDoorsLocked				(* Safety completed *)
				      AND bLightCurtainOk;

etMaintenanceType := etMaintenanceTypeReq;					  
					  
IF bHome
THEN
	etMachineModeReq := ET_MachineMode_eHome;
END_IF;

IF bMaintenanceCompleted
THEN
	etMachineModeReq := ET_MachineMode_eManual;
END_IF

IF bHomeCompleted
THEN
	bFirstHomeCompleted := bHomeCompleted;

	IF etMachineMode = ET_MachineMode_eHome                          	 (* Set auto mode *)
	    AND etMachinePrvState <> ET_MachineState_eAutoExe
	    AND etMachinePrvState <> ET_MachineState_eAutoSteppingExe
	    AND etMachinePrvState <> ET_MachineState_eAutoSteppingNoExe
		AND etMachinePrvState <> ET_MachineState_eMaintenanceExe
	    AND bModeExecute
	THEN
		IF etMachinePrvModeReq = ET_MachineMode_eManual
		THEN
			etMachineModeReq := ET_MachineMode_eManual;
			etMachinePrvModeReq := ET_MachineMode_eUndefined;
		ELSE
			etMachineModeReq := ET_MachineMode_eAutomatic;
		END_IF
	END_IF;	
ELSE
	IF etMachineModeReq <> ET_MachineMode_eManual                   	 (* Set home mode *)
	   AND SEL(bFirstHomeCompleted, TRUE, etMachineModeReq <> ET_MachineMode_eMaintenance)
	THEN
		etMachineModeReq := ET_MachineMode_eHome;
	
	END_IF;
END_IF;

IF (etMachineModeReq <> etMachineMode)                                    		(* Stop always if changed mode *)
THEN
	(*bStart := FALSE *)
	bStop := TRUE;
	
	IF (etMachineMode = ET_MachineMode_eAutomatic
	      AND etMachineModeReq = ET_MachineMode_eStepping)
	     OR
	     (etMachineMode = ET_MachineMode_eStepping
	      AND etMachineModeReq = ET_MachineMode_eAutomatic)
		  OR
	     (etMachineMode = ET_MachineMode_eManual
	      AND etMachineModeReq = ET_MachineMode_eMaintenance)
	THEN
		bStop := FALSE;
		
	ELSIF ((etMachineMode = ET_MachineMode_eAutomatic
			OR etMachineMode = ET_MachineMode_eStepping
			OR etMachineMode = ET_MachineMode_eCycle)
			AND bMachineRunning
			AND bChangeModeWithHome)
	THEN
		bStart := TRUE;
		bStop := FALSE;
		etMachinePrvModeReq := etMachineModeReq;
		etMachineModeReq := ET_MachineMode_eHome;
			
	END_IF;
	
	etMachineMode := etMachineModeReq;

END_IF;

rtStart(CLK := bStart);								(* Check start *)

rtStop(CLK := bStop								(* Check stop *)
		        OR bAbort
		        OR bAutoCompleted
		        OR (NOT bSafetyCompleted AND bMachineRunning));
rtAbort(CLK := bAbort);

IF rtStop.Q
THEN
	bModeExecute := FALSE;

	IF bAutoToHome
	     AND bAutoCompleted
	THEN
		etMachineModeReq := ET_MachineMode_eHome;
	END_IF
	
	IF etMachinePrvModeReq = ET_MachineMode_eManual
		OR etMachineMode = ET_MachineMode_eMaintenance
	THEN
		etMachineModeReq := ET_MachineMode_eManual;
		etMachinePrvModeReq := ET_MachineMode_eUndefined;
	END_IF

ELSIF rtStart.Q
	    AND bAllDoorsClosed
	    AND bLightCurtainOk
	    AND NOT bStop
	    AND NOT bAbort
	    AND ((etMachineMode = ET_MachineMode_eMaintenance 
			  AND SEL(etMachineState = ET_MachineState_eMaintenanceExe, 
					  bMaintenanceStartRelease, TRUE))
	    	  OR (etMachineMode = ET_MachineMode_eHome 
			  AND SEL(etMachineState = ET_MachineState_eHomeExe 
					  OR etMachineState = ET_MachineState_eHomeRefExe, 
					  bHomeStartRelease, TRUE))
	    	  OR ((etMachineMode = ET_MachineMode_eAutomatic OR etMachineMode = ET_MachineMode_eStepping) 
				   AND SEL(etMachineState = ET_MachineState_eAutoExe 
						   OR etMachineState = ET_MachineState_eAutoSteppingExe 
						   OR etMachineState = ET_MachineState_eAutoSteppingNoExe,
						   bAutoStartRelease, TRUE)))
THEN
	bModeExecute := TRUE;

END_IF;

bStart := FALSE;
bStop := FALSE;

CASE etMachineMode
OF
	ET_MachineMode_eAutomatic:            (* Statement section automatic *)
		bModeAutomatic := TRUE;
		bModeHome := FALSE;
		bModeManual := FALSE;
		bModeMaintenance := FALSE;

		IF bModeExecute
		     AND bSafetyCompleted
		THEN
			etMachineState := ET_MachineState_eAutoExe;
			etMachinePrvState := etMachineState;
		ELSE
		 	etMachineState := ET_MachineState_eIdle;
		END_IF;
	    
	ET_MachineMode_eStepping:             (* Statement section stepping *)
		bModeAutomatic := TRUE;
		bModeHome := FALSE;
		bModeManual := FALSE;
		bModeMaintenance := FALSE;

		IF bModeExecute
		     AND bSafetyCompleted
		THEN
			IF rtStart.Q
			THEN
				etMachineState := ET_MachineState_eAutoSteppingExe;
			ELSE
				etMachineState := ET_MachineState_eAutoSteppingNoExe;
			END_IF;

			etMachinePrvState := etMachineState;
		ELSE
			etMachineState := ET_MachineState_eIdle;
		END_IF;

	ET_MachineMode_eHome:                 (* Statement section home  *)
		bModeAutomatic := FALSE;
		bModeHome := TRUE;
		bModeManual := FALSE;
		bModeMaintenance := FALSE;
		
		IF bModeExecute
		     AND bSafetyCompleted
		THEN
			IF bReference
			THEN
				etMachineState := ET_MachineState_eHomeRefExe;
			ELSE
				etMachineState := ET_MachineState_eHomeExe;
			END_IF;

			etMachinePrvState := etMachineState;
		ELSE
			etMachineState := ET_MachineState_eIdle;
		END_IF;

	ET_MachineMode_eManual:              (* Statement section manual  *)
		bModeExecute := FALSE;
		bModeAutomatic := FALSE;
		bModeHome := FALSE;
		bModeManual := TRUE;
		bModeMaintenance := FALSE;

		etMachineState := ET_MachineState_eIdle;

	ET_MachineMode_eMaintenance:              (* Statement section maintenance  *)
		bModeAutomatic := FALSE;
		bModeHome := FALSE;
		bModeManual := FALSE;
		bModeMaintenance := TRUE;
	
		IF bModeExecute
		     AND bSafetyCompleted
		THEN
			etMachineState := ET_MachineState_eMaintenanceExe;
			etMachinePrvState := etMachineState;
		ELSE
		 	etMachineState := ET_MachineState_eIdle;
		END_IF;
	
	ELSE
		bModeExecute := FALSE;
		bModeAutomatic := FALSE;
		bModeHome := FALSE;
		bModeManual := FALSE;
		bModeMaintenance := FALSE;
	    
	    etMachineState := ET_MachineState_eUndefined;
        
END_CASE;

bMachineRunning := bModeExecute
		           AND etMachineMode <> ET_MachineMode_eManual
		           AND etMachineMode <> ET_MachineMode_eIdle
		           AND etMachineMode <> ET_MachineMode_eUndefined;
                    
bMachineStandstill := NOT bMachineRunning;]]></ST>
    </Implementation>
