<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_RealToStrf_1" Id="{59fa17e9-4808-4689-9ec4-75ce94ab1dcb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_RealToStrf_1 : STRING(20)
VAR_INPUT
	IN : REAL;
	N : INT;
	D : STRING(1);
END_VAR
VAR
	O: REAL;
	i: INT;
END_VAR

(*
version 1.8	2. jan 2012
programmer 	hugo
tested by	oscat

Real_to_strf converts a Real to a fixed length String.
the string will be filles with zeroes to achieve the fixed length N after the decimal separator.
the input parameter specifies the decimal separator to be used in the output string.

*)]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* LIMIT N to 0 .. 7 *)
N := LIMIT(0,N,7);
(* round the input to N digits and convert to string *)
O := ABS(in) * F_Exp10(N);
F_RealToStrf := DINT_TO_STRING(REAL_TO_DINT(O));
(* add zeroes in front to make sure sting is at least 8 digits long *)
FOR i := LEN(F_RealToStrf) TO N DO F_RealToStrf := CONCAT('0', F_RealToStrf); END_FOR;
(* add a dot if n > 0 *)
IF n > 0 THEN F_RealToStrf := INSERT(F_RealToStrf, D, LEN(F_RealToStrf) - N); END_IF;
(* add a minus sign if in is negative *)
IF in < 0 THEN F_RealToStrf := CONCAT('-', F_RealToStrf); END_IF;]]></ST>
    </Implementation>
    <LineIds Name="F_RealToStrf_1">
      <LineId Id="21" Count="10" />
    </LineIds>
  </POU>
</TcPlcObject>