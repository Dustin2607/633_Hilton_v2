VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	lrSetPoint							:LREAL;							(* Set point - SP *)
	lrProcessVariable						:LREAL;							(* Process variable - PV *)
	lrDeadZone							:LREAL;							(* Dead zone - noise*)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR
VAR
