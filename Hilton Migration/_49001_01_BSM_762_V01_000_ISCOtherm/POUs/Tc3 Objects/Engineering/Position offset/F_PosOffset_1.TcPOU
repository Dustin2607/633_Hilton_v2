<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_PosOffset_1" Id="{a7d445c1-925e-49f5-b5f7-140bee97bfa1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_PosOffset_1 : LREAL
(*

The function used to calculate position offset in range.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			01.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable							:BOOL;						(* Function enable *)
	lrCurrentPosHorizontal				:LREAL;						(* Current position of horizontal axis *)
	lrPosOffsetHorizontal				:LREAL;						(* Position offset of horizontal axis*)
	lrPosOffsetVertical					:LREAL;						(* Position offset of horizontal axis*)
	lrRangeOffset						:LREAL;						(* Range offset *)
END_VAR
VAR
	(* Variables *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	F_PosOffset := 0.0;

	RETURN;
END_IF

IF  lrRangeOffset > 0.0
     AND lrCurrentPosHorizontal >= lrPosOffsetHorizontal - ABS(lrRangeOffset * 0.5)
     AND lrCurrentPosHorizontal <= lrPosOffsetHorizontal + ABS(lrRangeOffset * 0.5)
THEN
	F_PosOffset := lrPosOffsetVertical;
ELSE
	F_PosOffset := 0.0;
END_IF




]]></ST>
    </Implementation>
    <LineIds Name="F_PosOffset_1">
      <LineId Id="26" Count="19" />
    </LineIds>
  </POU>
</TcPlcObject>