<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ExtContour_1" Id="{43fc2459-54d4-4745-87cd-4e9eeeef7364}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ExtContour_1
(*

The function block used to generate move external contour.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			01.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable							:BOOL;						(* Function block enable *)
	bStart							:BOOL;
	bStop							:BOOL;
	etContourType					:ET_ContourType;				(* Contour type *)
	lrActPosZ						:LREAL;						(* Current position of axis z *)
	lrActAngle 						:LREAL; 						(* Current angle *)
	lrStartMaxPosZ					:LREAL;						(* Contour start maximal position of axis z *)
	lrEndMinPosZ					:LREAL;						(* Contour end minimal position of axis z *)
	lrSafetyDistance					:LREAL;						(* Safety distance *)
	lrTargetPosY						:LREAL;						(* Target position of axis y *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	lrNewPos						:LREAL;						(* New position [mm] *)
	bEnabled  						:BOOL;						(* Calculate positon is enabled *)
	lrActVelo							:LREAL;
	lrActPosN1						:LREAL;
END_VAR
VAR_IN_OUT
	lrSetPosY						:LREAL;						(* Set position of axis y *)
END_VAR
VAR
	(* Instances / Instanzen *)

	(* Enumerator  *)

	(* General flags / Allgemeine Variablen *)
	lrContourPos						:LREAL;
	bFirstTime						:BOOL;


END_VAR
VAR CONSTANT

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	bEnabled := bStart;

	bFirstTime := FALSE;
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	bEnabled := FALSE;

	bFirstTime := TRUE;
END_IF


IF bStop
THEN
	bEnabled := FALSE;

ELSIF bStart
THEN
	lrContourPos := F_CalcContour(
		etContourType := etContourType,
		lrActPos := lrActPosZ,
		lrActAngle := lrActAngle,
		(*lrActVelo := Axis.stNcToPlc.stCommandPositioning.dnActVelocity,*)
		lrVerticalOffset := 0.0,  (*37.0,*) (* Offset Sägeband Unterkante zu Störkontur BF-Kopf *)
		lrStartMaxPos := lrStartMaxPosZ,
		lrEndMinPos := lrEndMinPosZ,
		lrSafetyDistance := lrSafetyDistance,
		lrTableHeight := SEL(lrStartMaxPosZ>450, 700.0, 200.0), (* ab welcher Höhe Tischbreite aktiv ist *)
		lrTableWidth := 700.0, (* Tischbreite Auflage Rohr *)
		lrActVeloExt := lrActVelo
	);


	lrSetPosY := lrTargetPosY + lrContourPos;

	bEnabled := TRUE;

END_IF



lrActVelo := (*lrActVelo *0.9 + 0.1 *)(lrActPosZ - lrActPosN1);
lrActPosN1:= lrActPosZ;]]></ST>
    </Implementation>
    <LineIds Name="FB_ExtContour_1">
      <LineId Id="51" Count="46" />
    </LineIds>
  </POU>
</TcPlcObject>