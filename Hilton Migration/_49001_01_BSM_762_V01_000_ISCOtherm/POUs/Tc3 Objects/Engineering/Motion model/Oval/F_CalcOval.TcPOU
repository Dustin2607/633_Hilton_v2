<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_CalcOval" Id="{a32c62b3-1604-46b7-accc-aed464175ffd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_CalcOval : LREAL
(*

The function used to calculate a trajectory of half circle dependent on angle of inclination axis and radius circle
Calculated position of axis is on output mapped.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			01.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	lrStartPosHorizontal				:LREAL;						(* Start position of horizontal axis *)
	lrStartPosVertical					:LREAL;						(* Start position of vertical axis *)
	lrCurrentPosHorizontal				:LREAL;						(* Current position of horizontal axis *)
	lrCurrentPosVertical				:LREAL;						(* Current position of vertical axis *)
	lrFactor							:LREAL;						(* Oval faktor *)
END_VAR
VAR
	(* Variables *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_CalcOval := lrCurrentPosVertical + (ABS(lrCurrentPosVertical - lrStartPosVertical) * lrFactor);

]]></ST>
    </Implementation>
    <LineIds Name="F_CalcOval">
      <LineId Id="26" Count="2" />
    </LineIds>
  </POU>
</TcPlcObject>