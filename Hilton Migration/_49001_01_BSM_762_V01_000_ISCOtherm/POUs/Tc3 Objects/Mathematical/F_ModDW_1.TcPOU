<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_ModDW_1" Id="{1c41ea45-38e6-428f-a6cd-755338daec67}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_ModDW_1 : DWORD
(*
Modulo function for double word numbers (dividend mod divisor).

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			20.01.2014
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	dwDividend						:DWORD;
	dwDivisor						:DWORD;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
F_MODDW := dwDivisor;

IF dwDivisor <> 0 
THEN
	F_MODDW := dwDividend MOD dwDivisor;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="F_ModDW_1">
      <LineId Id="19" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>