<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_DeadZone_1" Id="{5888097e-b36a-4f5d-8538-371f451989e1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_DeadZone_1 : REAL
(*
Function used to calculate dead zone.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			03.06.2014
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)

VAR_INPUT
	(* Enummerations *)

	(* Variables *)
	lrInSignal								:LREAL;							(* Input signal *)
	lrDeadZone							:LREAL;							(* Dead zone *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF ABS(lrInSignal) > lrDeadZone
THEN
	F_DeadZone := lrInSignal;
ELSE
	F_DeadZone := 0.0;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="F_DeadZone_1">
      <LineId Id="40" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>