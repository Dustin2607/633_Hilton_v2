<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_WordToRange_1" Id="{bbb638bf-2ed2-4bdf-a595-064b38c8fbca}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_WordToRange_1 : REAL
VAR_INPUT
	wWord 					:WORD;
	rLowLimit 				:REAL;
	rHighLimit 				:REAL;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
F_WordToRange := (rHighLimit - rLowLimit) * WORD_TO_REAL(wWord) * 0.00001525902189669640 + rLowLimit;]]></ST>
    </Implementation>
    <LineIds Name="F_WordToRange_1">
      <LineId Id="8" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>