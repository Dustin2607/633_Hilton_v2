<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FileCSVHandler" Id="{5729f216-0ac7-4f82-ae3d-85b118d4a04d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FileCSVHandler
(*

This function block is used to read and write datas into/from csv file.
None of the field value is containing any non-printing control characters like line feed, carriage return, quotation marks, semicolon... 

Constructor: 		Patryk Panylo
Company:			E. Riexinger GmbH
Date:				05.04.2019
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)

VAR_INPUT
	bEnable						:BOOL := FALSE;				(* Enable FB *)
	sNetID						:T_AmsNetID	:= '';			(* TwinCAT Net ID *)
	bExecute					:BOOL := FALSE;				(* Execute operation *)
	sFilePath					:T_MaxString := '';			(* File path *)
	sFileName					:T_MaxString := '';			(* File name *)
	bCommaSeparator				:BOOL := FALSE;				(* Enable comma csv separator *)
	dwOpenMode					:DWORD;				(*
															FOPEN_MODEREAD (16#0001)	"r": Opens for reading. If the file does not exist or cannot be found, the call fails.
															FOPEN_MODEWRITE (16#0002) "w": Opens an empty file for writing. If the given file exists, its contents are destroyed.
															FOPEN_MODEAPPEND (16#0004) "a": Opens for writing at the end of the file (appending) without removing the EOF marker before writing new data to the file; creates the file first if it doesn’t exist.
															FOPEN_MODEREAD OR FOPEN_MODEPLUS (16#0008) "r+": Opens for reading and writing. The file must exist.
															FOPEN_MODEWRITE OR FOPEN_MODEPLUS (16#0008) "w+": Opens an empty file for both reading and writing. If the given file exists, its contents are destroyed.
															FOPEN_MODEAPPEND OR FOPEN_MODEPLUS (16#0008)	 "a+": Opens for reading and appending; the appending operation includes the removal of the EOF marker before new data is written to the file and the EOF marker is restored after writing is complete; creates the file first if it doesn’t exist.
															When a file is opened with the "a" or "a+" access type, all write operations occur at the end of the file. The file pointer can be repositioned using FB_FileSeek, but is always moved back to the end of the file before any write operation is carried out. Thus, existing data cannot be overwritten.
															
															FOPEN_MODEBINARY (16#0010) "b": Open in binary (untranslated) mode.
															FOPEN_MODETEXT (16#0020) "t": Open in text (translated) mode.
														*)
	arsWriteRecords				:ARRAY[0..GVL_CSV.MAX_CSV_ROWS, 0..GVL_CSV.MAX_CSV_COLUMNS ] OF STRING(GVL_CSV.MAX_CSV_FIELD_LENGTH);			(* Write records *)
	udnRowUsingMax				:UDINT;						(* Maximal number of using rows *)
	udnColumnUsingMax			:UDINT;						(* Maximal number of using columns *)																				
	tTimeout					:TIME := T#1S;				(* States the time before the function is cancelled *)
END_VAR
VAR_OUTPUT
	arsReadRecords				:ARRAY[0..GVL_CSV.MAX_CSV_ROWS, 0..GVL_CSV.MAX_CSV_COLUMNS ] OF STRING(GVL_CSV.MAX_CSV_FIELD_LENGTH);			(* Read records *)																										
	bBusy						:BOOL;					(* Program busy *)
	bDone						:BOOL;					(* Program done *)
	bError						:BOOL;					(* Program error *)
	udnErrNo					:UDINT;					(* Error number *)
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)
	etCSVState					:ET_CSV_State := ET_CSV_State_eWaitExecute;
	
	(* Variables *)
	bFirstTime					:BOOL;					(* First PLC cycle *)

	dwModeCache					:DWORD;					(* Contains the mode in which the file is to be opened *)
	sPathName					:STRING;				(* Contains the path and filename for the file to be opened *)
	hFileHandle					:UINT;					(* File handle *)

	udnWriteCounter				:UDINT;
	udnReadCounter				:UDINT;

	udnRowCounter				:UDINT;
	udnColumnCounter			:UDINT;
	
	sCSVLine					:T_MaxString := '';		(* Single CSV text line (row, record), we are using string as record buffer (your are able to see created fields) *)
	sCSVField					:T_MaxString := '';		(* Single CSV field value (column, record field) *)
	
	(* Instances *)
	fbCreateDir					:FB_CreateDir;			(* Create direction *)
	
	fbFileOpen					:FB_FileOpen;			(* File open *)
	fbFileClose					:FB_FileClose;			(* File close *)

	fbFilePuts					:FB_FilePuts;			(* Writes one record (line) *)
	fbWriter					:FB_CSVMemBufferWriter;	(* Helper function block used to create CSV data bytes (single record line) *)
	
	fbFileGets					:FB_FileGets;			(* Reads one record (line) *)
	fbReader					:FB_CSVMemBufferReader;	(* Helper function block used to parse CSV data bytes (single record line) *)
END_VAR
VAR CONSTANT
	sFileSuffix					:STRING(5) := 'csv';
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable				(* Enable FB *)
THEN
	bFirstTime := FALSE;		(* First PLC cycle *)
	bBusy := FALSE;			(* Program busy *)
	bDone := FALSE;			(* Program done *)
	bError := FALSE;			(* Program error *)
	udnErrNo := 0;				(* Error number *)
	RETURN;
END_IF

IF NOT bFirstTime
THEN
	IF bCommaSeparator
	THEN
		DEFAULT_CSV_FIELD_SEP := 16#2C;			(* Comma ASCII code *)
	ELSE
		DEFAULT_CSV_FIELD_SEP := 16#3B;			(* Semicolon ASCII code *)
	END_IF

	etCSVState := ET_CSV_State_eWaitExecute;

	bFirstTime := TRUE;
END_IF


(* Sequence state for open, read/write and close the file *)
CASE etCSVState
OF
	ET_CSV_State_eWaitExecute:
		IF bExecute
		THEN				
			fbCreateDir(
				sNetId:= sNetID,
				sPathName:= sFilePath,
				ePath:= PATH_GENERIC,
				bExecute := FALSE, 
				tTimeout:= tTimeout
			);
		
			fbFileOpen(								(* File open *)
				sNetId := sNetID,
				nMode := dwOpenMode, 
				ePath := PATH_GENERIC,
				bExecute := FALSE,
				tTimeout := tTimeout 
			);			
			fbFileClose(							(* File close *)
				sNetId := sNetID, 
				bExecute := FALSE,
				tTimeout := tTimeout 
			);			
			
			fbFilePuts(								(* Writes one record (line) *)
				sNetId := sNetID,
				bExecute := FALSE,
				tTimeout := tTimeout 
			);			

			fbFileGets(								(* Writes one record (line) *)
				sNetId := sNetID,
				bExecute := FALSE,
				tTimeout := tTimeout 
			);
	
			(* Create data path *)
			sPathName := CONCAT(sFilePath, CONCAT(sFileName, CONCAT('.', sFileSuffix)));
	
			IF sPathName <> ''
			   AND dwOpenMode <> 0
			THEN
				udnErrNo := 0;
			
				etCSVState := ET_CSV_State_eCreateDir;			(* Next step *)
	
			ELSE
				udnErrNo := 1;
	
				etCSVState := ET_CSV_State_eError;				(* Next step *)
	
			END_IF
				
			bBusy := TRUE;
			bDone := FALSE;
			bError := FALSE;
			hFileHandle := 0;
			udnRowCounter := 0;
			udnColumnCounter := 0;

		END_IF
		
	(* Create direction *)
	ET_CSV_State_eCreateDir:
		fbCreateDir(bExecute := FALSE);
		fbCreateDir(
			sPathName := sFilePath, 
			bExecute := TRUE
		);

		etCSVState := ET_CSV_State_eChkCreateDir;				(* Next step *)

	ET_CSV_State_eChkCreateDir:	
		fbCreateDir(bExecute := FALSE);
	
		IF NOT fbCreateDir.bBusy
		THEN
			IF NOT fbCreateDir.bError
			THEN
				etCSVState := ET_CSV_State_eFileOpen;				(* Next step *)
			ELSE
				IF  fbCreateDir.nErrId = 16#723 	(* 0x723 Folder is allready existing or invalid sPathName or ePath parameter.*)
				THEN
					etCSVState := ET_CSV_State_eFileOpen;				(* Next step *)
				ELSE
					udnErrNo := fbFilePuts.nErrId;	
				
					etCSVState := ET_CSV_State_eError;					(* Next step *)
				END_IF
			END_IF
		END_IF
				
	(* Open the file *)
	ET_CSV_State_eFileOpen:
		fbFileOpen(bExecute := FALSE);
		fbFileOpen(
			sPathName := sPathName, 
			bExecute := TRUE
		);

		etCSVState := ET_CSV_State_eChkFileOpen;				(* Next step *)

	(* Check open the file *)
	ET_CSV_State_eChkFileOpen:
		fbFileOpen(bExecute := FALSE);
		
		IF NOT fbFileOpen.bBusy
		THEN
			IF NOT fbFileOpen.bError
			THEN
				hFileHandle := fbFileOpen.hFile;

				(* Choose write or read datas *)
				IF fbFileOpen.nMode = (FOPEN_MODEWRITE OR FOPEN_MODETEXT)
				THEN
					etCSVState := ET_CSV_State_eConvertRecord;			(* Next step *)

				ELSIF fbFileOpen.nMode = (FOPEN_MODEAPPEND OR FOPEN_MODETEXT)
				THEN
					etCSVState := ET_CSV_State_eConvertRecord;			(* Next step *)

				ELSIF fbFileOpen.nMode = (FOPEN_MODEREAD OR FOPEN_MODETEXT)
				THEN
					etCSVState := ET_CSV_State_eFileGets;			(* Next step *)
				
				ELSE
					udnErrNo := 2;
	
					etCSVState := ET_CSV_State_eError;				(* Next step *)

				END_IF
			ELSE
				udnErrNo := fbFileOpen.nErrId;
	
				etCSVState := ET_CSV_State_eError;					(* Next step *)
				
			END_IF
		END_IF

	(* Convert one PLC record to CSV format *)		
	ET_CSV_State_eConvertRecord:
		sCSVLine := '';
		fbWriter.eCmd := eEnumCmd_First;			(* Write first field value *)
		
		IF udnRowCounter <= MIN(udnRowUsingMax, GVL_CSV.MAX_CSV_ROWS) 
		THEN	
			FOR udnColumnCounter := 0 TO MIN(udnColumnUsingMax, GVL_CSV.MAX_CSV_COLUMNS) BY 1 
			DO	
				(* Get field value *)	
				sCSVField := STRING_TO_CSVFIELD(			
								arsWriteRecords[udnRowCounter, udnColumnCounter], 
								FALSE
							 );
		
				(* Add new field to the record buffer *)
				fbWriter(
					pBuffer := ADR(sCSVLine), 
					cbBuffer := SIZEOF(sCSVLine) - 1, 
					putValue := sCSVField, 
					pValue := 0, 
					cbValue := 0,
					bCRLF := (udnColumnCounter = MIN(udnColumnUsingMax, GVL_CSV.MAX_CSV_COLUMNS))			(* bCRLF == TRUE => Write CRLF after the last field value *)
				);
				
				IF fbWriter.bOk 
				THEN
					fbWriter.eCmd := eEnumCmd_Next;			(* Write next field value *)
					
				ELSE(* Error *)
					udnErrNo := 3;	
				
					etCSVState := ET_CSV_State_eError;					(* Next step *)
					
					RETURN;
				END_IF
		
			END_FOR
		
			(* FB_FilePuts adds allready CR (carriage return) to the written line.
			   We have to replace the $R$L characters with $L character to avoid double CR. *)
			IF RIGHT(sCSVLine, 2) = '$R$L' 
			THEN
				sCSVLine := REPLACE(sCSVLine, '$L', 2, LEN(sCSVLine) - 1);
			END_IF
		
			udnRowCounter := udnRowCounter + 1;					(* Increment number of created records (rows) *)
			
			etCSVState := ET_CSV_State_eFilePuts;				(* Write record to the file *)
		
		ELSE			(* All rows written => Close file *)
			udnWriteCounter := udnWriteCounter + 1;	
		
			etCSVState := ET_CSV_State_eFileClose;
		END_IF
		
		
	(* Writes one record (line) *)
	ET_CSV_State_eFilePuts:
		fbFilePuts(bExecute := FALSE);
		
		fbFilePuts(	
			hFile := hFileHandle, 
			sLine := sCSVLine, 
			bExecute := TRUE
		);

		etCSVState := ET_CSV_State_eChkFilePuts;				(* Next step *)

	(* Check write the file *)
	ET_CSV_State_eChkFilePuts:
		fbFilePuts(bExecute := FALSE);
		
		IF NOT fbFilePuts.bBusy
		THEN
			IF NOT fbFilePuts.bError
			THEN			
				etCSVState := ET_CSV_State_eConvertRecord;					(* Next step *)
				
			ELSE
				udnErrNo := fbFilePuts.nErrId;
	
				etCSVState := ET_CSV_State_eError;					(* Next step *)
				
			END_IF
		END_IF

	(* Read single line (record) *)
	ET_CSV_State_eFileGets:
		fbFileGets(bExecute := FALSE);
		
		fbFileGets(	
			hFile := hFileHandle, 
			bExecute := TRUE
		);

		etCSVState := ET_CSV_State_eChkFileGets;				(* Next step *)

	(* Check read the file *)
	ET_CSV_State_eChkFileGets:
		fbFileGets(bExecute := FALSE);
		
		sCSVLine := fbFileGets.sLine;
		
		IF NOT fbFileGets.bBusy
		THEN
			IF NOT fbFileGets.bError
			THEN				
				IF fbFileGets.bEOF 
				THEN
					udnReadCounter := udnReadCounter + 1;
				
					etCSVState := ET_CSV_State_eFileClose;			(* End of file reached => Close source file *)
				ELSE
					(* FB_FileGets returns text line without the CR (carriage return) character.
					   We have to restore the CR character (replace the $L character with $R$L characters) *)
					IF RIGHT(sCSVLine, 1) = '$L' 
					THEN
						sCSVLine := REPLACE(sCSVLine, '$R$L', 2, LEN(sCSVLine));
					END_IF

					etCSVState := ET_CSV_State_eParseSingleRecord;
					
				END_IF
				
			ELSE
				udnErrNo := fbFilePuts.nErrId;
	
				etCSVState := ET_CSV_State_eError;					(* Next step *)
				
			END_IF
		END_IF
		
	(* Parse single record *)
	ET_CSV_State_eParseSingleRecord:
		fbReader.eCmd := eEnumCmd_First;			(* Read first field value *)
		
		REPEAT
			fbReader(
				pBuffer := ADR(sCSVLine), 
				cbBuffer := SIZEOF(sCSVLine), 
				getValue => sCSVField
			);
			
			IF fbReader.bOk THEN
				fbReader.eCmd := eEnumCmd_Next;			(* Read next field value *)

				IF udnRowCounter <= MIN(udnRowUsingMax, GVL_CSV.MAX_CSV_ROWS) 
				THEN
					IF udnColumnCounter <= MIN(udnColumnUsingMax, GVL_CSV.MAX_CSV_COLUMNS) 
					THEN
						(* Save or use the field value *)
						arsReadRecords[udnRowCounter, udnColumnCounter] := CSVFIELD_TO_STRING(sCSVField, FALSE);
					END_IF
				END_IF

				udnColumnCounter := udnColumnCounter + 1;			(* Increment number of read columns *)
				
				IF fbReader.bCRLF			(* CRLF == TRUE => End of reacord reached *)
				THEN
					udnRowCounter := udnRowCounter + 1;				(* Increment number of read records *)
					udnColumnCounter := 0;			(* Reset number of columns *)
				END_IF

			ELSE			(* Error: End of record reached or all fields read *)
				etCSVState := ET_CSV_State_eFileGets;(* Try to read next line *)
				
			END_IF
			
		UNTIL NOT fbReader.bOk		
		END_REPEAT
				
	(* Close the file *)
	ET_CSV_State_eFileClose:
		fbFileClose(bExecute := FALSE);
		
		fbFileClose(	
			hFile := hFileHandle, 
			bExecute := TRUE
		);

		etCSVState := ET_CSV_State_eChkFileClose;				(* Next step *)

	(* Check close the file *)
	ET_CSV_State_eChkFileClose:
		fbFileClose(bExecute := FALSE);
	
		IF NOT fbFileClose.bBusy
		THEN
			hFileHandle := 0;
		
			IF NOT fbFileClose.bError
			THEN
				etCSVState := ET_CSV_State_eDone;					(* Next step *)

			ELSE
				udnErrNo := fbFileClose.nErrId;
	
				etCSVState := ET_CSV_State_eError;					(* Next step *)
				
			END_IF
		END_IF

	ET_CSV_State_eDone:
		bBusy := FALSE;
		bDone := TRUE;
		bError := FALSE;
		
		etCSVState := ET_CSV_State_eNoExecute;					(* Next step *)

	ET_CSV_State_eError:
		IF hFileHandle <> 0
		THEN
			bDone := FALSE;
			bError := TRUE;
			
			etCSVState := ET_CSV_State_eFileClose;					(* Next step *)

		ELSE
			bBusy := FALSE;
			bDone := FALSE;
			bError := TRUE;
	
			etCSVState := ET_CSV_State_eNoExecute;					(* Next step *)
		END_IF

	ET_CSV_State_eNoExecute:
		IF NOT bExecute
		THEN
			bBusy := FALSE;
			bDone := FALSE;
			bError := FALSE;

			etCSVState := ET_CSV_State_eWaitExecute;			(* Next step *)

		END_IF

END_CASE
]]></ST>
    </Implementation>
