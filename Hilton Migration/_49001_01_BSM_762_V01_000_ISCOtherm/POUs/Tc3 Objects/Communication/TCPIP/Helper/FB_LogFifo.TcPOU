<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_LogFifo" Id="{766c4f88-330d-4c7c-984a-9b7e56ff9b9d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogFifo
(*

The function block used to Log/debug/error message fifo.

Constructor: 	
Company:		Beckhoff
Date:			18.02.2019
Version:		1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bLog			:BOOL := FALSE;					(* TRUE => Enable log message output, FALSE => Disable *)
	sPrefix			:STRING := 'Unknown::';			(* Log message description string (allows the identification of log message source) *)
	
	sMessage		:STRING := '';					(* String message to add (write) to the fifo *)
	nErrID			:UDINT := 0;					(* Error code to add (write) to the fifo *)
	hSocket			:T_HSOCKET;						(* Socket connection handle *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bOk				:BOOL;							(* TRUE = New entry added or removed succesfully, FALSE = Fifo overflow or fifo empty *)
	sGet			:T_MaxString := '';				(* String entry removed (read) from fifo *)
	nCount			:UDINT := 0;					(* Number of fifo entries *)
END_VAR
VAR
	(* Variables *)
	buffer			:ARRAY[0..GVL_TCPIP.BUFFER_SIZE] OF BYTE;(* Internal buffer memory *)
	sSource			:T_MaxString;	
	sPut			:T_MaxString;
	
	(* Instances *)
	fbBuffer 		:FB_StringRingBuffer;			(* Basic (lower level) string buffer control function block *)

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[;]]></ST>
    </Implementation>
    <Action Name="Clear" Id="{a4df61f1-4670-459e-85e4-0bc625550458}">
      <Implementation>
        <ST><![CDATA[(* Clears all fifo entries *)
fbBuffer.A_Reset(
	pBuffer := ADR(buffer), 
	cbBuffer := SIZEOF(buffer), 
	bOk => bOk, 
	nCount => nCount, 
	getValue => sGet
); 
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Error" Id="{49c4c73c-15dd-4b90-a927-c56cc2cc30ce}">
      <Implementation>
        <ST><![CDATA[(* Adds new fifo entry *)
IF nErrID = 0 
THEN
	sSource := '::Error: 0x';
ELSIF ( nErrID AND 16#80000000) = 16#80000000 
THEN
	IF nErrID = 16#80072746 
	THEN
		sSource := '::Win32 error (the connection is reset by remote side): 0x';
	ELSE
		sSource := '::Win32 error: 0x';
	END_IF
ELSIF (nErrID AND 16#00008100) = 16#00008100 
THEN
	CASE nErrID 
	OF
		GVL_TCPIP.ERROR_RECEIVE_TIMEOUT:
			sSource := '::PLC sample project receive timeout error: 0x';
		GVL_TCPIP.ERROR_SENDFIFO_OVERFLOW:
			sSource := '::PLC sample project send fifo overflow error: 0x';
		GVL_TCPIP.ERROR_RECFIFO_OVERFLOW:
			sSource := '::PLC sample project receive fifo overflow error: 0x';
	ELSE
		sSource := '::Other PLC sample project error: 0x';
	END_CASE
ELSIF (nErrID AND 16#00008000) = 16#00008000 
THEN
	sSource := '::Internal TCP/IP Connection Server error: 0x';
ELSE
	sSource := '::TwinCAT System error: 0x';
END_IF

sPut := CONCAT( CONCAT( CONCAT( sPrefix, sMessage ), sSource ), DWORD_TO_HEXSTR( nErrID AND 16#FFFF, 0, FALSE ) ); 

fbBuffer.A_AddTail(
	pBuffer := ADR(buffer), 
	cbBuffer := SIZEOF(buffer),
	putValue := sPut, 
	bOk => bOk, 
	nCount => nCount 
);

IF bOk 
THEN
	IF bLog(* Log error message *)
	THEN
		ADSLOGSTR( ADSLOG_MSGTYPE_ERROR OR ADSLOG_MSGTYPE_LOG, '%s', sPut );	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Message" Id="{d4b98e3c-5bf4-4dfa-8ce6-e644902bb8f0}">
      <Implementation>
        <ST><![CDATA[(* Adds new fifo entry *)
sPut := CONCAT(
			CONCAT(sPrefix, sMessage ), 
			CONCAT( '::', HSOCKET_TO_STRING(hSocket)) 
		);
		
fbBuffer.A_AddTail(
	pBuffer := ADR(buffer), 
	cbBuffer := SIZEOF(buffer),
	putValue := sPut, 
	bOk => bOk, 
	nCount => nCount
);

IF bOk
THEN
	IF bLog(* Log information message *)
	THEN
		ADSLOGSTR( ADSLOG_MSGTYPE_HINT OR ADSLOG_MSGTYPE_LOG, '%s', sPut );	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Remove" Id="{2387caa5-c1aa-4e8c-84ec-7ab95b07567d}">
      <Implementation>
        <ST><![CDATA[(* Removes oldest fifo entry *)
IF nCount = 0 
THEN
	sGet := '';
	bOk := FALSE;
	RETURN;
END_IF

fbBuffer.A_RemoveHead(
	pBuffer := ADR(buffer), 
	cbBuffer := SIZEOF(buffer),
	getValue => sGet, 
	bOk => bOk, 
	nCount => nCount 
);
]]></ST>
      </Implementation>
    </Action>
