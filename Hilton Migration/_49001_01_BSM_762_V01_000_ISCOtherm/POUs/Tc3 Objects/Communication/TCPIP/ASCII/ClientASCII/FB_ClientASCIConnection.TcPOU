<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ClientASCIConnection" Id="{4b2f14ad-5908-4f67-ba35-ecf0b2db8ce8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ClientASCIConnection
(*

The function block used to establish or remove a simple TCP/IP client connection.

Basie on orginal Beckhoffs example.

Constructor: 	Patryk Panylo
Company:		E. Riexinger GmbH
Date:			18.02.2019
Version:		1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable						:BOOL := FALSE;				(* TRUE => Enable/connect, FALSE => Disable/disconnect *)
	bReset						:BOOL := FALSE;				(* Reset connection after error *)
	bFullDuplex					:BOOL := FALSE;				(* TRUE => Enable full duplex communication, FALSE => Disable *)	
	sSrvNetID					:T_AmsNetID	:= '';			(* TwinCAT TCP/IP server network address *)
	sRemoteHost					:T_IPv4Addr	:= '127.0.0.1';	(* IP address of remote server *)
	udnRemotePort				:UDINT := 23;				(* Remote server port *)
	tReconnect					:TIME := T#45S;				(* Try to reconnect after this time *)
	tReceiveTimeout				:TIME := T#100MS;			(* Recive time the which the answer is expected to come *)
	bLoggerEn					:BOOL := FALSE;				(* TRUE => Enable log message output, FALSE => Disable *)
	sDelimiter					:STRING := '';				(* Delimiter (null) *)	
	sPrefix						:STRING := '';				(* Log message description string (allows the identification of log message source) *)	
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bConnected					:BOOL := FALSE;				(* TCP/IP connection state connected *)
	bDisconnected				:BOOL := FALSE;				(* TCP/IP connection state disconnected *)
	bRcvDataValid				:BOOL := FALSE;				(* Recive data valid *)	
	bNoDataRcv 					:BOOL := FALSE;				(* No data receive *)
	bSndBusy					:BOOL := FALSE;				(* Tx function busy *)
	bRcvBusy					:BOOL := FALSE;				(* Rx function busy *)	
	bSndSocketBusy 				:BOOL := FALSE;				(* Send socket busy *)
	bRcvSocketBusy 				:BOOL := FALSE;				(* Recive socket busy *)
	bError						:BOOL := FALSE;				(* Program error *)
	bErrorConnect				:BOOL := FALSE;				(* Connect error *)
	bErrorSnd 					:BOOL := FALSE;				(* Send error *)
	bErrorRcvFifoOverflow 		:BOOL := FALSE;				(* Recive fifo overflow error *)
	bErrorRcv 					:BOOL := FALSE;				(* Receive error *)	
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	fbTx 						:FB_FrameFifo;				(* Tx fifo *)
	fbRx 						:FB_FrameFifo;				(* Rx fifo *)
	fbLoggger					:FB_LogFifo;				(* Logger message fifo *)
END_VAR
VAR
	(* Enummerations *)
	etConnState					:ET_TCPIP_ConnectionState := ET_TCPIP_ConnState_eConnect;
	etSocketConneState			:E_SocketConnectionState := eSOCKET_DISCONNECTED;(* TCP/IP connection state *)
	
	(* Variables *)
	bDisconnect					:BOOL := FALSE;				(* Disconnect flag, if set the socket will be closed *)

	
	
	sTxFrame					:T_MaxString := '';
	sRxFrame					:T_MaxString := '';
	arbyBuffer					:ARRAY[0..GVL_TCPIP.BUFFER_SIZE] OF BYTE;(* Temp. RX buffer *)	
	udnCntRcvBytes				:UDINT := 0;						(* Count of received data bytes *)
	udnLenRcvString				:UDINT := 0;						(* Byte length of received string *)
	udnIdxBytes					:UDINT := 0;
	
	bEndOfString				:BOOL := FALSE;
	udnLenOfString				:UDINT := 0;						(* String length inclusive the null delimiter *)
	bFirstTime 					:BOOL := FALSE;						(* Initialization *)
	
	(* References *)

	(* Interfaces *)

	(* Instances *)
	fbClientServerConnection 	:FB_ClientServerConnection;			(* Create/release TCP/IP connection *)
	fbSocketSend				:FB_SocketSend;						(* Send TCP/IP data *)
	fbSocketReceive				:FB_SocketReceive;					(* Receive TCP/IP data *)
	tonPollTimer				:TON;								(* Receive poll timer *)
	tonResponseTimer			:TON;								(* Response timeout timer *)
	tonReconnectTimer 			:TON;								(* Reconnect timer *)
			
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT bFirstTime
THEN
	tonReconnectTimer(IN := FALSE);

	etConnState := ET_TCPIP_ConnState_eIdle;
	
	bFirstTime := TRUE;
END_IF;
	
IF bReset
   AND bError
THEN
	bErrorConnect := FALSE;
	bErrorSnd := FALSE;
	bErrorRcvFifoOverflow := FALSE;
	bErrorRcv := FALSE;
	
	etConnState := ET_TCPIP_ConnState_eIdle;
END_IF

CASE etConnState 
OF
	ET_TCPIP_ConnState_eIdle:
		fbClientServerConnection( 	
			sSrvNetID := sSrvNetID,
			nMode := SEL(bLoggerEn, 0, CONNECT_MODE_ENABLEDBG),			(* Enable/disable debug messages? *)
			sRemoteHost := sRemoteHost, 
			nRemotePort := udnRemotePort,
			bEnable := FALSE, 
			tReconnect := tReconnect,
			eState => etSocketConneState 
		);
				
		(* Please wait some seconds and then try to connect again *)
		tonReconnectTimer(
			IN := NOT fbClientServerConnection.bBusy
				  AND NOT fbClientServerConnection.bError
		);
		
		IF tonReconnectTimer.Q 
		THEN
			fbSocketSend(bExecute := FALSE);
			fbSocketReceive(bExecute := FALSE);
			
			bSndSocketBusy := FALSE;
			bRcvSocketBusy := FALSE;
			bSndBusy := FALSE;
			bRcvBusy := FALSE;
			bDisconnect := FALSE;
			bRcvDataValid := FALSE;
			bNoDataRcv := FALSE;
			udnCntRcvBytes := 0;
			
			bErrorConnect := FALSE;
			bErrorSnd := FALSE;
			bErrorRcvFifoOverflow := FALSE;
			bErrorRcv := FALSE;
					
			tonPollTimer(IN := FALSE, PT := T#0S);
			tonResponseTimer(IN := FALSE, PT := tReceiveTimeout);
			tonReconnectTimer(IN := FALSE, PT := tReconnect);
			
			(* Clear Tx frame *)
			MEMSET(ADR(sTxFrame),0,SIZEOF(sTxFrame));
			(* Clear Rx frame *)
			MEMSET(ADR(sRxFrame),0,SIZEOF(sRxFrame));
			(* Clear buffer *)
			MEMSET(ADR(arbyBuffer),0,SIZEOF(arbyBuffer));
			
			(* Clear TX fifo (optional) *)
			fbTx.Clear( 
				sPrefix := CONCAT(sPrefix, 'FB_FrameFifo(sender)::' ), 
				bLog := bLoggerEn 
			);
			(* Clear RX fifo (optional) *)
			fbRx.Clear( 
				sPrefix := CONCAT(sPrefix, 'FB_FrameFifo(receiver)::' ), 
				bLog := bLoggerEn );
			(* Clear log fifo (optional) *)
			fbLoggger.Clear(
				sPrefix := sPrefix, 
				bLog := bLoggerEn 
			);
					
			etConnState := ET_TCPIP_ConnState_eConnect;
			
		END_IF
					
	ET_TCPIP_ConnState_eConnect:
		fbClientServerConnection( 	
			bEnable := bEnable, 
			eState => etSocketConneState 
		);
		
		IF NOT fbClientServerConnection.bBusy 
		   AND NOT fbClientServerConnection.bError
		THEN
			IF etSocketConneState = eSOCKET_CONNECTED		(* Connected *)
			THEN			
				(* Connection established *)	
				fbLoggger.Message(
					sMessage := 'Connection established!', 
					hSocket := fbClientServerConnection.hSocket 
				);
				
				etConnState := ET_TCPIP_ConnState_eDataExchsnge;
			END_IF
			
		ELSIF NOT fbClientServerConnection.bBusy 
			  AND fbClientServerConnection.bError
		THEN
			bErrorConnect := TRUE;			(* Connect error *)
		
			(* Connect error *)
			fbLoggger.Error(
				sMessage := 'FB_ClientServerConnection()', 
				nErrID := fbClientServerConnection.nErrId
			);
					
		END_IF
		
		IF NOT bEnable
		   AND bErrorConnect
		THEN
			//tonReconnectTimer(IN := FALSE, PT := T#0S);
		
			etConnState := ET_TCPIP_ConnState_eIdle;
		END_IF
		
	ET_TCPIP_ConnState_eDataExchsnge:
		bDisconnect := NOT bEnable OR bDisconnect;(* User/internal disconnect requested? *)
		
		IF bDisconnect 
		   AND NOT bSndSocketBusy 
		   AND NOT bRcvSocketBusy
		THEN
			bDisconnect := FALSE;			(* Reset flag *)
			
			fbLoggger.Message(
				sMessage := 'Closing connection!', 
				hSocket := fbClientServerConnection.hSocket
			);

			etConnState := ET_TCPIP_ConnState_eDisconnect;
		ELSE

			(* ------------------ Send tx data -------------------------------------- *)
			IF NOT bDisconnect 
			   AND NOT bSndSocketBusy
			THEN
				IF bFullDuplex
				   OR (NOT bFullDuplex AND NOT bRcvBusy)
				THEN							
					fbTx.RemoveHead(sGet => sTxFrame);			(* Remove oldest string entry *)
	
					IF fbTx.bOk			(* Success *)
					THEN
						bSndBusy := TRUE;
						bSndSocketBusy := TRUE;
						
						bRcvDataValid := FALSE;				(* Recive data valid *)	
						bNoDataRcv := FALSE;				(* No data receive *)
						tonPollTimer(IN := FALSE, PT := T#0S);
						tonResponseTimer(IN := FALSE);									(* Bytes received => disable timeout check *)
						
						CONCAT(sTxFrame, sDelimiter);				(* Add delimiter *)
												
						fbSocketSend(bExecute := FALSE);
						fbSocketSend(	
							sSrvNetID := sSrvNetID,
							hSocket := fbClientServerConnection.hSocket,
							cbLen := INT_TO_UDINT(LEN(sTxFrame)), (* Send string *)
							pSrc := ADR(sTxFrame),(* Address of the string variable *)
							bExecute := TRUE
						);						
					END_IF	 				
				END_IF
			ELSE			(* Wait until send not busy *)
				fbSocketSend(bExecute := FALSE);				
				
				IF NOT fbSocketSend.bBusy 
				   AND NOT fbSocketSend.bError
				THEN
					bSndBusy := FALSE;
					bSndSocketBusy := FALSE;
			
				ELSIF NOT fbSocketSend.bBusy 
				   	  AND fbSocketSend.bError
				THEN
					bSndBusy := FALSE;
					bSndSocketBusy := FALSE;
					bRcvDataValid := FALSE;
					bNoDataRcv := FALSE;				 
 					bErrorSnd := TRUE;			(* Send error *)					
					bDisconnect := TRUE;
 
					(* Send error => log error and disconnect *)
					fbLoggger.Error( 
						sMessage := 'FB_SocketSend()', 
						nErrID := fbSocketSend.nErrId
					);
	
				END_IF
			END_IF
			(* ---------------------------------------------------------------------- *)


			(* ---------------------- Get rx data ----------------------------------- *)
			IF NOT bDisconnect 
			   AND NOT bRcvSocketBusy 
			THEN
				bRcvDataValid := FALSE;				(* Recive data valid *)	
				bNoDataRcv := FALSE;				(* No data receive *)
				tonPollTimer(IN := SEL(bFullDuplex, NOT bSndBusy, TRUE));
				
				IF tonPollTimer.Q 
				THEN
					bRcvBusy := TRUE;
					
					IF fbRx.cbFree >= SIZEOF(sRxFrame)			(* Check free rx fifo space *)
					THEN
						bRcvSocketBusy := TRUE;
						tonPollTimer(IN := FALSE, PT := GVL_TCPIP.RECEIVE_POLLING_TIME);
						
						fbSocketReceive(bExecute := FALSE);
						fbSocketReceive( 
							sSrvNetId := sSrvNetID,
							hSocket := fbClientServerConnection.hSocket,
							cbLen := SIZEOF(arbyBuffer) - udnCntRcvBytes,
							pDest := ADR(arbyBuffer) + udnCntRcvBytes,
							bExecute := TRUE
						);						
					END_IF
				END_IF
				
			ELSE			(* Wait until receive not busy *)
				fbSocketReceive(bExecute := FALSE);
			
				IF NOT fbSocketReceive.bBusy
				   AND NOT fbSocketReceive.bError  
				THEN
					bRcvSocketBusy := FALSE;					
				
					IF fbSocketReceive.nRecBytes > 0 			(* Bytes received *)
					THEN				
						tonPollTimer(IN := FALSE, PT := T#0S);							(* Bytes received => increase the read (polling) speed *)
						tonResponseTimer(IN := FALSE);									(* Bytes received => disable timeout check *)
						udnCntRcvBytes := udnCntRcvBytes + fbSocketReceive.nRecBytes;	(* Calculate the number of received data bytes *)

						(* Parse received bytes and extract strings *)
						REPEAT
							bEndOfString := TRUE;
							
							IF udnCntRcvBytes > 0
							THEN
								(* Search for string null delimiter *)
								FOR udnIdxBytes := 0 TO udnCntRcvBytes - INT_TO_UDINT(LEN(sDelimiter)) BY 1
								DO
									(* End of string position found *)
									IF arbyBuffer[udnIdxBytes] = F_ToASC(sDelimiter)			
									THEN
										udnLenRcvString := udnIdxBytes + INT_TO_UDINT(LEN(sDelimiter));							(* Calculate the length of string *)
										MEMSET(ADR(sRxFrame),0,SIZEOF(sRxFrame));												(* Clear Rx frame *)			
										MEMCPY(ADR(sRxFrame), ADR(arbyBuffer), MIN(udnLenRcvString, SIZEOF(sRxFrame)));			(* Copy string bytes to temp string variable *)

										fbRx.AddTail(sPut := sRxFrame);			(* Add string to the rx fifo *)
										IF fbRx.bOk 
										THEN
											MEMSET(ADR(arbyBuffer), 0, udnLenRcvString);				(* Clear Rx buffer *)
											MEMMOVE(ADR(arbyBuffer), ADR(arbyBuffer) + udnLenRcvString, udnCntRcvBytes - udnLenRcvString);			(* Move/shift remaining bytes in buffer *)
											udnCntRcvBytes := udnCntRcvBytes - udnLenRcvString;			(* Recalculate the remaining data length *)

											IF fbRx.cbFree >= SIZEOF(sRxFrame)			(* Check free rx buffer space *)
											THEN
												bRcvSocketBusy := FALSE;
												bRcvBusy := FALSE;
												bRcvDataValid := TRUE;				(* Recive data valid *)	
												bNoDataRcv := FALSE;				(* No data receive *)
												
												bEndOfString := FALSE;						(* Try to parse the next string *)
												
											END_IF
											
										ELSE			(* Fifo overflow => log error and disconnect *)
											bRcvSocketBusy := FALSE;
											bRcvBusy := FALSE;
											bRcvDataValid := FALSE;
											bNoDataRcv := FALSE;
											bErrorRcvFifoOverflow := TRUE;			(* Fifo overflow error *)	
											bDisconnect := TRUE;
											
											fbLoggger.Error(
												sMessage := 'FB_FrameFifo(receiver)', 
												nErrID := GVL_TCPIP.ERROR_RECFIFO_OVERFLOW
											);
			
											RETURN;
										END_IF

										EXIT;
									END_IF
								END_FOR

							END_IF (* IF cbReceived > 0 THEN *)

						UNTIL bEndOfString
						END_REPEAT																
						
					ELSE			(* No bytes received *)
						tonResponseTimer(IN := tonResponseTimer.PT > T#0S);			(* No bytes received => enable timeout check *)
						
						IF bError
						   OR tonResponseTimer.Q	 				(* Timeout error*)
						THEN
							bRcvSocketBusy := FALSE;
							bRcvBusy := FALSE;						
							bRcvDataValid := FALSE;				(* Recive data valid *)	
							bNoDataRcv := TRUE;				(* No data receive *)				
							bDisconnect := bFullDuplex;
							
							MEMSET(ADR(sRxFrame),0,SIZEOF(sRxFrame));												(* Clear Rx frame *)
							tonResponseTimer(IN := FALSE);									(* Bytes received => disable timeout check *)
							
							fbLoggger.Error(
								sMessage := 'FB_SocketReceive()', 
								nErrID := GVL_TCPIP.ERROR_RECEIVE_TIMEOUT
							);
		
						END_IF
							
					END_IF(* IF fbReceive.nRecBytes > 0 THEN *)														
							
				ELSIF NOT fbSocketReceive.bBusy
				   	  AND fbSocketReceive.bError
				THEN
					bRcvSocketBusy := FALSE;
					bRcvBusy := FALSE;
					bRcvDataValid := FALSE;
					bNoDataRcv := FALSE;
					bErrorRcv:= TRUE;
					bDisconnect := TRUE;

					(* Receive error => log error and disconnect *)
					fbLoggger.Error(
						sMessage := 'FB_SocketReceive()', 
						nErrID := fbSocketReceive.nErrId
					);

				END_IF
				
			END_IF(* IF NOT bDisconnect AND NOT bRcvBusy THEN *)
			(* ---------------------------------------------------------------------- *)
			
		END_IF(* IF bDisconnect AND NOT bSndBusy AND NOT bRcvBusy THEN *)
		
	ET_TCPIP_ConnState_eDisconnect:		
		fbClientServerConnection(
			bEnable := FALSE, 
			eState => etSocketConneState 
		);
		
		IF etSocketConneState = eSOCKET_DISCONNECTED 
		THEN
			etConnState := ET_TCPIP_ConnState_eIdle;

		END_IF

END_CASE
			
(* TCP/IP connection state *)
bConnected := etSocketConneState = eSOCKET_CONNECTED;
bDisconnected := etSocketConneState = eSOCKET_DISCONNECTED;
bError := bErrorConnect
		  OR bErrorSnd
		  OR bErrorRcvFifoOverflow
		  OR bErrorRcv;
]]></ST>
    </Implementation>
