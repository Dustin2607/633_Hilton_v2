<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EtherCATFrameDiag_1" Id="{b3e3f95f-0d61-40b2-a345-7abaa0246d82}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EtherCATFrameDiag_1
VAR_INPUT
	wFrmXWcState 		: WORD;
	wReqZeroMask 		: WORD := 16#FFFF; (* bit TRUE: require wFrmXWcState.bit = FALSE, bit FALSE: ignore wFrmXWcState.bit *)
END_VAR
VAR_OUTPUT
	bFrameWcStateOK		: BOOL;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* set/clear frame flag *)
bFrameWcStateOK := ((wFrmXWcState AND wReqZeroMask) = 0);]]></ST>
    </Implementation>
    <LineIds Name="FB_EtherCATFrameDiag_1">
      <LineId Id="10" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>