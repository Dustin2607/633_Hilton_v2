<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Temperature_1" Id="{cd5a6239-1f02-41e4-9980-74aeaea9b137}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Temperature_1
(*

The function block used to control temperature.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable FB signal *)
	bIn						:BOOL;						(* Input signal *)
	tTimeOut					:TIME := t#5s;					(* Timeout *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bOut					:BOOL;						(* Air pressure ok *)
	bError					:BOOL;						(* Error by no air pressure *)
	bWarning				:BOOL;						(* Warning by no temperature *)
	udnErrorNo				:UDINT;
	udnMessageNo			:UDINT;
	sMsg					:STRING;
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime				:BOOL;						(* First cycle *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	tonWatchDog				:TON;						(* Timer to delay *)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	bOut := TRUE;
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	tonWatchDog(IN := FALSE,
	             		 PT := tTimeOut);
	bFirstTime := FALSE;
	RETURN;
END_IF;

IF NOT bFirstTime
THEN
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	tonWatchDog(IN := FALSE,
	             		 PT := tTimeOut);
	bFirstTime := TRUE;
END_IF;

(* Timer starts when came rising edge of signal *)
tonWatchDog(
	IN := NOT bIn,
	PT := tTimeOut
);

bOut := bIn;
bError := NOT bOut
	        AND tonWatchDog.Q;
bWarning := NOT bError
		      AND NOT bOut;

IF NOT bOut
THEN
	IF tonWatchDog.Q                       		 (* Error if air pressure not present *)
	THEN
		udnErrorNo := 1;
		udnMessageNo := 0;
		sMsg := 'Temperature not ok';
	END_IF;
ELSE
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_Temperature_1">
      <LineId Id="45" Count="48" />
    </LineIds>
  </POU>
</TcPlcObject>