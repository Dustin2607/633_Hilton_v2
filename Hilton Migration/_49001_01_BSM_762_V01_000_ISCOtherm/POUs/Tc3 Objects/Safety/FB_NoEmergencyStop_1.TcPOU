<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_NoEmergencyStop_1" Id="{af658b9a-567a-47a6-8267-4eabf9bb8d28}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NoEmergencyStop_1
(*

The function block used to control emergency stop.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			23.04.2015
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable FB signal *)
	bIn						:BOOL;						(* Input signal *)
	bInConf					:BOOL;						(* Emergency stop *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bOut					:BOOL;						(* Air pressure ok *)
	bOutConf					:BOOL;						(* Confirm output *)
	bError					:BOOL;						(* Error by no air pressure *)
	udnErrorNo				:UDINT;
	udnMessageNo			:UDINT;
	sMsg					:STRING;
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)
	bFirstTime				:BOOL;						(* First cycle *)

	(* References *)

	(* Interfaces *)

	(* Instances *)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	bOut := TRUE;
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	bFirstTime := FALSE;
	RETURN;
END_IF;

IF NOT bFirstTime
THEN
	bError := FALSE;
	udnErrorNo := 0;
	udnMessageNo := 0;
	sMsg := '';
	bFirstTime := TRUE;
END_IF;

bOut := bIn;
bError := NOT bOut;

IF bError
THEN
	udnErrorNo := 1;
	sMsg := 'Emergency stop';
ELSE
	udnErrorNo := 0;
	sMsg := 'No emergency stop';
END_IF;

bOutConf := bInConf AND NOT bIn;]]></ST>
    </Implementation>
    <LineIds Name="FB_NoEmergencyStop_1">
      <LineId Id="45" Count="32" />
    </LineIds>
  </POU>
</TcPlcObject>