      <LineId Id="38" Count="3" />
      <LineId Id="109" Count="2" />
      <LineId Id="42" Count="1" />
      <LineId Id="143" Count="0" />
      <LineId Id="44" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>