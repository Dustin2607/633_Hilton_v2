<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Hint_1" Id="{1fbf7dbb-b5a3-4694-872a-a72ce69d052e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Hint_1
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bEnable					:BOOL;						(* Enable FB signal *)
	stAlarmIn				:ST_AlarmProperties;				(* Alarm output *)
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	stAlarmOut				:ST_AlarmProperties;				(* Alarm output *)
END_VAR
VAR_IN_OUT

END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtAlarm					:R_TRIG;
	ftAlarm					:F_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Check method enabled *)
IF NOT bEnable
THEN
	RETURN;
END_IF;

rtAlarm(CLK := stAlarmIn.bActive);
ftAlarm(CLK := stAlarmIn.bActive);

IF rtAlarm.Q
THEN
	stAlarmOut.bActive := TRUE;
	stAlarmOut.enType := stAlarmIn.enType;
	stAlarmOut.dtDateTime := stAlarmIn.dtDateTime;
	stAlarmOut.dnCode := stAlarmIn.dnCode;
    
ELSIF ftAlarm.Q
THEN
	stAlarmOut.bActive := FALSE;
	//stAlarmOut.enType := ET_AlarmType.eIdle;
	//stAlarmOut.dtDateTime := DT#1970-01-01-00:00;
	//stAlarmOut.dnCode := 0;	
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="FB_Hint_1">
      <LineId Id="26" Count="5" />
      <LineId Id="69" Count="11" />
      <LineId Id="97" Count="0" />
      <LineId Id="123" Count="1" />
      <LineId Id="85" Count="0" />
      <LineId Id="43" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>