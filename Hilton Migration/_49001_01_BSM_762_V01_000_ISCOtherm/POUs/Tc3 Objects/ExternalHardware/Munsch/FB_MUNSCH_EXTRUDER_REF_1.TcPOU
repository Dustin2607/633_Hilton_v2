	bLockedInterface				:BOOL;						(* Locked interface *)
	bHeat						:BOOL;						(* Heat status ON = TRUE, OFF = FALSE *)
	bHeating						:BOOL;						(* Heating status ON = TRUE, OFF = FALSE *)
	bHeated						:BOOL;						(* Heated status ON = TRUE, OFF = FALSE *)
	bError						:BOOL;						(* Error ON = TRUE, OFF = FALSE *)
	bExtruding					:BOOL;						(* Extruder status ON = TRUE, OFF = FALSE *)
	nMaterialRefTemp			:INT;						(* Referenc material tamperature *)
	nMaterialActTemp				:INT;						(* Current material tamperature *)
	nAirRefTemp					:INT;						(* Referenc air tamperature *)
	nAirActTemp					:INT;						(* Current air tamperature *)
	stMunschCmd				:ST_MUNSCH_CMD_Data;
	stMunschRes					:ST_MUNSCH_RES_Data;
	bInterfaceReady				:BOOL;						(* Interface ready to use *)
	bInterfaceError				:BOOL;						(* Interface error *)
	bStringReceived				:BOOL;						(* String received *)
	bSetAirTemp					:BOOL;						(* Set air temperature *)
	bSetMaterialTemp			:BOOL;						(* Set material temperature *)
	bStartHeat					:BOOL;						(* Heat start *)
	bStopHeat					:BOOL;						(* Heat stop *)
	bStartExtruding				:BOOL;						(* Extruding start *)
	bStopExtruding				:BOOL;						(* Extruding start *)
	bReadStatus					:BOOL;						(* Enable read current status *)
	bExtrudingStop				:BOOL;						(* Extruding stop *)
	nExtrudingSpeed				:INT;						(* Extruding speed *)
END_VAR
VAR_OUTPUT

END_VAR
VAR_IN_OUT

END_VAR
VAR

