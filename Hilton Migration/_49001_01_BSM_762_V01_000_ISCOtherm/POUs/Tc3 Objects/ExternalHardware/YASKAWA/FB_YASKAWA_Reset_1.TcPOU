<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_YASKAWA_Reset_1" Id="{6bd22294-f442-4429-ac2e-a71c14778a4c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_YASKAWA_Reset_1
(*

The function block used to reset the yaskawa message.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			20.06.2018
Version:			1.00

Date:			Revision:		Who:				Comment

*)
VAR_INPUT
	(* Input variables / Eingang Variablen *)
	bExecute					:BOOL;		(* Execut the function block *)
	bExtReset					:BOOL;
END_VAR
VAR_OUTPUT
	(* Output variables / Ausgang Variablen *)
	bDone						:BOOL;			(* Program done. *)
	bBusy						:BOOL;			(* Program busy *)
	bError						:BOOL;			(* Error *)
	udnErrorNo					:UDINT;			(* Error number *)
	sErrorMsg					:STRING; 		(* Error message *)
END_VAR
VAR_IN_OUT
	(* Input Output variables / Ausgang Variablen *)
	Yaskawa					:ST_YASKAWA_REF;				(* The YASKAWA_REF data type  is an interface between the PLC and the YASKAWA and contains axis information *)
END_VAR
VAR
	(* Enummerations *)

	(* Variables *)

	(* References *)

	(* Interfaces *)

	(* Instances *)
	rtExecute						:R_TRIG;
	rtExtReset					:R_TRIG;
	rtDrivesOn					:R_TRIG;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExecute(CLK := bExecute
			      AND Yaskawa.stYaskawaToPlc.bAlarmErrorOccured);
rtDrivesOn(CLK := Yaskawa.stYaskawaToPlc.bServoIsOn
	   		        AND Yaskawa.stPlcToYaskawa.bExternalServoOn);

IF rtExecute.Q
     OR (rtDrivesOn.Q
	    AND Yaskawa.stYaskawaToPlc.bAlarmErrorOccured)
THEN
	bBusy := TRUE;
	Yaskawa.stPlcToYaskawa.bAlarmReset := TRUE;

ELSIF Yaskawa.stPlcToYaskawa.bAlarmReset
	   AND NOT Yaskawa.stYaskawaToPlc.bAlarmErrorOccured
THEN
	bBusy := FALSE;
	Yaskawa.stPlcToYaskawa.bAlarmReset := FALSE;
END_IF;

bDone := bExecute
		AND NOT bBusy
		AND NOT Yaskawa.stYaskawaToPlc.bAlarmErrorOccured;        (* Error *)]]></ST>
    </Implementation>
    <LineIds Name="FB_YASKAWA_Reset_1">
      <LineId Id="45" Count="22" />
    </LineIds>
  </POU>
</TcPlcObject>