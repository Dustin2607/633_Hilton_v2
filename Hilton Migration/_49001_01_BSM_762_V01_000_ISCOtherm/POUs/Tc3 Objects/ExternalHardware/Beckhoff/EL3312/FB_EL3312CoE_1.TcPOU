<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EL3312CoE_1" Id="{a74ec424-d5b7-4ed9-be11-bc61316d7690}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EL3312CoE_1
VAR CONSTANT
(*+++++ Upper Array Bounds +++++*)
	CnMaxIdxRead: UDINT:= 15;
	CnMaxIdxWrite: UDINT:= 15;
END_VAR
VAR_INPUT
(*+++++ AMS Address for CoE Com +++++*)
	stAdsAddr: ST_AmsAddr;
	nTerminalNr: UINT;
	nChannelNr					:UINT;
	bSetCoeParametersToDefault: BOOL;
	bReadCoeParameters: BOOL;
	bWriteCoeParameters: BOOL;
(*+++++ CoE Write +++++*)
	stCoeWrite: ST_EL3312CoeInfo;
END_VAR
VAR_OUTPUT
(*+++++ General Status for this Function Block +++++*)
	bCoeAccessOK: BOOL;
	sStatusCoeAccess:STRING(255);
(*+++++ CoE Read +++++*)
	stCoeRead: ST_EL3312CoeInfo;
END_VAR
VAR
(*+++++ AMS Address for CoE Com +++++*)
	sAdsAddr: STRING(30);
(*+++++ CoE Index +++++*)
	wCoeIndex:WORD;
	bCoeBusy: BOOL;
(*+++++ Init +++++*)
	bInitDoneRead: BOOL;
	bFirstDoneRead: BOOL;
	bInitDoneWrite: BOOL;
	bFirstDoneWrite: BOOL;
	bInitDoneBufLen: BOOL;
	bInitDoneAmsNetId: BOOL;
	bInitDoneIndex:BOOL;
	rtInit:R_TRIG;
(*+++++ CoE Read +++++*)
	fbCoeReadNew: FB_EcCoESdoRead;
	astCoeRead: ARRAY[1..CnMaxIdxRead] OF ST_EL3312CoeReadData;
	nIdxRead: UINT;
	nStepRead: UINT;
	nDummyData: UDINT;
	bCoeReadBusy: BOOL;
	rtCoeUpdate: R_TRIG;
	bStartRead: BOOL;
	rtStartRead: R_TRIG;
	bBusyRead: BOOL;
	bErrorRead: BOOL;
	nReadErrorId: UDINT;
(*+++++ CoE Reset+++++ *)
	fbCoeReset: FB_EcCoESdoWrite;
	nDummyReset: DWORD:= 16#64616F6C;
	rtCoeDefault: R_TRIG;
	nStepReset: UDINT;
	bBusyReset: BOOL;
	bErrorReset: BOOL;
	nResetErrorId: UDINT;
(*+++++ CoE Write +++++*)
	fbCoeWriteNew: FB_EcCoESdoWrite;
	astCoeWrite: ARRAY[1..CnMaxIdxWrite] OF ST_EL3312CoeWriteData;
	nIdxWrite: UINT;
	nStepWrite: UINT;
	dwDummyDataWrite: DWORD;
	bCoeWriteBusy:BOOL;
	rtCoeWrite: R_TRIG;
	bStartWrite: BOOL;
	rtStartWrite: R_TRIG;
	bBusyWrite: BOOL;
	bErrorWrite: BOOL;
	nWriteErrorId: UDINT;
(*+++++ Converted Variables +++++*)
	dwEnableFilterConv		:DWORD;
	dwEnableUserScaleConv: DWORD;
	dwEnableLimit1Conv: DWORD;
	dwEnableLimit2Conv: DWORD;
	dwEnableUserCalibrationConv: DWORD;
	dwEnableVendorCalibrationConv: DWORD;
(*+++++ Variables to show some parameters in the visu +++++*)
	sFilterSettings: STRING;
	sThermocouple: STRING;
	sStatus: STRING;
(*+++++ Error +++++*)
	bCoeError: BOOL;

(*+++++ Miscellaneous +++++*)
	sAdsErrorTextRead: STRING(255);
	sAdsErrorTextWrite: STRING(255);
	sAdsErrorTextReset: STRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
A_Init();
(*
(*Assigning String Values to the possbile inputs of the Subindex 'Filter settings' Index 8000:11 *)
CASE astCoeRead[12].dwData OF
	0:	sFilterSettings := '50 Hz';
	1:	sFilterSettings := '60 Hz';
	2:	sFilterSettings := '100 Hz';
	3:	sFilterSettings := '500 Hz';
	4:	sFilterSettings := '1 kHz';
	5:	sFilterSettings := '2 kHz';
	6:	sFilterSettings := '3.75 kHz';
	7:	sFilterSettings := '7.5 kHz';
	8:	sFilterSettings := '15 kHz';
	9:	sFilterSettings := '30 kHz';
	10:	sFilterSettings := '5 Hz';
	11:	sFilterSettings := '10 Hz';
END_CASE

(*Assigning String Values to the possbile inputs of the Subindex 'Thermocouple' Index 80n0:19 *)
CASE astCoeRead[15].dwData OF
	0:	sThermocouple := 'Typ: K -200°C bis 1370°C';
	1:	sThermocouple := 'Typ: J -100°C bis 1200°C';
	2:	sThermocouple := 'Typ: L 0°C bis 900°C';
	3:	sThermocouple := 'Typ: E -100°C bis 1000°C';
	4:	sThermocouple := 'Typ: T -200°C bis 400°C';
	5:	sThermocouple := 'Typ: N -100°C bis 1300°C';
	6:	sThermocouple := 'Typ: U 0°C bis 600°C';
	7:	sThermocouple := 'Typ: B 600°C bis 1800°C';
	8:	sThermocouple := 'Typ: R 0°C bis 1767°C';
	9:	sThermocouple := 'Typ: S 0°C bis 1760°C';
	10:	sThermocouple := 'Typ: C 0°C bis 2320°C';
	100:	sThermocouple := '+/-30 mV (1uV resolution)';
	101:	sThermocouple := '+/-60 mV (2uV resolution)';
	102:	sThermocouple := '+/-75 mV (4uV resolution)';
END_CASE

(*++++++++++++++++++++++++++++++ CoE Default ++++++++++++++++++++++++++++++*)
rtCoeDefault(CLK:= bSetCoeParametersToDefault , Q=>);
CASE nStepReset OF
	0:	(*Idle*)
		fbCoeReset.bExecute:= FALSE;
		IF rtCoeDefault.Q AND NOT bCoeBusy THEN
			nStepReset:= 10;
		END_IF
	10:	IF NOT fbCoeReset.bBusy THEN
			IF NOT fbCoeReset.bError THEN
				fbCoeReset.bExecute:= TRUE;
				stCoeWrite.bEnableUserScale := FALSE;
				stCoeWrite.bEnableFilter := FALSE;
				stCoeWrite.bEnableLimit1 := FALSE;
				stCoeWrite.bEnableLimit2 := FALSE;
				stCoeWrite.bEnableUserCalibration := FALSE;
				stCoeWrite.bEnableVendorCalibration := TRUE;
				stCoeWrite.dwColdjunctionCompensation := 0;
				stCoeWrite.nUserScaleOffset := 0;
				stCoeWrite.dnUserScaleGain := 65536;
				stCoeWrite.nLimit1 := 0;
				stCoeWrite.nLimit2 := 0;
				stCoeWrite.dwFilterSettings := 0;
				stCoeWrite.nUserCalibrationOffset := 0;
				stCoeWrite.unUserCalibrationGain := 65535;
				stCoeWrite.dwTCElement := 0;
				nStepReset:= 0;
				bStartRead:= TRUE;				(*After a Reset of the Parameters, they are automatically read so that they are shown correctly in the visu*)
			END_IF
		END_IF
	ELSE
		nStepReset:= 0;
END_CASE

(*++++++++++++++++++++++++++++++ CoE Read +++++++++++++++++++++++++++++*)
rtStartRead(CLK:=bStartRead, Q=> );
rtCoeUpdate(CLK:=bReadCoeParameters AND bFirstDoneRead, Q=> );
CASE nStepRead OF
	0:	(*Idle*)
		nDummyData:= 0;
		fbCoeReadNew.bExecute:= FALSE;
		bCoeReadBusy:= FALSE;
		IF rtCoeUpdate.Q OR rtStartRead.Q  THEN
			nIdxRead:= 0;
			nStepRead:= 10;
			bCoeReadBusy:= TRUE;
		END_IF
	10:	(*Start*)
		bStartRead:= FALSE;
		nDummyData:= 0;
		nIdxRead:= nIdxRead + 1;
		fbCoeReadNew.nIndex:= astCoeRead[nIdxRead].wIdx;
		fbCoeReadNew.nSubIndex := astCoeRead[nIdxRead].bySubIdx;
		fbCoeReadNew.bExecute:= TRUE;
		nStepRead:= 20;
	20:	(*Wait*)
		IF fbCoeReadNew.bBusy THEN
			fbCoeReadNew.bExecute:= FALSE;
			nStepRead:= 30;
		END_IF
	30:	(*Read*)
		IF NOT fbCoeReadNew.bBusy THEN
			IF NOT fbCoeReadNew.bError THEN
				astCoeRead[nIdxRead].dwData:= nDummyData;
				astCoeRead[nIdxRead].bReadOK:= TRUE;
				astCoeRead[nIdxRead].nSize:= fbCoeReadNew.fbAdsReadEx.COUNT_R;
				CASE nIdxRead OF
				1:	stCoeRead.bEnableUserScale := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				2:	stCoeRead.bEnableFilter := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				3:	stCoeRead.bEnableLimit1 := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				4:	stCoeRead.bEnableLimit2 := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				5:	stCoeRead.bEnableUserCalibration := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				6:	stCoeRead.bEnableVendorCalibration := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				7:	stCoeRead.dwColdjunctionCompensation := astCoeRead[nIdxRead].dwData;
				8:	stCoeRead.nUserScaleOffset := DWORD_TO_INT(astCoeRead[nIdxRead].dwData);
				9:	stCoeRead.dnUserScaleGain := DWORD_TO_DINT(astCoeRead[nIdxRead].dwData);
				10:	stCoeRead.nLimit1 := DWORD_TO_INT(astCoeRead[nIdxRead].dwData);
				11:	stCoeRead.nLimit2 := DWORD_TO_INT(astCoeRead[nIdxRead].dwData);
				12:	stCoeRead.dwFilterSettings := astCoeRead[nIdxRead].dwData;
				13:	stCoeRead.nUserCalibrationOffset := DWORD_TO_INT(astCoeRead[nIdxRead].dwData);
				14:	stCoeRead.unUserCalibrationGain := DWORD_TO_UINT(astCoeRead[nIdxRead].dwData);
				15:	stCoeRead.dwTCElement := astCoeRead[nIdxRead].dwData;
				END_CASE

			ELSE
				astCoeRead[nIdxRead].bReadOK:= FALSE;
				astCoeRead[nIdxRead].dwData:= 0;
				astCoeRead[nIdxRead].nSize:= 0;
			END_IF
			IF nIdxRead = CnMaxIdxRead THEN
				bFirstDoneRead := TRUE;
				bInitDoneBufLen := FALSE;
				nStepRead:= 0;
			ELSE
				nStepRead:= 10;
			END_IF
		END_IF
	ELSE
		nStepRead:= 0;
END_CASE

(*++++++++++++++++++++++++++ CoE Write ++++++++++++++++++++++++++++++*)
rtStartWrite(CLK:=bStartWrite, Q=> );
rtCoeWrite(CLK:= bWriteCoeParameters AND bFirstDoneWrite, Q=> );
CASE nStepWrite OF
	0:	(*Idle*)
		dwDummyDataWrite:= 0;
		fbCoeWriteNew.bExecute:= FALSE;
		bCoeWriteBusy := FALSE;
		IF rtCoeWrite.Q OR rtStartWrite.Q THEN
			nStepWrite:= 10;
			bCoeWriteBusy := TRUE;
		END_IF
	10: 	(*Start*)
		bStartWrite:= FALSE;
		(*FB_EL3351_CoE.a_Init_BufLen;*)
		IF nIdxWrite= CnMaxIdxWrite THEN
			nIdxWrite:= 0;
		END_IF
		nIdxWrite:= nIdxWrite + 1;
		fbCoeWriteNew.nIndex:= astCoeWrite[nIdxWrite].wIdx;
		fbCoeWriteNew.nSubIndex:= astCoeWrite[nIdxWrite].bySubIdx;
		fbCoeWriteNew.bExecute:= TRUE;
		nStepWrite:= 20;
	20: 	(*Wait*)
		IF fbCoeWriteNew.bBusy THEN
			fbCoeWriteNew.bExecute:= FALSE;
			nStepWrite:= 30;
		END_IF
	30: (*Write*)
		IF NOT fbCoeWriteNew.bBusy THEN
			IF NOT fbCoeWriteNew.bError THEN
				astCoeWrite[nIdxWrite].bWriteOK:= TRUE;
				(*The BOOL_TO_DWORD conversions are needed because some Buttons in the visu need to be linked to a variable of the type BOOL so that they can be toggled.
				Those BOOL variables need to be converted to the type DWORD so that they can be written into the array astCoeWrite.nSize. nSize is a variable of the type DWORD. *)
				CASE nIdxWrite OF
				1:	dwEnableUserScaleConv:= BOOL_TO_DWORD(stCoeWrite.bEnableUserScale);
					astCoeWrite[nIdxWrite].dwData:= dwEnableUserScaleConv;
				2:	dwEnableFilterConv:= BOOL_TO_DWORD(stCoeWrite.bEnableFilter);
					astCoeWrite[nIdxWrite].dwData:= dwEnableFilterConv;
				3:	dwEnableLimit1Conv:= BOOL_TO_DWORD(stCoeWrite.bEnableLimit1);
					astCoeWrite[nIdxWrite].dwData:= dwEnableLimit1Conv;
				4:	dwEnableLimit2Conv:= BOOL_TO_DWORD(stCoeWrite.bEnableLimit2);
					astCoeWrite[nIdxWrite].dwData:= dwEnableLimit2Conv;
				5:	dwEnableUserCalibrationConv:= BOOL_TO_DWORD(stCoeWrite.bEnableUserCalibration);
					astCoeWrite[nIdxWrite].dwData:= dwEnableUserCalibrationConv;
				6:	dwEnableVendorCalibrationConv:= BOOL_TO_DWORD(stCoeWrite.bEnableVendorCalibration);
					astCoeWrite[nIdxWrite].dwData:= dwEnableVendorCalibrationConv;
				7:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dwColdjunctionCompensation;
				8:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.nUserScaleOffset;
				9:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dnUserScaleGain;
				10:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.nLimit1;
				11:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.nLimit2;
				12:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dwFilterSettings;
				13:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.nUserCalibrationOffset;
				14:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.unUserCalibrationGain;
				15:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dwTCElement;
				END_CASE
				dwDummyDataWrite:= astCoeWrite[nIdxWrite].dwData;
				fbCoeWriteNew.bExecute:= TRUE;
			END_IF
			IF (nIdxWrite = CnMaxIdxWrite) THEN
				bFirstDoneWrite := TRUE;
				bStartRead:= TRUE;
				nStepWrite:= 0;
			ELSE
				nStepWrite:= 10;
			END_IF
		END_IF
	ELSE
		nStepWrite:= 0;
END_CASE

fbCoeReadNew( 	sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:=,
				nIndex:= ,
				pDstBuf:= ADR( nDummyData ),
				cbBufLen:=SIZEOF(nDummyData ),
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=>bBusyReset ,
				bError=>bErrorReset ,
				nErrId=>nReadErrorId );

(*This Function returns the ADS Error Text *)
sAdsErrorTextRead:= F_AdsError_Text (nCode:= nReadErrorId);

fbCoeWriteNew( 	sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:= 16#0,
				nIndex:= 16#0,
				pSrcBuf:= ADR( dwDummyDataWrite ),
				cbBufLen:= astCoeWrite[nIdxWrite].nSize,
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=>bBusyWrite ,
				bError=> bErrorWrite,
				nErrId=>nWriteErrorId );

(*This Function returns the ADS Error Text *)
sAdsErrorTextWrite:= F_AdsError_Text (nCode:= nWriteErrorId);

fbCoeReset( 		sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:= 16#01,
				nIndex:= 16#1011,
				pSrcBuf:= ADR( nDummyReset ),		(*Resetting all CoEs happens when CoE Index 16#1011, Subindex 16#01 is given the value 16#64616F6C*)
				cbBufLen:=SIZEOF( nDummyReset ),
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=> bBusyRead ,
				bError=> bErrorRead,
				nErrId=> nResetErrorId);

(*This Function returns the ADS Error Text *)
sAdsErrorTextReset:= F_AdsError_Text (nCode:= nResetErrorId);

(*++++++++++++++++++++++++++++++ Status Strings ++++++++++++++++++++++++++++++*)
IF bCoeWriteBusy THEN
	sStatus:= 'CoE Parameters are written';
ELSIF bCoeReadBusy THEN
	sStatus:= 'CoE Parameters are being read';
ELSIF bBusyReset THEN
	sStatus:= 'CoE Parameters are set to default';
ELSE
	sStatus:= 'Idling';
END_IF

(*Error/Busy*)
IF bErrorRead OR bErrorWrite OR bErrorReset THEN
	bCoeError:= TRUE;
ELSE
	bCoeError:= FALSE;
END_IF

IF bBusyRead OR bBusyWrite OR bBusyReset THEN
	bCoeBusy:= TRUE;
ELSE
	bCoeBusy:= FALSE;
END_IF

(*General Status for this Function Block*)
IF NOT bErrorRead AND NOT bErrorWrite AND NOT bErrorReset THEN
	bCoeAccessOK:= TRUE;
	sStatusCoeAccess:= 'Coe Access: No Error.';
ELSE
	bCoeAccessOK:= FALSE;
	IF bErrorRead THEN
		sStatusCoeAccess:= 'fbCoERead Error. ';
	ELSE
		sStatusCoeAccess:= '';
	END_IF
	IF bErrorWrite THEN
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, 'fbCoEWrite Error. ');
	ELSE
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, '');
	END_IF
	IF bErrorReset THEN
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, 'fbCoEReset Error. ');
	ELSE
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, '');
	END_IF
END_IF
*)
bCoeAccessOK:= TRUE;]]></ST>
    </Implementation>
    <Action Name="A_Init" Id="{2554fd51-e0bd-4212-a226-57ca1eadb910}">
      <Implementation>
        <ST><![CDATA[(* Generate ADS Address string from ADS Address Datatype *)
IF NOT bInitDoneAmsNetId THEN
	bInitDoneAmsNetId:= TRUE;
	sAdsAddr:= F_CreateAmsNetId(stAdsAddr.netId);
END_IF

IF NOT bInitDoneIndex THEN
	bInitDoneIndex:= TRUE;
	wCoeIndex := 16#8000 + (SEL(nChannelNr > 0, 0, nChannelNr - 1) * 16#10);
END_IF

IF NOT bInitDoneBufLen THEN
	bInitDoneBufLen:= TRUE;

	nIdxWrite:= 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[1].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[2].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[3].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[4].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[5].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[6].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[7].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[8].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[9].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[10].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[11].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[12].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[13].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[14].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[15].nSize;

	nIdxWrite:= 0;

END_IF

IF NOT bInitDoneRead THEN
	bInitDoneRead := TRUE;
	bStartRead := TRUE;

	nIdxRead:= 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#01;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#06;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#07;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#08;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#0A;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#0B;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#0C;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#11;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#12;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#13;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#14;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#15;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#17;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#18;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= wCoeIndex;
	astCoeRead[nIdxRead].bySubIdx:= 16#19;

END_IF

IF NOT bInitDoneWrite THEN
	bInitDoneWrite:= TRUE;

(*+++++ Index 80x0 +++++*)
	nIdxWrite:= 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#01;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#06;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#07;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#08;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#0A;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#0B;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#0C;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#11;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#12;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#13;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#14;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#15;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#17;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#18;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= wCoeIndex;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#19;

END_IF

rtInit(
	CLK := bInitDoneAmsNetId
		     AND bInitDoneIndex
		     AND bInitDoneBufLen
		     AND bInitDoneRead
		     AND bInitDoneWrite
		     AND bFirstDoneRead
);

IF rtInit.Q
THEN
	bStartWrite := TRUE;
END_IF]]></ST>
      </Implementation>
