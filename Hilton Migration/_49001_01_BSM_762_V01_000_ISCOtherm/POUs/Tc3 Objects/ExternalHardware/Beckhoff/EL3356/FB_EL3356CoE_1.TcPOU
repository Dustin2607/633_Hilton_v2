<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EL3356CoE_1" Id="{5821f14d-94b9-4e68-9561-55a1a9100319}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EL3356CoE_1
VAR CONSTANT
(*+++++ Upper Array Bounds +++++*)
	CnMaxIdxRead: UDINT:= 15;
	CnMaxIdxWrite: UDINT:= 15;
END_VAR
VAR_INPUT
(*+++++ AMS Address for CoE Com +++++*)
	stAdsAddr: ST_AmsAddr;
	nTerminalNr: UINT;
	bSetCoeParametersToDefault: BOOL;
	bReadCoeParameters: BOOL;
	bWriteCoeParameters: BOOL;
(*+++++ CoE Write +++++*)
	stCoeWrite: ST_EL3356CoeInfo;
END_VAR
VAR_OUTPUT
(*+++++ General Status for this Function Block +++++*)
	bCoeAccessOK: BOOL;
	sStatusCoeAccess:STRING(255);
(*+++++ CoE Read +++++*)
	stCoeRead: ST_EL3356CoeInfo;
END_VAR
VAR
(*+++++ AMS Address for CoE Com +++++*)
	sAdsAddr: STRING(30);
(*+++++ CoE Index +++++*)
	bCoeBusy: BOOL;
(*+++++ Init +++++*)
	bInitDoneRead: BOOL;
	bFirstDoneRead: BOOL;
	bInitDoneWrite: BOOL;
	bFirstDoneWrite: BOOL;
	bInitDoneBufLen: BOOL;
	bInitDoneAmsNetId: BOOL;
	rtInit:R_TRIG;
(*+++++ CoE Read +++++*)
	fbCoeReadNew: FB_EcCoESdoRead;
	astCoeRead: ARRAY[1..CnMaxIdxRead] OF ST_EL3356CoeReadData;
	nIdxRead: UINT;
	nStepRead: UINT;
	nDummyData: UDINT;
	bCoeReadBusy: BOOL;
	rtCoeUpdate: R_TRIG;
	bStartRead: BOOL;
	rtStartRead: R_TRIG;
	bBusyRead: BOOL;
	bErrorRead: BOOL;
	nReadErrorId: UDINT;
(*+++++ CoE Reset+++++ *)
	fbCoeReset: FB_EcCoESdoWrite;
	nDummyReset: DWORD:= 16#64616F6C;
	rtCoeDefault: R_TRIG;
	nStepReset: UDINT;
	bBusyReset: BOOL;
	bErrorReset: BOOL;
	nResetErrorId: UDINT;
(*+++++ CoE Write +++++*)
	fbCoeWriteNew: FB_EcCoESdoWrite;
	astCoeWrite: ARRAY[1..CnMaxIdxWrite] OF ST_EL3356CoeWriteData;
	nIdxWrite: UINT;
	nStepWrite: UINT;
	dwDummyDataWrite: DWORD;
	bCoeWriteBusy:BOOL;
	rtCoeWrite: R_TRIG;
	bStartWrite: BOOL;
	rtStartWrite: R_TRIG;
	bBusyWrite: BOOL;
	bErrorWrite: BOOL;
	nWriteErrorId: UDINT;
(*+++++ Converted Variables +++++*)
	dwEnableFilterConv		:DWORD;
	dwEnableUserScaleConv: DWORD;
	dwEnableUserScaleConvIndex8010: DWORD;
(*+++++ Variables to show some parameters in the visu +++++*)
	sFilterSettings: STRING;
	sStatus: STRING;
(*+++++ Error +++++*)
	bCoeError: BOOL;

(*+++++ Miscellaneous +++++*)
	sAdsErrorTextRead: STRING(255);
	sAdsErrorTextWrite: STRING(255);
	sAdsErrorTextReset: STRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
A_Init();

(*Assigning String Values to the possbile inputs of the Subindex 'Filter settings'
Pleas note that the Parameter 'Filter Settings' of Index 8000:11 also applys to Index 8010:15. *)
CASE astCoeRead[3].dwData OF
	0:	sFilterSettings := 'FIR 50 Hz';
	1:	sFilterSettings := 'FIR 60 Hz';
	2:	sFilterSettings := 'IIR 1';
	3:	sFilterSettings := 'IIR 2';
	4:	sFilterSettings := 'IIR 3';
	5:	sFilterSettings := 'IIR 4';
	6:	sFilterSettings := 'IIR 5';
	7:	sFilterSettings := 'IIR 6';
	8:	sFilterSettings := 'IIR 7';
	9:	sFilterSettings := 'IIR 8';
	10:	sFilterSettings := 'Dynamic IIR';
	11:	sFilterSettings := 'PDO Filter frequency';
END_CASE

(*++++++++++++++++++++++++++++++ CoE Default ++++++++++++++++++++++++++++++*)
rtCoeDefault(CLK:= bSetCoeParametersToDefault , Q=>);
CASE nStepReset OF
	0:	(*Idle*)
		fbCoeReset.bExecute:= FALSE;
		IF rtCoeDefault.Q AND NOT bCoeBusy THEN
			nStepReset:= 10;
		END_IF
	10:	IF NOT fbCoeReset.bBusy THEN
			IF NOT fbCoeReset.bError THEN
				fbCoeReset.bExecute:= TRUE;
				stCoeWrite.bEnableFilter := 1;
				stCoeWrite.bEnableUserScale := 1;
				stCoeWrite.dwFilterSettings := 0;
				stCoeWrite.rGain := 1.0;
				stCoeWrite.rTara := 0.0;
				stCoeWrite.rRatedOutput := 2.0;
				stCoeWrite.rNominalLoad := 5.0;
				stCoeWrite.rZeroBalance := 0.0;
				stCoeWrite.rGravityOfEarth := 9.806650;
				stCoeWrite.rScaleFactor := 1000.0;
				stCoeWrite.rReferenceLoad := 5.0;
				stCoeWrite.bEnableUserScaleIndex8010 := 0;
				stCoeWrite.dnUserScaleOffsetIndex8010 := 0;
				stCoeWrite.dnUserScaleGainIndex8010 := 65536;
				stCoeWrite.dwFilterSettingsIndex8010 := 0;
				nStepReset:= 0;
				bStartRead:= TRUE;				(*After a Reset of the Parameters, they are automatically read so that they are shown correctly in the visu*)
			END_IF
		END_IF
	ELSE
		nStepReset:= 0;
END_CASE

(*++++++++++++++++++++++++++++++ CoE Read +++++++++++++++++++++++++++++*)
rtStartRead(CLK:= bStartRead , Q=> );
rtCoeUpdate(CLK:=bReadCoeParameters AND bFirstDoneRead, Q=> );
CASE nStepRead OF
	0:	(*Idle*)
		nDummyData:= 0;
		fbCoeReadNew.bExecute:= FALSE;
		bCoeReadBusy:= FALSE;
		IF rtCoeUpdate.Q OR rtStartRead.Q  THEN
			nIdxRead:= 0;
			nStepRead:= 10;
			bCoeReadBusy:= TRUE;
		END_IF
	10:	(*Start*)
		bStartRead:= FALSE;
		nDummyData:= 0;
		nIdxRead:= nIdxRead + 1;
		fbCoeReadNew.nIndex:= astCoeRead[nIdxRead].wIdx;
		fbCoeReadNew.nSubIndex := astCoeRead[nIdxRead].bySubIdx;
		fbCoeReadNew.bExecute:= TRUE;
		nStepRead:= 20;
	20:	(*Wait*)
		IF fbCoeReadNew.bBusy THEN
			fbCoeReadNew.bExecute:= FALSE;
			nStepRead:= 30;
		END_IF
	30:	(*Read*)
		IF NOT fbCoeReadNew.bBusy THEN
			IF NOT fbCoeReadNew.bError THEN
				astCoeRead[nIdxRead].dwData:= nDummyData;
				astCoeRead[nIdxRead].bReadOK:= TRUE;
				astCoeRead[nIdxRead].nSize:= fbCoeReadNew.fbAdsReadEx.COUNT_R;
				CASE nIdxRead OF
				1:	stCoeRead.bEnableFilter := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				2:	stCoeRead.bEnableUserScale := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				3:	stCoeRead.dwFilterSettings := astCoeRead[nIdxRead].dwData;
				4:	stCoeRead.rGain := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				5:	stCoeRead.rTara := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				6:	stCoeRead.rRatedOutput := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				7:	stCoeRead.rNominalLoad := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				8:	stCoeRead.rZeroBalance := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				9:	stCoeRead.rGravityOfEarth := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				10:	stCoeRead.rScaleFactor := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				11:	stCoeRead.rReferenceLoad := F_DwordToBitReal(astCoeRead[nIdxRead].dwData);
				12:	stCoeRead.bEnableUserScaleIndex8010 := DWORD_TO_BOOL(astCoeRead[nIdxRead].dwData);
				13:	stCoeRead.dnUserScaleOffsetIndex8010 := astCoeRead[nIdxRead].dwData;
				14:	stCoeRead.dnUserScaleGainIndex8010 := astCoeRead[nIdxRead].dwData;
				15:	stCoeRead.dwFilterSettingsIndex8010 := astCoeRead[nIdxRead].dwData;
				END_CASE

			ELSE
				astCoeRead[nIdxRead].bReadOK:= FALSE;
				astCoeRead[nIdxRead].dwData:= 0;
				astCoeRead[nIdxRead].nSize:= 0;
			END_IF
			IF nIdxRead = CnMaxIdxRead THEN
				bFirstDoneRead := TRUE;
				bInitDoneBufLen := FALSE;
				nStepRead:= 0;
			ELSE
				nStepRead:= 10;
			END_IF
		END_IF
	ELSE
		nStepRead:= 0;
END_CASE

(*++++++++++++++++++++++++++ CoE Write ++++++++++++++++++++++++++++++*)
rtStartWrite(CLK:=bStartWrite, Q=> );
rtCoeWrite(CLK:= bWriteCoeParameters AND bFirstDoneWrite, Q=> );
CASE nStepWrite OF
	0:	(*Idle*)
		dwDummyDataWrite:= 0;
		fbCoeWriteNew.bExecute:= FALSE;
		bCoeWriteBusy := FALSE;
		IF rtCoeWrite.Q OR rtStartWrite.Q THEN
			nStepWrite:= 10;
			bCoeWriteBusy := TRUE;
		END_IF
	10: 	(*Start*)
		bStartWrite := FALSE;
		(*FB_EL3351_CoE.a_Init_BufLen;*)
		IF nIdxWrite= CnMaxIdxWrite THEN
			nIdxWrite:= 0;
		END_IF
		nIdxWrite:= nIdxWrite + 1;
		fbCoeWriteNew.nIndex:= astCoeWrite[nIdxWrite].wIdx;
		fbCoeWriteNew.nSubIndex:= astCoeWrite[nIdxWrite].bySubIdx;
		fbCoeWriteNew.bExecute:= TRUE;
		nStepWrite:= 20;
	20: 	(*Wait*)
		IF fbCoeWriteNew.bBusy THEN
			fbCoeWriteNew.bExecute:= FALSE;
			nStepWrite:= 30;
		END_IF
	30: (*Write*)
		IF NOT fbCoeWriteNew.bBusy THEN
			IF NOT fbCoeWriteNew.bError THEN
				astCoeWrite[nIdxWrite].bWriteOK:= TRUE;
				(*The BOOL_TO_DWORD conversions are needed because some Buttons in the visu need to be linked to a variable of the type BOOL so that they can be toggled.
				Those BOOL variables need to be converted to the type DWORD so that they can be written into the array astCoeWrite.nSize. nSize is a variable of the type DWORD. *)
				CASE nIdxWrite OF
				1:	dwEnableFilterConv:= BOOL_TO_DWORD(stCoeWrite.bEnableFilter);
					astCoeWrite[nIdxWrite].dwData:= dwEnableFilterConv;
				2:	dwEnableUserScaleConv:= BOOL_TO_DWORD(stCoeWrite.bEnableUserScale);
					astCoeWrite[nIdxWrite].dwData:= dwEnableUserScaleConv;
				3:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dwFilterSettings;
				4:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rGain);
				5:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rTara);
				6:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rRatedOutput);
				7:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rNominalLoad);
				8:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rZeroBalance);
				9:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rGravityOfEarth);
				10:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rScaleFactor);
				11:	astCoeWrite[nIdxWrite].dwData:= F_RealToBitDword(stCoeWrite.rReferenceLoad);
				12:	dwEnableUserScaleConvIndex8010:= BOOL_TO_DWORD(stCoeWrite.bEnableUserScaleIndex8010);
					astCoeWrite[nIdxWrite].dwData:= dwEnableUserScaleConvIndex8010;
				13:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dnUserScaleOffsetIndex8010;
				14:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dnUserScaleGainIndex8010;
				15:	astCoeWrite[nIdxWrite].dwData:= stCoeWrite.dwFilterSettingsIndex8010;
				END_CASE
				dwDummyDataWrite:= astCoeWrite[nIdxWrite].dwData;
				fbCoeWriteNew.bExecute:= TRUE;
			END_IF
			IF (nIdxWrite= CnMaxIdxWrite) THEN
				bFirstDoneWrite := TRUE;
				bStartRead:= TRUE;
				nStepWrite:= 0;
			ELSE
				nStepWrite:= 10;
			END_IF
		END_IF
	ELSE
		nStepWrite:= 0;
END_CASE

sAdsAddr := F_CreateAmsNetId(nIds:=stAdsAddr.netId );

fbCoeReadNew( 	sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:=,
				nIndex:= ,
				pDstBuf:= ADR( nDummyData ),
				cbBufLen:=SIZEOF(nDummyData ),
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=>bBusyReset ,
				bError=>bErrorReset ,
				nErrId=>nReadErrorId );

(*This Function returns the ADS Error Text *)
sAdsErrorTextRead:= F_AdsError_Text (nCode:= nReadErrorId);

fbCoeWriteNew( 	sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:=,
				nIndex:=,
				pSrcBuf:= ADR( dwDummyDataWrite ),
				cbBufLen:= astCoeWrite[nIdxWrite].nSize,
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=>bBusyWrite ,
				bError=> bErrorWrite,
				nErrId=>nWriteErrorId );

(*This Function returns the ADS Error Text *)
sAdsErrorTextWrite:= F_AdsError_Text (nCode:= nWriteErrorId);

fbCoeReset( 		sNetId:= sAdsAddr ,
				nSlaveAddr:= stAdsAddr.port ,
				nSubIndex:= 16#01,
				nIndex:= 16#1011,
				pSrcBuf:= ADR( nDummyReset ),		(*Resetting all CoEs happens when CoE Index 16#1011, Subindex 16#01 is given the value 16#64616F6C*)
				cbBufLen:=SIZEOF( nDummyReset ),
				bExecute:= ,
				tTimeout:=  t#2s,
				bBusy=> bBusyRead ,
				bError=> bErrorRead,
				nErrId=> nResetErrorId);

(*This Function returns the ADS Error Text *)
sAdsErrorTextReset:= F_AdsError_Text (nCode:= nResetErrorId);

(*++++++++++++++++++++++++++++++ Status Strings ++++++++++++++++++++++++++++++*)
IF bCoeWriteBusy THEN
	sStatus:= 'CoE Parameters are written';
ELSIF bCoeReadBusy THEN
	sStatus:= 'CoE Parameters are being read';
ELSIF bBusyReset THEN
	sStatus:= 'CoE Parameters are set to default';
ELSE
	sStatus:= 'Idling';
END_IF

(*Error/Busy*)
IF bErrorRead OR bErrorWrite OR bErrorReset THEN
	bCoeError:= TRUE;
ELSE
	bCoeError:= FALSE;
END_IF

IF bBusyRead OR bBusyWrite OR bBusyReset THEN
	bCoeBusy:= TRUE;
ELSE
	bCoeBusy:= FALSE;
END_IF

(*General Status for this Function Block*)
IF NOT bErrorRead AND NOT bErrorWrite AND NOT bErrorReset THEN
	bCoeAccessOK:= TRUE;
	sStatusCoeAccess:= 'Coe Access: No Error.';
ELSE
	bCoeAccessOK:= FALSE;
	IF bErrorRead THEN
		sStatusCoeAccess:= 'fbCoERead Error. ';
	ELSE
		sStatusCoeAccess:= '';
	END_IF
	IF bErrorWrite THEN
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, 'fbCoEWrite Error. ');
	ELSE
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, '');
	END_IF
	IF bErrorReset THEN
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, 'fbCoEReset Error. ');
	ELSE
		sStatusCoeAccess:= CONCAT(sStatusCoeAccess, '');
	END_IF
END_IF]]></ST>
    </Implementation>
    <Action Name="A_Init" Id="{e3e5f6b9-46bc-4b2f-9c7b-267d66bc2b9d}">
      <Implementation>
        <ST><![CDATA[(* Generate ADS Address string from ADS Address Datatype *)
IF NOT bInitDoneAmsNetId THEN
	bInitDoneAmsNetId:= TRUE;
	sAdsAddr:= F_CreateAmsNetId(stAdsAddr.netId);
END_IF

IF NOT bInitDoneBufLen THEN
	bInitDoneBufLen:= TRUE;

	nIdxWrite:= 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[1].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[2].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[3].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[4].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[5].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[6].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[7].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[8].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[9].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[10].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[11].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[12].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[13].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[14].nSize;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].nSize:= astCoeRead[15].nSize;


	nIdxWrite:= 0;

END_IF

IF NOT bInitDoneRead THEN
	bInitDoneRead := TRUE;
	bStartRead := TRUE;

(*+++++ Index 8000 +++++*)
	nIdxRead:= 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#01;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#03;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#11;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#21;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#22;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#23;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#24;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#25;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#26;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#27;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8000;
	astCoeRead[nIdxRead].bySubIdx:= 16#28;

(*+++++ Index 8010 +++++*)
	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8010;
	astCoeRead[nIdxRead].bySubIdx:= 16#01;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8010;
	astCoeRead[nIdxRead].bySubIdx:= 16#11;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8010;
	astCoeRead[nIdxRead].bySubIdx:= 16#12;

	nIdxRead:= nIdxRead + 1;
	astCoeRead[nIdxRead].wIdx:= 16#8010;
	astCoeRead[nIdxRead].bySubIdx:= 16#15;

END_IF

IF NOT bInitDoneWrite THEN
	bInitDoneWrite:= TRUE;

(*+++++ Index 8000 +++++*)
	nIdxWrite:= 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#01;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#03;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#11;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#21;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#22;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#23;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#24;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#25;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#26;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#27;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8000;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#28;

(*+++++ Index 8010 +++++*)
	nIdxWrite:= nIdxWrite +1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8010;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#01;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8010;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#11;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8010;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#12;

	nIdxWrite:= nIdxWrite + 1;
	astCoeWrite[nIdxWrite].wIdx:= 16#8010;
	astCoeWrite[nIdxWrite].bySubIdx:= 16#15;

END_IF

rtInit(
	CLK := bInitDoneAmsNetId
		     AND bInitDoneBufLen
		     AND bInitDoneRead
		     AND bInitDoneWrite
		     AND bFirstDoneRead
);

IF rtInit.Q
THEN
	bStartWrite := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FB_EL3356CoE_1">
      <LineId Id="85" Count="282" />
    </LineIds>
    <LineIds Name="FB_EL3356CoE_1.A_Init">
      <LineId Id="0" Count="205" />
    </LineIds>
  </POU>
</TcPlcObject>