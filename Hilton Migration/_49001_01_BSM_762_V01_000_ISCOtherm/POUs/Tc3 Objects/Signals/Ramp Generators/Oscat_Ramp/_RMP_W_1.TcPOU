<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="_RMP_W_1" Id="{26b6b21a-9b07-4514-a802-2da6760e3e97}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK _RMP_W_1
VAR_INPUT
	bEnable				:BOOL;			(* Enable input *)
	bDirection			:BOOL;			(* Direction, TRUE means Up *)
	tFullRmpTime		:TIME;			(* Time to run a full ramp *)
END_VAR
VAR_IN_OUT
	wRamp 				:WORD;			(* Output signal *)
END_VAR
VAR
	tx, tl 					:DWORD;
	dnStep 				:DINT;
	bInit					:BOOL;
	bLastDirection		:BOOL;
END_VAR

(*
_RMP_B Is an 16-bit ramp generator. The ramp is generated in an externally
declared variable. The ramp is rising when DIR = TRUE and falling if DIR
= FALSE. Reaching a final value of the ramp, the generator remains at this
value. With the input E the ramp can be stopped at any time, when E =
TRUE the ramp runs. The input TR shows the time which is needed to cycle
through 0-65535 or the other way around.

*)]]></Declaration>
    <Implementation>
      <ST><![CDATA[tx := T_PLC_MS();
IF bEnable
     AND bInit
THEN
	(* We need to set tl = tx when direction changes *)
	IF bDirection XOR bLastDirection
	THEN
	 	tl := tx;
	 	bLastDirection := bDirection;
	END_IF;

	(* Check elapsed time and calculate only if necessary *)
	IF tFullRmpTime > t#0s
	THEN
		dnStep := DWORD_TO_DINT(SHL(tx-tl, 16) / TIME_TO_DWORD(tFullRmpTime));
	ELSE
		dnStep := 65535;
	END_IF;

	IF dnStep > 0
	THEN
		(* Perform the step on the ramp *)
		tl := tx;
		(* Calculate the step response *)
		IF NOT bDirection
		THEN
			dnStep := -1 * dnStep;
		END_IF;

		wRamp := DINT_TO_WORD(LIMIT(0, WORD_TO_DINT(wRamp) + dnStep, 65535));

	END_IF;
ELSE
	tl := tx;
	bInit := TRUE;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="_RMP_W_1">
      <LineId Id="25" Count="35" />
    </LineIds>
  </POU>
</TcPlcObject>