<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ForceInput" Id="{54e587c0-0e93-4562-828a-7f2d4c58da9e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ForceInput
(*

Forcing the input bit through pointer.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			04.04.2020
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	bEnable						:BOOL; 							(* Enable FB *)
	pInputAddr					:POINTER TO BOOL;				(* The address of input argument *)
	bForceInState				:BOOL;							(* Force input state *)
	tDelayOn					:TIME;							(* Delay signal on *)
	tDelayOff					:TIME;							(* Delay signal off *)
END_VAR
VAR_OUTPUT
END_VAR
VAR
	pByteAddr					:POINTER TO BYTE;
	byCurrentInState				:BYTE;							(* Current input state *)
	byBitMask					:BYTE;

	tonDelayOn					:TON;
	tonDelayOff					:TOF;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	RETURN;
END_IF

(* Delay on signal *)
tonDelayOn(
	IN := bForceInState,
	PT := tDelayOn
);

(* Delay off signal *)
tonDelayOff(
	IN := tonDelayOn.Q,
	PT := tDelayOff
);

IF tonDelayOff.Q
THEN
	pInputAddr^ := TRUE;
ELSE
	pInputAddr^ := FALSE;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_ForceInput">
      <LineId Id="34" Count="15" />
      <LineId Id="55" Count="6" />
    </LineIds>
  </POU>
</TcPlcObject>