<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ForceByte_1" Id="{873ac721-84aa-4b54-a4ca-af5767ebbaca}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ForceByte_1
(*

Forcing the input bit through pointer.
IO variables in VAR_CONFIG are generated automatically by TwinCAT - read only
Matching variable must be with  %I* declarated.

Constructor: 		Patryk Panylo
Company:		E. Riexinger GmbH
Date:			28.10.2013
Version:			1.00

Date:			Revision:		Who:				Comment
dd.mm.yyyy		x.xx			Initials			comment

*)
VAR_INPUT
	bEnable						:BOOL; 							(* Enable FB *)
	pByteAddr					:POINTER TO BYTE;				(* The address of input argument in a DWORD: ADR(Input) where e.g Input = %IB *)
	bForceInState				:BOOL;							(* Force input state *)
	tDelayOn					:TIME;							(* Delay signal on *)
	tDelayOff						:TIME;							(* Delay signal off *)
END_VAR
VAR_OUTPUT
END_VAR
VAR
	byCurrentInState				:BYTE;							(* Current input state *)
	byBitMask					:BYTE;

	tonDelayOn					:TON;
	tonDelayOff					:TOF;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable
THEN
	RETURN;
END_IF

(* Delay on signal *)
tonDelayOn(
	IN := bForceInState,
	PT := tDelayOn
);

(* Delay off signal *)
tonDelayOff(
	IN := tonDelayOn.Q,
	PT := tDelayOff
);

byCurrentInState := pByteAddr^;

byBitMask := 2#00000001;

IF tonDelayOff.Q
THEN
	pByteAddr^ := byCurrentInState OR byBitMask;
ELSE
	pByteAddr^ := byCurrentInState AND NOT byBitMask;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_ForceByte_1">
      <LineId Id="34" Count="15" />
      <LineId Id="51" Count="10" />
    </LineIds>
  </POU>
</TcPlcObject>