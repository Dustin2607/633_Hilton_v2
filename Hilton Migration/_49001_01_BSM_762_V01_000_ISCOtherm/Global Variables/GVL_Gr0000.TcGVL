  <GVL Name="GVL_Gr0000" Id="{1a299dfc-298a-4a00-bab0-e59ff0917878}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
	etgGr00MachineMode				:ET_MachineMode;			(* Machine mode *)
	etgGr00MachineState				:ET_MachineState;			(* Machine state *)
	stgGr00Blinker					:ST_Blinker;
	bgGr00NoEmergencyStop			:BOOL;						(* No ermergency Stop / Keine Notaus *)
	bgGr00AirPressureOK				:BOOL;						(* Air Pressure is available / Luftdruck ist vorhanden *)
	bgGr00LightCurtainOK				:BOOL;						(* Light curtain ok / Freigabe Lichtschranke i.o *)
	bgGr00PowerSupplyOk			:BOOL;						(* Power supply on / Leitung eingeschaltet *)
	bgGr00AllDoorsClosed				:BOOL;						(* All doors closed / Alle Türen geschlossen *)
	bgGr00AllDoorsClosedLocked		:BOOL;						(* All doors closed and locked / Alle Türen geschlossen und verrrigelt *)
	bgGr00ModeAutomatic				:BOOL;						(* Machine mode automatic *)
	bgGr00ModeHome				:BOOL;						(* Machine mode home *)
	bgGr00ModeManual				:BOOL;						(* Machine mode manual *)
	bgGr00MachineRunning			:BOOL;						(* Machine running / Maschine lauft *)
	bgGr00MachineStandstill			:BOOL;						(* Machine standstill / Maschin steht *)
	bgGr00SafetyCompleted			:BOOL;						(* Safety completed *)
	bgGr00ManualCompleted			:BOOL;						(* Manual completed *)
	bgGr00HomeCompleted			:BOOL;						(* Home completed / Grundsrellung ausgeführt *)
	bgGr00AutoCompleted				:BOOL;						(* Automatic completed / Automatik beendet *)
	bgGr00MoveInterrupted			:BOOL;						(* Move interrupted / Bewegung unterbrochen *)
	bgGr00ConfirmAlarm				:BOOL;						(* Confirm alarm *)
	bgGr00MachinePurge				:BOOL;						(* Machine purge *)
	rgGr00Override					:REAL;						(* Override *)
	bgGr00WritePersistent				:BOOL;						(* Write persisten data *)
	stgGr00DateTime					:ST_DateTime;				(* Current date and time *)
	bgGr00HomeNotInCrashGr01		:BOOL;						(* Home not in crash for Gr01 output *)
	arrGr00ProcessPara				:ARRAY [0..usnFileArrayMaxDimR, 0..usnFileArrayMaxDimC ] OF REAL; 			(* Matrix with process parameters from file *)
	bgGr00DoorsUnlockRequest 		:BOOL;						(* Doors unlock request *)
	bgGr00DoorsUnlockRelease		:BOOL;						(* Doors unlock release *)
END_VAR]]></Declaration>
