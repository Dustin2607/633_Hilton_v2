<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr00IO" Id="{ef6e8546-689f-4fc0-aaf6-aef5ba56072a}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
(* Inputs / Eingänge *)
	stinGr00FieldbusStatus					AT %I*:ST_FieldbusStatus;										(* 		State of the fieldbus / Status des Fieldbus *)

	binGr00NoEmergencyStop					AT %I*:BOOL;													(*) 	No emergency stop / kein Notaus *)
	binGr00AirPressureOK					AT %I*:BOOL;													(*) 	Air pressure OK / Luftdruck i.O. *)
	arbinGr00DoorsClosed					AT %I* :ARRAY [1..5] OF BOOL;									(*) 	Doors closed / Türe geschlossen *)
	arbinGr00PowerSupplyOn					AT %I* :ARRAY [1..5] OF BOOL;									(*) 	Power supply on / 24V DC vorhanden. *)
	binGr00LightCurtainOK					AT %I*:BOOL;													(*) 	Light curtain ok / Freigabe Lichtschranke i.o *)
	binGr00TempOK							AT %I*:BOOL;													(*) 	Temperature fuse OK / Temperatursicherung i.O. *)
	binGr00AllDoorsClosed					AT %I*:BOOL;													(*) 	All doors closed / Alle Türen geschlossen *)
	binGr00AllDoorsLocked					AT %I*:BOOL;													(*) 	All doors locked / Alle Türen verriegelt *)

	binGr00PushBtnStart						AT %I*:BOOL;													(* DI 0.5)	Push button "Start" / Taste "Start" *)
	binGr00PushBtnStop						AT %I*:BOOL;													(* DI 0.6)	Push button "Stop" / Taste "Stop" *)
	binGr00PushBtnHome						AT %I*:BOOL;													(* DI 0.7)	Push button "Home" / Taster"Grundstellung" *)
	binGr00PushBtnReset						AT %I*:BOOL;													(* DI )	Push button "Reset" / Taste "Reset" *)
	binGr00PushBtnRef						AT %I*:BOOL;													(*) 	Push button "Ref" / Taste "Ref" *)

	binGr00PS6A24Ready						AT %I*:BOOL;													(* DI 10.1 PS6A24 is Ready; Ready if true *)
	binGr00PS6A24Warning_1					AT %I*:BOOL;													(* DI 10.3 PS6A24 Warning 1; Warning active if false; close to overload *)	
	binGr00PS6A24Warning_2					AT %I*:BOOL;													(* DI 10.5 PS6A24 Warning 2; Warning active if false; one or more phases out *)
	
	binGr00Luetze_F1						AT %I*:BOOL;													(* DI 10.0 DC Fuse F1 error *)
	binGr00Luetze_F2						AT %I*:BOOL;													(* DI 10.0 DC Fuse F2 error *)
	binGr00Luetze_F3						AT %I*:BOOL;													(* DI 10.0 DC Fuse F3 error *)
	
	
	(* Outputs / Ausgänge *)
	boutGr00AirPressureOn					AT %Q*:BOOL;													(* DQ 101.0) 	Air pressure on / Luftdruck ein. *)
	boutGr00ConfLightCurtain				AT %Q*:BOOL;													(*) 	Confirm light Curtain / Quitt Lichtschrank *)

	boutGr00BulbBtnStart					AT %Q*:BOOL;													(* DQ 0.5) 	Signal button bulb "start" / Signallampe "Start" *)
	boutGr00BulbBtnStop						AT %Q*:BOOL;													(* DQ 0.6) 	Signal button bulb "stop" / Signallampe "Stop" *)
	boutGr00BulbBtnHome						AT %Q*:BOOL;													(* DQ 0.7) 	Signal button bulb "home" / Signallampe "Grundstellung" *)
	boutGr00BulbBtnReset					AT %Q*:BOOL;													(* DQ 0.3) 	Signal button bulb "reset" / Signallampe "Reset" *)
	boutGr00BulbBtnRef						AT %Q*:BOOL;													(*) 	Signal button bulb "ref" / Signallampe "Ref" *)

	boutGr00BulbGreen						AT %Q*:BOOL;													(*) 	Signal column bulb "automatic" / Signallampe "Automatik" *)
	boutGr00BulbRed							AT %Q*:BOOL;													(*) 	Signal column bulb "stop" or "error" / Signallampe "Stop" oder "Fehler" *)
	boutGr00BulbYellow						AT %Q*:BOOL;													(*) 	Signal column bulb "warning" OR "message" / Signallampe "Warnung" oder "Message" *)
	boutGr00BulbWhite						AT %Q*:BOOL;													(*) 	Signal column bulb "" / Signallampe "" *)
	boutGr00Horn							AT %Q*:BOOL;													(*) 	Signal horn / Signal hupe *)

	boutGr00AllDoorsLock					AT %Q*:BOOL;													(* DQ 10.2) 	All doors lock / Alle Türen verriegeln *)
	

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>