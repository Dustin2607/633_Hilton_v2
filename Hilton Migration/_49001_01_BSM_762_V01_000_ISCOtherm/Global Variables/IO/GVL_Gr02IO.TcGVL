	boutGr02BulbBtnStart					AT %Q*:BOOL;													(*) 	Signal button bulb "start" / Signallampe "Start" *)
	boutGr02BulbBtnStop						AT %Q*:BOOL;													(*) 	Signal button bulb "stop" / Signallampe "Stop" *)

END_VAR
