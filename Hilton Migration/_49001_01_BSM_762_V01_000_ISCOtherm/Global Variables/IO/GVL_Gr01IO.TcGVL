<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr01IO" Id="{8ddbfdba-b39a-4415-a9f0-00e24c68f36a}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
	(* Inputs / Eingänge *)
	binGr01LightCurtainOK 						AT %I*:BOOL;														(* DIx.x Light curtain ok / Freigabe Lichtschranke i.o *)

	binGr01PushBtnStart 						AT %I*:BOOL; 													(* DIx.x Push button "Start" / Taste "Start" *)
	binGr01PushBtnStop 						AT %I*:BOOL; 													(* DIx.x Push button "Stop" / Taste "Stop" *)

	binGr01AxisSawBowLimitMax 				AT %I*:BOOL; 													(* DI100.4 Maximum limit of saw bow axis / Endschalter Bügel- Achse maximal *)
	binGr01AxisSawBowLimitMin 				AT %I*:BOOL; 													(* DI100.5 Minimum limit of saw bow axis Z / Endschalter Bügel- Achse minimal *)
	binGr01AxisAngleLimitMax 					AT %I*:BOOL; 													(* DI100.6 Maximum limit of angle axis / Endschalter Winkel - Achse maximal *)
	binGr01AxisAngleLimitMin 					AT %I*:BOOL; 													(* DI100.7 Minimum limit of angle axis / Endschalter Winkel - Achse minimal *)

	binGr01SawbandRelease					AT %I*:BOOL;														(* DI0.3 Saw band release / Sägeband-Freigabe *)
	binGr01SawbandMotorNOK					AT %I*:BOOL;														(* DIx.x Saw band motor protection switch is no ok / Sägeband-Motorschutzschalter NiO *)
	binGr01SawbandNoBroken					AT %I*:BOOL;														(* DI2.6 Saw band brake / Sägebandbruch *)

	binGr01VacuumCleanerMotorNOK			AT %I*:BOOL; 													(* DIx.x Vacuum cleaner motor protection switch is no ok / Absaugung-Motorschutzschalter NiO *)

	binGr01PipeNoIdentify						AT %I*:BOOL;														(* DI100.1 Pipe identify  / Rohrerkenung *)

	udninGr01CounterSawbandSpeed			AT %I* :UDINT;													(* 1A5 Counter Saw band speed counter / Sägeband-Geschwindigkeits-Zähler *)
	udninGr01IncAxisAngle						AT %I* :UDINT;													(* 1A6 SSI01 Axis angle increment *)

	ninGr01SawingOverride					AT %I* :INT;														(* Sawing override *)

	(* Outputs / Ausgänge *)
	boutGr01ConfLightCurtain 					AT %Q*:BOOL; 													(* DQx.x Confirm light Curtain / Quitt Lichtschrank *)

	boutGr01BulbBtnStart 						AT %Q*:BOOL; 													(* DQx.x Signal button bulb "start" / Signallampe "Start" *)
	boutGr01BulbBtnStop 						AT %Q*:BOOL; 													(* DQx.x Signal button bulb "stop" / Signallampe "Stop" *)

	boutGr01SawbandAirOn					AT %Q*:BOOL;													(* DQ100.1 Saw band air on / Sägeband Druckluft ein *)
	boutGr01LaserOn							AT %Q*:BOOL;													(* DQ100.2 Laser on / off / Laser ein / aus *)
	boutGr01VacuumCleanerOn					AT %Q*:BOOL;													(* DQx.x Vacuum cleaner on / off / Absaugung ein / aus *)

	boutGr01SawBowAngleZerro				AT %Q*:BOOL;													(* DQ100.7 Saw bow angle zerro, confirmed safety is needed *)

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>