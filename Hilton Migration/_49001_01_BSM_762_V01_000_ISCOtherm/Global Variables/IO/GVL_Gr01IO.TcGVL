<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr01IO" Id="{8ddbfdba-b39a-4415-a9f0-00e24c68f36a}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
	(* Inputs / Eingänge *)
	binGr01LightCurtainOK 					AT %I*:BOOL;													(*)		Light curtain ok / Freigabe Lichtschranke i.o *)

	binGr01PushBtnStart 					AT %I*:BOOL; 													(*)		Push button "Start" / Taste "Start" *)
	binGr01PushBtnStop 						AT %I*:BOOL; 													(*)		Push button "Stop" / Taste "Stop" *)

	binGr01AxisSawBowLimitMax 				AT %I*:BOOL; 													(* DI 110.0) 	Maximum limit of saw bow axis / Endschalter Bügel- Achse maximal *)
	binGr01AxisSawBowLimitMin 				AT %I*:BOOL; 													(* DI 110.1) 	Minimum limit of saw bow axis Z / Endschalter Bügel- Achse minimal *)
	binGr01AxisAngleLimitMax 				AT %I*:BOOL; 													(* DI 109.1) 	Maximum limit of angle axis / Endschalter Winkel - Achse maximal *)
	binGr01AxisAngleLimitMin 				AT %I*:BOOL; 													(* DI 109.0) 	Minimum limit of angle axis / Endschalter Winkel - Achse minimal *)

	binGr01SawbandRelease					AT %I*:BOOL;													(* DI102.0)		Saw band release / Sägeband-Freigabe *)
	binGr01SawbandLocked					AT %I*:BOOL;													(* DI102.1)		Currently not active *)
	binGr01SawbandMotorNOK					AT %I*:BOOL;													(*) 	DIx.x Saw band motor protection switch is no ok / Sägeband-Motorschutzschalter NiO *)
	binGr01SawbandNoBroken					AT %I*:BOOL;													(*) 	DI2.6 Saw band brake / Sägebandbruch *)

	binGr01VacuumCleanerMotorNOK			AT %I*:BOOL; 													(*) 	DIx.x Vacuum cleaner motor protection switch is no ok / Absaugung-Motorschutzschalter NiO *)

	binGr01PipeNoIdentify					AT %I*:BOOL;													(* DI106.0) 	DI100.1 Pipe identify  / Rohrerkenung *)

	udninGr01CounterSawbandSpeed			AT %I* :UDINT;													(*) 	Counter Saw band speed counter / Sägeband-Geschwindigkeits-Zähler *)
	udninGr01IncAxisAngle					AT %I* :UDINT;													(*) 	SSI01 Axis angle increment *)

	ninGr01SawingOverride					AT %I* :INT;													(*) 	Sawing override *)

	(* Outputs / Ausgänge *)
	boutGr01ConfLightCurtain 				AT %Q*:BOOL; 													(*) 	Confirm light Curtain / Quitt Lichtschrank *)

	boutGr01BulbBtnStart 					AT %Q*:BOOL; 													(*) 	Signal button bulb "start" / Signallampe "Start" *)
	boutGr01BulbBtnStop 					AT %Q*:BOOL; 													(*) 	Signal button bulb "stop" / Signallampe "Stop" *)

	boutGr01SawbandAirOn					AT %Q*:BOOL;													(*) 	Saw band air on / Sägeband Druckluft ein *)
	boutGr01LaserOn							AT %Q*:BOOL;													(*) 	Laser on / off / Laser ein / aus *)
	boutGr01VacuumCleanerOn					AT %Q*:BOOL;													(*) 	Vacuum cleaner on / off / Absaugung ein / aus *)

	boutGr01SawBowAngleZerro				AT %Q*:BOOL;													(*) 	Saw bow angle zerro, confirmed safety is needed *)

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>