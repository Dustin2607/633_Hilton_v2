<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr05IO" Id="{adc762c1-8163-4f5b-a6c6-fe82249bf7ec}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
(* Inputs / Eingänge *)
	binGr05LightCurtainOK					AT %I*:BOOL;													(*) 	Light curtain ok / Freigabe Lichtschranke i.o *)

	binGr05PushBtnStart						AT %I*:BOOL;													(*) 	Push button "Start" / Taste "Start" *)
	binGr05PushBtnStop						AT %I*:BOOL;													(*) 	Push button "Stop" / Taste "Stop" *)

	binGr05AxisClamp1LimitMax				AT %I*:BOOL;													(* DI 108.0) 	Max Limit of clamp 1 feed; also ref point set with lrOriginShiftPos from HMI *)
	binGr05AxisClamp1LimitMin				AT %I*:BOOL;													(* DI 108.1) 	Min Limit of clamp 1 feed *)

	binGr05SlideTop							AT %I*:BOOL;													(*) 	Valve opened slide / Ventil Rutsche geöffnet *)
	binGr05SlideBottom						AT %I*:BOOL;													(*) 	Valve closed slide / Ventil Rutsche geschlossen *)

	binGr05RemovalBandNOK					AT %I*:BOOL;													(*) 	Removal band error / Abtransportband Fehler *)
	binGr05RemovalBandInPlus				AT %I*:BOOL;													(*) 	Removal band in plus limit / Abtransportband Plusendlage *)
	binGr05PushBtnRemovalBandStart			AT %I*:BOOL;													(*) 	Push button removal band "Start" / Taste Abtransportband "Start" *)
	binGr05RemovalBandInMinus				AT %I*:BOOL;													(*) 	Removal band in minus limit / Abtransportband Minusendlage *)

	arbinGr05ClampOpened					AT %I*: ARRAY[1..ungGr05ClampMaxNo] OF BOOL;					(*) 	Valve opened clamp 1, 2 / Ventil Klemmung 1, 2 geöffnet *)
	arbinGr05ClampClosed					AT %I*: ARRAY[1..ungGr05ClampMaxNo] OF BOOL;					(*) 	Valve closed clamp 1, 2  / Ventil Klemmung 1, 2  geschlossen *)

	arbinGr05CylinderPosOpened				AT %I*: ARRAY[1..ungGr05CylinderPosMaxNo] OF BOOL;				(* DI 103.0; 104.0; 105.0) 	Valve Pos Home | 100mm^=[1] | 200mm^=[2] | 300mm^=[3] *)
	arbinGr05CylinderPosClosed				AT %I*: ARRAY[1..ungGr05CylinderPosMaxNo] OF BOOL;				(* DI 103.1; 104.1; 105.1) 	Valves Pos Work | 100mm^=[1] | 200mm^=[2] | 300mm^=[3] *)

	binGr05PipeEndEdge						AT %I*:BOOL;													(* DI 106.1) 	Pipe end edge  / Rohrendekante *)
	binGr05PipeBeginEdge					AT %I*:BOOL;													(* DI 107.1) 	Pipe begin edge  / Rohranfangkante *)

	(* Outputs / Ausgänge *)
	boutGr05ConfLightCurtain				AT %Q*:BOOL;													(*) 	Confirm light Curtain / Quitt Lichtschrank *)

	boutGr05BulbBtnStart					AT %Q*:BOOL;													(*) 	Signal button bulb "start" / Signallampe "Start" *)
	boutGr05BulbBtnStop						AT %Q*:BOOL;													(*) 	Signal button bulb "stop" / Signallampe "Stop" *)

	boutGr05SlideUp							AT %Q*:BOOL;													(*) 	Valve open slide / Ventil Rutsche öffnen *)
	boutGr05SlideDown						AT %Q*:BOOL;													(*) 	Valve close slide / Ventil Rutsche schlissen *)

	boutGr05RemovalBandToPlus				AT %Q*:BOOL;													(*) 	Move removal band in plus direction / Abtransportband in Plusrichtung *)
	boutGr05RemovalBandToMinus				AT %Q*:BOOL;													(*) 	Move removal band in minus direction / Abtransportband in Minusrichtung *)


	arboutGr05ClampOpen						AT %Q*: ARRAY[1..ungGr05ClampMaxNo] OF BOOL;					(* DQ 102.0; 102.2) Valve Clamping MOVE to HomePos | Clamp_1^=[1] | Clamp_2^=[2] *)
	arboutGr05ClampClose					AT %Q*: ARRAY[1..ungGr05ClampMaxNo] OF BOOL;					(* DQ 102.1; 102.2)	Valve Clamping MOVE to WorkPos | Clamp_1^=[1] | Clamp_2^=[2] *)

	arboutGr05CylinderPosOpen				AT %Q*: ARRAY[1..ungGr05CylinderPosMaxNo] OF BOOL;				(* DQ 103.0; 103.2; 104.0) 	Valve MOVE to Pos Home | 100mm^=[1] | 200mm^=[2] | 300mm^=[3] *)
	arboutGr05CylinderPosClose				AT %Q*: ARRAY[1..ungGr05CylinderPosMaxNo] OF BOOL;				(* DQ 103.1; 103.3; 104.1) 	Valve MOVE to Pos Work | 100mm^=[1] | 200mm^=[2] | 300mm^=[3] *)

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>