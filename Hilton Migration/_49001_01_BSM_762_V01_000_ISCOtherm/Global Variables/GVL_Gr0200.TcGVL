	bgGr02SafetyCompleted			:BOOL := TRUE;				(* Safety completed *)
	bgGr02ManualCompleted			:BOOL := TRUE;				(* Manual completed *)
	bgGr02HomeCompleted			:BOOL := TRUE;				(* Home completed / Grundsrellung ausgeführt *)
	bgGr02AutoCompleted				:BOOL := TRUE;				(* Automatic completed / Automatik beendet *)
	bgGr02MoveInterrupted			:BOOL;						(* Move interrupted / Bewegung unterbrochen *)
	bgGr02WritePersistent				:BOOL;						(* Write persisten data *)
