<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr02Config" Id="{99d12c24-a657-41e3-a0f2-7016e67e8abd}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL CONSTANT
	tgGr02ControllerOff					:TIME := t#10s;				(* Delay to switch the controller off *)
	tgGr02LightCurtainDelay				:TIME := t#1s;					(* After time light Curtain safe *)
	tgGr02MaxRefTime					:TIME := t#4m;					(* Maximum time after start reference until message in reference / Maximale Zeit von Starten der Referenbzfahr bis ende der Referenzfahrt *)

	rgGr02AdsOverrideAcc					:REAL := 10.0;					(* Override accerlation per second / Override Beschleuingung pro sekunde *)
	rgGr02AdsOverrideDec				:REAL :=100.0;				(* Override decerlation per second / Override Verzögerung pro sekunde *)

	sgGr02LifetimeFilePath					:STRING := 'C:\TwinCAT\Boot\';	(* File path for saw band enabled life time *)
	sgGr02LifetimeFileName				:STRING := 'lt2';				(* File name for saw band enabled life time *)

	(* Axis parameters *)

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>