<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Gr00Config" Id="{72f43e33-8f47-445a-ade9-8d6f50b8204f}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL CONSTANT
	tgGr00FieldbusMasterStartUp		:TIME := t#60s;					(* Maximal start time for the fieldbus master / Maximale startzeit für den Busmaster *)
	tgGr00PowerSupplyOn				:TIME := t#2s;						(* Delay to switch the power supply on *)
	tgGr00PowerSupplyOff				:TIME := t#1s;						(* Delay to switch the power supply off *)
	tgGr00AirPressureOnDelay			:TIME := t#1s;						(* Delay air pressure on *)
	tgGr00AirPressureDelay			:TIME := t#2s;						(* Delay air pressure present *)
	tgGr00AirPressureBuildUp			:TIME := t#20s;					(* Max time to building up the air pressure  / Maximale Zeit zum erreichen des Solldrucks *)
	tgGr00LightCurtainDelay			:TIME := t#1s;						(* After time light Curtain safe *)
	tgGr00TempErrorDelay			:TIME := t#5m;						(* Max delay time until the message turns to an error *)
	rgGr00AdsOverrideAcc				:REAL := 10.0;						(* Override accerlation per second / Override Beschleuingung pro sekunde *)
	rgGr00AdsOverrideDec			:REAL :=100.0;					(* Override decerlation per second / Override Verzögerung pro sekunde *)
	sgGr00MachineLifetimeFilePath		:STRING := 'C:\TwinCAT\Boot\';(* File path for machine life time *)
	sgGr00MachineLifetimeFileName	:STRING := 'mlt';					(* File name for machine life time *)
	sgGr00PrgPath					:STRING := 'C:\TwinCAT\Boot\';(* Program path e.g. '\Hard Disk\Riex\Recipe'*)
	sgGr00PrgName					:STRING := 'prg';					(* Recipe name e.g. 'default' *)
	sgGr00PrgSuffix					:STRING := 'riex';					(* Recipe suffix e.g. rcp *)
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>