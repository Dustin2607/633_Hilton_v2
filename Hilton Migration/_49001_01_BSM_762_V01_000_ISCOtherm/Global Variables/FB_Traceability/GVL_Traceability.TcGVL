<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Traceability" Id="{e524f3d2-116d-4e9f-9ed6-44fbc29852de}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL CONSTANT
	bTraceEnable						:BOOL := TRUE;					(* Traceability enable *)
	sTracePath							:STRING := '\Hard Disk\Riex\Traceability\NewData\';	(* Path to file e.g. 'c:\', \Hard Disk\ *)
	sTraceFileName						:STRING(20);						(* Name of file *)
	sTraceFileExtension					:STRING(5) := 'txt';					(* File extension  *)
	sTraceColSep						:STRING(5) := '$T';					(* Seperator sign for columns *)
	udnTraceStringLengthMax 				:UDINT := 255;
	udnTraceSampleMax 					:UDINT := 101;
	udnTraceDataMax 					:UDINT := 19;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>